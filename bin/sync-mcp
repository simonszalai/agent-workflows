#!/usr/bin/env python3
"""Render one MCP manifest into Claude, Codex, Cursor, and Grok configuration."""

from __future__ import annotations

import argparse
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NamedTuple


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_MANIFEST = ROOT / "config/mcp.json"
PROJECT_CONTEXT = ROOT / "bin/project-context"
BEGIN = "# BEGIN agent-workflows managed MCP"
END = "# END agent-workflows managed MCP"
TOML_HEADER = re.compile(r"^\s*\[([^]]+)]\s*(?:#.*)?$")
SERVER_TABLE = re.compile(r'^mcp_servers\.(?:"([^"]+)"|([A-Za-z0-9_-]+))(?:\..*)?$')
BIOME_INDENT_STYLE = re.compile(r'"indentStyle"\s*:\s*"(tab|space)"')
BIOME_INDENT_WIDTH = re.compile(r'"indentWidth"\s*:\s*([1-9][0-9]*)')
ENV_VAR_NAME = re.compile(r"[A-Za-z_][A-Za-z0-9_]*")


class Server(NamedTuple):
    name: str
    transport: str
    url: str = ""
    profile: str = ""
    env_vars: tuple[str, ...] = ()


def fail(message: str, status: int = 2) -> None:
    print(f"sync-mcp: {message}", file=sys.stderr)
    raise SystemExit(status)


def load_json(path: Path, *, missing: object | None = None) -> object:
    try:
        return json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        if missing is not None:
            return missing
        fail(f"missing configuration: {path}")
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {path}: {error}")


def manifest(path: Path) -> dict[str, object]:
    value = load_json(path)
    if not isinstance(value, dict) or value.get("schema_version") != 1:
        fail(f"unsupported MCP manifest schema: {path}")
    for key in ("global_servers", "project_servers"):
        if not isinstance(value.get(key), dict):
            fail(f"{key} must be an object in {path}")
    names = value.get("managed_server_names")
    if not isinstance(names, list) or not all(isinstance(name, str) for name in names):
        fail(f"managed_server_names must be an array of strings in {path}")
    return value


def project_context(cwd: Path) -> tuple[str, Path]:
    result = subprocess.run(
        [str(PROJECT_CONTEXT), "--cwd", str(cwd)],
        capture_output=True,
        text=True,
        check=False,
        env={**os.environ, "PROJECT_TOOLS_CONFIG": str(
            Path(os.environ.get("PROJECT_TOOLS_CONFIG", ROOT / "config/project-tools.json"))
        )},
    )
    if result.returncode:
        fail(result.stderr.strip().splitlines()[-1] if result.stderr.strip() else
             "could not resolve the project")
    try:
        value = json.loads(result.stdout)
        project = value["project"]
        repo_root = value["repo_root"]
    except (KeyError, TypeError, json.JSONDecodeError) as error:
        fail(f"project-context returned invalid output: {error}")
    if not isinstance(project, str) or not isinstance(repo_root, str):
        fail("project-context returned an incomplete repository profile")
    return project, Path(repo_root)


def parse_server(name: str, raw: object) -> Server:
    if not isinstance(raw, dict):
        fail(f"MCP server {name!r} must be an object")
    raw_env_vars = raw.get("env_vars", [])
    if not isinstance(raw_env_vars, list):
        fail(f"MCP server {name!r} env_vars must be an array of strings")
    if not all(isinstance(variable, str) for variable in raw_env_vars):
        fail(f"MCP server {name!r} env_vars must be an array of strings")
    env_vars = tuple(raw_env_vars)
    invalid = next((variable for variable in env_vars
                    if not ENV_VAR_NAME.fullmatch(variable)), None)
    if invalid is not None:
        fail(f"MCP server {name!r} has invalid environment variable name {invalid!r}")
    if len(set(env_vars)) != len(env_vars):
        fail(f"MCP server {name!r} env_vars contains duplicate names")
    transport = raw.get("transport")
    if transport == "http":
        if "env_vars" in raw:
            fail(f"HTTP MCP server {name!r} cannot declare env_vars")
        url = raw.get("url")
        auth = raw.get("auth")
        if not isinstance(url, str) or not url.startswith("https://"):
            fail(f"HTTP MCP server {name!r} must use an HTTPS URL")
        if auth not in {"none", "oauth"}:
            fail(f"HTTP MCP server {name!r} has unsupported auth {auth!r}")
        return Server(name=name, transport=transport, url=url)
    if transport == "stdio-bridge":
        profile = raw.get("profile")
        if not isinstance(profile, str) or not re.fullmatch(r"[a-z][a-z0-9_]*", profile):
            fail(f"stdio MCP server {name!r} has an invalid profile")
        return Server(name=name, transport=transport, profile=profile, env_vars=env_vars)
    fail(f"MCP server {name!r} has unsupported transport {transport!r}")


def servers_for(
    config: dict[str, object], project: str | None, *, global_only: bool,
) -> list[Server]:
    merged: dict[str, object] = dict(config["global_servers"])
    if not global_only:
        projects = config["project_servers"]
        merged.update(projects.get("*", {}))
        if project:
            extra = projects.get(project, {})
            if not isinstance(extra, dict):
                fail(f"project_servers.{project} must be an object")
            merged.update(extra)
    return [parse_server(name, merged[name]) for name in sorted(merged)]


def bridge_args(server: Server, project: str | None) -> tuple[str, list[str]]:
    if server.profile == "autodev_memory":
        if not project:
            fail(f"project is required for {server.name}")
        return "sh", [
            "-lc",
            'exec "$HOME/.local/bin/mcp-bridge" autodev-memory --project "$1"',
            "mcp-bridge",
            project,
        ]
    if server.profile == "conductor":
        return "sh", ["-lc", 'exec "$HOME/.local/bin/mcp-bridge" conductor']
    fail(f"no bridge implementation for profile {server.profile!r}")


def json_entry(server: Server, project: str | None) -> dict[str, object]:
    if server.transport == "http":
        return {"type": "http", "url": server.url}
    command, args = bridge_args(server, project)
    return {"type": "stdio", "command": command, "args": args}


def toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def toml_entry(server: Server, project: str | None, *, grok: bool) -> list[str]:
    lines = [f"[mcp_servers.{server.name}]"]
    if server.transport == "http":
        lines.append(f"url = {toml_string(server.url)}")
    else:
        command, args = bridge_args(server, project)
        lines.append(f"command = {toml_string(command)}")
        rendered = ", ".join(toml_string(arg) for arg in args)
        lines.append(f"args = [{rendered}]")
        if server.env_vars and not grok:
            if len(server.env_vars) == 1:
                lines.append(f"env_vars = [{toml_string(server.env_vars[0])}]")
            else:
                lines.append("env_vars = [")
                lines.extend(f"  {toml_string(variable)}," for variable in server.env_vars)
                lines.append("]")
    if grok:
        lines.append("enabled = true")
        if server.transport == "stdio-bridge":
            lines.append("startup_timeout_sec = 30")
    return lines


def strip_managed_toml(text: str, managed: set[str]) -> str:
    lines = text.splitlines()
    kept: list[str] = []
    skipping_marker = False
    skipping_table = False
    for line in lines:
        if line.strip() == BEGIN:
            skipping_marker = True
            skipping_table = False
            continue
        if line.strip() == END and skipping_marker:
            skipping_marker = False
            continue
        if skipping_marker:
            continue
        header = TOML_HEADER.match(line)
        if header:
            matched = SERVER_TABLE.fullmatch(header.group(1))
            name = (matched.group(1) or matched.group(2)) if matched else ""
            skipping_table = bool(matched and name in managed)
        if not skipping_table:
            kept.append(line)
    remaining = "\n".join(kept).strip()
    semantic = [
        line for line in kept
        if line.strip() and not line.lstrip().startswith("#")
    ]
    if not semantic:
        return ""
    return remaining


def render_toml(
    current: str, servers: list[Server], project: str | None, managed: set[str], *,
    grok: bool,
) -> str:
    base = strip_managed_toml(current, managed)
    block = [BEGIN]
    for index, server in enumerate(servers):
        if index:
            block.append("")
        block.extend(toml_entry(server, project, grok=grok))
    block.append(END)
    pieces = [piece for piece in (base, "\n".join(block)) if piece]
    return "\n\n".join(pieces).rstrip() + "\n"


def render_json(
    current: object, servers: list[Server], project: str | None, managed: set[str], *,
    indent: int | str, trailing_newline: bool,
) -> str:
    if not isinstance(current, dict):
        fail("MCP JSON root must be an object")
    raw_servers = current.get("mcpServers", {})
    if not isinstance(raw_servers, dict):
        fail("mcpServers must be an object")
    merged = {name: value for name, value in raw_servers.items() if name not in managed}
    for server in servers:
        merged[server.name] = json_entry(server, project)
    value = dict(current)
    value["mcpServers"] = {name: merged[name] for name in sorted(merged)}
    rendered = json.dumps(value, indent=indent, ensure_ascii=False)
    return rendered + ("\n" if trailing_newline else "")


def json_indent(text: str) -> int | str:
    """Keep the repository formatter's existing JSON indentation convention."""
    for line in text.splitlines()[1:]:
        if not line.strip():
            continue
        prefix = line[:len(line) - len(line.lstrip())]
        if prefix.startswith("\t"):
            return "\t"
        if prefix:
            return len(prefix)
        break
    return 2


def project_json_indent(root: Path, fallback: str) -> int | str:
    """Prefer a repository's explicit Biome JSON style over historical file style."""
    for name in ("biome.json", "biome.jsonc"):
        text = read_text(root / name)
        if not text:
            continue
        matched = BIOME_INDENT_STYLE.search(text)
        if matched and matched.group(1) == "tab":
            return "\t"
        if matched and matched.group(1) == "space":
            width = BIOME_INDENT_WIDTH.search(text)
            return int(width.group(1)) if width else 2
    return json_indent(fallback)


def read_text(path: Path) -> str:
    try:
        return path.read_text(encoding="utf-8")
    except FileNotFoundError:
        return ""
    except OSError as error:
        fail(f"cannot read {path}: {error}")


def atomic_write(path: Path, content: str, *, private: bool) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    old_mode = None
    try:
        old_mode = stat.S_IMODE(path.stat().st_mode)
    except FileNotFoundError:
        pass
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, old_mode if old_mode is not None else (0o600 if private else 0o644))
        os.replace(temporary, path)
    except BaseException:
        try:
            os.unlink(temporary)
        except OSError:
            pass
        raise


def update(path: Path, desired: str, *, check: bool, private: bool) -> bool:
    current = read_text(path)
    if current == desired:
        return False
    if check:
        print(f"stale: {path}", file=sys.stderr)
    else:
        atomic_write(path, desired, private=private)
        print(f"updated: {path}")
    return True


def sync_json(
    path: Path, servers: list[Server], project: str | None, managed: set[str], *,
    check: bool, private: bool, indent: int | str,
) -> bool:
    current_text = read_text(path)
    current = load_json(path, missing={})
    # Claude owns ~/.claude.json and rewrites it without a trailing newline during
    # ordinary commands such as `claude mcp list`. Preserve that user-file convention
    # so a health check does not make the renderer report false drift. Checked-in
    # project configs and newly created user files keep the normal final newline.
    trailing_newline = not private or not current_text or current_text.endswith("\n")
    desired = render_json(
        current, servers, project, managed, indent=indent,
        trailing_newline=trailing_newline,
    )
    return update(path, desired, check=check, private=private)


def sync_toml(
    path: Path, servers: list[Server], project: str | None, managed: set[str], *,
    check: bool, private: bool, grok: bool,
) -> bool:
    desired = render_toml(read_text(path), servers, project, managed, grok=grok)
    return update(path, desired, check=check, private=private)


def sync_scope(
    root: Path, servers: list[Server], project: str | None, managed: set[str], *,
    user: bool, check: bool,
) -> bool:
    if user:
        paths = {
            "claude": root / ".claude.json",
            "codex": root / ".codex/config.toml",
            "cursor": root / ".cursor/mcp.json",
            "grok": root / ".grok/config.toml",
        }
    else:
        paths = {
            "claude": root / ".mcp.json",
            "codex": root / ".codex/config.toml",
            "cursor": root / ".cursor/mcp.json",
            "grok": root / ".grok/config.toml",
        }
    claude_text = read_text(paths["claude"])
    cursor_text = read_text(paths["cursor"])
    if user:
        claude_indent = json_indent(claude_text)
        cursor_indent = json_indent(cursor_text)
    else:
        project_indent = project_json_indent(root, claude_text or cursor_text)
        claude_indent = project_indent
        cursor_indent = project_indent
    changed = sync_json(
        paths["claude"], servers, project, managed, check=check, private=user,
        indent=claude_indent,
    )
    changed |= sync_toml(
        paths["codex"], servers, project, managed,
        check=check, private=user, grok=False,
    )
    changed |= sync_json(
        paths["cursor"], servers, project, managed, check=check, private=user,
        indent=cursor_indent,
    )
    changed |= sync_toml(
        paths["grok"], servers, project, managed,
        check=check, private=user, grok=True,
    )
    return changed


def main() -> None:
    parser = argparse.ArgumentParser(prog="sync-mcp")
    parser.add_argument("--user", action="store_true", help="sync user-scope configuration")
    parser.add_argument("--project", action="store_true", help="sync checked-in project files")
    parser.add_argument("--include-project", action="store_true",
                        help="include the current project in user scope (cloud workspaces)")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--cwd", type=Path, default=Path.cwd())
    parser.add_argument("--home", type=Path, default=Path.home())
    parser.add_argument("--manifest", type=Path, default=DEFAULT_MANIFEST)
    args = parser.parse_args()
    if not args.user and not args.project:
        fail("choose --user and/or --project")
    if args.include_project and not args.user:
        fail("--include-project requires --user")

    config = manifest(args.manifest)
    managed = set(config["managed_server_names"])
    project = None
    repo_root = None
    if args.project or args.include_project:
        project, repo_root = project_context(args.cwd)

    changed = False
    if args.user:
        user_servers = servers_for(config, project, global_only=not args.include_project)
        changed |= sync_scope(
            args.home.expanduser(), user_servers,
            project if args.include_project else None,
            managed, user=True, check=args.check,
        )
    if args.project:
        assert project is not None and repo_root is not None
        project_servers = servers_for(config, project, global_only=False)
        changed |= sync_scope(
            repo_root, project_servers, project, managed,
            user=False, check=args.check,
        )
    if args.check and changed:
        raise SystemExit(1)


if __name__ == "__main__":
    main()
