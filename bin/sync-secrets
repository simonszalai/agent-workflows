#!/usr/bin/env bash
# sync-secrets — vault-truth secret sync: push a repo's manifest-routed secrets
# from 1Password to their destinations (GitHub Actions, Render env vars,
# Prefect blocks). One direction only; nothing writes back to the vault.
# Idempotent, upsert-only, never deletes a destination secret.
#
# The routing manifest lives in the TARGET repo at scripts/secrets/manifest
# (KIND<TAB>DEST<TAB>ENVNAME<TAB>REF<TAB>TRANSFORM). The engine (parsing,
# reads, transforms, writers) lives here in agent-workflows/secrets/.
#
# Project layer (service-account token env/Keychain item, Render API key ref)
# is resolved from the target repo's git remote via bin/project-context — no
# ambient fallback, no hardcoded per-service tables.
#
# usage:
#   sync-secrets [--repo <path>] [--dry-run] [--dest <DEST>] [--only NAME[,NAME...]]
#                [--changed 'op://Vault/Item[/field]'] [--reason TEXT]
#                [--channel github|render|prefect] [--no-deploy]
#
#   default sweep = github + render. prefect is explicit only (--channel
#   prefect): it runs a Python entrypoint and prod prompts for confirmation.
#   --changed matches REF by exact equality (full ref) or by op://Vault/Item/
#   prefix (field-less form) — never bare substring. It cannot combine with
#   --channel and never reaches prefect.
#
# exit codes: 0 ok, 1 operational failure, 2 usage, 3 refusal.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../secrets/lib}"

usage() {
  cat >&2 <<'EOF'
usage:
  sync-secrets [--repo <path>] [--dry-run] [--dest <DEST>] [--only NAME[,NAME...]]
               [--changed 'op://Vault/Item[/field]'] [--reason TEXT]
               [--channel github|render|prefect] [--no-deploy]

Pushes the target repo's scripts/secrets/manifest rows to their destinations.
Default sweep = github + render; prefect only via --channel prefect.
--dry-run reads nothing and writes nothing (works from agent shells).
EOF
  exit 2
}

repo="" dry=0 dest="" only="" changed="" reason="" channel="" no_deploy=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) repo="${2:?}"; shift 2 ;;
    --repo=*) repo="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --dest) dest="${2:?}"; shift 2 ;;
    --dest=*) dest="${1#*=}"; shift ;;
    --only) only="${2:?}"; shift 2 ;;
    --only=*) only="${1#*=}"; shift ;;
    --changed) changed="${2:?}"; shift 2 ;;
    --changed=*) changed="${1#*=}"; shift ;;
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --channel) channel="${2:?}"; shift 2 ;;
    --channel=*) channel="${1#*=}"; shift ;;
    --no-deploy) no_deploy=1; shift ;;
    -h|--help) usage ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage ;;
  esac
done

if [[ -n "$channel" ]]; then
  case "$channel" in
    github|render|prefect) ;;
    *) echo "ERROR: --channel must be github, render, or prefect" >&2; exit 2 ;;
  esac
fi
if [[ -n "$changed" && -n "$channel" ]]; then
  echo "ERROR: --changed cannot combine with --channel (it fans out to github+render itself)" >&2
  exit 2
fi

# --changed: full exact ref, or field-less op://Vault/Item -> prefix match on
# op://Vault/Item/ (never bare substring).
ref_arg=() # writer flag pair
if [[ -n "$changed" ]]; then
  if [[ "$changed" =~ ^op://[^/]+/[^/]+/[^/]+$ ]]; then
    ref_arg=(--ref "$changed")
  elif [[ "$changed" =~ ^op://[^/]+/[^/]+$ ]]; then
    ref_arg=(--ref-prefix "$changed/")
  else
    echo "ERROR: --changed needs op://Vault/Item or op://Vault/Item/field, got: $changed" >&2
    exit 2
  fi
fi

# Target repo + manifest.
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "ERROR: not inside a git repo; pass --repo <path>" >&2; exit 2; }
fi
repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "ERROR: repo path does not exist" >&2; exit 2; }
manifest="$repo/scripts/secrets/manifest"
[[ -f "$manifest" ]] || {
  echo "ERROR: no secrets manifest at $manifest — this repo is not routed. Add scripts/secrets/manifest (see agent-workflows docs/secrets.md)." >&2
  exit 2
}
export _MANIFEST_FILE="$manifest"

# shellcheck source=../secrets/lib/manifest.sh
source "$SECRETS_LIB/manifest.sh"
manifest_validate || exit $?

# DB-credential guard at the routing layer: a --changed selection that would
# push any canonical DB env name is refused before ANY channel writes. The
# postgres tooling (rotate-secret provider postgres / db-provision-roles) owns
# those pushes. Exact ENVNAME match only — derived names like
# DATABASE_URL_GLOBAL are routine pushes.
if [[ -n "$changed" ]]; then
  guarded=""
  for ch in github render; do
    rows="$(manifest_rows "$ch" "$dest")" || exit $?
    case "${ref_arg[0]}" in
      --ref) rows="$(awk -F'\t' -v r="${ref_arg[1]}" '$4 == r' <<< "$rows")" ;;
      --ref-prefix) rows="$(awk -F'\t' -v p="${ref_arg[1]}" 'index($4, p) == 1' <<< "$rows")" ;;
    esac
    hit="$(awk -F'\t' '$3 == "DATABASE_URL" || $3 == "MIGRATE_DATABASE_URL" || $3 == "SYSTEM_DATABASE_URL" { printf "  %s[%s] %s\n", $1, $2, $3 }' <<< "$rows")"
    [[ -n "$hit" ]] && guarded="${guarded}${hit}"$'\n'
  done
  if [[ -n "$guarded" ]]; then
    echo "ERROR: --changed $changed selects DB credential rows:" >&2
    printf '%s' "$guarded" >&2
    echo "Rotate Postgres credentials through the postgres tooling instead:" >&2
    echo "  rotate-secret --ref '<op-ref>' --reason ...   (provider postgres)" >&2
    echo "  db-provision-roles --project <p> [--app <app>] <tier> --reason ..." >&2
    exit 2
  fi
fi

# Project layer resolution — skipped for --dry-run, which must read nothing and
# work everywhere (the writers' dry plans need only the manifest).
if [[ "$dry" -eq 0 ]]; then
  ctx="$("$HERE/project-context" --cwd "$repo")" || exit 2
  SECRETS_SA_TOKEN_ENV="$(printf '%s' "$ctx" | jq -er '.service_account.token_env')" || exit 2
  SECRETS_SA_KEYCHAIN_ITEM="$(printf '%s' "$ctx" | jq -r '.service_account.keychain_item // ""')"
  SECRETS_RENDER_KEY_REF="$(printf '%s' "$ctx" | jq -r '.tools.render.api_key_ref // ""')"
  export SECRETS_SA_TOKEN_ENV SECRETS_SA_KEYCHAIN_ITEM SECRETS_RENDER_KEY_REF
fi

if [[ -n "$channel" ]]; then
  channels=("$channel")
else
  channels=(github render)
fi

# Count a channel's selected rows so an empty channel is skipped rather than
# run, and a --changed run that matches nothing anywhere exits 1.
rows_for_channel() { # channel -> matching row count on stdout
  local ch="$1" rows
  rows="$(manifest_rows "$ch" "$dest")" || return $?
  if [[ ${#ref_arg[@]} -gt 0 ]]; then
    case "${ref_arg[0]}" in
      --ref) rows="$(awk -F'\t' -v r="${ref_arg[1]}" '$4 == r' <<< "$rows")" ;;
      --ref-prefix) rows="$(awk -F'\t' -v p="${ref_arg[1]}" 'index($4, p) == 1' <<< "$rows")" ;;
    esac
  fi
  printf '%s' "$rows" | grep -c . || true
}

worst=0
note_rc() { # keep the most meaningful failure: refusal(3) > usage(2) > operational(1)
  local rc="$1"
  [[ "$rc" -eq 0 ]] && return 0
  if [[ "$worst" -eq 0 || "$rc" -gt "$worst" ]]; then worst="$rc"; fi
}

total_matched=0
for ch in "${channels[@]}"; do
  count="$(rows_for_channel "$ch")" || exit $?
  if [[ "$count" -eq 0 ]]; then
    if [[ -n "$changed" ]]; then
      echo "sync-secrets: no $ch rows reference $changed — channel skipped"
    else
      echo "sync-secrets: no $ch rows${dest:+ for $dest} — channel skipped"
    fi
    continue
  fi
  total_matched=$((total_matched + count))

  args=()
  [[ "$dry" -eq 1 ]] && args+=(--dry-run)
  [[ -n "$dest" ]] && args+=(--dest "$dest")
  [[ -n "$only" ]] && args+=(--only "$only")
  [[ ${#ref_arg[@]} -gt 0 ]] && args+=("${ref_arg[@]}")
  [[ -n "$reason" ]] && args+=(--reason "$reason")
  if [[ "$ch" == "render" && "$no_deploy" -eq 1 ]]; then args+=(--no-deploy); fi
  if [[ "$ch" == "prefect" ]]; then args+=(--repo "$repo"); fi

  echo "== sync-secrets: $ch ($repo) =="
  rc=0
  "$SECRETS_LIB/writers/$ch" ${args[@]+"${args[@]}"} || rc=$?
  note_rc "$rc"
done

if [[ -n "$changed" && "$total_matched" -eq 0 ]]; then
  echo "ERROR: --changed $changed matched no github or render rows in $manifest" >&2
  exit 1
fi

if [[ "$worst" -ne 0 ]]; then
  exit "$worst"
fi

if [[ "$dry" -eq 0 ]]; then
  cat <<'EOF'

Next:
  1. Confirm the touched services picked up the new values (deploy-last already ran unless --no-deploy).
  2. For prefect rows, run sync-secrets --channel prefect explicitly.
EOF
fi
