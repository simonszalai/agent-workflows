#!/usr/bin/env bash
# sync-secrets — vault-truth secret sync: push a project's routed secrets
# from 1Password to their destinations (GitHub Actions, Render env vars,
# Prefect blocks). One direction only; nothing writes back to the vault.
# Idempotent, upsert-only, never deletes a destination secret.
#
# Routes live in the project config at <primary-repo>/secrets.yaml
# (routes: repo/kind/dest/env/ref/transform). The engine (parsing,
# reads, transforms, writers) lives here in agent-workflows/secrets/.
#
# Project layer (service-account token env/Keychain item, Render API key ref)
# is resolved from the target repo's git remote via bin/project-context — no
# ambient fallback, no hardcoded per-service tables.
#
# usage:
#   sync-secrets [--repo <path>] [--dry-run] [--dest <DEST>] [--only NAME[,NAME...]]
#                [--changed 'op://Vault/Item[/field]'] [--reason TEXT]
#                [--channel github|render|prefect|hermes] [--no-deploy] [--include-db]
#
#   default sweep = github + render + hermes + prefect (both prefect tiers;
#   the prod tier runs last in the foreground and prompts unless
#   SECRETS_ASSUME_YES=1 — rotate-secret/rotate-project set it, the operator
#   already confirmed the live rotation).
#   --changed matches REF by exact equality (full ref) or by op://Vault/Item/
#   prefix (field-less form) — never bare substring. It cannot combine with
#   --channel.
#   --include-db is the one-time initial-cutover override for the canonical DB
#   env names (DATABASE_URL / MIGRATE_DATABASE_URL / SYSTEM_DATABASE_URL): it
#   is only valid together with a targeted --changed selection AND --reason,
#   and pushes the selected DB rows like normal rows. Rotations still go
#   through rotate-secret (provider postgres) / db-provision-roles.
#
# exit codes: 0 ok, 1 operational failure, 2 usage, 3 refusal.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../secrets/lib}"

usage() {
  cat >&2 <<'EOF'
usage:
  sync-secrets [--repo <path>] [--dry-run] [--dest <DEST>] [--only NAME[,NAME...]]
               [--changed 'op://Vault/Item[/field]'] [--reason TEXT]
               [--channel github|render|prefect|hermes] [--no-deploy] [--include-db]

Pushes the project config's routes to their destinations.
Default sweep = github + render + hermes + prefect (prod prefect prompts).
--dry-run reads nothing and writes nothing (works from agent shells).
--include-db (initial DB cutover only) requires --changed AND --reason.
EOF
  exit 2
}

repo="" dry=0 dest="" only="" changed="" reason="" channel="" no_deploy=0 skip_db_rows=0 include_db=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) repo="${2:?}"; shift 2 ;;
    --repo=*) repo="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --dest) dest="${2:?}"; shift 2 ;;
    --dest=*) dest="${1#*=}"; shift ;;
    --only) only="${2:?}"; shift 2 ;;
    --only=*) only="${1#*=}"; shift ;;
    --changed) changed="${2:?}"; shift 2 ;;
    --changed=*) changed="${1#*=}"; shift ;;
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --channel) channel="${2:?}"; shift 2 ;;
    --channel=*) channel="${1#*=}"; shift ;;
    --no-deploy) no_deploy=1; shift ;;
    --skip-db-rows) skip_db_rows=1; shift ;;
    --include-db) include_db=1; shift ;;
    -h|--help) usage ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage ;;
  esac
done

if [[ -n "$channel" ]]; then
  case "$channel" in
    github|render|prefect|hermes) ;;
    *) echo "ERROR: --channel must be github, render, prefect, or hermes" >&2; exit 2 ;;
  esac
fi
if [[ -n "$changed" && -n "$channel" ]]; then
  echo "ERROR: --changed cannot combine with --channel (it fans out to every default channel itself)" >&2
  exit 2
fi

# --include-db: one-time initial-cutover override. Targeted + audited only:
# it never widens a full sweep, and rotations stay with the postgres tooling.
if [[ "$include_db" -eq 1 ]]; then
  if [[ "$skip_db_rows" -eq 1 ]]; then
    echo "ERROR: --include-db cannot combine with --skip-db-rows" >&2
    exit 2
  fi
  if [[ -z "$changed" ]]; then
    echo "ERROR: --include-db needs a targeted --changed selection — full sweeps never push canonical DB rows." >&2
    echo "Initial cutover: sync-secrets --changed 'op://Vault/Item[/field]' --include-db --reason ..." >&2
    echo "Rotations: rotate-secret --ref '<op-ref>' --reason ...   (provider postgres)" >&2
    exit 2
  fi
  if [[ -z "$reason" ]]; then
    echo "ERROR: --include-db requires --reason (audited one-time initial-cutover push)" >&2
    exit 2
  fi
fi

# --changed: full exact ref, or field-less op://Vault/Item -> prefix match on
# op://Vault/Item/ (never bare substring).
ref_arg=() # writer flag pair
sel_ref="" sel_prefix=""
if [[ -n "$changed" ]]; then
  if [[ "$changed" =~ ^op://[^/]+/[^/]+/[^/]+$ ]]; then
    sel_ref="$changed"; ref_arg=(--ref "$changed")
  elif [[ "$changed" =~ ^op://[^/]+/[^/]+$ ]]; then
    sel_prefix="$changed/"; ref_arg=(--ref-prefix "$changed/")
  else
    echo "ERROR: --changed needs op://Vault/Item or op://Vault/Item/field, got: $changed" >&2
    exit 2
  fi
fi

# Target repo + project config. The repo may be any repo in the project: a
# non-primary repo carries a pointer to the project's primary config.
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "ERROR: not inside a git repo; pass --repo <path>" >&2; exit 2; }
fi
repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "ERROR: repo path does not exist" >&2; exit 2; }
export _SECRETS_CONFIG="$repo"

# shellcheck source=../secrets/lib/config.sh
source "$SECRETS_LIB/config.sh"
# shellcheck source=../secrets/lib/writer-common.sh
source "$SECRETS_LIB/writer-common.sh"
manifest="$(config_path)" || exit $?
config_validate || exit $?

# DB-credential guard at the routing layer (shared with writers/render): a
# --changed selection that would push any canonical DB env name is refused
# before ANY channel writes — channels run concurrently below, so the render
# writer's own guard would come too late for github. --include-db (validated
# above: --changed + --reason) lets the selected rows through.
if [[ -n "$changed" && "$skip_db_rows" -eq 0 && "$include_db" -eq 0 ]]; then
  { config_rows github "$dest" "$sel_ref" "$sel_prefix"; config_rows render "$dest" "$sel_ref" "$sel_prefix"; } \
    | db_guard_refuse sync || exit $?
fi

# Project layer resolution — skipped for --dry-run, which must read nothing and
# work everywhere (the writers' dry plans need only the manifest).
if [[ "$dry" -eq 0 ]]; then
  ctx="$("$HERE/project-context" --cwd "$repo")" || exit 2
  SECRETS_SA_TOKEN_ENV="$(printf '%s' "$ctx" | jq -er '.service_account.token_env')" || exit 2
  SECRETS_SA_KEYCHAIN_ITEM="$(printf '%s' "$ctx" | jq -r '.service_account.keychain_item // ""')"
  SECRETS_RENDER_KEY_REF="$(printf '%s' "$ctx" | jq -r '.tools.render.api_key_ref // ""')"
  export SECRETS_SA_TOKEN_ENV SECRETS_SA_KEYCHAIN_ITEM SECRETS_RENDER_KEY_REF
fi

# Channel tokens: github | render | hermes | prefect:<tier>. prefect is
# tier-scoped like its writer: --dest names the tier; without --dest both
# tiers run (each only when it has rows).
if [[ -n "$channel" ]]; then
  channels=("$channel")
else
  channels=(github render hermes prefect)
fi
expanded=()
for ch in "${channels[@]}"; do
  if [[ "$ch" == "prefect" ]]; then
    case "$dest" in
      "") expanded+=(prefect:staging prefect:prod) ;;
      staging|prod) expanded+=("prefect:$dest") ;;
      *) [[ -z "$channel" ]] || { echo "ERROR: --channel prefect needs --dest staging|prod (got $dest)" >&2; exit 2; } ;;
    esac
  else
    expanded+=("$ch")
  fi
done
channels=("${expanded[@]}")

# Count a channel's selected rows so an empty channel is skipped rather than
# run, and a --changed run that matches nothing anywhere exits 1.
rows_for_channel() { # channel token -> matching row count on stdout
  local ch="$1" d="$dest"
  [[ "$ch" != prefect:* ]] || { d="${ch#prefect:}"; ch=prefect; }
  config_rows "$ch" "$d" "$sel_ref" "$sel_prefix" | grep -c . || true
}

worst=0
note_rc() { # keep the most meaningful failure: refusal(3) > usage(2) > operational(1)
  local rc="$1"
  [[ "$rc" -eq 0 ]] && return 0
  if [[ "$worst" -eq 0 || "$rc" -gt "$worst" ]]; then worst="$rc"; fi
}

channel_args() { # channel token -> writer bin in $writer, argv in $args
  local ch="$1"
  args=()
  writer="$ch"
  [[ "$dry" -eq 1 ]] && args+=(--dry-run)
  [[ -n "$only" ]] && args+=(--only "$only")
  [[ ${#ref_arg[@]} -gt 0 ]] && args+=("${ref_arg[@]}")
  [[ -n "$reason" ]] && args+=(--reason "$reason")
  if [[ "$ch" == prefect:* ]]; then
    writer=prefect
    args+=(--repo "$repo" --dest "${ch#prefect:}")
    return 0
  fi
  [[ -n "$dest" ]] && args+=(--dest "$dest")
  if [[ "$ch" == "render" && "$no_deploy" -eq 1 ]]; then args+=(--no-deploy); fi
  if [[ "$ch" == "render" && "$skip_db_rows" -eq 1 ]]; then args+=(--skip-db-rows); fi
  if [[ "$ch" == "render" && "$include_db" -eq 1 ]]; then args+=(--include-db); fi
}

# Channels are independent destinations, so they run concurrently; each one's
# output is captured and replayed in channel order once all have finished.
# prefect:prod runs last in the foreground: it prompts on the tty unless
# SECRETS_ASSUME_YES=1.
total_matched=0
run_channels=() fg_channels=()
for ch in "${channels[@]}"; do
  count="$(rows_for_channel "$ch")" || exit $?
  if [[ "$count" -eq 0 ]]; then
    if [[ -n "$changed" ]]; then
      echo "sync-secrets: no $ch rows reference $changed — channel skipped"
    else
      echo "sync-secrets: no $ch rows${dest:+ for $dest} — channel skipped"
    fi
    continue
  fi
  total_matched=$((total_matched + count))
  if [[ "$ch" == "prefect:prod" ]]; then fg_channels+=("$ch"); else run_channels+=("$ch"); fi
done

run_foreground() { # channel token
  local rc=0
  channel_args "$1"
  echo "== sync-secrets: $1 ($repo) =="
  "$SECRETS_LIB/writers/$writer" ${args[@]+"${args[@]}"} || rc=$?
  note_rc "$rc"
}

if [[ ${#run_channels[@]} -eq 1 ]]; then
  run_foreground "${run_channels[0]}"
elif [[ ${#run_channels[@]} -gt 1 ]]; then
  outdir="$(mktemp -d "${TMPDIR:-/tmp}/sync-secrets.XXXXXX")"
  trap 'rm -rf "$outdir"' EXIT
  pids=()
  for ch in "${run_channels[@]}"; do
    channel_args "$ch"
    "$SECRETS_LIB/writers/$writer" ${args[@]+"${args[@]}"} >"$outdir/$ch.out" 2>"$outdir/$ch.err" </dev/null &
    pids+=($!)
  done
  i=0
  for ch in "${run_channels[@]}"; do
    rc=0
    wait "${pids[$i]}" || rc=$?
    echo "== sync-secrets: $ch ($repo) =="
    cat "$outdir/$ch.out"
    cat "$outdir/$ch.err" >&2
    note_rc "$rc"
    i=$((i + 1))
  done
fi
for ch in ${fg_channels[@]+"${fg_channels[@]}"}; do run_foreground "$ch"; done

if [[ -n "$changed" && "$total_matched" -eq 0 ]]; then
  # A ref whose only routes are dev has nothing to push — that is a fact, not
  # a failure (dev-env reads the vault live). Only a ref matching NOTHING is
  # an error (typo guard).
  other="$(config_rows "" "" "$sel_ref" "$sel_prefix")" || exit $?
  if [[ -n "$other" ]]; then
    kinds="$(printf '%s
' "$other" | awk -F'	' '{print $1}' | sort -u | paste -sd, -)"
    echo "sync-secrets: $changed routes only to $kinds — nothing to push (dev reads the vault live)"
  else
    echo "ERROR: --changed $changed matched no routes at all in $manifest" >&2
    exit 1
  fi
fi

if [[ "$worst" -ne 0 ]]; then
  exit "$worst"
fi

if [[ "$dry" -eq 0 ]]; then
  cat <<'EOF'

Next:
  Confirm the touched services picked up the new values (deploy-last already ran unless --no-deploy;
  prefect flows read the saved blocks on their next run).
EOF
fi
