#!/usr/bin/env python3
"""Execute or reuse an orchestrator-owned validation gate on one exact tree."""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from pathlib import Path


FORBIDDEN_OWNERS = {"builder", "reviewer", "review_resolution_builder", "test_writer"}
MAX_REPAIR_RUNS = 3


class ReceiptError(ValueError):
    """The validation request or receipt registry is unsafe or ambiguous."""


def git_read(cwd: Path, *args: str, env: dict[str, str] | None = None) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(cwd), *args],
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def working_tree_sha(cwd: Path) -> str | None:
    head = git_read(cwd, "rev-parse", "HEAD^{tree}")
    git_index = git_read(cwd, "rev-parse", "--git-path", "index")
    if head is None or git_index is None:
        return None
    index_path = Path(git_index)
    if not index_path.is_absolute():
        index_path = cwd / index_path
    with tempfile.TemporaryDirectory() as directory:
        temporary_index = Path(directory) / "index"
        if index_path.is_file():
            shutil.copy2(index_path, temporary_index)
        environment = os.environ.copy()
        environment["GIT_INDEX_FILE"] = str(temporary_index)
        staged = subprocess.run(
            ["git", "-C", str(cwd), "add", "-A"],
            capture_output=True,
            text=True,
            check=False,
            env=environment,
        )
        if staged.returncode:
            return None
        return git_read(cwd, "write-tree", env=environment)


def normalized_command(cwd: Path, command: list[str]) -> str:
    return json.dumps(
        {"cwd": str(cwd), "argv": command},
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=True,
    )


def load_receipts(registry: Path) -> list[dict]:
    receipts: list[dict] = []
    if not registry.exists():
        return receipts
    for path in sorted(registry.glob("*.json")):
        try:
            value = json.loads(path.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(value, dict):
            value.setdefault("recorded_at_epoch", path.stat().st_mtime)
            receipts.append(value)
    return sorted(
        receipts,
        key=lambda row: row.get("recorded_at_epoch", 0),
    )


def key_for(tree_sha: str, command: str) -> str:
    encoded = json.dumps(
        [tree_sha, command], separators=(",", ":"), ensure_ascii=True
    ).encode()
    return hashlib.sha256(encoded).hexdigest()


def atomic_write(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n")
    os.chmod(temporary, 0o600)
    os.replace(temporary, path)


def parse_compact_receipt(completed: subprocess.CompletedProcess) -> dict:
    lines = [line for line in completed.stdout.splitlines() if line.strip()]
    if not lines:
        raise ReceiptError("compact-exec emitted no receipt")
    try:
        value = json.loads(lines[-1])
    except json.JSONDecodeError as exc:
        raise ReceiptError("compact-exec emitted an invalid receipt") from exc
    if not isinstance(value, dict):
        raise ReceiptError("compact-exec receipt must be an object")
    return value


def main() -> int:
    parser = argparse.ArgumentParser(prog="validation-receipt")
    parser.add_argument("--owner", required=True)
    parser.add_argument(
        "--registry",
        type=Path,
        default=Path.home() / ".cache/agent-workflows/validation-receipts",
    )
    parser.add_argument("--timeout", type=float)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command:
        parser.error("a command is required after --")
    if args.owner in FORBIDDEN_OWNERS:
        print(json.dumps({
            "status": "invalid",
            "error": f"{args.owner} cannot own a full validation gate",
        }, separators=(",", ":")))
        return 2
    if args.owner != "orchestrator":
        print(json.dumps({
            "status": "invalid",
            "error": "owner must be orchestrator",
        }, separators=(",", ":")))
        return 2

    cwd = Path.cwd().resolve()
    tree_sha = working_tree_sha(cwd)
    exact_command = normalized_command(cwd, command)
    registry = args.registry.expanduser().resolve()
    registry.mkdir(parents=True, exist_ok=True, mode=0o700)
    registry.chmod(0o700)
    lock_digest = hashlib.sha256(exact_command.encode()).hexdigest()
    registry_lock = (registry / f"{lock_digest}.lock").open("w")
    os.chmod(registry_lock.name, 0o600)
    fcntl.flock(registry_lock, fcntl.LOCK_EX)
    prior = load_receipts(registry)
    exact = [
        row for row in prior
        if row.get("tree_sha") == tree_sha
        and row.get("normalized_exact_command") == exact_command
    ] if tree_sha else []
    exact_pass = next(
        (
            row for row in reversed(exact)
            if row.get("status") == "success"
            and row.get("attribution_certain") is True
        ),
        None,
    )
    if exact_pass is not None:
        receipt = {
            **exact_pass,
            "status": "success",
            "executed": False,
            "classification": "exact_tree_duplicate",
            "reused_receipt": exact_pass.get("receipt_file"),
        }
        print(json.dumps(receipt, separators=(",", ":")))
        return 0
    if exact and any(row.get("status") == "failure" for row in exact):
        print(json.dumps({
            "status": "invalid",
            "executed": False,
            "classification": "exact_tree_duplicate",
            "tree_sha": tree_sha,
            "normalized_exact_command": exact_command,
            "error": "failed validation cannot rerun on an unchanged tree",
        }, separators=(",", ":")))
        return 2

    command_history = [
        row for row in prior
        if row.get("normalized_exact_command") == exact_command
    ]
    latest_execution = next(
        (row for row in reversed(command_history) if row.get("executed", True)),
        None,
    )
    consecutive_failed_repairs = 0
    for row in reversed(command_history):
        if not row.get("executed", True):
            continue
        if row.get("status") != "failure":
            break
        if row.get("classification") != "repair_run":
            break
        consecutive_failed_repairs += 1
    if tree_sha is None:
        classification = "uncertain_attribution"
    elif exact:
        classification = "exact_tree_duplicate"
    elif latest_execution and latest_execution.get("status") == "failure":
        if consecutive_failed_repairs >= MAX_REPAIR_RUNS:
            print(json.dumps({
                "status": "invalid",
                "executed": False,
                "classification": "repair_run",
                "repair_runs": consecutive_failed_repairs,
                "max_repair_runs": MAX_REPAIR_RUNS,
                "tree_sha": tree_sha,
                "normalized_exact_command": exact_command,
                "error": (
                    "changed-tree repair rerun budget is exhausted "
                    f"({MAX_REPAIR_RUNS} repair runs)"
                ),
            }, separators=(",", ":")))
            return 2
        classification = "repair_run"
    elif command_history:
        classification = "changed_tree_run"
    else:
        classification = "initial_run"

    compact_command = [
        str(Path(__file__).with_name("compact-exec")),
    ]
    if args.timeout is not None:
        compact_command.extend(["--timeout", str(args.timeout)])
    compact_command.extend(["--", *command])
    completed = subprocess.run(
        compact_command,
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        compact = parse_compact_receipt(completed)
    except ReceiptError as exc:
        print(json.dumps({
            "status": "invalid",
            "executed": True,
            "classification": "uncertain_attribution",
            "error": str(exc),
        }, separators=(",", ":")))
        return 2

    certain = (
        tree_sha is not None
        and compact.get("tree_sha") == tree_sha
        and compact.get("tree_changed_during_command") is not True
    )
    if not certain:
        classification = "uncertain_attribution"
    receipt = {
        **compact,
        "tree_sha": compact.get("tree_sha") or tree_sha,
        "normalized_exact_command": exact_command,
        "owner": args.owner,
        "executed": True,
        "classification": classification,
        "attribution_certain": certain,
        "recorded_at_epoch": time.time(),
    }
    if classification == "repair_run":
        receipt["repair_run_number"] = consecutive_failed_repairs + 1
        receipt["max_repair_runs"] = MAX_REPAIR_RUNS
    if receipt["tree_sha"] is not None:
        receipt_path = registry / f"{key_for(receipt['tree_sha'], exact_command)}.json"
        receipt["receipt_file"] = str(receipt_path)
        atomic_write(receipt_path, receipt)
    print(json.dumps(receipt, separators=(",", ":")))
    return completed.returncode


if __name__ == "__main__":
    sys.exit(main())
