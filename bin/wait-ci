#!/usr/bin/env python3
"""Wait for GitHub PR checks or an Actions run in one bounded invocation."""

from __future__ import annotations

import argparse
import json
import os
import shlex
import signal
import subprocess
import sys
import time


TERMINAL_FAILURE = {"fail", "cancel"}
TERMINAL_CHECK_BUCKETS = {"pass", "fail", "cancel", "skipping"}
RUN_SUCCESS = {"success", "neutral", "skipped"}
MINIMUM_RESUME_TIMEOUT_SECONDS = 120


def main() -> None:
    parser = argparse.ArgumentParser(prog="wait-ci")
    parser.add_argument("ref", nargs="?", default="")
    parser.add_argument("--run", dest="run_id", default="",
                        help="wait for one GitHub Actions run instead of PR checks")
    # Default caps at 540s so one foreground call stays under a typical 9-minute harness cap.
    # Longer waits belong in a fresh no-history waiter, not parent-turn process polling.
    parser.add_argument("--timeout", type=float, default=540)
    parser.add_argument("--initial-delay", type=float, default=5)
    parser.add_argument("--max-delay", type=float, default=30)
    parser.add_argument("--gh", default="gh", help=argparse.SUPPRESS)
    args = parser.parse_args()
    if args.run_id and args.ref:
        parser.error("pass either a PR ref or --run, not both")
    if args.timeout < 0 or args.initial_delay < 0 or args.max_delay < 0:
        parser.error("timeouts and delays must be non-negative")

    started = time.monotonic()
    deadline = started + args.timeout
    delay = args.initial_delay
    polls = 0
    checks: list[dict] = []
    run: dict = {}
    status = "timeout"
    error = None
    prior_terminal_check_keys: set[tuple[str, str]] | None = None

    def check_fields() -> dict:
        status_counts: dict[str, int] = {}
        failed_checks = []
        pending = 0
        for item in checks:
            if not isinstance(item, dict):
                continue
            bucket = str(item.get("bucket") or "pending").lower()
            status_counts[bucket] = status_counts.get(bucket, 0) + 1
            if bucket not in TERMINAL_CHECK_BUCKETS:
                pending += 1
            if bucket in TERMINAL_FAILURE:
                failed_checks.append(
                    {key: item.get(key) for key in ("name", "state", "bucket", "link")}
                )
        return {
            "checks_pending": pending,
            "status_counts": dict(sorted(status_counts.items())),
            "failed_checks": failed_checks,
        }

    def resume_command() -> str:
        elapsed = time.monotonic() - started
        # A fresh invocation must have enough time for two GitHub observations. PR mode
        # deliberately requires two identical terminal check sets so a partial early set does not
        # look complete. Reusing the exhausted original deadline produced `--timeout 1`, which
        # could never make those observations and therefore could not actually resume.
        remaining = max(MINIMUM_RESUME_TIMEOUT_SECONDS, round(args.timeout - elapsed))
        command = "wait-ci"
        if args.run_id:
            command += f" --run {shlex.quote(args.run_id)}"
        elif args.ref:
            command += f" {shlex.quote(args.ref)}"
        return command + f" --timeout {remaining}"

    def handle_signal(signum: int, _frame: object) -> None:
        # Best-effort: the Bash harness (or an operator) is tearing us down before a
        # terminal state. Emit the same summary shape with a resume command so the caller
        # can pick the wait back up, then exit 124 like a natural timeout.
        summary = {
            "status": "timeout",
            "kind": "run" if args.run_id else "pr",
            "polls": polls,
            "duration_ms": round((time.monotonic() - started) * 1000),
            "checks_total": len(checks),
            "checks": [{key: item.get(key) for key in ("name", "state", "bucket", "link")}
                       for item in checks[:100] if isinstance(item, dict)],
            "checks_truncated": len(checks) > 100,
            **check_fields(),
            "run": {key: run.get(key) for key in
                    ("name", "status", "conclusion", "url")} if run else None,
            "error": f"interrupted by signal {signum} before a terminal CI state",
            "resume_command": resume_command(),
        }
        try:
            print(json.dumps(summary, separators=(",", ":")))
            sys.stdout.flush()
        except Exception:
            pass
        os._exit(124)

    signal.signal(signal.SIGTERM, handle_signal)
    signal.signal(signal.SIGINT, handle_signal)

    while True:
        if args.run_id:
            command = [args.gh, "run", "view", args.run_id, "--json",
                       "name,status,conclusion,url,jobs"]
        else:
            command = [args.gh, "pr", "checks"]
            if args.ref:
                command.append(args.ref)
            command += ["--json", "name,state,link,bucket"]
        remaining = max(0.1, deadline - time.monotonic())
        try:
            result = subprocess.run(command, capture_output=True, text=True, check=False,
                                    timeout=min(30, remaining))
        except subprocess.TimeoutExpired:
            status, error = "timeout", "gh poll exceeded the remaining deadline"
            break
        except OSError as exception:
            status, error = "error", str(exception)[-1000:]
            break
        polls += 1
        if result.returncode not in ((0,) if args.run_id else (0, 1, 8)):
            status = "error"
            error = (result.stderr or "gh CI query failed").strip()[-1000:]
            break
        try:
            parsed = json.loads(result.stdout or "[]")
        except json.JSONDecodeError:
            status, error = "error", "gh emitted invalid JSON"
            break
        if args.run_id:
            run = parsed if isinstance(parsed, dict) else {}
            conclusion = str(run.get("conclusion") or "").lower()
            if str(run.get("status") or "").lower() == "completed":
                status = "success" if conclusion in RUN_SUCCESS else "failure"
                break
        else:
            checks = parsed if isinstance(parsed, list) else []
            buckets = {str(item.get("bucket", "pending")).lower() for item in checks
                       if isinstance(item, dict)}
            check_keys = {
                (str(item.get("name") or ""), str(item.get("link") or ""))
                for item in checks if isinstance(item, dict)
            }
            all_terminal = bool(checks) and buckets <= TERMINAL_CHECK_BUCKETS
            # Two consecutive terminal observations of the same set prevent a partial early set
            # from looking complete before GitHub has registered the remaining required jobs.
            if all_terminal:
                if prior_terminal_check_keys == check_keys:
                    status = "failure" if buckets & TERMINAL_FAILURE else "success"
                    break
                prior_terminal_check_keys = check_keys
            else:
                prior_terminal_check_keys = None
        now = time.monotonic()
        if now >= deadline:
            break
        time.sleep(min(delay, max(0, deadline - now)))
        delay = min(args.max_delay, max(delay * 1.7, 0.1))

    summary = {
        "status": status,
        "kind": "run" if args.run_id else "pr",
        "polls": polls,
        "duration_ms": round((time.monotonic() - started) * 1000),
        "checks_total": len(checks),
        "checks": [{key: item.get(key) for key in ("name", "state", "bucket", "link")}
                   for item in checks[:100] if isinstance(item, dict)],
        "checks_truncated": len(checks) > 100,
        **check_fields(),
        "run": {key: run.get(key) for key in
                ("name", "status", "conclusion", "url")} if run else None,
        "error": error,
    }
    if status == "timeout":
        summary["resume_command"] = resume_command()
    print(json.dumps(summary, separators=(",", ":")))
    raise SystemExit({"success": 0, "failure": 1, "error": 2, "timeout": 124}[status])


if __name__ == "__main__":
    main()
