#!/usr/bin/env python3
"""Validate a finalized deployment-guide contract before remote mutation."""

from __future__ import annotations

import argparse
import json
import math
import sys
from pathlib import Path


GATE_CLASSES = {"causal_ship_gate", "observation"}
ENVIRONMENTS = {"staging", "production"}
EVIDENCE_SOURCES = {"immediate", "bounded_producer", "natural_traffic"}
ACCEPTANCE_SOURCES = {
    "source_criterion",
    "explicit_user_decision",
    "measured_production_baseline",
    "invariant",
}
FAILURE_CLASSES = {
    "code_defect",
    "verifier_defect",
    "environment_capacity",
    "external_observation",
    "invalid_evidence",
    "unknown",
}


class ContractError(ValueError):
    """The deployment guide cannot safely authorize mutation."""


def require_string(value: object, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ContractError(f"{field} must be a non-empty string")
    return value


def require_int(value: object, field: str, *, minimum: int = 0) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
        raise ContractError(f"{field} must be an integer >= {minimum}")
    return value


def require_positive_number(value: object, field: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)) or value <= 0:
        raise ContractError(f"{field} must be a positive number")
    return float(value)


def validate_acceptance_source(value: object, field: str) -> None:
    if not isinstance(value, dict):
        raise ContractError(f"{field} must be an object")
    if value.get("kind") not in ACCEPTANCE_SOURCES:
        raise ContractError(f"{field}.kind is invalid")
    require_string(value.get("reference"), f"{field}.reference")


def validate_evidence_timing(
    value: object,
    field: str,
    *,
    gate_class: str,
    sample_size: int,
) -> None:
    if not isinstance(value, dict):
        raise ContractError(f"{field} must be an object")
    source = value.get("source")
    if source not in EVIDENCE_SOURCES:
        raise ContractError(f"{field}.source is invalid")
    maturity = require_int(
        value.get("maturity_delay_seconds"),
        f"{field}.maturity_delay_seconds",
    )
    acquisition = require_int(
        value.get("acquisition_time_seconds"),
        f"{field}.acquisition_time_seconds",
    )
    deadline = require_int(
        value.get("verification_deadline_seconds"),
        f"{field}.verification_deadline_seconds",
        minimum=1,
    )
    if source == "natural_traffic":
        rate = require_positive_number(
            value.get("conservative_eligible_units_per_day"),
            f"{field}.conservative_eligible_units_per_day",
        )
        rate_bound = math.ceil(sample_size * 86400 / rate)
        if acquisition < rate_bound:
            raise ContractError(
                f"{field}.acquisition_time_seconds must be >= {rate_bound} "
                "for the declared natural-traffic rate"
            )
    elif value.get("conservative_eligible_units_per_day") is not None:
        raise ContractError(
            f"{field}.conservative_eligible_units_per_day is only valid for natural_traffic"
        )
    if gate_class == "causal_ship_gate" and maturity + acquisition > deadline:
        raise ContractError(
            f"{field} is infeasible for a causal_ship_gate: maturity + acquisition "
            "exceeds the verification deadline; classify it as observation or keep "
            "the guide DRAFT"
        )


def require_value_or_na(value: object, field: str) -> object:
    if isinstance(value, str) and value.strip():
        return value
    if not isinstance(value, dict) or value.get("status") != "N/A":
        raise ContractError(f"{field} must be a non-empty string or justified N/A")
    require_string(value.get("justification"), f"{field}.justification")
    if set(value) != {"status", "justification"}:
        raise ContractError(f"{field} N/A may contain only status and justification")
    return value


def load(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ContractError(f"cannot read {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise ContractError("contract root must be an object")
    return value


def validate(value: dict, required_environment: str | None = None) -> dict:
    if value.get("schema_version") != 2:
        raise ContractError("schema_version must equal 2")
    if value.get("status") != "FINALIZED":
        raise ContractError("status must equal FINALIZED")
    require_value_or_na(value.get("activation_boundary"), "activation_boundary")
    environments = value.get("environments")
    if not isinstance(environments, dict) or set(environments) != ENVIRONMENTS:
        raise ContractError("environments must contain exactly staging and production")

    counts: dict[str, int] = {}
    for environment in sorted(ENVIRONMENTS):
        contract = environments[environment]
        prefix = f"environments.{environment}"
        if isinstance(contract, dict) and contract.get("status") == "N/A":
            require_value_or_na(contract, prefix)
            counts[environment] = 0
            continue
        if not isinstance(contract, dict) or set(contract) != {"rows"}:
            raise ContractError(f"{prefix} must contain rows or be a justified N/A")
        rows = contract["rows"]
        if not isinstance(rows, list) or not rows:
            raise ContractError(f"{prefix}.rows must be a non-empty array")
        seen: dict[str, dict] = {}
        causal_rows = 0
        for index, row in enumerate(rows):
            field = f"{prefix}.rows[{index}]"
            if not isinstance(row, dict):
                raise ContractError(f"{field} must be an object")
            row_id = require_string(row.get("id"), f"{field}.id")
            if row_id in seen:
                raise ContractError(f"{field}.id is duplicated")
            require_string(row.get("exact_command"), f"{field}.exact_command")
            require_string(row.get("expected_result"), f"{field}.expected_result")
            require_string(row.get("bad_interpretation"), f"{field}.bad_interpretation")
            gate_class = row.get("gate_class")
            if gate_class not in GATE_CLASSES:
                raise ContractError(
                    f"{field}.gate_class must be causal_ship_gate or observation"
                )
            if gate_class == "causal_ship_gate":
                causal_rows += 1
                require_string(
                    row.get("causal_failure_meaning"),
                    f"{field}.causal_failure_meaning",
                )
            elif row.get("causal_failure_meaning") is not None:
                raise ContractError(
                    f"{field}.causal_failure_meaning is only valid for causal_ship_gate"
                )
            validate_acceptance_source(
                row.get("acceptance_source"),
                f"{field}.acceptance_source",
            )
            require_string(
                row.get("minimum_sufficient_evidence"),
                f"{field}.minimum_sufficient_evidence",
            )
            defect = require_string(
                row.get("distinguishes_defect"),
                f"{field}.distinguishes_defect",
            )
            failure_class = row.get("failure_class_on_failure")
            if failure_class not in FAILURE_CLASSES:
                raise ContractError(f"{field}.failure_class_on_failure is invalid")
            sample_size = require_int(
                row.get("sample_size"),
                f"{field}.sample_size",
                minimum=1,
            )
            validate_evidence_timing(
                row.get("evidence_timing"),
                f"{field}.evidence_timing",
                gate_class=gate_class,
                sample_size=sample_size,
            )
            exact_path_canary = row.get("exact_path_canary")
            if not isinstance(exact_path_canary, bool):
                raise ContractError(f"{field}.exact_path_canary must be boolean")
            canary_id = row.get("canary_row_id")
            if sample_size > 1:
                statistical = row.get("statistical_threshold")
                if not isinstance(statistical, dict):
                    raise ContractError(
                        f"{field}.statistical_threshold is required for sample_size > 1"
                    )
                require_string(
                    statistical.get("baseline"),
                    f"{field}.statistical_threshold.baseline",
                )
                require_string(
                    statistical.get("sample_size_rationale"),
                    f"{field}.statistical_threshold.sample_size_rationale",
                )
                require_string(
                    statistical.get("resource_budget"),
                    f"{field}.statistical_threshold.resource_budget",
                )
                if require_string(
                    statistical.get("distinguishes_defect"),
                    f"{field}.statistical_threshold.distinguishes_defect",
                ) != defect:
                    raise ContractError(
                        f"{field}.statistical_threshold.distinguishes_defect must "
                        "match the row"
                    )
                canary_id = require_string(canary_id, f"{field}.canary_row_id")
                canary = seen.get(canary_id)
                if (
                    canary is None
                    or canary["sample_size"] != 1
                    or canary["exact_path_canary"] is not True
                    or canary["distinguishes_defect"] != defect
                ):
                    raise ContractError(
                        f"{field}.canary_row_id must reference an earlier exact-path "
                        "single-unit canary for the same defect"
                    )
            elif canary_id is not None:
                raise ContractError(f"{field}.canary_row_id must be null for sample_size=1")
            require_value_or_na(row.get("bounded_producer"), f"{field}.bounded_producer")
            require_value_or_na(row.get("cleanup"), f"{field}.cleanup")
            seen[row_id] = {
                "sample_size": sample_size,
                "exact_path_canary": exact_path_canary,
                "distinguishes_defect": defect,
            }
        if causal_rows == 0:
            raise ContractError(f"{prefix}.rows must contain at least one causal_ship_gate")
        counts[environment] = len(rows)
    required = {
        "staging": {"staging"},
        "production": {"production"},
        "full": ENVIRONMENTS,
    }.get(required_environment, set())
    missing = sorted(environment for environment in required if counts[environment] == 0)
    if missing:
        raise ContractError(
            "required environment rows are N/A: " + ", ".join(missing)
        )
    if not any(counts.values()):
        raise ContractError("at least one environment must contain evidence rows")
    return {
        "status": "valid",
        "contract_status": "FINALIZED",
        "environment_row_counts": counts,
    }


def main() -> int:
    parser = argparse.ArgumentParser(prog="deployment-guide-contract")
    parser.add_argument(
        "--environment",
        choices=("staging", "production", "full"),
        help="require evidence rows for the selected deployment target",
    )
    parser.add_argument("contract", type=Path)
    args = parser.parse_args()
    try:
        result = validate(load(args.contract.resolve()), args.environment)
    except ContractError as exc:
        print(json.dumps({"status": "invalid", "error": str(exc)}, separators=(",", ":")))
        return 2
    print(json.dumps(result, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    sys.exit(main())
