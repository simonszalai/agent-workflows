OPAQUE_ID = re.compile(r"^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$")
SAFE_PATH = re.compile(r"^/[A-Za-z0-9._/-]{1,1023}$")


class SafeError(Exception):
    """An error whose code, but never detail, may cross the output boundary."""

    def __init__(
        self,
        code: str,
        *,
        exit_code: int = EXIT_PREFLIGHT,
        safe_result: dict[str, object] | None = None,
    ) -> None:
        super().__init__(code)
        self.code = code
        self.exit_code = exit_code
        self.safe_result = safe_result or {}


@dataclass(frozen=True)
class ItemSpec:
    name: str
    ref: str


@dataclass(frozen=True)
class ItemReceipt:
    name: str
    ref: str
    item_id: str
    state: str


@dataclass(frozen=True)
class DeployReceipt:
    mode: str
    service: str
    key: str
    deploy_id: str


@dataclass(frozen=True)
class HttpResponse:
    status: int
    body: object


ITEMS = (
    ItemSpec(MEMORY_ITEM, MEMORY_REF),
    ItemSpec(GATEWAY_ITEM, GATEWAY_REF),
)


def require_object(value: object, code: str = "protocol_shape_mismatch") -> dict[str, object]:
    if not isinstance(value, dict) or any(not isinstance(key, str) for key in value):
        raise SafeError(code, exit_code=EXIT_EXTERNAL)
    return cast(dict[str, object], value)


def require_list(value: object, code: str = "protocol_shape_mismatch") -> list[object]:
    if not isinstance(value, list):
        raise SafeError(code, exit_code=EXIT_EXTERNAL)
    return cast(list[object], value)


def require_string(value: object, code: str = "protocol_shape_mismatch") -> str:
    if not isinstance(value, str) or not value.strip():
        raise SafeError(code, exit_code=EXIT_EXTERNAL)
    return value


def require_opaque_id(value: object, code: str = "protocol_shape_mismatch") -> str:
    identifier = require_string(value, code)
    if not OPAQUE_ID.fullmatch(identifier):
        raise SafeError(code, exit_code=EXIT_EXTERNAL)
    return identifier


def require_exact_keys(value: dict[str, object], keys: set[str], code: str) -> None:
    if set(value) != keys:
        raise SafeError(code)


def validate_plan_transition_result(
    result: dict[str, object],
    *,
    ticket_id: str,
    repo: str,
) -> None:
    code = "canary_plan_transition_failed"
    required = {
        "operation_id",
        "ticket_id",
        "repo",
        "status",
        "artifact_id",
        "ticket_status",
    }
    additive = {"category", "assignee_id"}
    if frozenset(result) not in {frozenset(required), frozenset(required | additive)}:
        raise SafeError(code, exit_code=EXIT_CLEANUP)
    if (
        result["operation_id"] != "create-plan-and-plan-ticket"
        or result["ticket_id"] != ticket_id
        or result["repo"] != repo
        or result["status"] != "applied"
        or result["ticket_status"] != "planned"
    ):
        raise SafeError(code, exit_code=EXIT_CLEANUP)
    require_opaque_id(result["artifact_id"], code)
    if additive.issubset(result):
        if result["category"] != "feature" or result["assignee_id"] is not None:
            raise SafeError(code, exit_code=EXIT_CLEANUP)


def compact_json(value: object) -> bytes:
    return json.dumps(value, ensure_ascii=True, separators=(",", ":"), sort_keys=True).encode(
        "utf-8"
    )


def parse_json_bytes(data: bytes, code: str) -> object:
    if len(data) > MAX_HTTP_BYTES:
        raise SafeError(code, exit_code=EXIT_EXTERNAL)
    try:
        return json.loads(data.decode("utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError):
        raise SafeError(code, exit_code=EXIT_EXTERNAL) from None


def fixed_error_result(command: str, error: SafeError) -> dict[str, object]:
    result: dict[str, object] = {"code": error.code}
    result.update(error.safe_result)
    return {
        "schema": OUTPUT_SCHEMA,
        "command": command,
        "status": "fail",
        "result": result,
    }


def success_result(command: str, result: dict[str, object]) -> dict[str, object]:
    validate_public_result(command, result)
    return {
        "schema": OUTPUT_SCHEMA,
        "command": command,
        "status": "pass",
        "result": result,
    }


def validate_public_result(command: str, result: dict[str, object]) -> None:
    allowed: dict[str, set[str]] = {
        "items ensure": {"items"},
        "memory apply": {"mode", "service", "key", "deploy_id"},
        "render wait": {"service", "deploy_id", "state", "resume_command"},
        "render cancel": {"service", "deploy_id", "state", "canceled"},
        "memory canary": {
            "run_id",
            "repo",
            "ticket_id",
            "phase",
            "checks",
            "cleanup",
        },
    }
    expected = allowed.get(command)
    if expected is None or set(result) != expected:
        raise SafeError("unsafe_result_shape")
    encoded = compact_json(result)
    forbidden = (b"authorization", b"bearer", b'"token":', b'"value":', b'"digest":')
    lowered = encoded.lower()
    if any(marker in lowered for marker in forbidden):
        raise SafeError("unsafe_result_content")


def validate_envelope(value: object) -> dict[str, object]:
    envelope = require_object(value, "receipt_shape_mismatch")
    require_exact_keys(envelope, {"schema", "command", "status", "result"}, "receipt_shape_mismatch")
    if envelope["schema"] != OUTPUT_SCHEMA or envelope["status"] not in {"pass", "fail"}:
        raise SafeError("receipt_shape_mismatch")
    command = require_string(envelope["command"], "receipt_shape_mismatch")
    result = require_object(envelope["result"], "receipt_shape_mismatch")
    if envelope["status"] == "pass":
        validate_public_result(command, result)
    elif set(result) - {"code", "items", "deploy_id", "service", "state", "resume_command"}:
        raise SafeError("receipt_shape_mismatch")
    return envelope


def ensure_safe_existing_file(path: Path) -> None:
    try:
        info = path.lstat()
    except FileNotFoundError:
        return
    if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
        raise SafeError("unsafe_receipt_path")
    if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o600:
        raise SafeError("unsafe_receipt_permissions")


def atomic_write_json(path: Path, value: object) -> None:
    data = compact_json(value) + b"\n"
    if len(data) > MAX_RECEIPT_BYTES:
        raise SafeError("receipt_too_large")
    path = path.expanduser()
    if not path.parent.is_dir():
        raise SafeError("receipt_parent_missing")
    ensure_safe_existing_file(path)
    temporary: Path | None = None
    try:
        descriptor, name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
        temporary = Path(name)
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
        temporary = None
        os.chmod(path, 0o600)
    except OSError:
        raise SafeError("receipt_write_failed") from None
    finally:
        if temporary is not None:
            try:
                temporary.unlink()
            except OSError:
                pass


def receipt_path(value: str) -> Path:
    path = Path(value).expanduser()
    if (
        not path.is_absolute()
        or not SAFE_PATH.fullmatch(str(path))
        or any(part in {".", ".."} for part in path.parts)
    ):
        raise argparse.ArgumentTypeError("receipt path must be a safe absolute path")
    return path


def validate_receipt_target(path: Path) -> None:
    if not path.parent.is_dir():
        raise SafeError("receipt_parent_missing")
    ensure_safe_existing_file(path)


def load_json_receipt(path: Path) -> dict[str, object]:
    flags = os.O_RDONLY
    if hasattr(os, "O_NOFOLLOW"):
        flags |= os.O_NOFOLLOW
    try:
        descriptor = os.open(path, flags)
        info = os.fstat(descriptor)
        if (
            not stat.S_ISREG(info.st_mode)
            or info.st_uid != os.getuid()
            or stat.S_IMODE(info.st_mode) != 0o600
        ):
            os.close(descriptor)
            raise SafeError("unsafe_receipt_permissions")
        if info.st_size > MAX_RECEIPT_BYTES:
            os.close(descriptor)
            raise SafeError("receipt_too_large")
        with os.fdopen(descriptor, "rb") as stream:
            data = stream.read(MAX_RECEIPT_BYTES + 1)
    except FileNotFoundError:
        raise SafeError("receipt_missing") from None
    except OSError:
        raise SafeError("receipt_read_failed") from None
    return require_object(parse_json_bytes(data, "receipt_shape_mismatch"), "receipt_shape_mismatch")


def validated_executable(
    path: str | Path,
    *,
    unusable_code: str,
) -> tuple[Path, Path]:
    try:
        candidate = Path(path).expanduser()
    except (OSError, RuntimeError):
        raise SafeError(unusable_code) from None
    if not candidate.is_absolute():
        raise SafeError(unusable_code)
    try:
        info = candidate.lstat()
    except OSError:
        raise SafeError(unusable_code) from None
    if (
        stat.S_ISLNK(info.st_mode)
        or not stat.S_ISREG(info.st_mode)
        or not os.access(candidate, os.X_OK)
        or (stat.S_IMODE(info.st_mode) & 0o022) != 0
    ):
        raise SafeError(unusable_code)
    try:
        resolved = candidate.resolve(strict=True)
    except (OSError, RuntimeError):
        raise SafeError(unusable_code) from None
    return candidate, resolved


def validate_executable_pair(provider_path: str | Path, op_bin: str | Path) -> str:
    provider, resolved_provider = validated_executable(
        provider_path,
        unusable_code="provider_unusable",
    )
    if provider.name != "hermes-activation" or provider.parent.name != "bin":
        raise SafeError("provider_unusable")
    root = resolved_provider.parent.parent
    if resolved_provider != root / "bin" / "hermes-activation":
        raise SafeError("provider_unusable")

    _, resolved_op = validated_executable(op_bin, unusable_code="op_bin_unusable")
    if resolved_op != root / "bin" / "op":
        raise SafeError("op_bin_root_mismatch")
    return str(resolved_op)


def preflight_environment(provider_path: str | Path) -> tuple[bool, str]:
    reason = os.environ.get("SENSITIVE_ACCESS_REASON", "")
    if not reason.strip():
        raise SafeError("missing_sensitive_access_reason")
    op_bin = os.environ.get("OP_BIN")
    if not op_bin:
        raise SafeError("missing_op_bin")
    test_mode = os.environ.get("HERMES_ACTIVATION_TEST_MODE") == "1"
    return test_mode, validate_executable_pair(provider_path, op_bin)


def test_base(name: str, production: str, test_mode: bool) -> str:
    variable = f"HERMES_ACTIVATION_TEST_{name}_BASE"
    override = os.environ.get(variable)
    if not test_mode:
        if override is not None:
            raise SafeError("production_endpoint_override")
        return production
    if override is None:
        raise SafeError("missing_test_endpoint")
    parsed = urllib.parse.urlsplit(override)
    if parsed.scheme != "http" or parsed.hostname not in {"127.0.0.1", "::1", "localhost"}:
        raise SafeError("non_loopback_test_endpoint")
    if parsed.username or parsed.password or parsed.query or parsed.fragment:
        raise SafeError("invalid_test_endpoint")
    return override.rstrip("/")


class OpClient:
    def __init__(self, executable: str, timeout: float = 30.0) -> None:
        self.executable = executable
        self.timeout = timeout

    def _run(self, arguments: list[str]) -> bytes:
        if any("=" in argument and argument != "--format=json" for argument in arguments):
            raise SafeError("unsafe_op_argv")
        try:
            process = subprocess.Popen(
                [self.executable, *arguments],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                start_new_session=True,
            )
        except OSError:
            raise SafeError("op_start_failed", exit_code=EXIT_EXTERNAL) from None

        if process.stdout is None or process.stderr is None:
            self._terminate(process)
            raise SafeError("op_start_failed", exit_code=EXIT_EXTERNAL)
        output = bytearray()
        total = 0
        deadline = time.monotonic() + self.timeout
        selector = selectors.DefaultSelector()
        try:
            for stream, keep in ((process.stdout, True), (process.stderr, False)):
                os.set_blocking(stream.fileno(), False)
                selector.register(stream, selectors.EVENT_READ, keep)
            while selector.get_map():
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    self._terminate(process)
                    raise SafeError("op_timeout", exit_code=EXIT_EXTERNAL)
                events = selector.select(min(0.1, remaining))
                if not events and process.poll() is not None:
                    events = [
                        (key, selectors.EVENT_READ) for key in list(selector.get_map().values())
                    ]
                for key, _mask in events:
                    try:
                        chunk = os.read(
                            key.fd,
                            min(65536, MAX_CHILD_BYTES - total + 1),
                        )
                    except BlockingIOError:
                        continue
                    if not chunk:
                        selector.unregister(key.fileobj)
                        continue
                    total += len(chunk)
                    if total > MAX_CHILD_BYTES:
                        self._terminate(process)
                        raise SafeError("op_response_too_large", exit_code=EXIT_EXTERNAL)
                    if key.data is True:
                        output.extend(chunk)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                self._terminate(process)
                raise SafeError("op_timeout", exit_code=EXIT_EXTERNAL)
            try:
                process.wait(timeout=remaining)
            except subprocess.TimeoutExpired:
                self._terminate(process)
                raise SafeError("op_timeout", exit_code=EXIT_EXTERNAL) from None
        except OSError:
            self._terminate(process)
            raise SafeError("op_stream_failed", exit_code=EXIT_EXTERNAL) from None
        finally:
            selector.close()
        if process.returncode:
            raise SafeError("op_command_failed", exit_code=EXIT_EXTERNAL)
        return bytes(output)

    @staticmethod
    def _terminate(process: subprocess.Popen[bytes]) -> None:
        if process.poll() is not None:
            return
        try:
            os.killpg(process.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        try:
            process.wait(timeout=2)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(process.pid, signal.SIGKILL)
            except ProcessLookupError:
                return
            process.wait()

    def json(self, arguments: list[str]) -> object:
        return parse_json_bytes(self._run(arguments), "op_contract_mismatch")

    def read(self, reference: str) -> bytes:
        value = self._run(["read", "--no-newline", reference])
        if len(value) < MIN_PASSWORD_LENGTH or value != value.strip():
            value = b""
            raise SafeError("op_value_invalid", exit_code=EXIT_EXTERNAL)
        return value


def item_vault_name(row: dict[str, object]) -> str:
    vault = row.get("vault")
    if isinstance(vault, str):
        return vault
    if isinstance(vault, dict):
        return require_string(cast(dict[str, object], vault).get("name"), "op_contract_mismatch")
    raise SafeError("op_contract_mismatch", exit_code=EXIT_EXTERNAL)


def item_category(row: dict[str, object]) -> str:
    category = require_string(row.get("category"), "op_contract_mismatch")
    if category.lower() != "password":
        raise SafeError("op_item_category_mismatch", exit_code=EXIT_EXTERNAL)
    return category


def validate_created_item(value: object, spec: ItemSpec) -> str:
    row = require_object(value, "op_contract_mismatch")
    if require_string(row.get("title"), "op_contract_mismatch") != spec.name:
        raise SafeError("op_item_title_mismatch", exit_code=EXIT_EXTERNAL)
    item_category(row)
    if item_vault_name(row) != VAULT:
        raise SafeError("op_item_vault_mismatch", exit_code=EXIT_EXTERNAL)
    fields = require_list(row.get("fields"), "op_contract_mismatch")
    has_password = False
    for candidate in fields:
        field = require_object(candidate, "op_contract_mismatch")
        purpose = field.get("purpose")
        identifier = field.get("id")
        if purpose == "PASSWORD" or identifier == "password":
            has_password = True
    if not has_password:
        raise SafeError("op_password_field_missing", exit_code=EXIT_EXTERNAL)
    return require_opaque_id(row.get("id"), "op_item_id_invalid")


def ensure_items(op: OpClient) -> list[ItemReceipt]:
    inventory = op.json(
        [
            "item",
            "list",
            "--vault",
            VAULT,
            "--categories",
            "Password",
            "--format=json",
        ]
    )
    rows = require_list(inventory, "op_contract_mismatch")
    selected: dict[str, str] = {}
    for candidate in rows:
        row = require_object(candidate, "op_contract_mismatch")
        title = require_string(row.get("title"), "op_contract_mismatch")
        if title not in {item.name for item in ITEMS}:
            continue
        item_category(row)
        if item_vault_name(row) != VAULT:
            raise SafeError("op_item_vault_mismatch", exit_code=EXIT_EXTERNAL)
        if title in selected:
            raise SafeError("op_item_ambiguous", exit_code=EXIT_EXTERNAL)
        selected[title] = require_opaque_id(row.get("id"), "op_item_id_invalid")

    receipts: list[ItemReceipt] = []
    values: list[bytes] = []
    try:
        for spec in ITEMS:
            item_id = selected.get(spec.name)
            state = "existing"
            if item_id is None:
                try:
                    created = op.json(
                        [
                            "item",
                            "create",
                            "--category",
                            "Password",
                            "--title",
                            spec.name,
                            "--vault",
                            VAULT,
                            "--generate-password",
                            "--format=json",
                        ]
                    )
                    item_id = validate_created_item(created, spec)
                    state = "created"
                except SafeError as error:
                    if receipts:
                        raise SafeError(
                            "partial_item_ensure",
                            exit_code=error.exit_code,
                            safe_result={"items": [asdict(item) for item in receipts]},
                        ) from None
                    raise
            if any(receipt.item_id == item_id for receipt in receipts):
                raise SafeError("op_item_id_reused", exit_code=EXIT_EXTERNAL)
            receipts.append(ItemReceipt(spec.name, spec.ref, item_id, state))
            try:
                values.append(op.read(spec.ref))
            except SafeError as error:
                if any(receipt.state == "created" for receipt in receipts):
                    raise SafeError(
                        "partial_item_ensure",
                        exit_code=error.exit_code,
                        safe_result={"items": [asdict(item) for item in receipts]},
                    ) from None
                raise
        if hmac.compare_digest(values[0], values[1]):
            raise SafeError("op_values_reused", exit_code=EXIT_EXTERNAL)
        return receipts
    finally:
        for index in range(len(values)):
            values[index] = b""


class NoCrossHostRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(
        self,
        request: urllib.request.Request,
        file_pointer: object,
        code: int,
        message: str,
        headers: object,
        new_url: str,
    ) -> urllib.request.Request | None:
        old = urllib.parse.urlsplit(request.full_url)
        new = urllib.parse.urlsplit(new_url)
        if (old.scheme, old.hostname, old.port) != (new.scheme, new.hostname, new.port):
            raise SafeError("cross_host_redirect", exit_code=EXIT_EXTERNAL)
        return None


class HttpClient:
    def __init__(self, base: str, bearer: bytes, timeout: float = 15.0) -> None:
        self.base = base.rstrip("/")
        self.bearer = bearer
        self.timeout = timeout
        self.opener = urllib.request.build_opener(NoCrossHostRedirect())

    def request(
        self,
        method: str,
        path: str,
        body: object | None = None,
        *,
        accepted: set[int],
    ) -> HttpResponse:
        if not path.startswith("/") or "://" in path:
            raise SafeError("http_path_mismatch")
        data = None if body is None else compact_json(body)
        if data is not None and len(data) > MAX_HTTP_BYTES:
            raise SafeError("request_too_large")
        headers = {
            "Accept": "application/json",
            "Authorization": "Bearer " + self.bearer.decode("utf-8"),
        }
        if data is not None:
            headers["Content-Type"] = "application/json"
        request = urllib.request.Request(
            self.base + path,
            method=method,
            headers=headers,
            data=data,
        )
        try:
            with self.opener.open(request, timeout=self.timeout) as response:
                raw = response.read(MAX_HTTP_BYTES + 1)
                status_code = response.status
                content_type = response.headers.get_content_type()
        except urllib.error.HTTPError:
            raise SafeError("external_http_failure", exit_code=EXIT_EXTERNAL) from None
        except (urllib.error.URLError, TimeoutError, OSError):
            raise SafeError("external_transport_failure", exit_code=EXIT_EXTERNAL) from None
        if status_code not in accepted:
            raise SafeError("external_http_status", exit_code=EXIT_EXTERNAL)
        if len(raw) > MAX_HTTP_BYTES or content_type != "application/json":
            raise SafeError("external_response_invalid", exit_code=EXIT_EXTERNAL)
        return HttpResponse(status_code, parse_json_bytes(raw, "external_response_invalid"))


class RenderClient:
    def __init__(
        self,
        http: HttpClient,
        *,
        clock: Callable[[], float] = time.monotonic,
        sleeper: Callable[[float], None] = time.sleep,
        poll_seconds: float = POLL_SECONDS,
        wait_seconds: float = WAIT_SECONDS,
    ) -> None:
        self.http = http
        self.clock = clock
        self.sleeper = sleeper
        self.poll_seconds = poll_seconds
        self.wait_seconds = wait_seconds

    @property
    def deploy_collection(self) -> str:
        return f"/v1/services/{RENDER_SERVICE}/deploys"

    def apply(self, mode: str, memory_token: bytes | None) -> DeployReceipt:
        if mode == "active":
            if memory_token is None:
                raise SafeError("memory_token_missing")
            policy = [
                {
                    "approvals": "none",
                    "config": "read",
                    "epics": "none",
                    "knowledge": "read",
                    "origin": "hermes",
                    "project": PROJECT,
                    "tickets": "rw",
                    "token": memory_token.decode("utf-8"),
                }
            ]
            value = compact_json(policy).decode("utf-8")
        elif mode == "inert":
            value = "[]"
        else:
            raise SafeError("invalid_mode")
        key_path = f"/v1/services/{RENDER_SERVICE}/env-vars/{RENDER_KEY}"
        response = self.http.request("PUT", key_path, {"value": value}, accepted={200})
        shape = require_object(response.body, "render_put_shape_mismatch")
        require_exact_keys(shape, {"key", "value"}, "render_put_shape_mismatch")
        if shape["key"] != RENDER_KEY or not isinstance(shape["value"], str):
            raise SafeError("render_put_shape_mismatch", exit_code=EXIT_EXTERNAL)
        if not hmac.compare_digest(cast(str, shape["value"]), value):
            raise SafeError("render_put_shape_mismatch", exit_code=EXIT_EXTERNAL)
        try:
            triggered = self.http.request(
                "POST",
                self.deploy_collection,
                {"clearCache": "do_not_clear"},
                accepted={201},
            )
            deploy = validate_render_deploy(triggered.body)
            deploy_id = cast(str, deploy["id"])
        except SafeError:
            raise SafeError(
                "deploy_trigger_unknown_after_env_write",
                exit_code=EXIT_UNKNOWN,
                safe_result={
                    "service": RENDER_SERVICE,
                    "state": "unknown",
                    "resume_command": "manual Render reconciliation required; do not retry",
                },
            ) from None
        return DeployReceipt(mode, RENDER_SERVICE, RENDER_KEY, deploy_id)

    def get_state(self, deploy_id: str) -> str:
        require_opaque_id(deploy_id, "invalid_deploy_id")
        response = self.http.request(
            "GET",
            f"{self.deploy_collection}/{deploy_id}",
            accepted={200},
        )
        deploy = validate_render_deploy(response.body, deploy_id=deploy_id, require_status=True)
        state = cast(str, deploy["status"])
        if state not in ALL_DEPLOY_STATES:
            raise SafeError("render_status_unknown", exit_code=EXIT_EXTERNAL)
        return state

    def wait(self, deploy_id: str, timeout_receipt: Path) -> str:
        started = self.clock()
        deadline = started + self.wait_seconds
        while True:
            state = self.get_state(deploy_id)
            if state == "live":
                return state
            if state in TERMINAL_STATES:
                raise SafeError(
                    "render_terminal_nonpass",
                    exit_code=EXIT_EXTERNAL,
                    safe_result={"deploy_id": deploy_id, "service": RENDER_SERVICE, "state": state},
                )
            now = self.clock()
            if now >= deadline:
                receipt = {
                    "schema": TIMEOUT_RECEIPT_SCHEMA,
                    "service": RENDER_SERVICE,
                    "deploy_id": deploy_id,
                    "state": "unknown",
                    "started_at": started,
                    "deadline_at": deadline,
                }
                atomic_write_json(timeout_receipt, receipt)
                resume = f"bin/hermes-activation render wait --deploy-id {deploy_id} "
                resume += f"--timeout-receipt {timeout_receipt}"
                raise SafeError(
                    "render_wait_timeout",
                    exit_code=EXIT_UNKNOWN,
                    safe_result={
                        "deploy_id": deploy_id,
                        "service": RENDER_SERVICE,
                        "state": "unknown",
                        "resume_command": resume,
                    },
                )
            self.sleeper(min(self.poll_seconds, max(0.0, deadline - now)))

    def cancel(
        self,
        deploy_id: str,
        timeout_receipt: Path,
        canceled_receipt: Path,
        verified_timeout: dict[str, object] | None = None,
    ) -> str:
        if verified_timeout is None:
            validate_timeout_receipt(deploy_id, timeout_receipt)
        requested = load_cancel_receipt(deploy_id, canceled_receipt)
        state = self.get_state(deploy_id)
        if state == "canceled":
            self._write_canceled(deploy_id, canceled_receipt)
            return "canceled"
        if requested == "canceled":
            raise SafeError("cancel_receipt_remote_mismatch", exit_code=EXIT_EXTERNAL)
        if state not in RUNNING_STATES:
            raise SafeError("deploy_not_cancelable", exit_code=EXIT_EXTERNAL)
        if requested is None:
            atomic_write_json(
                canceled_receipt,
                {
                    "schema": CANCELED_RECEIPT_SCHEMA,
                    "service": RENDER_SERVICE,
                    "deploy_id": deploy_id,
                    "state": "cancel_requested",
                },
            )
            try:
                response = self.http.request(
                    "POST",
                    f"{self.deploy_collection}/{deploy_id}/cancel",
                    accepted={200},
                )
                validate_render_deploy(response.body, deploy_id=deploy_id)
            except SafeError:
                raise self._cancel_unknown(deploy_id, timeout_receipt, canceled_receipt) from None
        deadline = self.clock() + self.wait_seconds
        while True:
            state = self.get_state(deploy_id)
            if state == "canceled":
                self._write_canceled(deploy_id, canceled_receipt)
                return state
            if state not in RUNNING_STATES:
                raise SafeError("cancel_not_proven", exit_code=EXIT_EXTERNAL)
            now = self.clock()
            if now >= deadline:
                raise self._cancel_unknown(deploy_id, timeout_receipt, canceled_receipt)
            self.sleeper(min(self.poll_seconds, max(0.0, deadline - now)))

    @staticmethod
    def _write_canceled(deploy_id: str, canceled_receipt: Path) -> None:
        atomic_write_json(
            canceled_receipt,
            {
                "schema": CANCELED_RECEIPT_SCHEMA,
                "service": RENDER_SERVICE,
                "deploy_id": deploy_id,
                "state": "canceled",
            },
        )

    @staticmethod
    def _cancel_unknown(
        deploy_id: str,
        timeout_receipt: Path,
        canceled_receipt: Path,
    ) -> SafeError:
        resume = f"bin/hermes-activation render cancel --deploy-id {deploy_id} "
        resume += f"--timeout-receipt {timeout_receipt} --canceled-receipt {canceled_receipt}"
        return SafeError(
            "cancel_unknown",
            exit_code=EXIT_UNKNOWN,
            safe_result={
                "service": RENDER_SERVICE,
                "deploy_id": deploy_id,
                "state": "unknown",
                "resume_command": resume,
            },
        )


def validate_render_deploy(
    value: object,
    *,
    deploy_id: str | None = None,
    require_status: bool = False,
) -> dict[str, object]:
    deploy = require_object(value, "render_deploy_shape_mismatch")
    allowed = {
        "id",
        "commit",
        "image",
        "status",
        "trigger",
        "startedAt",
        "finishedAt",
        "createdAt",
        "updatedAt",
    }
    if set(deploy) - allowed:
        raise SafeError("render_deploy_shape_mismatch", exit_code=EXIT_EXTERNAL)
    identifier = require_opaque_id(deploy.get("id"), "render_deploy_shape_mismatch")
    if deploy_id is not None and identifier != deploy_id:
        raise SafeError("render_deploy_shape_mismatch", exit_code=EXIT_EXTERNAL)
    if require_status and "status" not in deploy:
        raise SafeError("render_deploy_shape_mismatch", exit_code=EXIT_EXTERNAL)
    if "status" in deploy and deploy["status"] not in ALL_DEPLOY_STATES:
        raise SafeError("render_status_unknown", exit_code=EXIT_EXTERNAL)
    triggers = {
        "api",
        "blueprint_sync",
        "deploy_hook",
        "deployed_by_render",
        "manual",
        "other",
        "new_commit",
        "rollback",
        "service_resumed",
        "service_updated",
    }
    if "trigger" in deploy and deploy["trigger"] not in triggers:
        raise SafeError("render_deploy_shape_mismatch", exit_code=EXIT_EXTERNAL)
    for key in ("startedAt", "finishedAt", "createdAt", "updatedAt"):
        if key in deploy:
            require_string(deploy[key], "render_deploy_shape_mismatch")
    if "commit" in deploy:
        commit = require_object(deploy["commit"], "render_deploy_shape_mismatch")
        if set(commit) - {"id", "message", "createdAt"}:
            raise SafeError("render_deploy_shape_mismatch", exit_code=EXIT_EXTERNAL)
        for item in commit.values():
            require_string(item, "render_deploy_shape_mismatch")
    if "image" in deploy:
        image = require_object(deploy["image"], "render_deploy_shape_mismatch")
        if set(image) - {"ref", "sha", "registryCredential"}:
            raise SafeError("render_deploy_shape_mismatch", exit_code=EXIT_EXTERNAL)
        for item in image.values():
            require_string(item, "render_deploy_shape_mismatch")
    return deploy


def load_cancel_receipt(deploy_id: str, path: Path) -> str | None:
    try:
        receipt = load_json_receipt(path)
    except SafeError as error:
        if error.code == "receipt_missing":
            return None
        raise
    require_exact_keys(
        receipt,
        {"schema", "service", "deploy_id", "state"},
        "cancel_receipt_mismatch",
    )
    if (
        receipt["schema"] != CANCELED_RECEIPT_SCHEMA
        or receipt["service"] != RENDER_SERVICE
        or receipt["deploy_id"] != deploy_id
        or receipt["state"] not in {"cancel_requested", "canceled"}
    ):
        raise SafeError("cancel_receipt_mismatch")
    return cast(str, receipt["state"])


def validate_timeout_receipt(deploy_id: str, path: Path) -> dict[str, object]:
    receipt = load_json_receipt(path)
    require_exact_keys(
        receipt,
        {"schema", "service", "deploy_id", "state", "started_at", "deadline_at"},
        "timeout_receipt_mismatch",
    )
    if (
        receipt["schema"] != TIMEOUT_RECEIPT_SCHEMA
        or receipt["service"] != RENDER_SERVICE
        or receipt["deploy_id"] != deploy_id
        or receipt["state"] != "unknown"
    ):
        raise SafeError("timeout_receipt_mismatch")
    for key in ("started_at", "deadline_at"):
        number = receipt[key]
        if isinstance(number, bool) or not isinstance(number, (int, float)):
            raise SafeError("timeout_receipt_mismatch")
        if not math.isfinite(float(number)):
            raise SafeError("timeout_receipt_mismatch")
    if float(receipt["deadline_at"]) < float(receipt["started_at"]):
        raise SafeError("timeout_receipt_mismatch")
    return receipt


class MemoryClient:
    def __init__(self, http: HttpClient) -> None:
        self.http = http
        self.request_id = 0

    def tool(self, name: str, arguments: dict[str, object]) -> dict[str, object]:
        self.request_id += 1
        request_id = self.request_id
        response = self.http.request(
            "POST",
            MCP_PATH,
            {
                "jsonrpc": "2.0",
                "id": request_id,
                "method": "tools/call",
                "params": {"name": name, "arguments": arguments},
            },
            accepted={200},
        )
        envelope = require_object(response.body, "memory_mcp_shape_mismatch")
        if set(envelope) - {"jsonrpc", "id", "result"}:
            raise SafeError("memory_mcp_shape_mismatch", exit_code=EXIT_EXTERNAL)
        if envelope.get("jsonrpc") != "2.0" or envelope.get("id") != request_id:
            raise SafeError("memory_mcp_shape_mismatch", exit_code=EXIT_EXTERNAL)
        result = require_object(envelope.get("result"), "memory_mcp_shape_mismatch")
        if set(result) - {"content", "structuredContent", "isError", "_meta"}:
            raise SafeError("memory_tool_failure", exit_code=EXIT_EXTERNAL)
        if "isError" in result and not isinstance(result["isError"], bool):
            raise SafeError("memory_mcp_shape_mismatch", exit_code=EXIT_EXTERNAL)
        if result.get("isError") is True:
            raise SafeError("memory_tool_failure", exit_code=EXIT_EXTERNAL)
        if "_meta" in result:
            require_object(result["_meta"], "memory_mcp_shape_mismatch")

        structured: dict[str, object] | None = None
        if "structuredContent" in result:
            structured = require_object(
                result["structuredContent"],
                "memory_tool_shape_mismatch",
            )

        content = require_list(result.get("content"), "memory_mcp_shape_mismatch")
        if len(content) != 1:
            raise SafeError("memory_mcp_shape_mismatch", exit_code=EXIT_EXTERNAL)
        block = require_object(content[0], "memory_mcp_shape_mismatch")
        require_exact_keys(block, {"type", "text"}, "memory_mcp_shape_mismatch")
        if block["type"] != "text":
            raise SafeError("memory_mcp_shape_mismatch", exit_code=EXIT_EXTERNAL)
        text = require_string(block["text"], "memory_mcp_shape_mismatch")
        legacy = require_object(
            parse_json_bytes(text.encode("utf-8"), "memory_tool_shape_mismatch"),
            "memory_tool_shape_mismatch",
        )

        if structured is not None and compact_json(structured) != compact_json(legacy):
            raise SafeError("memory_tool_shape_mismatch", exit_code=EXIT_EXTERNAL)
        return structured if structured is not None else legacy

    def batch(
        self,
        project: str,
        operations: list[dict[str, object]],
        *,
        mode: str,
    ) -> dict[str, object]:
        response = self.http.request(
            "POST",
            BATCH_PATH,
            {"project": project, "mode": mode, "operations": operations},
            accepted={200},
        )
        return require_object(response.body, "memory_batch_shape_mismatch")


@dataclass
class CanaryState:
    schema: str
    run_id: str
    repo: str
    ticket_id: str | None
    phase: str
    started_at: float
    deadline_at: float
    checks: list[str]
    cleanup: str | None
    requests: int
    mutations: int
    embedding_writes: int
    cleanup_requests: int
    cleanup_mutations: int

    @classmethod
    def from_receipt(cls, value: dict[str, object]) -> CanaryState:
        expected = {
            "schema",
            "run_id",
            "repo",
            "ticket_id",
            "phase",
            "started_at",
            "deadline_at",
            "checks",
            "cleanup",
            "requests",
            "mutations",
            "embedding_writes",
            "cleanup_requests",
            "cleanup_mutations",
        }
        require_exact_keys(value, expected, "canary_receipt_mismatch")
        if value["schema"] != CANARY_RECEIPT_SCHEMA:
            raise SafeError("canary_receipt_mismatch")
        run_id = require_opaque_id(value["run_id"], "canary_receipt_mismatch")
        repo = require_string(value["repo"], "canary_receipt_mismatch")
        if repo != CANARY_REPO_PREFIX + run_id:
            raise SafeError("canary_receipt_mismatch")
        phase = require_string(value["phase"], "canary_receipt_mismatch")
        if phase not in CANARY_PHASES:
            raise SafeError("canary_receipt_mismatch")
        ticket_value = value["ticket_id"]
        ticket_id = None
        if ticket_value is not None:
            ticket_id = require_opaque_id(ticket_value, "canary_receipt_mismatch")
        if phase in {"awaiting_admin_approval", "awaiting_admin_reapproval"} and ticket_id is None:
            raise SafeError("canary_receipt_mismatch")
        checks_raw = require_list(value["checks"], "canary_receipt_mismatch")
        checks = cast(list[str], checks_raw)
        has_cleanup_check = bool(checks) and checks[-1] == CANARY_CHECKS[-1]
        normal_checks = checks[:-1] if has_cleanup_check else checks
        if (
            normal_checks != list(CANARY_CHECKS[:-1][: len(normal_checks)])
            or len(normal_checks) > len(CANARY_CHECKS) - 1
        ):
            raise SafeError("canary_receipt_mismatch")
        phase_check_ranges = {
            "prepare": range(0, 6),
            "awaiting_admin_approval": range(6, 9),
            "awaiting_admin_reapproval": range(9, 12),
        }
        if phase in phase_check_ranges and len(checks) not in phase_check_ranges[phase]:
            raise SafeError("canary_receipt_mismatch")
        if normal_checks and ticket_id is None:
            raise SafeError("canary_receipt_mismatch")
        timestamps: dict[str, float] = {}
        for key in ("started_at", "deadline_at"):
            raw = value[key]
            if isinstance(raw, bool) or not isinstance(raw, (int, float)):
                raise SafeError("canary_receipt_mismatch")
            number = float(raw)
            if not math.isfinite(number):
                raise SafeError("canary_receipt_mismatch")
            timestamps[key] = number
        if timestamps["started_at"] <= 0:
            raise SafeError("canary_receipt_mismatch")
        if timestamps["deadline_at"] - timestamps["started_at"] != CANARY_SECONDS:
            raise SafeError("canary_receipt_mismatch")
        counters: dict[str, int] = {}
        for key in (
            "requests",
            "mutations",
            "embedding_writes",
            "cleanup_requests",
            "cleanup_mutations",
        ):
            raw = value[key]
            if isinstance(raw, bool) or not isinstance(raw, int) or raw < 0:
                raise SafeError("canary_receipt_mismatch")
            counters[key] = raw
        normal_requests = counters["requests"] - counters["cleanup_requests"]
        normal_mutations = counters["mutations"] - counters["cleanup_mutations"]
        minimum_requests = (0, 2, 4, 6, 9, 11, 13, 14, 16, 17, 18, 19)
        minimum_mutations = (0, 1, 1, 1, 1, 1, 2, 2, 3, 3, 3, 3)
        completed_checks = len(normal_checks)
        request_floor = minimum_requests[completed_checks]
        mutation_floor = minimum_mutations[completed_checks]
        embedding_floor = 2 if completed_checks >= 6 else (1 if ticket_id is not None else 0)
        if ticket_id is not None and completed_checks == 0:
            request_floor = 1
            mutation_floor = 1
        if (
            counters["requests"] > MAX_CANARY_REQUESTS
            or normal_requests < 0
            or normal_requests < request_floor
            or normal_requests > MAX_CANARY_NORMAL_REQUESTS
            or counters["cleanup_requests"] > MAX_CANARY_CLEANUP_REQUESTS
            or counters["mutations"] > MAX_CANARY_MUTATIONS
            or normal_mutations < 0
            or normal_mutations < mutation_floor
            or counters["cleanup_mutations"] > MAX_CANARY_CLEANUP_MUTATIONS
            or counters["cleanup_mutations"] > counters["cleanup_requests"]
            or counters["embedding_writes"] > MAX_CANARY_EMBEDDING_WRITES
            or counters["embedding_writes"] < embedding_floor
            or counters["embedding_writes"] > normal_mutations
            or counters["mutations"] > counters["requests"]
        ):
            raise SafeError("canary_receipt_mismatch")
        cleanup = value["cleanup"]
        if cleanup not in {None, "pass"}:
            raise SafeError("canary_receipt_mismatch")
        if (phase == "complete") != (cleanup == "pass"):
            raise SafeError("canary_receipt_mismatch")
        if (phase == "complete") != has_cleanup_check:
            raise SafeError("canary_receipt_mismatch")
        return cls(
            schema=CANARY_RECEIPT_SCHEMA,
            run_id=run_id,
            repo=repo,
            ticket_id=ticket_id,
            phase=phase,
            started_at=timestamps["started_at"],
            deadline_at=timestamps["deadline_at"],
            checks=checks,
            cleanup=cast("str | None", cleanup),
            requests=counters["requests"],
            mutations=counters["mutations"],
            embedding_writes=counters["embedding_writes"],
            cleanup_requests=counters["cleanup_requests"],
            cleanup_mutations=counters["cleanup_mutations"],
        )


class Canary:
    def __init__(
        self,
        memory: MemoryClient,
        state: CanaryState,
        receipt: Path,
        *,
        clock: Callable[[], float] = time.time,
    ) -> None:
        self.memory = memory
        self.state = state
        self.receipt = receipt
        self.clock = clock

    def save(self) -> None:
        atomic_write_json(self.receipt, asdict(self.state))

    def _reserve(
        self,
        *,
        mutation: bool = False,
        embedding: bool = False,
        cleanup: bool = False,
    ) -> None:
        self.check_deadline(cleanup=cleanup)
        normal_requests = self.state.requests - self.state.cleanup_requests
        if cleanup:
            if self.state.cleanup_requests >= MAX_CANARY_CLEANUP_REQUESTS:
                raise SafeError("canary_cleanup_reserve_exhausted", exit_code=EXIT_CLEANUP)
            if mutation and self.state.cleanup_mutations >= MAX_CANARY_CLEANUP_MUTATIONS:
                raise SafeError("canary_cleanup_reserve_exhausted", exit_code=EXIT_CLEANUP)
        elif normal_requests >= MAX_CANARY_NORMAL_REQUESTS:
            raise SafeError("canary_bound_exceeded", exit_code=EXIT_CLEANUP)
        if self.state.requests >= MAX_CANARY_REQUESTS:
            raise SafeError("canary_bound_exceeded", exit_code=EXIT_CLEANUP)
        if mutation and self.state.mutations >= MAX_CANARY_MUTATIONS:
            raise SafeError("canary_bound_exceeded", exit_code=EXIT_CLEANUP)
        if embedding and self.state.embedding_writes >= MAX_CANARY_EMBEDDING_WRITES:
            raise SafeError("canary_bound_exceeded", exit_code=EXIT_CLEANUP)
        self.state.requests += 1
        if mutation:
            self.state.mutations += 1
        if embedding:
            self.state.embedding_writes += 1
        if cleanup:
            self.state.cleanup_requests += 1
            if mutation:
                self.state.cleanup_mutations += 1
        self.save()

    def tool(
        self,
        name: str,
        arguments: dict[str, object],
        *,
        mutation: bool = False,
        embedding: bool = False,
        cleanup: bool = False,
    ) -> dict[str, object]:
        self._reserve(mutation=mutation, embedding=embedding, cleanup=cleanup)
        return self.memory.tool(name, arguments)

    def batch(
        self,
        operations: list[dict[str, object]],
        *,
        mutation: bool = False,
        embedding: bool = False,
    ) -> dict[str, object]:
        self._reserve(mutation=mutation, embedding=embedding)
        return self.memory.batch(PROJECT, operations, mode="atomic")

    def check_deadline(self, *, cleanup: bool = False) -> None:
        if not cleanup and self.clock() > self.state.deadline_at:
            raise SafeError("canary_deadline_expired", exit_code=EXIT_UNKNOWN)

    @staticmethod
    def expect_tool_denial(result: dict[str, object], message: str, code: str) -> None:
        require_exact_keys(result, {"error"}, "canary_denial_shape_mismatch")
        if result["error"] != message:
            raise SafeError(code, exit_code=EXIT_CLEANUP)

    @staticmethod
    def expect_update_ack(result: dict[str, object], ticket_id: str) -> dict[str, object]:
        require_exact_keys(result, {"status", "ticket_id", "ticket"}, "canary_update_shape_mismatch")
        if result["status"] != "updated" or result["ticket_id"] != ticket_id:
            raise SafeError("canary_update_shape_mismatch", exit_code=EXIT_CLEANUP)
        return require_object(result["ticket"], "canary_update_shape_mismatch")

    def validate_ticket(
        self,
        ticket: dict[str, object],
        *,
        status: str | None = None,
        approval: bool | None = None,
    ) -> dict[str, object]:
        title = CANARY_TITLE_PREFIX + self.state.run_id
        tags = ticket.get("tags")
        if (
            ticket.get("id") != self.state.ticket_id
            or ticket.get("project") != PROJECT
            or ticket.get("repo") != self.state.repo
            or ticket.get("origin") != "hermes"
            or ticket.get("title") != title
            or not isinstance(tags, dict)
            or cast(dict[str, object], tags).get("canary") != CANARY_TAG
            or cast(dict[str, object], tags).get("run_id") != self.state.run_id
        ):
            raise SafeError("canary_ticket_identity_mismatch", exit_code=EXIT_CLEANUP)
        if status is not None and ticket.get("status") != status:
            raise SafeError("canary_ticket_state_mismatch", exit_code=EXIT_CLEANUP)
        approved_at = ticket.get("execution_approved_at")
        approved_by = ticket.get("execution_approved_by")
        if (approved_at is None) != (approved_by is None):
            raise SafeError("canary_approval_pair_mismatch", exit_code=EXIT_CLEANUP)
        if approved_at is not None and approved_by != "admin":
            raise SafeError("canary_approval_pair_mismatch", exit_code=EXIT_CLEANUP)
        approved = approved_at is not None and approved_by == "admin"
        if approval is not None and approved != approval:
            raise SafeError("canary_approval_state_mismatch", exit_code=EXIT_CLEANUP)
        return ticket

    def ticket(self, *, cleanup: bool = False) -> tuple[dict[str, object], list[object]]:
        if self.state.ticket_id is None:
            raise SafeError("canary_ticket_missing")
        result = self.tool(
            "get_ticket",
            {
                "project": PROJECT,
                "repo": self.state.repo,
                "ticket_id": self.state.ticket_id,
                "detail": "light",
                "include_events": False,
            },
            cleanup=cleanup,
        )
        allowed = {"ticket", "artifacts", "open_comment_count", "context_version", "detail"}
        if set(result) != allowed:
            raise SafeError("canary_ticket_shape_mismatch", exit_code=EXIT_CLEANUP)
        ticket = require_object(result["ticket"], "canary_ticket_shape_mismatch")
        artifacts = require_list(result["artifacts"], "canary_ticket_shape_mismatch")
        return ticket, artifacts

    def expect_ticket(
        self,
        *,
        status: str | None = None,
        approval: bool | None = None,
        require_source: bool = False,
        cleanup: bool = False,
    ) -> dict[str, object]:
        ticket, artifacts = self.ticket(cleanup=cleanup)
        self.validate_ticket(ticket, status=status, approval=approval)
        if require_source:
            sources = [
                artifact
                for artifact in artifacts
                if isinstance(artifact, dict) and artifact.get("artifact_type") == "source"
            ]
            if len(sources) != 1 or len(artifacts) != 1:
                raise SafeError("canary_source_cardinality_mismatch", exit_code=EXIT_CLEANUP)
        return ticket

    def _recover_created_ticket(self, *, cleanup: bool = False) -> None:
        found = self.tool(
            "list_tickets",
            {"project": PROJECT, "repo": self.state.repo, "limit": 2},
            cleanup=cleanup,
        )
        require_exact_keys(found, {"tickets", "count"}, "canary_create_reconcile_mismatch")
        rows = require_list(found["tickets"], "canary_create_reconcile_mismatch")
        if found["count"] != 1 or len(rows) != 1:
            raise SafeError("canary_create_unknown", exit_code=EXIT_UNKNOWN)
        row = require_object(rows[0], "canary_create_reconcile_mismatch")
        if (
            row.get("repo") != self.state.repo
            or row.get("title") != CANARY_TITLE_PREFIX + self.state.run_id
            or row.get("origin") != "hermes"
        ):
            raise SafeError("canary_create_reconcile_mismatch", exit_code=EXIT_CLEANUP)
        self.state.ticket_id = require_opaque_id(row.get("id"), "canary_create_reconcile_mismatch")
        self.save()

    def prepare(self) -> None:
        if self.state.phase != "prepare" or self.state.checks or self.state.ticket_id is not None:
            raise SafeError("canary_nonterminal_receipt_requires_cleanup")
        title = CANARY_TITLE_PREFIX + self.state.run_id
        try:
            created = self.tool(
                "create_ticket",
                {
                    "project": PROJECT,
                    "repo": self.state.repo,
                    "title": title,
                    "type": "feature",
                    "description": "Synthetic bounded canary source.",
                    "status": "merged",
                    "summary_bullets": ["Bounded Hermes policy canary"],
                    "tags": {"canary": CANARY_TAG, "run_id": self.state.run_id},
                    "command": "e0006-m3-canary",
                    "agent": "hermes",
                },
                mutation=True,
                embedding=True,
            )
            require_exact_keys(created, {"status", "ticket_id", "slug"}, "canary_create_shape_mismatch")
            if created["status"] != "created":
                raise SafeError("canary_create_shape_mismatch", exit_code=EXIT_CLEANUP)
            self.state.ticket_id = require_opaque_id(
                created["ticket_id"], "canary_create_shape_mismatch"
            )
            self.save()
        except SafeError:
            if self.state.ticket_id is not None:
                raise
            try:
                self._recover_created_ticket()
            except SafeError as recovery_error:
                raise recovery_error from None
        self.expect_ticket(status="backlog", approval=False, require_source=True)
        self.state.checks.append(CANARY_CHECKS[0])
        self.save()

        denied = self.tool(
            "update_ticket",
            {
                "project": PROJECT,
                "repo": self.state.repo,
                "ticket_id": self.state.ticket_id,
                "status": "merged",
                "command": "e0006-m3-canary",
                "agent": "hermes",
            },
        )
        self.expect_tool_denial(
            denied,
            "Restricted principals cannot set status 'merged' during planning",
            "canary_execution_denial_missing",
        )
        self.expect_ticket(status="backlog", approval=False)
        self.state.checks.append(CANARY_CHECKS[1])
        self.save()

        operation_id = "deny-execution-status"
        batched = self.batch(
            [
                {
                    "operation_id": operation_id,
                    "idempotency_key": f"{self.state.run_id}-status-denial",
                    "repo": self.state.repo,
                    "ticket_id": self.state.ticket_id,
                    "ticket_update": {"status": "merged"},
                }
            ]
        )
        require_exact_keys(
            batched,
            {"mode", "committed", "complete", "results"},
            "canary_rest_denial_shape_mismatch",
        )
        results = require_list(batched["results"], "canary_rest_denial_shape_mismatch")
        if (
            batched["mode"] != "atomic"
            or batched["committed"] is not False
            or batched["complete"] is not False
            or len(results) != 1
        ):
            raise SafeError("canary_rest_denial_missing", exit_code=EXIT_CLEANUP)
        denial = require_object(results[0], "canary_rest_denial_shape_mismatch")
        require_exact_keys(
            denial,
            {"operation_id", "ticket_id", "repo", "status", "error_type", "code", "detail"},
            "canary_rest_denial_shape_mismatch",
        )
        if (
            denial["operation_id"] != operation_id
            or denial["ticket_id"] != self.state.ticket_id
            or denial["repo"] != self.state.repo
            or denial["status"] != "failed"
            or denial["error_type"] != "TicketPolicyError"
            or denial["code"] != "ticket_status_denied"
            or denial["detail"] != "Restricted principals cannot set status 'merged' during planning"
        ):
            raise SafeError("canary_rest_denial_missing", exit_code=EXIT_CLEANUP)
        self.expect_ticket(status="backlog", approval=False)
        self.state.checks.append(CANARY_CHECKS[2])
        self.save()

        human = self.tool(
            "get_ticket",
            {
                "project": PROJECT,
                "repo": HUMAN_TICKET_REPO,
                "ticket_id": HUMAN_TICKET_ID,
                "detail": "light",
                "include_events": False,
            },
        )
        human_ticket = require_object(human.get("ticket"), "canary_human_shape_mismatch")
        if (
            human_ticket.get("id") != HUMAN_TICKET_ID
            or human_ticket.get("repo") != HUMAN_TICKET_REPO
            or human_ticket.get("origin") != "admin"
        ):
            raise SafeError("canary_human_shape_mismatch", exit_code=EXIT_CLEANUP)
        before_tags = human_ticket.get("tags")
        if not isinstance(before_tags, dict):
            raise SafeError("canary_human_shape_mismatch", exit_code=EXIT_CLEANUP)
        cross = self.tool(
            "update_ticket",
            {
                "project": PROJECT,
                "repo": HUMAN_TICKET_REPO,
                "ticket_id": HUMAN_TICKET_ID,
                "tags": {"canary_probe": self.state.run_id},
                "command": "e0006-m3-canary",
                "agent": "hermes",
            },
        )
        self.expect_tool_denial(
            cross,
            "This principal may mutate only tickets created by the same origin",
            "canary_origin_denial_missing",
        )
        human_after = self.tool(
            "get_ticket",
            {
                "project": PROJECT,
                "repo": HUMAN_TICKET_REPO,
                "ticket_id": HUMAN_TICKET_ID,
                "detail": "light",
                "include_events": False,
            },
        )
        after_ticket = require_object(human_after.get("ticket"), "canary_human_shape_mismatch")
        if after_ticket.get("tags") != before_tags:
            raise SafeError("canary_human_ticket_changed", exit_code=EXIT_CLEANUP)
        self.state.checks.append(CANARY_CHECKS[3])
        self.save()

        approval = self.tool(
            "update_ticket",
            {
                "project": PROJECT,
                "repo": self.state.repo,
                "ticket_id": self.state.ticket_id,
                "approve_execution": True,
                "command": "e0006-m3-canary",
                "agent": "hermes",
            },
        )
        self.expect_tool_denial(
            approval,
            "Execution approval requires the admin principal",
            "canary_self_approval_denial_missing",
        )
        self.expect_ticket(status="backlog", approval=False)
        self.state.checks.append(CANARY_CHECKS[4])
        self.save()

        planned = self.batch(
            [
                {
                    "operation_id": "create-plan-and-plan-ticket",
                    "idempotency_key": f"{self.state.run_id}-plan",
                    "repo": self.state.repo,
                    "ticket_id": self.state.ticket_id,
                    "artifact": {
                        "artifact_type": "plan",
                        "title": "Bounded direct-memory canary plan",
                        "content": "Synthetic plan for the E0006 M3 bounded canary.",
                    },
                    "ticket_update": {"status": "planned"},
                }
            ],
            mutation=True,
            embedding=True,
        )
        require_exact_keys(
            planned,
            {"mode", "committed", "complete", "results"},
            "canary_plan_transition_failed",
        )
        planned_results = require_list(planned["results"], "canary_plan_transition_failed")
        if (
            planned["mode"] != "atomic"
            or planned["committed"] is not True
            or planned["complete"] is not True
            or len(planned_results) != 1
        ):
            raise SafeError("canary_plan_transition_failed", exit_code=EXIT_CLEANUP)
        planned_result = require_object(planned_results[0], "canary_plan_transition_failed")
        validate_plan_transition_result(
            planned_result,
            ticket_id=self.state.ticket_id,
            repo=self.state.repo,
        )
        pickup = self.tool("next_ticket", {"project": PROJECT, "repo": self.state.repo})
        require_exact_keys(pickup, {"ticket", "message"}, "canary_pickup_shape_mismatch")
        if pickup["ticket"] is not None:
            raise SafeError("canary_unapproved_pickup", exit_code=EXIT_CLEANUP)
        self.state.checks.append(CANARY_CHECKS[5])
        self.state.phase = "awaiting_admin_approval"
        self.save()

    def after_approval(self) -> None:
        if self.state.phase != "awaiting_admin_approval":
            raise SafeError("canary_phase_mismatch")
        observed_now = False
        if len(self.state.checks) == 6:
            self.expect_ticket(status="planned", approval=True)
            self.state.checks.append(CANARY_CHECKS[6])
            self.save()
            observed_now = True
        if len(self.state.checks) == 7:
            needs_edit = True
            if not observed_now:
                current = self.expect_ticket(status="planned")
                needs_edit = current.get("execution_approved_at") is not None
            if needs_edit:
                changed = self.tool(
                    "update_ticket",
                    {
                        "project": PROJECT,
                        "repo": self.state.repo,
                        "ticket_id": self.state.ticket_id,
                        "summary_bullets": ["Hermes owner edit clears approval"],
                        "command": "e0006-m3-canary",
                        "agent": "hermes",
                    },
                    mutation=True,
                )
                self.expect_update_ack(changed, cast(str, self.state.ticket_id))
                self.expect_ticket(status="planned", approval=False)
            self.state.checks.append(CANARY_CHECKS[7])
            self.save()
        if len(self.state.checks) == 8:
            pickup = self.tool("next_ticket", {"project": PROJECT, "repo": self.state.repo})
            require_exact_keys(pickup, {"ticket", "message"}, "canary_pickup_shape_mismatch")
            if pickup["ticket"] is not None:
                raise SafeError("canary_cleared_approval_pickup", exit_code=EXIT_CLEANUP)
            self.state.checks.append(CANARY_CHECKS[8])
        self.state.phase = "awaiting_admin_reapproval"
        self.save()

    def after_reapproval(self) -> None:
        if self.state.phase != "awaiting_admin_reapproval":
            raise SafeError("canary_phase_mismatch")
        ticket: dict[str, object] | None = None
        if len(self.state.checks) == 9:
            ticket = self.expect_ticket(status="planned", approval=True)
            self.state.checks.append(CANARY_CHECKS[9])
            self.save()
        if len(self.state.checks) == 10:
            pickup = self.tool("next_ticket", {"project": PROJECT, "repo": self.state.repo})
            require_exact_keys(
                pickup,
                {"ticket", "artifacts", "open_comment_count", "context_version", "detail"},
                "canary_pickup_shape_mismatch",
            )
            picked = require_object(pickup["ticket"], "canary_pickup_shape_mismatch")
            require_list(pickup["artifacts"], "canary_pickup_shape_mismatch")
            self.validate_ticket(picked, status="planned", approval=True)
            self.state.checks.append(CANARY_CHECKS[10])
            self.save()
        self.cleanup(ticket)

    def cleanup(self, verified_ticket: dict[str, object] | None = None) -> None:
        if self.state.phase == "complete" and self.state.cleanup == "pass":
            return
        if self.state.ticket_id is None:
            if self.state.phase != "prepare":
                raise SafeError("canary_cleanup_ticket_missing", exit_code=EXIT_CLEANUP)
            self._recover_created_ticket(cleanup=True)
        ticket = verified_ticket
        if ticket is None:
            ticket = self.expect_ticket(cleanup=True)
        else:
            self.validate_ticket(ticket)
        if (
            ticket.get("status") != "abandoned"
            or ticket.get("execution_approved_at") is not None
            or ticket.get("execution_approved_by") is not None
        ):
            changed = self.tool(
                "update_ticket",
                {
                    "project": PROJECT,
                    "repo": self.state.repo,
                    "ticket_id": self.state.ticket_id,
                    "status": "abandoned",
                    "command": "e0006-m3-canary-cleanup",
                    "agent": "hermes",
                },
                mutation=True,
                cleanup=True,
            )
            ticket = self.expect_update_ack(changed, self.state.ticket_id)
        self.validate_ticket(ticket, status="abandoned", approval=False)
        pickup = self.tool(
            "next_ticket",
            {"project": PROJECT, "repo": self.state.repo},
            cleanup=True,
        )
        require_exact_keys(pickup, {"ticket", "message"}, "canary_pickup_shape_mismatch")
        if pickup["ticket"] is not None:
            raise SafeError("canary_cleanup_pickup_not_empty", exit_code=EXIT_CLEANUP)
        if not self.state.checks or self.state.checks[-1] != CANARY_CHECKS[-1]:
            self.state.checks.append(CANARY_CHECKS[-1])
        self.state.phase = "complete"
        self.state.cleanup = "pass"
        self.save()


def validate_preflight(path: Path) -> None:
    receipt = load_json_receipt(path)
    expected = {
        "schema",
        "status",
        "evidence_id",
        "valid_config_count",
        "invalid_config_count",
        "observed_at",
    }
    require_exact_keys(receipt, expected, "preflight_receipt_mismatch")
    if (
        receipt["schema"] != PREFLIGHT_SCHEMA
        or receipt["status"] != "pass"
        or receipt["valid_config_count"] != 1
        or receipt["invalid_config_count"] != 0
    ):
        raise SafeError("preflight_receipt_mismatch")
    require_opaque_id(receipt["evidence_id"], "preflight_receipt_mismatch")
    observed = receipt["observed_at"]
    if isinstance(observed, bool) or not isinstance(observed, (int, float)):
        raise SafeError("preflight_receipt_mismatch")
    observed_at = float(observed)
    if not math.isfinite(observed_at):
        raise SafeError("preflight_receipt_mismatch")
    if abs(time.time() - observed_at) > CANARY_SECONDS:
        raise SafeError("preflight_receipt_stale")


def reject_secret_like_fields(value: object) -> None:
    forbidden = {
        "bearer",
        "body",
        "c4",
        "digest",
        "header",
        "length",
        "password",
        "secret",
        "token",
        "value",
    }
    if isinstance(value, dict):
        for raw_key, child in value.items():
            if not isinstance(raw_key, str) or raw_key.lower() in forbidden:
                raise SafeError("handoff_secret_field")
            reject_secret_like_fields(child)
    elif isinstance(value, list):
        for child in value:
            reject_secret_like_fields(child)


def validate_handoff(value: object) -> dict[str, object]:
    """Validate the closed, value-free F0033-to-F0021 handoff object."""
    handoff = require_object(value, "handoff_shape_mismatch")
    require_exact_keys(
        handoff,
        {
            "schema",
            "status",
            "provider",
            "items",
            "deployments",
            "admin_matrix",
            "direct_canary",
            "evidence_artifact_id",
        },
        "handoff_shape_mismatch",
    )
    if handoff["schema"] != HANDOFF_SCHEMA or handoff["status"] != "pass":
        raise SafeError("handoff_nonpass")
    provider = require_object(handoff["provider"], "handoff_shape_mismatch")
    require_exact_keys(
        provider,
        {"ticket", "path", "contract", "output_schema", "merge_sha", "tree_sha"},
        "handoff_shape_mismatch",
    )
    if (
        provider["ticket"] != "F0023"
        or provider["path"] != "bin/hermes-activation"
        or provider["contract"] != CONTRACT
        or provider["output_schema"] != OUTPUT_SCHEMA
    ):
        raise SafeError("handoff_provider_mismatch")
    require_opaque_id(provider["merge_sha"], "handoff_shape_mismatch")
    require_opaque_id(provider["tree_sha"], "handoff_shape_mismatch")

    item_rows = require_list(handoff["items"], "handoff_shape_mismatch")
    if len(item_rows) != len(ITEMS):
        raise SafeError("handoff_item_mismatch")
    item_ids: set[str] = set()
    for expected, candidate in zip(ITEMS, item_rows):
        item = require_object(candidate, "handoff_shape_mismatch")
        require_exact_keys(item, {"name", "ref", "item_id", "state"}, "handoff_shape_mismatch")
        if (
            item["name"] != expected.name
            or item["ref"] != expected.ref
            or item["state"] not in {"created", "existing"}
        ):
            raise SafeError("handoff_item_mismatch")
        item_id = require_opaque_id(item["item_id"], "handoff_shape_mismatch")
        if item_id in item_ids:
            raise SafeError("handoff_duplicate_id")
        item_ids.add(item_id)

    deployments = require_list(handoff["deployments"], "handoff_shape_mismatch")
    labels = ("initial_active", "inert", "final_active")
    if len(deployments) != len(labels):
        raise SafeError("handoff_deployment_mismatch")
    deploy_ids: set[str] = set()
    for index, candidate in enumerate(deployments):
        deployment = require_object(candidate, "handoff_shape_mismatch")
        require_exact_keys(
            deployment,
            {"label", "deploy_id", "state", "valid_config_count", "invalid_config_count"},
            "handoff_shape_mismatch",
        )
        expected_valid = 0 if labels[index] == "inert" else 1
        if (
            deployment["label"] != labels[index]
            or deployment["state"] != "live"
            or deployment["valid_config_count"] != expected_valid
            or deployment["invalid_config_count"] != 0
        ):
            raise SafeError("handoff_deployment_mismatch")
        deploy_id = require_opaque_id(deployment["deploy_id"], "handoff_shape_mismatch")
        if deploy_id in deploy_ids:
            raise SafeError("handoff_duplicate_id")
        deploy_ids.add(deploy_id)

    admin = require_object(handoff["admin_matrix"], "handoff_shape_mismatch")
    require_exact_keys(admin, {"evidence_id", "status"}, "handoff_shape_mismatch")
    if admin["status"] != "pass":
        raise SafeError("handoff_nonpass")
    require_opaque_id(admin["evidence_id"], "handoff_shape_mismatch")

    canary = require_object(handoff["direct_canary"], "handoff_shape_mismatch")
    require_exact_keys(
        canary,
        {"run_id", "ticket_id", "evidence_id", "status", "cleanup"},
        "handoff_shape_mismatch",
    )
    if canary["status"] != "pass" or canary["cleanup"] != "pass":
        raise SafeError("handoff_nonpass")
    for key in ("run_id", "ticket_id", "evidence_id"):
        require_opaque_id(canary[key], "handoff_shape_mismatch")
    require_opaque_id(handoff["evidence_artifact_id"], "handoff_shape_mismatch")
    reject_secret_like_fields(handoff)
    return handoff


def canary_result(state: CanaryState) -> dict[str, object]:
    return {
        "run_id": state.run_id,
        "repo": state.repo,
        "ticket_id": state.ticket_id or "pending",
        "phase": state.phase,
        "checks": [{"code": code, "pass": True} for code in state.checks],
        "cleanup": state.cleanup,
    }


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="hermes-activation", allow_abbrev=False)
    root.add_argument("--version", action="version", version=CONTRACT)
    groups = root.add_subparsers(dest="group", required=True)

    items = groups.add_parser("items", allow_abbrev=False)
    item_commands = items.add_subparsers(dest="action", required=True)
    ensure = item_commands.add_parser("ensure", allow_abbrev=False)
    ensure.add_argument("--receipt", type=receipt_path)

    memory = groups.add_parser("memory", allow_abbrev=False)
    memory_commands = memory.add_subparsers(dest="action", required=True)
    apply = memory_commands.add_parser("apply", allow_abbrev=False)
    apply.add_argument("--mode", choices=("active", "inert"), required=True)
    apply.add_argument("--receipt", type=receipt_path)
    canary = memory_commands.add_parser("canary", allow_abbrev=False)
    canary.add_argument(
        "--phase",
        choices=("prepare", "after-approval", "after-reapproval", "cleanup"),
        required=True,
    )
    canary.add_argument("--state-receipt", type=receipt_path, required=True)
    canary.add_argument("--preflight-receipt", type=receipt_path)

    render = groups.add_parser("render", allow_abbrev=False)
    render_commands = render.add_subparsers(dest="action", required=True)
    wait = render_commands.add_parser("wait", allow_abbrev=False)
    wait.add_argument("--deploy-id", required=True)
    wait.add_argument("--timeout-receipt", type=receipt_path, required=True)
    cancel = render_commands.add_parser("cancel", allow_abbrev=False)
    cancel.add_argument("--deploy-id", required=True)
    cancel.add_argument("--timeout-receipt", type=receipt_path, required=True)
    cancel.add_argument("--canceled-receipt", type=receipt_path, required=True)
    return root


def render_client(op: OpClient, test_mode: bool) -> RenderClient:
    render_token = op.read(RENDER_REF)
    base = test_base("RENDER", RENDER_BASE, test_mode)
    poll = POLL_SECONDS
    wait = WAIT_SECONDS
    if test_mode:
        poll = float(os.environ.get("HERMES_ACTIVATION_TEST_POLL_SECONDS", "0.01"))
        wait = float(os.environ.get("HERMES_ACTIVATION_TEST_WAIT_SECONDS", "1"))
        if poll <= 0 or wait <= 0:
            raise SafeError("invalid_test_timing")
    return RenderClient(HttpClient(base, render_token), poll_seconds=poll, wait_seconds=wait)


def emit(value: dict[str, object], receipt: Path | None = None) -> None:
    validate_envelope(value)
    if receipt is not None:
        atomic_write_json(receipt, value)
    sys.stdout.buffer.write(compact_json(value) + b"\n")


def command_name(args: argparse.Namespace) -> str:
    return f"{args.group} {args.action}"


def run(args: argparse.Namespace) -> tuple[dict[str, object], Path | None]:
    command = command_name(args)
    timeout_receipt: dict[str, object] | None = None
    output_receipt = getattr(args, "receipt", None)
    if output_receipt is not None:
        validate_receipt_target(output_receipt)
    if command == "render wait":
        require_opaque_id(args.deploy_id, "invalid_deploy_id")
        validate_receipt_target(args.timeout_receipt)
    elif command == "render cancel":
        require_opaque_id(args.deploy_id, "invalid_deploy_id")
        validate_receipt_target(args.canceled_receipt)
        timeout_receipt = validate_timeout_receipt(args.deploy_id, args.timeout_receipt)
    if command == "memory canary" and args.phase == "prepare":
        validate_receipt_target(args.state_receipt)
        if args.state_receipt.exists():
            existing = CanaryState.from_receipt(load_json_receipt(args.state_receipt))
            code = (
                "canary_receipt_already_complete"
                if existing.phase == "complete"
                else "canary_nonterminal_receipt_requires_cleanup"
            )
            raise SafeError(code)
    test_mode, executable = preflight_environment(Path(__file__))
    op = OpClient(executable)
    if command == "items ensure":
        items = ensure_items(op)
        return success_result(command, {"items": [asdict(item) for item in items]}), args.receipt
    if command == "memory apply":
        client = render_client(op, test_mode)
        memory_token: bytes | None = None
        try:
            if args.mode == "active":
                memory_token = op.read(MEMORY_REF)
            applied = client.apply(args.mode, memory_token)
        finally:
            memory_token = None
        return success_result(command, asdict(applied)), args.receipt
    if command == "render wait":
        client = render_client(op, test_mode)
        state = client.wait(args.deploy_id, args.timeout_receipt)
        result = {
            "service": RENDER_SERVICE,
            "deploy_id": args.deploy_id,
            "state": state,
            "resume_command": None,
        }
        return success_result(command, result), None
    if command == "render cancel":
        client = render_client(op, test_mode)
        state = client.cancel(
            args.deploy_id,
            args.timeout_receipt,
            args.canceled_receipt,
            timeout_receipt,
        )
        result = {
            "service": RENDER_SERVICE,
            "deploy_id": args.deploy_id,
            "state": state,
            "canceled": True,
        }
        return success_result(command, result), None
    if command == "memory canary":
        base = test_base("MEMORY", MEMORY_BASE, test_mode)
        state: CanaryState | None
        if args.phase == "prepare":
            if args.preflight_receipt is None:
                raise SafeError("preflight_receipt_required")
            validate_preflight(args.preflight_receipt)
            run_id = uuid.uuid4().hex[:20]
            started = time.time()
            state = CanaryState(
                schema=CANARY_RECEIPT_SCHEMA,
                run_id=run_id,
                repo=CANARY_REPO_PREFIX + run_id,
                ticket_id=None,
                phase="prepare",
                started_at=started,
                deadline_at=started + CANARY_SECONDS,
                checks=[],
                cleanup=None,
                requests=0,
                mutations=0,
                embedding_writes=0,
                cleanup_requests=0,
                cleanup_mutations=0,
            )
            atomic_write_json(args.state_receipt, asdict(state))
        else:
            state = CanaryState.from_receipt(load_json_receipt(args.state_receipt))
        try:
            token = op.read(MEMORY_REF)
        except SafeError:
            if state is not None and state.ticket_id is None:
                state.checks = [CANARY_CHECKS[-1]]
                state.phase = "complete"
                state.cleanup = "pass"
                atomic_write_json(args.state_receipt, asdict(state))
            raise
        try:
            memory = MemoryClient(HttpClient(base, token))
            if state is None:
                raise SafeError("canary_receipt_mismatch")
            machine = Canary(memory, state, args.state_receipt)
            if args.phase == "prepare":
                machine.prepare()
            elif args.phase == "after-approval":
                machine.after_approval()
            elif args.phase == "after-reapproval":
                machine.after_reapproval()
            else:
                machine.cleanup()
            return success_result(command, canary_result(state)), None
        except SafeError as error:
            if (
                args.phase != "cleanup"
                and state is not None
                and state.ticket_id is not None
                and state.cleanup != "pass"
            ):
                try:
                    Canary(memory, state, args.state_receipt).cleanup()
                except SafeError:
                    raise SafeError("canary_cleanup_failed", exit_code=EXIT_CLEANUP) from None
            raise error
        finally:
            token = b""
    raise SafeError("unsupported_command")


def main() -> NoReturn:
    args = parser().parse_args()
    command = command_name(args)
    receipt = getattr(args, "receipt", None)
    try:
        value, receipt = run(args)
        emit(value, receipt)
        raise SystemExit(0)
    except SafeError as error:
        value = fixed_error_result(command, error)
        try:
            emit(value, receipt)
        except SafeError:
            fallback = fixed_error_result(command, SafeError("safe_output_failed"))
            sys.stdout.buffer.write(compact_json(fallback) + b"\n")
        raise SystemExit(error.exit_code)
    except Exception:
        value = fixed_error_result(command, SafeError("internal_error"))
        sys.stdout.buffer.write(compact_json(value) + b"\n")
        raise SystemExit(EXIT_PREFLIGHT)


if __name__ == "__main__":
    main()
