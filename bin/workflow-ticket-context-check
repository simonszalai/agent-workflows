#!/usr/bin/env python3
"""Reject broad unfiltered full-ticket reads in active workflow examples."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


def call_blocks(text: str) -> list[tuple[int, str]]:
    blocks: list[tuple[int, str]] = []
    lines = text.splitlines()
    for index, line in enumerate(lines):
        if "get_ticket(" not in line:
            continue
        block = [line]
        depth = line.count("(") - line.count(")")
        cursor = index + 1
        while depth > 0 and cursor < len(lines):
            block.append(lines[cursor])
            depth += lines[cursor].count("(") - lines[cursor].count(")")
            cursor += 1
        blocks.append((index + 1, "\n".join(block)))
    return blocks


def main() -> int:
    parser = argparse.ArgumentParser(prog="workflow-ticket-context-check")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    args = parser.parse_args()
    violations: list[dict] = []
    for relative_root in ("skills", "agents", "workflows"):
        root = args.root / relative_root
        if not root.exists():
            continue
        for path in root.rglob("*"):
            if not path.is_file() or path.suffix not in {".md", ".toml", ".js"}:
                continue
            for line, block in call_blocks(path.read_text(encoding="utf-8", errors="replace")):
                if not re.search(r"""detail\s*=\s*["']full["']""", block):
                    continue
                if "artifact_types" in block or "narrow-full-ticket-exception:" in block:
                    continue
                violations.append({
                    "path": str(path.relative_to(args.root)),
                    "line": line,
                    "reason": "unfiltered_full_ticket_read",
                })
    result = {"status": "pass" if not violations else "fail", "violations": violations}
    print(json.dumps(result, separators=(",", ":")))
    return 0 if not violations else 2


if __name__ == "__main__":
    sys.exit(main())
