#!/bin/bash
# Resolve committed op:// reference env files and exec a command.
# Defaults to .env; override with ENV_FILE=.env.prod (or another reference file).
# Secret values stay inside `op run` and must never be printed by callers.

set -euo pipefail

if [[ $# -eq 0 ]]; then
  echo "usage: op-env <command> [args...]" >&2
  echo "       ENV_FILE=.env.prod op-env <command> [args...]" >&2
  exit 2
fi

OP_BIN="${OP_BIN:-op}"
ENV_FILE="${ENV_FILE:-.env}"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "op-env: env file not found: $ENV_FILE" >&2
  exit 2
fi

inspect_file_mode() {
  local path="$1"
  local candidate=""

  INSPECTED_MODE=""
  candidate="$(/usr/bin/stat -f '%Lp' "$path" 2>/dev/null)" || candidate=""
  if [[ "$candidate" =~ ^0?[0-7]{3}$ ]]; then
    INSPECTED_MODE="${candidate#0}"
    return 0
  fi

  candidate="$(/usr/bin/stat -c '%a' "$path" 2>/dev/null)" || candidate=""
  if [[ "$candidate" =~ ^0?[0-7]{3}$ ]]; then
    INSPECTED_MODE="${candidate#0}"
    return 0
  fi
  return 1
}

mode_is_not_group_or_other_writable() {
  local mode_value

  inspect_file_mode "$1" || return 1
  mode_value=$((8#$INSPECTED_MODE))
  (( (mode_value & 0022) == 0 ))
}

scan_sensitive_env_file() {
  local scan_file="$1"
  local chunk=""
  local window=""
  local reference_tail=""
  local read_status=0
  local reads_completed=0
  local scanned_chars=0
  local chunk_size=4096
  local max_reads=65536
  local max_chars=16777216

  if ! exec 3<"$scan_file"; then
    return 0
  fi

  while (( reads_completed < max_reads )); do
    chunk=""
    if IFS= read -r -n "$chunk_size" chunk <&3; then
      read_status=0
    else
      read_status=$?
    fi
    ((reads_completed += 1))
    scanned_chars=$((scanned_chars + ${#chunk} + 1))
    window+="$chunk"

    if [[ "$window" =~ op://[^/[:space:]]+-sensitive/ ]]; then
      exec 3<&-
      return 0
    fi
    if (( scanned_chars > max_chars )); then
      exec 3<&-
      return 0
    fi

    reference_tail="${window##*op://}"
    if [[ "$reference_tail" != "$window" &&
          "$reference_tail" != */* &&
          ! "$reference_tail" =~ [[:space:]] &&
          ${#reference_tail} -ge $chunk_size ]]; then
      exec 3<&-
      return 0
    fi
    if (( ${#window} > chunk_size * 2 )); then
      window="${window: -$chunk_size}"
    fi

    if (( read_status != 0 )); then
      exec 3<&-
      return 1
    fi
  done

  chunk=""
  if IFS= read -r -n 1 chunk <&3; then
    read_status=0
  else
    read_status=$?
  fi
  exec 3<&-
  if (( read_status == 0 )) || [[ -n "$chunk" ]]; then
    return 0
  fi
  return 1
}

# Sensitive env files must enter through this installation's exact op shim.
# The shim, rather than op-env or a caller-selected binary, owns the complete
# cache -> reason -> notifier -> human selector -> real child chain.
if scan_sensitive_env_file "$ENV_FILE"; then
  unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
  for variable_name in "${!OP_SESSION_@}"; do
    unset "$variable_name"
  done

  script_dir="${BASH_SOURCE[0]%/*}"
  [[ "$script_dir" == "${BASH_SOURCE[0]}" ]] && script_dir="."
  HERE="$(cd "$script_dir" && pwd)"
  expected_op="$HERE/op"
  if [[ "$OP_BIN" != "$expected_op" || -L "$expected_op" || ! -f "$expected_op" ||
        ! -x "$expected_op" ]] ||
     ! mode_is_not_group_or_other_writable "$expected_op"; then
    echo "op-env: sensitive access requires the exact co-located op shim" >&2
    exit 2
  fi

  exec "$expected_op" run --env-file="$ENV_FILE" -- "$@"
fi

if ! command -v "$OP_BIN" >/dev/null 2>&1; then
  echo "op-env: missing 1Password CLI: $OP_BIN" >&2
  exit 2
fi

# Prefer an explicit token. Otherwise, use the Keychain service-account token of
# the project that OWNS the vaults this env file addresses. Each per-project
# service account reads exactly one regular vault, so a file spanning several
# projects (or naming an unregistered vault) resolves no token and keeps the
# existing interactive behavior instead of presenting the wrong account.
# Vault names are parsed in-process. No external command may read the env file:
# it carries op:// references alongside whatever else the caller committed.
collect_env_file_vaults() {
  local scan_file="$1"
  local line="" remainder="" vault="" existing="" known=0

  ENV_FILE_VAULTS=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    remainder="$line"
    while [[ "$remainder" =~ op://([^/\"[:space:]]+)/ ]]; do
      vault="${BASH_REMATCH[1]}"
      known=0
      for existing in ${ENV_FILE_VAULTS[@]+"${ENV_FILE_VAULTS[@]}"}; do
        if [[ "$existing" == "$vault" ]]; then
          known=1
          break
        fi
      done
      (( known )) || ENV_FILE_VAULTS+=("$vault")
      remainder="${remainder#*op://}"
    done
  done <"$scan_file"
}

keychain_item_for_vaults() {
  local registry
  registry="$(cd "${BASH_SOURCE[0]%/*}" && pwd)/../config/project-tools.json"

  [[ -r "$registry" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  jq -Rr --slurpfile registry "$registry" -s '
    split("\n") | map(select(length > 0)) as $vaults
    | ($registry[0].projects | to_entries) as $projects
    | ($vaults | map(. as $v | $projects | map(select(.value.service_account.vaults // [] | index($v))) | first)) as $owners
    | if ($owners | all(. != null)) and ($owners | map(.key) | unique | length) == 1
      then $owners[0].value.service_account.keychain_item // empty
      else empty
      end
  ' 2>/dev/null
}

if [[ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]]; then
  collect_env_file_vaults "$ENV_FILE"

  # An env file with no op:// references needs no token. One that names vaults
  # must resolve to exactly one owning project with a stored service account;
  # anything else is a configuration fault and stops here rather than falling
  # back to the human's fingerprint.
  if (( ${#ENV_FILE_VAULTS[@]} > 0 )); then
    keychain_item="$(
      printf '%s\n' "${ENV_FILE_VAULTS[@]}" | keychain_item_for_vaults || true
    )"
    if [[ -z "$keychain_item" ]]; then
      echo "op-env: $ENV_FILE references vaults with no single registered owner:" >&2
      printf '  %s\n' "${ENV_FILE_VAULTS[@]}" >&2
      echo "Register each vault under projects[].service_account.vaults in" >&2
      echo "config/project-tools.json, or split the file per project." >&2
      exit 5
    fi
    token="$(security find-generic-password -s "$keychain_item" -a simon -w 2>/dev/null || true)"
    if [[ -z "$token" ]]; then
      echo "op-env: no service-account token for $ENV_FILE." >&2
      echo "Store it with: security add-generic-password -U -s $keychain_item -a simon -w" >&2
      exit 6
    fi
    export OP_SERVICE_ACCOUNT_TOKEN="$token"
  fi
fi

exec "$OP_BIN" run --env-file="$ENV_FILE" -- "$@"
