#!/bin/bash
# op audit shim (E0022) — logs every op invocation (WHO/WHAT/WHEN, never values)
# to ~/.local/state/op-audit.log, then execs the real op.
#
# Answers "what is this fingerprint prompt for?": when a 1Password prompt
# appears, `op-audit` (alias for tail of the log) shows the requesting command,
# its parent process, and the op:// refs involved.
#
# SILENT-BY-DEFAULT (2026-07-08): non-sensitive reads retain an inherited
# OP_SERVICE_ACCOUNT_TOKEN or the Keychain-backed token of the project that
# OWNS the addressed vault (config/project-tools.json -> projects[].service_account.vaults
# -> .keychain_item), injected only into the exec'd op process.
# A command that names a regular vault FAILS CLOSED when that vault is not in
# the registry (exit 5) or its project has no stored token (exit 6), rather than
# presenting another project's service account or escalating an ordinary read to
# the human's fingerprint. Commands that name no vault (signin, --version,
# stdin-only inject) keep their existing behavior. A detected
# sensitive cache miss instead requires a reason and valid reviewed
# human-account selector configuration. It preflights idempotent `op signin`,
# showing the macOS purpose notification only when authentication is
# still waiting long enough to indicate a biometric prompt. Its canonical
# account is used unless the command supplies an explicit account;
# machine credentials are removed from that sensitive child. Sensitive cache
# hits remain notification- and authentication-free. OP_DESKTOP=1 is neither
# required nor a supported workaround for sensitive access.
#
# Args are sanitized: any arg containing '=' is truncated at the '=' (field
# assignments can carry values); op:// refs and subcommands pass through.
# (the retired mcp-gateway used to bypass this shim via a direct
# absolute op path and owns a separate audit line. Repairing or widening that
# gateway route is explicitly outside B0002.

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
LOG="$LOG_DIR/op-audit.log"

script_dir="${BASH_SOURCE[0]%/*}"
[[ "$script_dir" == "${BASH_SOURCE[0]}" ]] && script_dir="."
HERE="$(cd "$script_dir" && pwd)"

resolve_real_op() {
  local path_entry=""
  local remaining_path="${PATH:-}"
  local candidate=""
  local last_path_entry=0

  if [[ -n "${OP_REAL_BIN:-}" ]]; then
    if [[ "$OP_REAL_BIN" != /* || ! -f "$OP_REAL_BIN" || ! -x "$OP_REAL_BIN" ||
          "$OP_REAL_BIN" -ef "$HERE/op" ]]; then
      echo "ERROR: OP_REAL_BIN must name an absolute executable 1Password CLI path," >&2
      echo "not the op audit shim." >&2
      return 127
    fi
    REAL_OP="$OP_REAL_BIN"
    return 0
  fi

  while (( last_path_entry == 0 )); do
    if [[ "$remaining_path" == *:* ]]; then
      path_entry="${remaining_path%%:*}"
      remaining_path="${remaining_path#*:}"
    else
      path_entry="$remaining_path"
      last_path_entry=1
    fi
    [[ -n "$path_entry" ]] || path_entry="."
    candidate="$path_entry/op"
    if [[ -f "$candidate" && -x "$candidate" && ! "$candidate" -ef "$HERE/op" ]]; then
      REAL_OP="$candidate"
      return 0
    fi
  done

  for candidate in /opt/homebrew/bin/op /usr/local/bin/op /usr/bin/op; do
    if [[ -f "$candidate" && -x "$candidate" && ! "$candidate" -ef "$HERE/op" ]]; then
      REAL_OP="$candidate"
      return 0
    fi
  done

  echo "ERROR: no real 1Password CLI found. Install op or set OP_REAL_BIN." >&2
  return 127
}

resolve_real_op || exit $?

canonical_human_requested="${OP_USE_CANONICAL_HUMAN_ACCOUNT:-0}"
unset OP_USE_CANONICAL_HUMAN_ACCOUNT
if [[ "$canonical_human_requested" != "0" && "$canonical_human_requested" != "1" ]]; then
  echo "ERROR: OP_USE_CANONICAL_HUMAN_ACCOUNT must be 0 or 1." >&2
  exit 2
fi

inspect_file_mode() {
  local path="$1"
  local candidate=""

  INSPECTED_MODE=""
  candidate="$(/usr/bin/stat -f '%Lp' "$path" 2>/dev/null)" || candidate=""
  if [[ "$candidate" =~ ^0?[0-7]{3}$ ]]; then
    INSPECTED_MODE="${candidate#0}"
    return 0
  fi

  candidate="$(/usr/bin/stat -c '%a' "$path" 2>/dev/null)" || candidate=""
  if [[ "$candidate" =~ ^0?[0-7]{3}$ ]]; then
    INSPECTED_MODE="${candidate#0}"
    return 0
  fi
  return 1
}

mode_is_not_group_or_other_writable() {
  local mode_value

  inspect_file_mode "$1" || return 1
  mode_value=$((8#$INSPECTED_MODE))
  (( (mode_value & 0022) == 0 ))
}

load_human_account() {
  local selector="$HERE/op-human-account"
  local extra=""

  [[ -f "$selector" && ! -L "$selector" && -r "$selector" ]] || return 1
  inspect_file_mode "$selector" || return 1
  [[ "$INSPECTED_MODE" == "644" ]] || return 1
  {
    IFS= read -r HUMAN_ACCOUNT || return 1
    [[ "$HUMAN_ACCOUNT" =~ ^[A-Z0-9]{26}$ ]] || return 1
    while IFS= read -r extra || [[ -n "$extra" ]]; do
      [[ "$extra" =~ ^[[:space:]]*$ ]] || return 1
      extra=""
    done
  } <"$selector" 2>/dev/null
}

scan_sensitive_env_file() {
  local scan_file="$1"
  local chunk=""
  local window=""
  local reference_tail=""
  local read_status=0
  local reads_completed=0
  local scanned_chars=0
  local chunk_size=4096
  local max_reads=65536
  local max_chars=16777216

  if ! exec 3<"$scan_file"; then
    sensitive_vault="unreadable-sensitive-env-file"
    sensitive_item="env-file safety gate"
    return
  fi

  while (( reads_completed < max_reads )); do
    chunk=""
    if IFS= read -r -n "$chunk_size" chunk <&3; then
      read_status=0
    else
      read_status=$?
    fi
    ((reads_completed += 1))
    scanned_chars=$((scanned_chars + ${#chunk} + 1))
    window+="$chunk"

    if [[ "$window" =~ op://([^/[:space:]]+-sensitive)/ ]]; then
      sensitive_vault="${BASH_REMATCH[1]}"
      sensitive_item="env-file references"
      exec 3<&-
      return
    fi
    if (( scanned_chars > max_chars )); then
      sensitive_vault="oversized-sensitive-env-file"
      sensitive_item="env-file safety gate"
      exec 3<&-
      return
    fi

    # Retain a bounded overlap for references split across reads. An
    # abnormally long unterminated op:// vault token is treated as sensitive
    # rather than allowing a bounded scan to fail open.
    reference_tail="${window##*op://}"
    if [[ "$reference_tail" != "$window" &&
          "$reference_tail" != */* &&
          ! "$reference_tail" =~ [[:space:]] &&
          ${#reference_tail} -ge $chunk_size ]]; then
      sensitive_vault="unbounded-sensitive-env-reference"
      sensitive_item="env-file safety gate"
      exec 3<&-
      return
    fi
    if (( ${#window} > chunk_size * 2 )); then
      window="${window: -$chunk_size}"
    fi

    if (( read_status != 0 )); then
      exec 3<&-
      return
    fi
  done

  # Bound both bytes and delimiter-driven short reads. Files beyond the scan
  # budget enter the sensitive path conservatively.
  chunk=""
  if IFS= read -r -n 1 chunk <&3; then
    read_status=0
  else
    read_status=$?
  fi
  exec 3<&-
  if (( read_status == 0 )) || [[ -n "$chunk" ]]; then
    sensitive_vault="oversized-sensitive-env-file"
    sensitive_item="env-file safety gate"
  fi
}

sanitized=()
for a in "$@"; do
  case "$a" in
    *=*) sanitized+=("${a%%=*}=<redacted>") ;;
    *)   sanitized+=("$a") ;;
  esac
done

# --- sensitive-access attribution ------------------------------------------
# A reason is mandatory before an agent/tool can trigger Touch ID for a
# *-sensitive vault. Detect both direct refs and `--vault <name>` operations.
sensitive_vault="" sensitive_item="" env_file=""
previous=""
for a in "$@"; do
  case "$a" in
    op://*-sensitive/*/*)
      ref="${a#op://}"
      sensitive_vault="${ref%%/*}"
      rest="${ref#*/}"
      sensitive_item="${rest%%/*}"
      ;;
    --vault=*-sensitive)
      sensitive_vault="${a#--vault=}"
      sensitive_item="vault operation"
      ;;
    *-sensitive)
      sensitive_vault="$a"
      sensitive_item="vault operation"
      ;;
    --env-file=*) env_file="${a#--env-file=}" ;;
    --env-file) ;;
    *)
      if [[ "$previous" == "--env-file" ]]; then env_file="$a"; fi
      ;;
  esac
  previous="$a"
done

# --- regular-vault attribution ---------------------------------------------
# The silent service-account fallback needs the OWNING project's token: the
# per-project service accounts each read exactly one regular vault. Capture the
# addressed vault separately from the sensitive gate above, which must keep its
# own detection semantics untouched.
requested_vault=""
previous=""
for a in "$@"; do
  case "$a" in
    op://*/*/*)
      ref="${a#op://}"
      requested_vault="${ref%%/*}"
      ;;
    --vault=*)
      requested_vault="${a#--vault=}"
      ;;
    *)
      if [[ "$previous" == "--vault" ]]; then requested_vault="$a"; fi
      ;;
  esac
  previous="$a"
done

# Vault -> Keychain item, resolved from the canonical registry rather than a
# single hardcoded project. An unknown vault yields no token, so the call falls
# through to the existing interactive path instead of presenting the wrong
# project's service account.
keychain_item_for_vault() {
  local vault="$1"
  local registry="$HERE/../config/project-tools.json"

  [[ -n "$vault" ]] || return 1
  [[ -r "$registry" ]] || return 1
  command -v jq >/dev/null 2>&1 || return 1
  jq -er --arg vault "$vault" '
    .projects
    | to_entries
    | map(select(.value.service_account.vaults // [] | index($vault)))
    | first
    | .value.service_account.keychain_item // error("no keychain item")
  ' "$registry" 2>/dev/null
}

if [[ -z "$sensitive_vault" && -n "$env_file" &&
      ( -e "$env_file" || -L "$env_file" ) ]]; then
  if [[ -f "$env_file" && -r "$env_file" ]]; then
    scan_sensitive_env_file "$env_file"
  else
    sensitive_vault="invalid-sensitive-env-file"
    sensitive_item="env-file safety gate"
  fi
fi

# Commands such as `op inject` receive refs on stdin, which cannot be inspected
# here without consuming the caller's stream. A reviewed wrapper can provide a
# value-free vault/item hint so this shim still owns the sensitive auth gate.
if [[ -z "$sensitive_vault" && -n "${OP_SENSITIVE_VAULT_HINT:-}" ]]; then
  if [[ ! "$OP_SENSITIVE_VAULT_HINT" =~ ^[^/[:space:]]+-sensitive$ ]]; then
    echo "ERROR: invalid OP_SENSITIVE_VAULT_HINT; expected a *-sensitive vault name." >&2
    exit 2
  fi
  sensitive_vault="$OP_SENSITIVE_VAULT_HINT"
  sensitive_item="${OP_SENSITIVE_ITEM_HINT:-streamed input}"
fi
unset OP_SENSITIVE_VAULT_HINT OP_SENSITIVE_ITEM_HINT

if [[ -n "$sensitive_vault" || "$canonical_human_requested" == "1" ]]; then
  # No machine credential may reach any human-account process, including the
  # cache helper and notifier on paths that block before the real op command.
  unset OP_SERVICE_ACCOUNT_TOKEN OP_CONNECT_HOST OP_CONNECT_TOKEN
  for variable_name in "${!OP_SESSION_@}"; do
    unset "$variable_name"
  done
fi

mkdir -p "$LOG_DIR" 2>/dev/null

parent="$(ps -o comm= -p "$PPID" 2>/dev/null | tail -1 | tr -d ' ')"
gparent_pid="$(ps -o ppid= -p "$PPID" 2>/dev/null | tr -d ' ')"
gparent="$(ps -o comm= -p "${gparent_pid:-1}" 2>/dev/null | tail -1 | tr -d ' ')"

audit_vault="$(printf '%s' "$sensitive_vault" | tr '\r\n\t' '   ' | cut -c1-220)"
audit_item="$(printf '%s' "$sensitive_item" | tr '\r\n\t' '   ' | cut -c1-220)"

# Reuse direct sensitive reads within one Conductor session. Values live only
# in the memory of a per-session helper process (0700 directory / 0600 socket),
# never in a file, argv, audit log, or ambient environment. A cache hit returns
# before notification/authentication, so repeated reads do not trigger Touch ID.
cacheable_sensitive_read=0
cache_key=""
top_level_command=""
has_explicit_account=0
explicit_account=""
capture_account_value=0
skip_option_value=0
for a in "$@"; do
  [[ "$a" == "--" ]] && break
  if [[ "$capture_account_value" == "1" ]]; then
    explicit_account="$a"
    capture_account_value=0
    skip_option_value=0
    continue
  fi
  if [[ "$skip_option_value" == "1" ]]; then
    skip_option_value=0
    continue
  fi
  case "$a" in
    --account)
      has_explicit_account=1
      capture_account_value=1
      skip_option_value=1
      ;;
    --account=*)
      has_explicit_account=1
      explicit_account="${a#--account=}"
      ;;
    --config|--encoding|--format|--session)
      skip_option_value=1
      ;;
    --config=*|--encoding=*|--format=*|--session=*|-*) ;;
    *)
      if [[ -z "$top_level_command" ]]; then
        top_level_command="$a"
      fi
      ;;
  esac
done
if [[ "$canonical_human_requested" == "1" && "$has_explicit_account" != "1" &&
      -z "$sensitive_vault" ]] && ! load_human_account; then
  echo "ERROR: invalid human account selector configuration." >&2
  exit 4
fi
if [[ -n "$sensitive_vault" && "$top_level_command" == "read" && -n "${CONDUCTOR_SESSION_ID:-}" ]]; then
  cacheable_sensitive_read=1
  cache_key="$(printf '%s\0' "$@" | shasum -a 256 | awk '{print $1}')"
  if "$HERE/sensitive-session-cache" get "$cache_key"; then
    printf '%s pid=%s parent=%s<-%s auth=session-cache vault=%s item=%s :: op read <cached>\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$audit_vault" "$audit_item" \
      >> "$LOG" 2>/dev/null
    exit 0
  fi
fi

# A cache miss can require Touch ID. Preflight the idempotent `op signin` for
# the exact account and start the notifier only if authentication is still
# waiting after a short local-IPC grace period. This keeps the purpose visible
# alongside a real biometric prompt without spamming already-authenticated
# calls. The legacy OP_SENSITIVE_NOTIFICATION_SENT escape hatch remains
# intentionally ignored.
if [[ -n "$sensitive_vault" ]]; then
  reason="${SENSITIVE_ACCESS_REASON:-${OP_ACCESS_REASON:-}}"
  if [[ ! "$reason" =~ [^[:space:]] ]]; then
    printf '%s pid=%s parent=%s<-%s status=BLOCKED missing-reason vault=%s item=%s\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$audit_vault" "$audit_item" \
      >> "$LOG" 2>/dev/null
    echo "ERROR: sensitive vault access requires a reason." >&2
    echo "Set SENSITIVE_ACCESS_REASON (or OP_ACCESS_REASON) to a concise explanation." >&2
    exit 3
  fi
  if [[ "$has_explicit_account" != "1" ]] && ! load_human_account; then
    printf '%s pid=%s parent=%s<-%s status=BLOCKED invalid-account-config vault=%s item=%s\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$audit_vault" "$audit_item" \
      >> "$LOG" 2>/dev/null
    echo "ERROR: invalid human account selector configuration." >&2
    exit 4
  fi

  auth_account="$explicit_account"
  [[ "$has_explicit_account" == "1" ]] || auth_account="$HUMAN_ACCOUNT"
  if [[ ! "$auth_account" =~ [^[:space:]] ]]; then
    printf '%s pid=%s parent=%s<-%s status=BLOCKED invalid-account-selector vault=%s item=%s\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$audit_vault" "$audit_item" \
      >> "$LOG" 2>/dev/null
    echo "ERROR: invalid human account selector." >&2
    exit 4
  fi

  requester="${CONDUCTOR_WORKSPACE_NAME:-${CONDUCTOR_WORKSPACE:-$parent}}"
  notifier="$HERE/sensitive-access-notify"
  if [[ ! -e "$notifier" && ! -L "$notifier" ]]; then
    notification_preflight_status=127
  elif [[ -L "$notifier" || ! -f "$notifier" || ! -x "$notifier" ]] ||
       ! mode_is_not_group_or_other_writable "$notifier"; then
    notification_preflight_status=126
  else
    notification_preflight_status=0
  fi
  if [[ "$notification_preflight_status" != "0" ]]; then
    printf '%s pid=%s parent=%s<-%s status=BLOCKED notification-failed notification-status=%s vault=%s item=%s\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$notification_preflight_status" \
      "$audit_vault" "$audit_item" >> "$LOG" 2>/dev/null
    echo "ERROR: sensitive vault access notification failed." >&2
    exit "$notification_preflight_status"
  fi

  notification_pid=""
  sensitive_notification_shown=0
  cleanup_pending_notification() {
    if [[ -n "$notification_pid" ]]; then
      kill "$notification_pid" 2>/dev/null
      wait "$notification_pid" 2>/dev/null
      notification_pid=""
    fi
  }
  trap cleanup_pending_notification EXIT HUP INT TERM
  (
    sleep 0.25
    exec "$notifier" "$sensitive_vault" "$sensitive_item" "$reason" "$requester"
  ) &
  notification_pid=$!

  "$REAL_OP" signin --account "$auth_account" >/dev/null 2>&1
  authentication_status=$?
  kill "$notification_pid" 2>/dev/null
  wait "$notification_pid" 2>/dev/null
  notification_status=$?
  notification_pid=""
  trap - EXIT HUP INT TERM

  if [[ "$notification_status" != "0" && "$notification_status" != "143" ]]; then
    printf '%s pid=%s parent=%s<-%s status=BLOCKED notification-failed notification-status=%s vault=%s item=%s\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$notification_status" \
      "$audit_vault" "$audit_item" >> "$LOG" 2>/dev/null
    echo "ERROR: sensitive vault access notification failed." >&2
    exit "$notification_status"
  fi
  [[ "$notification_status" == "0" ]] && sensitive_notification_shown=1
  if [[ "$authentication_status" != "0" ]]; then
    printf '%s pid=%s parent=%s<-%s status=BLOCKED authentication-failed authentication-status=%s vault=%s item=%s\n' \
      "$(date '+%F %T')" "$$" "$parent" "$gparent" "$authentication_status" \
      "$audit_vault" "$audit_item" >> "$LOG" 2>/dev/null
    echo "ERROR: sensitive vault authentication failed." >&2
    exit "$authentication_status"
  fi
fi

# --- auth mode resolution ---------------------------------------------------
# Sensitive requests automatically use the reviewed human account after the
# notification; an explicit --account remains explicit. For ordinary requests,
# signin/account subcommands, explicit --account, and OP_DESKTOP=1 select the
# desktop path without changing silent service-account behavior.
wants_desktop=0
[[ "$has_explicit_account" == "1" ]] && wants_desktop=1
[[ "$canonical_human_requested" == "1" ]] && wants_desktop=1
[ "${OP_DESKTOP:-0}" = "1" ] && wants_desktop=1
case "$top_level_command" in signin|account) wants_desktop=1 ;; esac

child_argv=("$@")
if [[ -n "$sensitive_vault" ]]; then
  if [[ "$has_explicit_account" != "1" ]]; then
    child_argv=(--account "$HUMAN_ACCOUNT" "$@")
  fi

  auth="interactive desktop-session(silent)"
  [[ "$sensitive_notification_shown" == "1" ]] && auth="interactive BIOMETRIC-PROMPT"
elif [[ "$canonical_human_requested" == "1" ]]; then
  if [[ "$has_explicit_account" != "1" ]]; then
    child_argv=(--account "$HUMAN_ACCOUNT" "$@")
  fi
  auth="interactive canonical-account(silent)"
else
  auth="interactive BIOMETRIC-PROMPT"
  if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    auth="service-account(silent)"
  elif [ "$wants_desktop" != "1" ] && [ -n "$requested_vault" ]; then
    # A regular vault named on the command line must be served by its owning
    # project's service account. Both "unregistered vault" and "registered vault
    # with no stored token" are configuration faults, so fail closed instead of
    # escalating an ordinary read to the human's fingerprint.
    keychain_item="$(keychain_item_for_vault "$requested_vault" || true)"
    if [ -z "$keychain_item" ]; then
      printf '%s pid=%s parent=%s<-%s status=BLOCKED unregistered-vault vault=%s\n' \
        "$(date '+%F %T')" "$$" "$parent" "$gparent" \
        "$(printf '%s' "$requested_vault" | tr '\r\n\t' '   ' | cut -c1-220)" \
        >> "$LOG" 2>/dev/null
      echo "ERROR: vault '$requested_vault' has no project in config/project-tools.json." >&2
      echo "Register it under projects[].service_account.vaults, or pass an explicit" >&2
      echo "OP_SERVICE_ACCOUNT_TOKEN / --account for a deliberate non-registry read." >&2
      exit 5
    fi
    OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -s "$keychain_item" -a simon -w 2>/dev/null)"
    if [ -z "$OP_SERVICE_ACCOUNT_TOKEN" ]; then
      printf '%s pid=%s parent=%s<-%s status=BLOCKED missing-service-account-token vault=%s item=%s\n' \
        "$(date '+%F %T')" "$$" "$parent" "$gparent" \
        "$(printf '%s' "$requested_vault" | tr '\r\n\t' '   ' | cut -c1-220)" \
        "$keychain_item" >> "$LOG" 2>/dev/null
      echo "ERROR: no service-account token for vault '$requested_vault'." >&2
      echo "Store it with: security add-generic-password -U -s $keychain_item -a simon -w" >&2
      exit 6
    fi
    export OP_SERVICE_ACCOUNT_TOKEN
    auth="service-account(keychain)"
  fi
fi

reason_log="${SENSITIVE_ACCESS_REASON:-${OP_ACCESS_REASON:-}}"
reason_log="$(printf '%s' "$reason_log" | tr '\r\n\t' '   ' | cut -c1-220)"
printf '%s pid=%s parent=%s<-%s auth=%s%s :: op %s\n' \
  "$(date '+%F %T')" "$$" "$parent" "$gparent" "$auth" \
  "${reason_log:+ reason=[$reason_log]}" "${sanitized[*]}" >> "$LOG" 2>/dev/null

if [[ "$cacheable_sensitive_read" == "1" ]]; then
  # `op read` callers use --no-newline, so command substitution is lossless.
  # The resolved value stays in process memory and is sent over the 0600 socket.
  sensitive_value="$("$REAL_OP" "${child_argv[@]}")" || exit $?
  printf %s "$sensitive_value" | "$HERE/sensitive-session-cache" put "$cache_key"
  printf %s "$sensitive_value"
  sensitive_value=""
  exit 0
fi

exec "$REAL_OP" "${child_argv[@]}"
