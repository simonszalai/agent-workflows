#!/usr/bin/env bash
# rotate-project — one-command full rotation sweep for a project.
#
# Runs every config/secret-rotation.json entry belonging to --project through
# rotate-secret in a safe order, verifying consumer health after each entry:
#
#   1. staging postgres entries      (first one runs --keep-old as the canary)
#   2. SELF_MINTED entries           (fully automatic)
#   3. provider entries              (automated when the provider handler can
#                                     mint; otherwise the script prompts you to
#                                     paste the freshly minted value ONCE — it
#                                     is read silently and piped to --complete,
#                                     never argv or history)
#   4. prod postgres entries         (one at a time, health-gated between)
#
# Stops on the first failure; rerunning is safe (rotate-secret is resumable /
# idempotent per entry). Values never reach stdout or argv.
#
# usage:
#   rotate-project <amaru|ts|workflow-pro|autodev> --reason "<why>"
#                  [--dry-run] [--tier staging|prod|all] [--skip id[,id...]]
#                  [--only id[,id...]]
#
# exit codes: 0 all entries rotated+verified, 1 a rotation or health check
#   failed (state printed), 2 usage/config, 3 agent-shell refusal.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REGISTRY="${ROTATION_REGISTRY:-$HERE/../config/secret-rotation.json}"
ROTATE="${ROTATE_SECRET:-$HERE/rotate-secret}"

usage() { sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

project="" reason="" dry=0 tier="all" skip="" only=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --tier) tier="${2:?}"; shift 2 ;;
    --tier=*) tier="${1#*=}"; shift ;;
    --skip) skip="${2:?}"; shift 2 ;;
    --skip=*) skip="${1#*=}"; shift ;;
    --only) only="${2:?}"; shift 2 ;;
    --only=*) only="${1#*=}"; shift ;;
    -h|--help) usage ;;
    -*) echo "ERROR: unknown flag $1" >&2; usage ;;
    *) [[ -z "$project" ]] || usage; project="$1"; shift ;;
  esac
done
[[ -n "$project" ]] || usage
[[ -n "$reason" || "$dry" -eq 1 ]] || { echo "ERROR: --reason is required for a live sweep." >&2; exit 2; }
case "$tier" in staging|prod|all) ;; *) echo "ERROR: --tier must be staging|prod|all" >&2; exit 2 ;; esac
command -v jq >/dev/null || { echo "ERROR: missing dependency: jq" >&2; exit 2; }
[[ -f "$REGISTRY" ]] || { echo "ERROR: registry not found: $REGISTRY" >&2; exit 2; }

# Entry selection + phase classification. Staging-ness comes from the ref's
# item name (environment is encoded in item titles across every vault).
plan_json="$(jq -c --arg p "$project" '
  [.secrets[] | select(.project == $p)
   | . + {staging: ((.ref // "") | test("staging"; "i")),
          phase: (if .provider == "postgres" and ((.ref // "") | test("staging"; "i")) then 1
                  elif .mode == "SELF_MINTED" then 2
                  elif .provider != "postgres" then 3
                  else 4 end)}]
  | sort_by(.phase)' "$REGISTRY")"
count="$(jq 'length' <<< "$plan_json")"
[[ "$count" -gt 0 ]] || { echo "ERROR: no registry entries for project '$project'." >&2; exit 2; }

in_csv() { local needle="$1" csv="$2"; [[ ",$csv," == *",$needle,"* ]]; }

health_gate() { # entry json -> verify every consumer dest registered in health_urls
  local entry="$1" dest url body ok=1
  while IFS= read -r dest; do
    url="$(jq -r --arg d "$dest" '.health_urls[$d] // empty' "$REGISTRY")"
    [[ -n "$url" ]] || continue
    if body="$(curl -sf --max-time 30 "$url")"; then
      if jq -e 'has("databaseRoleSafe")' <<< "$body" >/dev/null 2>&1 \
         && ! jq -e '.status == "ok" and .databaseRoleSafe == true' <<< "$body" >/dev/null; then
        echo "  HEALTH FAIL $dest ($url): $body" >&2; ok=0
      else
        echo "  health ok: $dest"
      fi
    else
      echo "  HEALTH FAIL $dest ($url): unreachable/non-200" >&2; ok=0
    fi
  done < <(jq -r '.consumers[]?.dest' <<< "$entry" | sort -u)
  [[ "$ok" -eq 1 ]]
}

# Filter the plan down to what this invocation actually runs.
run_json="$(jq -c --arg tier "$tier" --arg only "$only" --arg skip "$skip" '
  def incsv($csv): ($csv | split(",")) as $l | . as $x | ($l | index($x)) != null;
  [.[] | select(($only == "" or (.id | incsv($only)))
    and (($skip == "") or ((.id | incsv($skip)) | not))
    and (if $tier == "staging" then .staging
         elif $tier == "prod" then (.staging | not)
         else true end))]' <<< "$plan_json")"
run_count="$(jq 'length' <<< "$run_json")"
skipped=$((count - run_count))
echo "rotate-project $project — $run_count of $count entries (tier=$tier, $skipped filtered out)"

rotate_one() { # entry json, extra flag or ""; logs to $2-named file, returns rotate rc
  local entry="$1" logf="$2" xtra="$3" id ref rc=0
  id="$(jq -r '.id' <<< "$entry")"
  ref="$(jq -r '.ref' <<< "$entry")"
  "$ROTATE" --ref "$ref" --reason "$reason [$id]" --yes ${xtra:+"$xtra"} >> "$logf" 2>&1 || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    health_gate "$entry" >> "$logf" 2>&1 || rc=99
  fi
  return "$rc"
}

manual_complete() { # entry json (provider printed its playbook already)
  local entry="$1" id ref new_value
  id="$(jq -r '.id' <<< "$entry")"
  ref="$(jq -r '.ref' <<< "$entry")"
  if ! { : < /dev/tty; } 2>/dev/null; then
    echo "ERROR: $id needs a manually minted value but there is no controlling terminal." >&2; return 1
  fi
  printf 'Paste the NEW value for %s (input hidden, Enter to submit): ' "$id" > /dev/tty
  IFS= read -rs new_value < /dev/tty; echo > /dev/tty
  [[ -n "$new_value" ]] || { echo "ERROR: empty value — aborting before touching $id." >&2; return 1; }
  printf %s "$new_value" | "$ROTATE" --ref "$ref" --reason "$reason [$id]" --complete || { new_value=""; return 1; }
  new_value=""
  health_gate "$entry"
}

logdir="$(mktemp -d)"
trap 'rm -rf "$logdir"' EXIT
first_staging_pg=1 ran=0 failed=0 idx=0
manual_queue=()

# Phase batches: postgres entries run strictly sequentially (instance advisory
# lock); other entries within one phase run concurrently when their consumer
# dest sets are pairwise disjoint (overlapping services would race deploys).
for phase in 1 2 3 4; do
  phase_json="$(jq -c --argjson ph "$phase" '[.[] | select(.phase == $ph)]' <<< "$run_json")"
  n="$(jq 'length' <<< "$phase_json")"
  [[ "$n" -gt 0 ]] || continue

  if [[ "$phase" -eq 1 || "$phase" -eq 4 ]]; then
    # postgres: sequential
    while IFS= read -r entry; do
      idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
      xtra=""
      if [[ "$phase" -eq 1 && "$first_staging_pg" -eq 1 ]]; then xtra="--keep-old"; first_staging_pg=0; fi
      if [[ "$dry" -eq 1 ]]; then
        echo "[$idx/$run_count] would rotate (sequential): $id${xtra:+ $xtra} -> $(jq -r '.ref' <<< "$entry")"
        continue
      fi
      echo "[$idx/$run_count] rotating (sequential): $id${xtra:+ $xtra}"
      logf="$logdir/$id.log"; : > "$logf"
      rc=0; rotate_one "$entry" "$logf" "$xtra" || rc=$?
      cat "$logf"
      if [[ "$rc" -ne 0 ]]; then
        echo "ERROR: $id failed (rc=$rc) — stopping. Rerun the same command to resume." >&2
        exit 1
      fi
      ran=$((ran + 1))
    done < <(jq -c '.[]' <<< "$phase_json")
  else
    # non-postgres: greedy disjoint-consumer batches
    remaining="$phase_json"
    while [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]]; do
      batch="$(jq -c '
        reduce .[] as $e ({batch: [], used: [], rest: []};
          ($e.consumers // [] | map(.dest)) as $d
          | if ((.used | map(. as $u | $d | index($u)) | map(select(. != null)) | length) == 0)
            then {batch: (.batch + [$e]), used: (.used + $d), rest: .rest}
            else {batch: .batch, used: .used, rest: (.rest + [$e])} end)
        | {batch: .batch, rest: .rest}' <<< "$remaining")"
      remaining="$(jq -c '.rest' <<< "$batch")"
      current="$(jq -c '.batch' <<< "$batch")"
      bn="$(jq 'length' <<< "$current")"
      if [[ "$dry" -eq 1 ]]; then
        while IFS= read -r entry; do
          idx=$((idx + 1))
          echo "[$idx/$run_count] would rotate (parallel x$bn): $(jq -r '.id' <<< "$entry") -> $(jq -r '.ref' <<< "$entry")"
        done < <(jq -c '.[]' <<< "$current")
        continue
      fi
      pids=() ids=() entries=()
      while IFS= read -r entry; do
        idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
        echo "[$idx/$run_count] rotating (parallel x$bn): $id"
        logf="$logdir/$id.log"; : > "$logf"
        rotate_one "$entry" "$logf" "" &
        pids+=($!); ids+=("$id"); entries+=("$entry")
      done < <(jq -c '.[]' <<< "$current")
      i=0
      for pid in "${pids[@]}"; do
        rc=0; wait "$pid" || rc=$?
        id="${ids[$i]}"; entry="${entries[$i]}"
        cat "$logdir/$id.log"
        if [[ "$rc" -eq 3 ]]; then
          echo "  $id: provider needs a manually minted value — queued for the paste phase."
          manual_queue+=("$entry")
        elif [[ "$rc" -ne 0 ]]; then
          echo "ERROR: $id failed (rc=$rc) — see log above." >&2
          failed=$((failed + 1))
        else
          ran=$((ran + 1))
        fi
        i=$((i + 1))
      done
      [[ "$failed" -eq 0 ]] || { echo "ERROR: stopping after parallel batch failures. Rerun to resume." >&2; exit 1; }
    done
  fi

  # Manual-completion queue drains at the end of its phase, one prompt at a time.
  if [[ "${#manual_queue[@]}" -gt 0 && "$dry" -eq 0 ]]; then
    for entry in "${manual_queue[@]}"; do
      manual_complete "$entry" || exit 1
      ran=$((ran + 1))
    done
    manual_queue=()
  fi
done

echo
if [[ "$dry" -eq 1 ]]; then
  echo "dry-run complete: $run_count entries planned."
else
  echo "rotate-project $project complete: $ran rotated+verified, $skipped filtered out."
fi
