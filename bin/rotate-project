#!/usr/bin/env bash
# rotate-project — one-command full rotation sweep for a project.
#
# Runs every rotation entry of the project secrets.yaml through rotate-secret
# (two-stage: rotate → fan-out → deploys live + health → finalize) in a safe
# order:
#
#   1   staging postgres    dest+lock+item-disjoint waves; each entry is rotated,
#                           health-gated, then finalized — except the CANARY (the
#                           first staging postgres entry), whose predecessor stays
#                           valid until the very end of the sweep (rollback window)
#   2a  staging non-postgres  parallel save-only rotations (same 1Password item
#   2b  prod non-postgres     sequential); then ONE deploy per touched service,
#                           deploys live, health, then finalize per entry
#   3   prod postgres       waves, as phase 1 (no canary)
#
# Stops on the first rotation failure. Rerunning the SAME command resumes the
# unfinished sweep from its checkpoint: completed entries are not reminted,
# deferred deploys are retriggered, pending finalizes are retried. A finished
# sweep deletes the checkpoint. --fresh discards a checkpoint (refused while it
# still holds deferred deploys/finalizes). Values never reach stdout or argv.
#
# Two entry actions:
#   ROTATE — the provider mints/stages a NEW credential automatically
#            (postgres, self-minted, configured resend/openai/aws_iam, hook: full).
#   SYNC   — manual / unconfigured providers: push whatever value the 1Password
#            item currently holds to every consumer. To rotate one, update the
#            item in 1Password first, then run the sweep (or --only that entry).
#
# usage:
#   rotate-project <amaru|ts|workflow-pro|autodev> --reason "<why>"
#                  [--dry-run] [--tier staging|prod|all]
#                  [--skip id[,id...]] [--only id[,id...]] [--fresh]
#
# exit codes: 0 all entries rotated+verified, 1 a rotation, deploy, health check
#   or finalize failed (state printed; rerun resumes), 2 usage/config/checkpoint
#   refusal, 3 agent-shell refusal.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../secrets/lib}"
PROVIDERS_DIR="${SECRETS_PROVIDERS_DIR:-$HERE/../secrets/providers}"
ROTATE="${ROTATE_SECRET:-$HERE/rotate-secret}"
SYNC="${SYNC_SECRETS:-$HERE/sync-secrets}"
PG_ROTATOR="${POSTGRES_ROTATE_BIN:-$HERE/../secrets/providers/postgres-rotate}"

# shellcheck source=../secrets/lib/config.sh
source "$SECRETS_LIB/config.sh"
# shellcheck source=../secrets/lib/read.sh
source "$SECRETS_LIB/read.sh"
# shellcheck source=../secrets/lib/render-api.sh
source "$SECRETS_LIB/render-api.sh"
# shellcheck source=../secrets/lib/deploy-wait.sh
source "$SECRETS_LIB/deploy-wait.sh"

usage() { sed -n '2,39p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

repo="" project="" reason="" dry=0 tier="all" skip="" only="" fresh=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) repo="${2:?}"; shift 2 ;;
    --repo=*) repo="${1#*=}"; shift ;;
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --tier) tier="${2:?}"; shift 2 ;;
    --tier=*) tier="${1#*=}"; shift ;;
    --skip) skip="${2:?}"; shift 2 ;;
    --skip=*) skip="${1#*=}"; shift ;;
    --only) only="${2:?}"; shift 2 ;;
    --only=*) only="${1#*=}"; shift ;;
    --fresh) fresh=1; shift ;;
    -h|--help) usage ;;
    -*) echo "ERROR: unknown flag $1" >&2; usage ;;
    *) [[ -z "$project" ]] || usage; project="$1"; shift ;;
  esac
done
[[ -n "$project" ]] || usage
[[ -n "$reason" || "$dry" -eq 1 ]] || { echo "ERROR: --reason is required for a live sweep." >&2; exit 2; }
# This orchestrator resolves sensitive refs itself (the Render API key for
# deploys lives in <PROJECT>-sensitive); the shim needs the reason in the env.
[[ -n "$reason" ]] && export SENSITIVE_ACCESS_REASON="$reason"
case "$tier" in staging|prod|all) ;; *) echo "ERROR: --tier must be staging|prod|all" >&2; exit 2 ;; esac
need jq
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "ERROR: not inside a git repo; pass --repo <path>" >&2; exit 2; }
fi
repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "ERROR: repo path does not exist" >&2; exit 2; }
export _SECRETS_CONFIG="$repo"
REGISTRY="$(config_registry)" || exit 2
export SECRET_ROTATION_CONFIG="$REGISTRY"
config_project="$(jq -r '.secrets[0].project // empty' "$REGISTRY")"
if [[ -n "$config_project" && "$project" != "$config_project" ]]; then
  echo "ERROR: project '$project' requested but $repo belongs to project '$config_project'" >&2
  exit 2
fi
[[ "$dry" -eq 1 ]] || guard_agent_shell || exit 3

# --- output helpers ----------------------------------------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OK=$'\033[32m'; C_ERR=$'\033[31m'; C_RUN=$'\033[36m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
  C_OK=""; C_ERR=""; C_RUN=""; C_DIM=""; C_BOLD=""; C_OFF=""
fi
fmt_dur() { local t="$1"; if [[ "$t" -ge 60 ]]; then printf '%dm%02ds' $((t/60)) $((t%60)); else printf '%ds' "$t"; fi; }
phase_label() { case "$1" in 1) printf 'phase 1' ;; 2) printf 'phase 2a' ;; 3) printf 'phase 2b' ;; 4) printf 'phase 3' ;; esac; }

# --- plan: phase classification + auto (provider file exists && auto_ready) ---
# Staging-ness comes from the ref's item name (environment is encoded in item
# titles across every vault). Phases: 1 staging postgres, 2 staging non-postgres,
# 3 prod non-postgres, 4 prod postgres.
plan_json="$(jq -c --arg p "$project" '
  [.secrets[] | select(.project == $p)
   | ((.ref // "") | test("staging"; "i")) as $st
   | . + {staging: $st,
          phase: (if .provider == "postgres" then (if $st then 1 else 4 end)
                  else (if $st then 2 else 3 end) end)}]
  | sort_by(.phase)' "$REGISTRY")"
count="$(jq 'length' <<< "$plan_json")"
[[ "$count" -gt 0 ]] || { echo "ERROR: no registry entries for project '$project'." >&2; exit 2; }

entry_auto() { # entry json -> rc 0 when the provider can mint this entry automatically
  local entry="$1" provider file
  [[ "$(jq -r '.hook // ""' <<< "$entry")" == "full" ]] && return 0
  provider="$(jq -r '.provider' <<< "$entry")"
  file="$PROVIDERS_DIR/$provider.sh"
  [[ -f "$file" ]] || return 1
  (
    export ROTATE_ENTRY_JSON="$entry"
    ROTATE_ID="$(jq -r '.id' <<< "$entry")"; ROTATE_REF="$(jq -r '.ref' <<< "$entry")"
    ROTATE_PROVIDER="$provider"; ROTATE_PROJECT="$project"
    export ROTATE_ID ROTATE_REF ROTATE_PROVIDER ROTATE_PROJECT
    # shellcheck disable=SC1090
    source "$file" && provider_auto_ready
  ) >/dev/null 2>&1
}
auto_ids='[]'
while IFS= read -r entry; do
  [[ -n "$entry" ]] || continue
  entry_auto "$entry" && auto_ids="$(jq -c --arg id "$(jq -r '.id' <<< "$entry")" '. + [$id]' <<< "$auto_ids")"
done < <(jq -c '.[]' <<< "$plan_json")
plan_json="$(jq -c --argjson auto "$auto_ids" '[.[] | . + {auto: (.id as $id | $auto | index($id) != null)}]' <<< "$plan_json")"

# --only/--skip must name real entries: a typo must never silently narrow a sweep.
validate_ids() { # flag csv
  local flag="$1" csv="$2" id unknown=()
  [[ -n "$csv" ]] || return 0
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    jq -e --arg id "$id" 'any(.[]; .id == $id)' <<< "$plan_json" >/dev/null || unknown+=("$id")
  done < <(tr ',' '\n' <<< "$csv")
  [[ ${#unknown[@]} -eq 0 ]] || {
    echo "ERROR: $flag names unknown rotation id(s): ${unknown[*]}" >&2
    echo "Known ids: $(jq -r '[.[].id] | join(" ")' <<< "$plan_json")" >&2
    exit 2
  }
}
validate_ids --only "$only"
validate_ids --skip "$skip"

run_json="$(jq -c --arg tier "$tier" --arg only "$only" --arg skip "$skip" '
  def incsv($csv): ($csv | split(",")) as $l | . as $x | ($l | index($x)) != null;
  [.[] | select(($only == "" or (.id | incsv($only)))
    and (($skip == "") or ((.id | incsv($skip)) | not))
    and (if $tier == "staging" then .staging
         elif $tier == "prod" then (.staging | not)
         else true end))]' <<< "$plan_json")"
run_count="$(jq 'length' <<< "$run_json")"
skipped=$((count - run_count))
[[ "$run_count" -gt 0 ]] || { echo "ERROR: the selection (tier=$tier only='$only' skip='$skip') matches no entries." >&2; exit 2; }

# Stamp postgres entries with lockKey (admin project/tier of the physical box,
# from the rotator — the single source of that derivation) and renderDests, so
# the postgres phases can run disjoint groups in parallel. Any failure is fatal:
# a silently unknown lock would either serialize everything or race two
# rotations on one instance.
annotate_postgres_keys() {
  local annotated='[]' entry id provider key dests
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    provider="$(jq -r '.provider' <<< "$entry")"
    key=""
    if [[ "$provider" == "postgres" ]]; then
      id="$(jq -r '.id' <<< "$entry")"
      [[ -x "$PG_ROTATOR" ]] || { echo "ERROR: postgres rotator not found: $PG_ROTATOR" >&2; return 1; }
      key="$(ROTATE_ENTRY_JSON="$entry" ROTATE_ID="$id" ROTATE_REF="$(jq -r '.ref' <<< "$entry")" \
             ROTATE_PROVIDER=postgres ROTATE_PROJECT="$project" "$PG_ROTATOR" --print-lock-key)" \
        || { echo "ERROR: could not derive the instance lock key for $id (postgres-rotate --print-lock-key failed)" >&2; return 1; }
      [[ -n "$key" ]] || { echo "ERROR: empty lock key for $id" >&2; return 1; }
    fi
    dests="$(jq -c '[.consumers[]?.dest | select(test("^(srv|crn)-"))] | unique' <<< "$entry")"
    annotated="$(jq -c --argjson e "$entry" --arg k "$key" --argjson d "$dests" \
      '. + [$e + {lockKey: $k, renderDests: $d}]' <<< "$annotated")"
  done < <(jq -c '.[]' <<< "$run_json")
  run_json="$annotated"
}
annotate_postgres_keys || exit 2
ALL_JSON="$run_json"   # annotated, unfiltered: lookups for ids completed by earlier runs

# --- waves ---------------------------------------------------------------------
# Entries whose refs live in the SAME 1Password item never run concurrently
# (each edit replaces the whole item; parallel writers race on the version).
# Postgres entries additionally stay sequential when they share a Render dest
# (overlapping exact deploys) or the instance advisory lock.
compute_waves() { # $1 = json array of annotated entries, $2 = postgres(0|1) -> json array of waves
  local remaining="$1" pg="$2" waves='[]' split
  while [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]]; do
    split="$(jq -c --argjson pg "$pg" '
      def items: ([.ref] + (.sync_refs // [])) | map(select(startswith("op://")) | sub("^op://"; "") | sub("/[^/]*$"; ""));
      . as $all
      | reduce range(0; length) as $i ({citem: [], cdest: [], clock: [], now: [], later: []};
          . as $acc
          | ($all[$i] | items) as $mine
          | ($all[$i] | .renderDests // []) as $d
          | ($all[$i] | .lockKey // "") as $k
          | (
              ($mine | any(. as $x | $acc.citem | index($x) != null))
              or ($pg == 1 and ($d | any(. as $x | $acc.cdest | index($x) != null)))
              or ($pg == 1 and $k != "" and ($acc.clock | index($k) != null))
            ) as $conflict
          | if $conflict then $acc | .later += [$all[$i]]
            else $acc | .now += [$all[$i]] | .citem += $mine | .cdest += $d
                 | (if $k != "" then .clock += [$k] else . end)
            end)
      | {now: .now, later: .later}' <<< "$remaining")"
    waves="$(jq -c --argjson w "$(jq -c '.now' <<< "$split")" '. + [$w]' <<< "$waves")"
    remaining="$(jq -c '.later' <<< "$split")"
  done
  printf '%s\n' "$waves"
}
# Waves are computed ONCE per phase; the dry-run prints exactly what a live
# run executes.
WAVES_1="$(compute_waves "$(jq -c '[.[] | select(.phase == 1)]' <<< "$run_json")" 1)"
WAVES_2="$(compute_waves "$(jq -c '[.[] | select(.phase == 2)]' <<< "$run_json")" 0)"
WAVES_3="$(compute_waves "$(jq -c '[.[] | select(.phase == 3)]' <<< "$run_json")" 0)"
WAVES_4="$(compute_waves "$(jq -c '[.[] | select(.phase == 4)]' <<< "$run_json")" 1)"
waves_for_phase() { case "$1" in 1) printf '%s' "$WAVES_1" ;; 2) printf '%s' "$WAVES_2" ;; 3) printf '%s' "$WAVES_3" ;; 4) printf '%s' "$WAVES_4" ;; esac; }
wave_labels() { # phase -> {id: "phase X · wave i/n · parallel xN"}
  jq -c --arg ph "$(phase_label "$1")" '
    . as $waves | ($waves | length) as $n
    | [range(0; $n) as $i
       | ($waves[$i] | length) as $bn
       | $waves[$i][]
       | {key: .id,
          value: ($ph + " · wave \($i+1)/\($n)" + (if $bn > 1 then " · parallel x\($bn)" else "" end))}]
    | from_entries' <<< "$(waves_for_phase "$1")"
}
# The canary is the first entry of the first staging-postgres wave, fixed at
# plan time (never reassigned; a resumed sweep keeps the checkpointed ref).
PLAN_CANARY_REF="$(jq -r '.[0][0].ref // empty' <<< "$WAVES_1")"

echo "${C_BOLD}rotate-project $project${C_OFF} — $run_count of $count entries ${C_DIM}(tier=$tier, $skipped filtered out)${C_OFF}"

# --- dry-run: render the full plan (credential-free) and exit ----------------
if [[ "$dry" -eq 1 ]]; then
  labels="$(jq -n -c --argjson a "$(wave_labels 1)" --argjson b "$(wave_labels 2)" \
                     --argjson c "$(wave_labels 3)" --argjson d "$(wave_labels 4)" '$a + $b + $c + $d')"
  render_plan_section() { # title, color, entries json
    local title="$1" color="$2" entries="$3" n entry id provider staging how ref dest env label host plan hookm tierlabel kind src disabled
    n="$(jq 'length' <<< "$entries")"
    [[ "$n" -gt 0 ]] || return 0
    echo
    echo "${color}${C_BOLD}${title} (${n})${C_OFF}"
    while IFS= read -r entry; do
      id="$(jq -r '.id' <<< "$entry")"
      provider="$(jq -r '.provider' <<< "$entry")"
      staging="$(jq -r '.staging' <<< "$entry")"
      ref="$(jq -r '.ref' <<< "$entry")"
      how="$(jq -r --arg id "$id" '.[$id] // ""' <<< "$labels")"
      tierlabel="prod"; [[ "$staging" == "true" ]] && tierlabel="staging"
      hookm="$(jq -r '.hook // ""' <<< "$entry")"
      if [[ "$hookm" == "full" ]]; then
        plan="repo hook owns the rotation (see hook line) → engine fan-out re-syncs consumers → deploys live + health"
      elif [[ "$provider" == "postgres" ]]; then
        if [[ "$ref" == "$PLAN_CANARY_REF" ]]; then
          plan="stage new versioned DB login → deploy → health-gate; keep predecessor as rollback (canary), retired after the sweep succeeds"
        else
          plan="stage new versioned DB login → deploy → health-gate → finalize: drain + retire predecessor"
        fi
      elif [[ "$(jq -r '.auto' <<< "$entry")" == "true" ]]; then
        if [[ "$provider" == "self_minted" ]]; then
          plan="mint $(jq -r '(.generate.format // "hex") + "/" + ((.generate.bytes // 32)|tostring)' <<< "$entry") automatically → save to consumers → one deploy per service → live + health → finalize"
        else
          plan="mint a new credential at $provider (predecessor stays valid) → save to consumers → one deploy per service → live + health → finalize retires the predecessor"
        fi
      else
        plan="SYNC the item's current 1Password value → consumers → one deploy per service (update the item in 1Password first to rotate it)"
      fi
      echo "  ${C_BOLD}${id}${C_OFF} ${C_DIM}${provider} · ${tierlabel} · ${how}${C_OFF}"
      disabled="$(jq -r '.disabled_reason // ""' <<< "$entry")"
      [[ -z "$disabled" ]] || echo "    ${C_ERR}DISABLED${C_OFF} ${C_DIM}$disabled${C_OFF}"
      echo "    ${C_DIM}plan${C_OFF}  $plan"
      if [[ -n "$hookm" ]]; then
        local hook_repo hook_bin
        hook_repo="$(config_repo_path "$(jq -r '.owner_repo // ""' <<< "$entry")" 2>/dev/null || printf '%s' "$repo")"
        hook_bin="$hook_repo/scripts/secrets/rotate-hook"
        if [[ -x "$hook_bin" ]]; then
          if [[ "$hookm" == "full" ]]; then
            echo "    ${C_RUN}hook${C_OFF}  ${C_DIM}rotation delegated to $hook_bin${C_OFF}"
          else
            echo "    ${C_RUN}hook${C_OFF}  ${C_DIM}repo-specific activation via $hook_bin (runs inside the rotation window)${C_OFF}"
          fi
          ROTATE_ENTRY_JSON="$entry" "$hook_bin" plan 2>/dev/null | sed "s/^/    ${C_DIM}      /;s/\$/${C_OFF}/" || true
        else
          echo "    ${C_ERR}hook MISSING${C_OFF} ${C_DIM}entry declares hook: $hookm but $hook_bin is absent — rotate-secret will refuse${C_OFF}"
        fi
      fi
      # Every map row comes from the routes that share the entry's ref(s) —
      # derived, never restated, so it can neither under- nor over-report.
      while IFS=$'\t' read -r kind dest env src; do
        [[ -n "$dest" ]] || continue
        case "$kind" in
          render)
            host="$(jq -r --arg d "$dest" '.health_urls[$d] // empty' "$REGISTRY" | sed -E '/^deploy-only$/d; s#https?://##; s#/.*##')"
            label="render:${host:-$dest}" ;;
          *) label="$kind:$dest" ;;
        esac
        printf '    %bmap%b   %b%s%b  %b→%b  %s  %b%s%b\n' \
          "$C_DIM" "$C_OFF" "$C_RUN" "$src" "$C_OFF" "$C_DIM" "$C_OFF" "$label" "$C_BOLD" "$env" "$C_OFF"
      done < <(jq -r '.routes[]? | [.kind, .dest, .env, .ref] | @tsv' <<< "$entry")
      echo
    done < <(jq -c '.[]' <<< "$entries")
  }
  render_plan_section "ROTATE — new credentials minted automatically" "$C_OK" "$(jq -c '[.[] | select(.auto)]' <<< "$run_json")"
  render_plan_section "SYNC — pushes the current 1Password value to consumers" "$C_RUN" "$(jq -c '[.[] | select(.auto | not)]' <<< "$run_json")"
  echo

  # ── preflight: verify every op:// field the sweep will READ actually exists.
  # Item metadata only (field labels) — no values are read or printed. Vaults
  # without a silent credential route (*-sensitive, Touch ID) are reported as
  # unchecked rather than prompting during a dry run. ROTATE_PREFLIGHT=0 skips.
  if [[ "${ROTATE_PREFLIGHT:-1}" == "1" ]]; then
    db_roles="${DB_ROLES_CONFIG:-$HERE/../config/db-roles.json}"
    admin_vault="" admin_vault_sensitive="" admin_root_staging="" admin_root_prod=""
    if [[ -f "$db_roles" ]]; then
      admin_vault="$(jq -r --arg p "$project" '.projects[$p].vault // empty' "$db_roles")"
      admin_vault_sensitive="$(jq -r --arg p "$project" '.projects[$p].vault_sensitive // empty' "$db_roles")"
      admin_root_staging="$(jq -r --arg p "$project" '.projects[$p].admin_refs.staging.root // empty' "$db_roles")"
      admin_root_prod="$(jq -r --arg p "$project" '.projects[$p].admin_refs.prod.root // empty' "$db_roles")"
    fi
    [[ -n "$admin_root_staging" || -z "$admin_vault" ]] || admin_root_staging="op://$admin_vault/Postgres staging/root"
    [[ -n "$admin_root_prod" || -z "$admin_vault_sensitive" ]] || admin_root_prod="op://$admin_vault_sensitive/Postgres prod/root"
    # every ref the run touches: entry ref, sync_refs, provider config refs,
    # route refs — plus the postgres control root ref per tier.
    needed="$(jq -r --arg rs "$admin_root_staging" --arg rp "$admin_root_prod" '
      [.[] | ( [.ref] + (.sync_refs // [])
              + [(.config.secret_ref // empty)]
              + [(.routes // [])[].ref]
              + (if .provider == "postgres" then
                   [ (if .staging then $rs else $rp end) | select(. != "") ]
                 else [] end) )[] ]
      | map(select(type == "string" and startswith("op://"))) | unique | .[]' <<< "$run_json")"
    pf_fail=0 pf_checked=0 pf_unchecked=0
    while IFS= read -r vault_item; do
      [[ -n "$vault_item" ]] || continue
      pf_vault="${vault_item%%/*}"; pf_item="${vault_item#*/}"
      pf_fields="$(printf '%s\n' "$needed" | awk -F/ -v v="$pf_vault" -v i="$pf_item" \
        '{ rest=substr($0,6); vv=rest; sub("/.*","",vv); it=rest; sub("^[^/]*/","",it); f=it; sub("/[^/]*$","",it); sub(".*/","",f); if (vv==v && it==i) print f }' | sort -u)"
      if [[ "$pf_vault" == *-sensitive ]]; then
        pf_unchecked=$((pf_unchecked+1))
        echo "  ${C_DIM}preflight: $pf_vault/$pf_item — unchecked (Touch ID vault; verified at run time)${C_OFF}"
        continue
      fi
      if ! pf_json="$("${OP_BIN:-$HERE/op}" item get "$pf_item" --vault "$pf_vault" --format json 2>/dev/null)"; then
        echo "  ${C_ERR}preflight FAIL: item '$pf_vault/$pf_item' is missing or unreadable${C_OFF}" >&2
        pf_fail=1; continue
      fi
      pf_have="$(printf '%s' "$pf_json" | jq -r '[.fields[].label] | join("\n")')"
      pf_json=""
      while IFS= read -r pf_f; do
        [[ -n "$pf_f" ]] || continue
        if ! grep -qxF "$pf_f" <<< "$pf_have"; then
          echo "  ${C_ERR}preflight FAIL: '$pf_vault/$pf_item' has no field '$pf_f'${C_OFF}" >&2
          pf_fail=1
        fi
      done <<< "$pf_fields"
      pf_checked=$((pf_checked+1))
    done < <(printf '%s\n' "$needed" | sed 's|^op://||; s|/[^/]*$||' | sort -u)
    echo
    if [[ "$pf_fail" -eq 1 ]]; then
      echo "${C_ERR}${C_BOLD}✗ PREFLIGHT FAIL${C_OFF}${C_ERR} — a live sweep would stop on the missing refs above.${C_OFF}" >&2
      exit 1
    fi
    echo "${C_OK}${C_BOLD}✓ PREFLIGHT PASS${C_OFF} ${C_DIM}— $pf_checked item(s) verified by field name; $pf_unchecked Touch-ID item(s) unchecked (verified at run time). No values were read.${C_OFF}"
  fi
  echo "${C_DIM}dry-run: nothing was written anywhere; no secret values were read.${C_OFF}"
  exit 0
fi

# --- sweep checkpoint ------------------------------------------------------------
# Unfinished runs persist completed/minted entry ids, deferred deploy dests,
# pending finalizes, the canary ref and the selection, so a rerun resumes
# exactly. Value-free (ids and service ids only). The pending lists live in
# files under the run's log dir (children append to them); the checkpoint is
# always written from those files.
SWEEP_STATE_DIR="${ROTATE_PROJECT_STATE_DIR:-$HOME/.local/state/agent-workflows/rotate-project}"
SWEEP_STATE="$SWEEP_STATE_DIR/${project}.state"
logdir="$SWEEP_STATE_DIR/$project/logs/$(date +%Y%m%dT%H%M%S)-$$"
mkdir -p "$logdir" && chmod 700 "$SWEEP_STATE_DIR" "$SWEEP_STATE_DIR/$project" "$SWEEP_STATE_DIR/$project/logs" "$logdir"
PENDING_DESTS="$logdir/pending-dests"
PENDING_FINALIZE="$logdir/pending-finalize"
: > "$PENDING_DESTS"; : > "$PENDING_FINALIZE"
# One sweep id + inventory cache for every rotate-secret of this run: the
# postgres finalize inventory scan is proven clean once per sweep, not once per
# entry (rotate-secret passes both through to the rotator).
ROTATE_SWEEP_ID="$(basename "$logdir")"
ROTATE_INVENTORY_CACHE_DIR="$logdir/inventory-cache"
export ROTATE_SWEEP_ID ROTATE_INVENTORY_CACHE_DIR
# A confirmed live sweep: the prod prefect tier of sync-secrets must not prompt.
export SECRETS_ASSUME_YES=1
COMPLETED_IDS=()
MINTED_IDS=()
CANARY_REF=""
sweep_ids_json() { if [[ $# -eq 0 ]]; then printf '[]\n'; else jq -n '$ARGS.positional' --args -- "$@"; fi; }
file_ids_json() { if [[ -s "$1" ]]; then sort -u "$1" | grep . | jq -R . | jq -s -c .; else printf '[]\n'; fi; }
sweep_state_save() {
  jq -n -c --arg p "$project" --arg t "$tier" --arg o "$only" --arg s "$skip" --arg c "$CANARY_REF" \
    --argjson completed "$(sweep_ids_json ${COMPLETED_IDS[@]+"${COMPLETED_IDS[@]}"})" \
    --argjson minted "$(sweep_ids_json ${MINTED_IDS[@]+"${MINTED_IDS[@]}"})" \
    --argjson pendingDests "$(file_ids_json "$PENDING_DESTS")" \
    --argjson pendingFinalize "$(file_ids_json "$PENDING_FINALIZE")" \
    '{stateVersion:2, project:$p, selection:{tier:$t, only:$o, skip:$s}, canaryRef:$c,
      completed:$completed, minted:$minted, pendingDests:$pendingDests, pendingFinalize:$pendingFinalize}' \
    > "$SWEEP_STATE.tmp"
  chmod 600 "$SWEEP_STATE.tmp" && mv "$SWEEP_STATE.tmp" "$SWEEP_STATE"
}
sweep_state_load() {
  local json sel
  [[ -f "$SWEEP_STATE" ]] || return 0
  json="$(cat "$SWEEP_STATE")" || return 1
  jq -e --arg p "$project" '.stateVersion == 2 and .project == $p' <<< "$json" >/dev/null || {
    echo "ERROR: sweep checkpoint $SWEEP_STATE is malformed, from an older engine, or for another project — inspect and remove it by hand." >&2
    return 1
  }
  if [[ "$fresh" -eq 1 ]]; then
    local nd nf
    nd="$(jq '.pendingDests | length' <<< "$json")"; nf="$(jq '.pendingFinalize | length' <<< "$json")"
    if [[ "$nd" -gt 0 || "$nf" -gt 0 ]]; then
      echo "ERROR: --fresh refused: the checkpoint still holds $nd deferred deploy(s) and $nf pending finalize(s)." >&2
      echo "       Rerun WITHOUT --fresh (same selection) to drain them first; then --fresh starts over." >&2
      return 1
    fi
    rm -f "$SWEEP_STATE"
    echo "${C_DIM}--fresh: discarded unfinished sweep checkpoint${C_OFF}"
    return 0
  fi
  sel="$(jq -r '.selection | "tier=\(.tier) only=\(.only) skip=\(.skip)"' <<< "$json")"
  if [[ "$sel" != "tier=$tier only=$only skip=$skip" ]]; then
    echo "ERROR: the unfinished sweep checkpoint was created with a different selection ($sel);" >&2
    echo "       rerun with that selection to resume it, or --fresh to discard it." >&2
    return 1
  fi
  while IFS= read -r x; do [[ -n "$x" ]] && COMPLETED_IDS+=("$x"); done < <(jq -r '.completed[]?' <<< "$json")
  while IFS= read -r x; do [[ -n "$x" ]] && MINTED_IDS+=("$x"); done < <(jq -r '.minted[]?' <<< "$json")
  jq -r '.pendingDests[]?' <<< "$json" > "$PENDING_DESTS"
  jq -r '.pendingFinalize[]?' <<< "$json" > "$PENDING_FINALIZE"
  CANARY_REF="$(jq -r '.canaryRef // empty' <<< "$json")"
}
sweep_mark_completed() { COMPLETED_IDS+=("$1"); sweep_state_save; }
sweep_mark_minted() { # id, entry json — the entry's Render dests become deferred deploys
  MINTED_IDS+=("$1")
  jq -r '.renderDests[]?' <<< "$2" >> "$PENDING_DESTS"
  sweep_state_save
}
sweep_promote_minted() {
  local x
  for x in "${MINTED_IDS[@]-}"; do [[ -n "$x" ]] && COMPLETED_IDS+=("$x"); done
  MINTED_IDS=()
  sweep_state_save
}
pending_finalize_add() { printf '%s\n' "$1" >> "$PENDING_FINALIZE"; sweep_state_save; }
pending_finalize_remove() { local tmp="$PENDING_FINALIZE.tmp"; grep -vxF "$1" "$PENDING_FINALIZE" > "$tmp" || true; mv "$tmp" "$PENDING_FINALIZE"; sweep_state_save; }

log_highlights() { # concise facts pulled from a full entry log
  grep -E '^\s*(vault: updated|vault: created op|db: retired|drain: predecessor|render\[[^]]*\] deploy |minted new|health ok:|finalize)' "$1" \
    | sed -E 's/^ */    /' | sort -u | head -6 || true
}
# ROTATE entries mint a new credential; SYNC entries only push the value the
# vault already holds — rendering both as a bare ✓ let "nothing was rotated"
# read as "rotated".
entry_ok() { # id, seconds, logf, kind(rotated|synced)
  if [[ "${4:-rotated}" == "synced" ]]; then
    echo "${C_OK}≡${C_OFF} ${C_BOLD}$1${C_OFF} ${C_DIM}($(fmt_dur "$2")) — synced only, credential NOT rotated${C_OFF}"
  else
    echo "${C_OK}✓${C_OFF} ${C_BOLD}$1${C_OFF} ${C_DIM}($(fmt_dur "$2"))${C_OFF}"
  fi
  log_highlights "$3"
}
entry_fail() { # id, rc, seconds, logf
  echo "${C_ERR}✗ ${C_BOLD}$1${C_OFF}${C_ERR} failed (rc=$2, $(fmt_dur "$3"))${C_OFF}"
  echo "${C_DIM}  ── last log lines ──${C_OFF}"
  tail -12 "$4" | sed 's/^/  /'
  echo "${C_DIM}  full log: $4${C_OFF}"
}
entry_kind() { if [[ "$(jq -r '.auto' <<< "$1")" == "true" ]]; then printf 'rotated'; else printf 'synced'; fi; }

RESULT_IDS=(); RESULT_STATES=(); RESULT_TIMES=(); RESULT_KINDS=()
record_result() { RESULT_IDS+=("$1"); RESULT_STATES+=("$2"); RESULT_TIMES+=("$3"); RESULT_KINDS+=("${4:-rotated}"); }

summary_and_exit() { # exit code
  local code="$1" i=0 state kind mark note total=$SECONDS rotated_n=0 synced_n=0 pending
  echo
  echo "${C_BOLD}── rotate-project $project summary ──${C_OFF}"
  for id in "${RESULT_IDS[@]-}"; do
    [[ -n "$id" ]] || continue
    state="${RESULT_STATES[$i]}"; kind="${RESULT_KINDS[$i]}"; note=""
    if [[ "$state" != "ok" ]]; then
      mark="${C_ERR}✗${C_OFF}"
    elif [[ "$kind" == "synced" ]]; then
      mark="${C_OK}≡${C_OFF}"; note="  ${C_DIM}synced only — credential NOT rotated${C_OFF}"; synced_n=$((synced_n + 1))
    else
      mark="${C_OK}✓${C_OFF}"; rotated_n=$((rotated_n + 1))
    fi
    printf '  %b %-45s %s%b\n' "$mark" "$id" "$(fmt_dur "${RESULT_TIMES[$i]}")" "$note"
    i=$((i + 1))
  done
  pending="$(sort -u "$PENDING_FINALIZE" | grep . || true)"
  if [[ -n "$pending" ]]; then
    echo "  ${C_ERR}${C_BOLD}predecessor cleanup pending${C_OFF} ${C_DIM}for:${C_OFF} $(tr '\n' ' ' <<< "$pending")"
    echo "  ${C_DIM}those rotations are complete; rerun the same command to retry their finalize step (or rotate-secret --finalize per entry)${C_OFF}"
  fi
  if [[ "$code" -eq 0 && -n "$pending" ]]; then
    sweep_state_save
    code=1
  elif [[ "$code" -eq 0 ]]; then
    rm -f "$SWEEP_STATE"
    local synced_note=""
    [[ "$synced_n" -gt 0 ]] && synced_note=", ${C_BOLD}$synced_n synced only${C_OFF}"
    echo "  ${C_OK}${C_BOLD}$rotated_n rotated+verified${C_OFF}${synced_note} ${C_DIM}in $(fmt_dur "$total") ($skipped filtered out)${C_OFF}"
    [[ "$synced_n" -eq 0 ]] || echo "  ${C_DIM}synced entries pushed the value the vault already held; rotate them at their source (see each entry's playbook).${C_OFF}"
  else
    sweep_state_save
    echo "  ${C_ERR}${C_BOLD}stopped after a failure${C_OFF} ${C_DIM}— rerun the same command to resume (completed entries are not reminted)${C_OFF}"
  fi
  echo "  ${C_DIM}logs: $logdir${C_OFF}"
  exit "$code"
}

# --- per-entry runners (each runs in a background subshell; rc = outcome) -----
# rotate-secret --finalize outcome: 0 done, 6 predecessor cleanup still pending
# (non-fatal: recorded, retried by the next run), anything else is a failure.
finalize_entry() { # id ref logf -> rc 0 (done or pending-recorded) | other
  local id="$1" ref="$2" logf="$3" rc=0
  "$ROTATE" --repo "$repo" --ref "$ref" --reason "$reason [$id finalize]" --yes --finalize >> "$logf" 2>&1 || rc=$?
  case "$rc" in
    0) return 0 ;;
    6) echo "  finalize pending for $id (predecessor still valid; retried on the next run)" >> "$logf"
       touch "$logdir/$id.finalize-pending"; return 0 ;;
    *) return "$rc" ;;
  esac
}

rotate_postgres_entry() { # entry json, logf: rotate (--no-finalize) → health gate → finalize (not for the canary)
  local entry="$1" logf="$2" id ref rc=0
  id="$(jq -r '.id' <<< "$entry")"; ref="$(jq -r '.ref' <<< "$entry")"
  "$ROTATE" --repo "$repo" --ref "$ref" --reason "$reason [$id]" --yes --resume --no-finalize >> "$logf" 2>&1 || return $?
  health_gate "$entry" >> "$logf" 2>&1 || return 99
  if [[ "$ref" == "$CANARY_REF" ]]; then
    echo "  canary: predecessor kept as the sweep's rollback window (finalized at the end)" >> "$logf"
    return 0
  fi
  finalize_entry "$id" "$ref" "$logf"
}

sync_entry() { # entry json, logf: push the CURRENT vault value(s); own repo save-only, cross-project repos deploy themselves
  local entry="$1" logf="$2" id ref r rc=0
  local repos=("$repo") rels=()
  id="$(jq -r '.id' <<< "$entry")"
  while IFS= read -r r; do [[ -n "$r" ]] && rels+=("$r"); done < <(jq -r '(.sync_repos // [])[]' <<< "$entry")
  if [[ ${#rels[@]} -gt 0 ]]; then
    while IFS= read -r r; do [[ -n "$r" ]] && repos+=("$r"); done < <(config_sync_repos "${rels[@]}")
  fi
  while IFS= read -r ref; do
    [[ -n "$ref" ]] || continue
    for r in "${repos[@]}"; do
      if [[ "$r" == "$repo" ]]; then
        "$SYNC" --repo "$r" --changed "$ref" --reason "$reason [$id]" --no-deploy >> "$logf" 2>&1 || rc=$?
      else
        "$SYNC" --repo "$r" --changed "$ref" --reason "$reason [$id]" >> "$logf" 2>&1 || rc=$?
      fi
    done
  done < <(jq -r '(.sync_refs // [.ref]) | .[]' <<< "$entry")
  return "$rc"
}

rotate_batched_entry() { # entry json, logf: auto entry, save-only; deploy + finalize happen per phase
  local entry="$1" logf="$2" id ref
  id="$(jq -r '.id' <<< "$entry")"; ref="$(jq -r '.ref' <<< "$entry")"
  ROTATE_NO_DEPLOY=1 "$ROTATE" --repo "$repo" --ref "$ref" --reason "$reason [$id]" --yes --resume --no-finalize >> "$logf" 2>&1
}

rotate_standalone_entry() { # entry json, logf: auto entry with cross-project sync_repos — rotate-secret deploys, waits and finalizes itself
  local entry="$1" logf="$2" id ref rc=0
  id="$(jq -r '.id' <<< "$entry")"; ref="$(jq -r '.ref' <<< "$entry")"
  "$ROTATE" --repo "$repo" --ref "$ref" --reason "$reason [$id]" --yes --resume >> "$logf" 2>&1 || rc=$?
  if [[ "$rc" -eq 6 ]]; then
    echo "  finalize pending for $id (predecessor still valid; retried on the next run)" >> "$logf"
    touch "$logdir/$id.finalize-pending"; rc=0
  fi
  return "$rc"
}

# Deploy every service touched by the batched saves exactly once (request-
# correlated deploy ids), wait for each to go live, then health-check it.
deploy_pending() {
  local sids nsids sid pid url ok=1 deploys="$logdir/deploys.tsv"
  local pids=()
  sids="$(sort -u "$PENDING_DESTS" | grep . || true)"
  [[ -n "$sids" ]] || return 0
  nsids="$(printf '%s\n' "$sids" | grep -c .)"
  echo
  echo "${C_RUN}⟳${C_OFF} ${C_BOLD}all values saved — deploying $nsids service(s)${C_OFF}"
  render_key_once "$repo" || return 1
  : > "$deploys"
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    ( id="$(render_trigger_deploy_id "$sid")" || exit 1
      printf '%s\t%s\n' "$sid" "$id" > "$logdir/deploy.$sid"
      echo "  render[$sid] deploy triggered ($id)" ) &
    pids+=($!)
  done <<< "$sids"
  for pid in "${pids[@]}"; do wait "$pid" || ok=0; done
  [[ "$ok" -eq 1 ]] || { echo "${C_ERR}✗ a deploy trigger failed — dests stay deferred; rerun to retry${C_OFF}" >&2; return 1; }
  cat "$logdir"/deploy.* > "$deploys"
  echo "${C_DIM}  waiting for every deploy to go live (nothing is done until this passes)…${C_OFF}"
  deploy_wait_all "$deploys" || { echo "${C_ERR}✗ a deploy did not go live — dests stay deferred; rerun to retry${C_OFF}" >&2; return 1; }
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    url="$(jq -r --arg d "$sid" '.health_urls[$d] // empty' "$REGISTRY")"
    [[ "$url" == "deploy-only" ]] && url=""
    if [[ -z "$url" ]]; then
      echo "${C_OK}✓${C_OFF} $sid ${C_DIM}live — no health URL registered${C_OFF}"
    elif curl -sf --max-time 30 "$url" >/dev/null; then
      echo "${C_OK}✓${C_OFF} $sid ${C_DIM}live + healthy${C_OFF}"
    else
      echo "${C_ERR}✗ $sid live but health check failed ($url)${C_OFF}" >&2; ok=0
    fi
  done <<< "$sids"
  [[ "$ok" -eq 1 ]] || return 1
  : > "$PENDING_DESTS"
  rm -f "$logdir"/deploy.*
  sweep_state_save
}

# After the batched deploys are proven: finalize every minted auto entry
# (rc 6 → pending, retried later), then promote minted → completed.
finalize_minted() {
  local id entry ref rc=0 logf
  for id in "${MINTED_IDS[@]-}"; do
    [[ -n "$id" ]] || continue
    entry="$(jq -c --arg id "$id" '.[] | select(.id == $id)' <<< "$ALL_JSON")"
    [[ -n "$entry" && "$(jq -r '.auto' <<< "$entry")" == "true" ]] || continue
    ref="$(jq -r '.ref' <<< "$entry")"
    logf="$logdir/$id.log"
    if finalize_entry "$id" "$ref" "$logf"; then
      if [[ -e "$logdir/$id.finalize-pending" ]]; then
        pending_finalize_add "$id"
        echo "${C_ERR}!${C_OFF} $id ${C_DIM}finalize pending (predecessor still valid)${C_OFF}"
      else
        echo "${C_OK}✓${C_OFF} $id ${C_DIM}finalized (predecessor retired)${C_OFF}"
      fi
    else
      rc=$?
      echo "${C_ERR}✗ $id finalize failed (rc=$rc)${C_OFF}"; tail -8 "$logf" | sed 's/^/  /'
      return 1
    fi
  done
  sweep_promote_minted
}

retry_pending_finalizes() { # ids left by a previous run (rc 6): retry, keep the still-pending ones
  local id ref entry logf rc
  [[ -s "$PENDING_FINALIZE" ]] || return 0
  echo "${C_RUN}⟳${C_OFF} ${C_BOLD}retrying pending finalizes${C_OFF}"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    entry="$(jq -c --arg id "$id" '.secrets[] | select(.id == $id)' "$REGISTRY")"
    ref="$(jq -r '.ref' <<< "$entry")"
    logf="$logdir/$id.finalize.log"; : > "$logf"
    rm -f "$logdir/$id.finalize-pending"
    if finalize_entry "$id" "$ref" "$logf"; then
      if [[ -e "$logdir/$id.finalize-pending" ]]; then
        echo "${C_ERR}!${C_OFF} $id ${C_DIM}finalize still pending${C_OFF}"
      else
        pending_finalize_remove "$id"
        echo "${C_OK}✓${C_OFF} $id ${C_DIM}finalized (predecessor retired)${C_OFF}"
      fi
    else
      rc=$?
      echo "${C_ERR}✗ $id finalize failed (rc=$rc)${C_OFF}"; tail -8 "$logf" | sed 's/^/  /'
      return 1
    fi
  done < <(sort -u "$PENDING_FINALIZE")
}

finalize_canary() {
  # The canary kept one predecessor login valid as the sweep's rollback
  # window. Once every entry succeeded there is nothing to roll back to, so
  # retire it (idempotent: no finalize-state → "nothing to finalize").
  [[ -n "$CANARY_REF" ]] || return 0
  local id logf
  id="$(jq -r --arg r "$CANARY_REF" '.secrets[] | select(.ref == $r) | .id' "$REGISTRY")"
  echo "${C_RUN}⟳${C_OFF} finalizing canary $id ${C_DIM}(retiring the kept predecessor login)${C_OFF}"
  logf="$logdir/canary-finalize.log"; : > "$logf"
  if finalize_entry "$id" "$CANARY_REF" "$logf"; then
    if [[ -e "$logdir/$id.finalize-pending" ]]; then
      pending_finalize_add "$id"
      echo "${C_ERR}!${C_OFF} canary finalize pending ${C_DIM}(predecessor login remains valid; retried on the next run)${C_OFF}"
    else
      echo "${C_OK}✓${C_OFF} canary predecessor retired"
    fi
  else
    echo "${C_ERR}✗ canary finalize failed — predecessor login remains valid (safe).${C_OFF}"
    tail -8 "$logf" | sed 's/^/  /'
    return 1
  fi
}

# --- live sweep -----------------------------------------------------------------
sweep_state_load || exit 2
failed=0 idx=0
if [[ -s "$PENDING_DESTS" ]]; then
  echo "${C_RUN}⟳${C_OFF} ${C_BOLD}resuming${C_OFF} ${C_DIM}retrying $(sort -u "$PENDING_DESTS" | grep -c .) deferred deploy(s); already-minted secrets will not be reminted${C_OFF}"
  deploy_pending || summary_and_exit 1
fi
# Minted entries whose deploys are already live but whose finalize never ran
# (a crash or finalize failure between deploy_pending and finalize_minted).
if [[ ${#MINTED_IDS[@]} -gt 0 ]]; then
  echo "${C_RUN}⟳${C_OFF} ${C_BOLD}resuming${C_OFF} ${C_DIM}finalizing ${#MINTED_IDS[@]} minted entr(y/ies) whose deploys are live${C_OFF}"
  finalize_minted || summary_and_exit 1
fi
retry_pending_finalizes || summary_and_exit 1
if [[ ${#COMPLETED_IDS[@]} -gt 0 || ${#MINTED_IDS[@]} -gt 0 ]]; then
  echo "${C_DIM}  checkpoint: $(( ${#COMPLETED_IDS[@]} + ${#MINTED_IDS[@]} )) already completed this sweep — not reminting${C_OFF}"
  done_json="$(sweep_ids_json ${COMPLETED_IDS[@]+"${COMPLETED_IDS[@]}"} ${MINTED_IDS[@]+"${MINTED_IDS[@]}"})"
  run_json="$(jq -c --argjson done "$done_json" '[.[] | select(.id as $id | $done | index($id) | not)]' <<< "$run_json")"
  run_count="$(jq 'length' <<< "$run_json")"
fi
if [[ "$run_count" -eq 0 && ${#MINTED_IDS[@]} -eq 0 ]]; then
  if [[ -s "$PENDING_FINALIZE" ]]; then
    echo "${C_ERR}!${C_OFF} ${C_BOLD}nothing left to mint${C_OFF} ${C_DIM}— predecessor cleanup still pending (see summary)${C_OFF}"
  else
    echo "${C_OK}✓${C_OFF} ${C_BOLD}sweep already complete${C_OFF} ${C_DIM}(checkpoint had nothing left)${C_OFF}"
  fi
  finalize_canary || summary_and_exit 1
  summary_and_exit 0
fi
[[ -n "$CANARY_REF" ]] || CANARY_REF="$PLAN_CANARY_REF"

run_wave() { # phase, wave json -> 0 | 1 (failed; results recorded)
  local phase="$1" current="$2" bn entry id logf pid i rc dt kind how batch_t0
  local pids=() ids=() entries=()
  bn="$(jq 'length' <<< "$current")"
  batch_t0=$SECONDS
  while IFS= read -r entry; do
    idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
    how="$(phase_label "$phase")"; [[ "$bn" -gt 1 ]] && how="$how, parallel x$bn"
    [[ "$(jq -r '.ref' <<< "$entry")" == "$CANARY_REF" ]] && how="$how, canary"
    echo "${C_RUN}⟳${C_OFF} [$idx/$run_count] $id ${C_DIM}($how)${C_OFF}"
    logf="$logdir/$id.log"; : > "$logf"
    if [[ "$phase" -eq 1 || "$phase" -eq 4 ]]; then
      rotate_postgres_entry "$entry" "$logf" &
    elif [[ "$(jq -r '.auto' <<< "$entry")" != "true" ]]; then
      sync_entry "$entry" "$logf" &
    elif jq -e '(.sync_repos // []) | length > 0' <<< "$entry" >/dev/null; then
      rotate_standalone_entry "$entry" "$logf" &
    else
      rotate_batched_entry "$entry" "$logf" &
    fi
    pids+=($!); ids+=("$id"); entries+=("$entry")
  done < <(jq -c '.[]' <<< "$current")
  i=0
  for pid in "${pids[@]}"; do
    rc=0; wait "$pid" || rc=$?
    dt=$((SECONDS - batch_t0))
    id="${ids[$i]}"; entry="${entries[$i]}"
    if [[ "$rc" -ne 0 ]]; then
      entry_fail "$id" "$rc" "$dt" "$logdir/$id.log"
      record_result "$id" "failed" "$dt"
      failed=$((failed + 1))
    else
      kind="$(entry_kind "$entry")"
      entry_ok "$id" "$dt" "$logdir/$id.log" "$kind"
      record_result "$id" "ok" "$dt" "$kind"
      if [[ "$phase" -eq 2 || "$phase" -eq 3 ]] \
         && ! { [[ "$kind" == "rotated" ]] && jq -e '(.sync_repos // []) | length > 0' <<< "$entry" >/dev/null; }; then
        sweep_mark_minted "$id" "$entry"
      else
        sweep_mark_completed "$id"
      fi
      if [[ -e "$logdir/$id.finalize-pending" ]]; then
        pending_finalize_add "$id"
        echo "  ${C_ERR}!${C_OFF} ${C_DIM}finalize pending for $id (predecessor still valid; retried on the next run)${C_OFF}"
      fi
    fi
    i=$((i + 1))
  done
  [[ "$failed" -eq 0 ]]
}

for phase in 1 2 3 4; do
  waves="$(waves_for_phase "$phase")"
  # Entries already completed by a previous run were filtered out of run_json;
  # the waves keep their plan-time shape, so drop those ids here.
  waves="$(jq -c --argjson run "$run_json" '[.[] | [.[] | select(.id as $id | $run | any(.[]; .id == $id))] | select(length > 0)]' <<< "$waves")"
  while IFS= read -r current; do
    [[ -n "$current" ]] || continue
    run_wave "$phase" "$current" || summary_and_exit 1
  done < <(jq -c '.[]' <<< "$waves")
  # Batched phases deploy + finalize whatever is minted — even with no wave
  # left to run, so a resumed sweep never exits with minted ids unfinalized.
  if [[ "$phase" -eq 2 || "$phase" -eq 3 ]]; then
    deploy_pending || summary_and_exit 1
    finalize_minted || summary_and_exit 1
  fi
done

finalize_canary || summary_and_exit 1
summary_and_exit 0
