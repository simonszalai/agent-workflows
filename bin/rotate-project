#!/usr/bin/env bash
# rotate-project — one-command full rotation sweep for a project.
#
# Runs every rotation entry of the project secrets.yaml through
# rotate-secret in a safe order, verifying consumer health after each entry:
#
#   1. staging postgres              dest+lock waves; first entry --keep-old (canary)
#   2. SELF_MINTED + provider        parallel saves (same 1Password item sequential);
#                                    then one deploy per touched service, live-wait
#                                    in parallel. Provider entries without a mint
#                                    handler SYNC the current vault value.
#   3. prod postgres                 dest+lock waves (same Render dest or instance
#                                    advisory lock stay sequential)
#
# Stops on the first failure. Rerunning the SAME command resumes the unfinished
# sweep: completed entries are not reminted, batched dests whose values were
# already saved are redeployed, postgres --resume still applies. A finished
# sweep deletes the checkpoint so the next invocation is a new rotation.
# --fresh discards the checkpoint and starts over. Values never reach stdout
# or argv.
#
# Two entry actions:
#   ROTATE — postgres and self-minted entries mint/stage a NEW credential
#            automatically (nothing to do by hand).
#   SYNC   — provider-minted entries (AWS, Resend, ...) push whatever value the
#            1Password item currently holds to every consumer. To rotate one,
#            update the item in 1Password first, then run the sweep (or filter
#            to just that entry with --only).
# Every run covers all selected entries; --only/--skip/--tier narrow the run.
#
# usage:
#   rotate-project <amaru|ts|workflow-pro|autodev> --reason "<why>"
#                  [--dry-run] [--tier staging|prod|all]
#                  [--skip id[,id...]] [--only id[,id...]] [--fresh]
#
# exit codes: 0 all entries rotated+verified, 1 a rotation or health check
#   failed (state printed), 2 usage/config, 3 agent-shell refusal.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../secrets/lib}"
ROTATE="${ROTATE_SECRET:-$HERE/rotate-secret}"

# shellcheck source=../secrets/lib/config.sh
source "$SECRETS_LIB/config.sh"

usage() { sed -n '2,37p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

repo="" project="" reason="" dry=0 tier="all" skip="" only="" fresh=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) repo="${2:?}"; shift 2 ;;
    --repo=*) repo="${1#*=}"; shift ;;
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --tier) tier="${2:?}"; shift 2 ;;
    --tier=*) tier="${1#*=}"; shift ;;
    --skip) skip="${2:?}"; shift 2 ;;
    --skip=*) skip="${1#*=}"; shift ;;
    --only) only="${2:?}"; shift 2 ;;
    --only=*) only="${1#*=}"; shift ;;
    --fresh) fresh=1; shift ;;
    -h|--help) usage ;;
    -*) echo "ERROR: unknown flag $1" >&2; usage ;;
    *) [[ -z "$project" ]] || usage; project="$1"; shift ;;
  esac
done
[[ -n "$project" ]] || usage
[[ -n "$reason" || "$dry" -eq 1 ]] || { echo "ERROR: --reason is required for a live sweep." >&2; exit 2; }
# Child rotate-secret / sync-secrets processes each export their own reason, but
# this orchestrator ALSO resolves sensitive refs directly — the Render API key
# for deploy finalization lives in <PROJECT>-sensitive. Without the reason in the
# environment, the shim refuses (exit 3) after every value has already been
# saved, so the sweep dies with the deploys untriggered.
[[ -n "$reason" ]] && export SENSITIVE_ACCESS_REASON="$reason"
case "$tier" in staging|prod|all) ;; *) echo "ERROR: --tier must be staging|prod|all" >&2; exit 2 ;; esac
command -v jq >/dev/null || { echo "ERROR: missing dependency: jq" >&2; exit 2; }
# Project config discovery: run from any repo of the project (or --repo). The
# synthesized registry derives every entry's consumers from the routes.
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "ERROR: not inside a git repo; pass --repo <path>" >&2; exit 2; }
fi
repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "ERROR: repo path does not exist" >&2; exit 2; }
export _SECRETS_CONFIG="$repo"
REGISTRY="$(config_registry)" || exit 2
export SECRET_ROTATION_CONFIG="$REGISTRY"
config_project="$(jq -r '.secrets[0].project // empty' "$REGISTRY")"
if [[ -n "$config_project" && "$project" != "$config_project" ]]; then
  echo "ERROR: project '$project' requested but $repo belongs to project '$config_project'" >&2
  exit 2
fi

# Entry selection + phase classification. Staging-ness comes from the ref's
# item name (environment is encoded in item titles across every vault).
plan_json="$(jq -c --arg p "$project" '
  [.secrets[] | select(.project == $p)
   | . + {staging: ((.ref // "") | test("staging"; "i")),
          auto: (.provider == "postgres" or .mode == "SELF_MINTED" or (.automated // false)),
          phase: (if .provider == "postgres" and ((.ref // "") | test("staging"; "i")) then 1
                  elif .provider != "postgres" then 2
                  else 3 end)}]
  | sort_by(.phase)' "$REGISTRY")"
count="$(jq 'length' <<< "$plan_json")"
[[ "$count" -gt 0 ]] || { echo "ERROR: no registry entries for project '$project'." >&2; exit 2; }

in_csv() { local needle="$1" csv="$2"; [[ ",$csv," == *",$needle,"* ]]; }

health_gate() { # entry json -> verify every consumer dest registered in health_urls
  local entry="$1" dest url body ok=1
  while IFS= read -r dest; do
    url="$(jq -r --arg d "$dest" '.health_urls[$d] // empty' "$REGISTRY")"
    [[ -n "$url" && "$url" != "deploy-only" ]] || continue
    if body="$(curl -sf --max-time 30 "$url")"; then
      if jq -e 'has("databaseRoleSafe")' <<< "$body" >/dev/null 2>&1 \
         && ! jq -e '.status == "ok" and .databaseRoleSafe == true' <<< "$body" >/dev/null; then
        echo "  HEALTH FAIL $dest ($url): $body" >&2; ok=0
      else
        echo "  health ok: $dest"
      fi
    else
      echo "  HEALTH FAIL $dest ($url): unreachable/non-200" >&2; ok=0
    fi
  done < <(jq -r '.consumers[]?.dest' <<< "$entry" | sort -u)
  [[ "$ok" -eq 1 ]]
}

# Filter the plan down to what this invocation actually runs.
run_json="$(jq -c --arg tier "$tier" --arg only "$only" --arg skip "$skip" '
  def incsv($csv): ($csv | split(",")) as $l | . as $x | ($l | index($x)) != null;
  [.[] | select(($only == "" or (.id | incsv($only)))
    and (($skip == "") or ((.id | incsv($skip)) | not))
    and (if $tier == "staging" then .staging
         elif $tier == "prod" then (.staging | not)
         else true end))]' <<< "$plan_json")"
run_count="$(jq 'length' <<< "$run_json")"
skipped=$((count - run_count))

# Sweep checkpoint: unfinished runs persist completed/minted entry ids and
# batched dests so a rerun does not remint SELF_MINTED secrets or restart a
# finished postgres rotation. Value-free (ids and service ids only).
SWEEP_STATE_DIR="${ROTATE_PROJECT_STATE_DIR:-$HOME/.local/state/agent-workflows/rotate-project}"
SWEEP_STATE="$SWEEP_STATE_DIR/${project}.state"
COMPLETED_IDS=()
MINTED_IDS=()
PENDING_SIDS=()
sweep_has_id() { local needle="$1" x; for x in "${COMPLETED_IDS[@]-}" "${MINTED_IDS[@]-}"; do [[ "$x" == "$needle" ]] && return 0; done; return 1; }
sweep_ids_json() { # args -> JSON string array
  if [[ $# -eq 0 ]]; then printf '[]\n'; return 0; fi
  jq -n '$ARGS.positional' --args -- "$@"
}
sweep_state_save() {
  local completed minted pending
  mkdir -p "$SWEEP_STATE_DIR"
  chmod 700 "$SWEEP_STATE_DIR" 2>/dev/null || true
  if [[ ${#COMPLETED_IDS[@]} -gt 0 ]]; then completed="$(sweep_ids_json "${COMPLETED_IDS[@]}")"; else completed='[]'; fi
  if [[ ${#MINTED_IDS[@]} -gt 0 ]]; then minted="$(sweep_ids_json "${MINTED_IDS[@]}")"; else minted='[]'; fi
  if [[ ${#PENDING_SIDS[@]} -gt 0 ]]; then pending="$(sweep_ids_json "${PENDING_SIDS[@]}")"; else pending='[]'; fi
  jq -n --arg p "$project" --arg t "$tier" --arg c "${CANARY_REF:-}" \
    --argjson completed "$completed" --argjson minted "$minted" --argjson pendingDests "$pending" \
    '{stateVersion:1, project:$p, tier:$t, canaryRef:$c, completed:$completed, minted:$minted, pendingDests:$pendingDests}' \
    > "$SWEEP_STATE"
  chmod 600 "$SWEEP_STATE"
}
sweep_state_load() {
  local json
  COMPLETED_IDS=(); MINTED_IDS=(); PENDING_SIDS=()
  [[ -f "$SWEEP_STATE" ]] || return 0
  json="$(cat "$SWEEP_STATE")" || return 1
  printf '%s' "$json" | jq -e --arg p "$project" '.stateVersion == 1 and .project == $p' >/dev/null || {
    echo "ERROR: sweep checkpoint $SWEEP_STATE is malformed or for another project." >&2
    return 1
  }
  while IFS= read -r x; do [[ -n "$x" ]] && COMPLETED_IDS+=("$x"); done < <(jq -r '.completed[]?' <<<"$json")
  while IFS= read -r x; do [[ -n "$x" ]] && MINTED_IDS+=("$x"); done < <(jq -r '.minted[]?' <<<"$json")
  while IFS= read -r x; do [[ -n "$x" ]] && PENDING_SIDS+=("$x"); done < <(jq -r '.pendingDests[]?' <<<"$json")
  CANARY_REF="$(jq -r '.canaryRef // empty' <<<"$json")"
}
sweep_state_clear() { rm -f "$SWEEP_STATE"; }
sweep_mark_completed() { COMPLETED_IDS+=("$1"); sweep_state_save; }
sweep_mark_minted() { MINTED_IDS+=("$1"); sweep_state_save; }
sweep_capture_pending_dests() {
  PENDING_SIDS=()
  [[ -s "$logdir/pending-dests" ]] || { sweep_state_save; return 0; }
  while IFS= read -r x; do [[ -n "$x" ]] && PENDING_SIDS+=("$x"); done < <(sort -u "$logdir/pending-dests")
  sweep_state_save
}
sweep_promote_minted() {
  local x
  for x in "${MINTED_IDS[@]-}"; do [[ -n "$x" ]] && COMPLETED_IDS+=("$x"); done
  MINTED_IDS=()
  PENDING_SIDS=()
  sweep_state_save
}
# --- output helpers (concise per-entry status; full logs only on failure) ----
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OK=$'\033[32m'; C_ERR=$'\033[31m'; C_RUN=$'\033[36m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
  C_OK=""; C_ERR=""; C_RUN=""; C_DIM=""; C_BOLD=""; C_OFF=""
fi
fmt_dur() { local t="$1"; if [[ "$t" -ge 60 ]]; then printf '%dm%02ds' $((t/60)) $((t%60)); else printf '%ds' "$t"; fi; }
log_highlights() { # concise facts pulled from a full entry log
  grep -E '^\s*(vault: updated|vault: created op|db: retired|drain: predecessor|render\[[^]]*\] deploy |minted new|health ok:)' "$1" \
    | sed -E 's/^ */    /' | sort -u | head -6 || true
}
# A successful entry has two very different meanings, and rendering both as a
# bare ✓ let "nothing was rotated" read as "rotated". ROTATE entries mint a new
# credential; SYNC entries (manual/unconfigured providers) only push the value
# the vault already holds, so the credential is unchanged and any actual
# rotation is still owed to the operator.
entry_ok() { # id, seconds, logf, kind(rotated|synced)
  if [[ "${4:-rotated}" == "synced" ]]; then
    echo "${C_OK}≡${C_OFF} ${C_BOLD}$1${C_OFF} ${C_DIM}($(fmt_dur "$2")) — synced only, credential NOT rotated${C_OFF}"
  else
    echo "${C_OK}✓${C_OFF} ${C_BOLD}$1${C_OFF} ${C_DIM}($(fmt_dur "$2"))${C_OFF}"
  fi
  log_highlights "$3"
}
entry_fail() { # id, rc, seconds, logf
  echo "${C_ERR}✗ ${C_BOLD}$1${C_OFF}${C_ERR} failed (rc=$2, $(fmt_dur "$3"))${C_OFF}"
  echo "${C_DIM}  ── last log lines ──${C_OFF}"
  tail -12 "$4" | sed 's/^/  /'
  echo "${C_DIM}  full log: $4${C_OFF}"
}
# entry_kind ENTRY_JSON -> rotated|synced. `auto` entries run a provider that
# mints a new credential; the rest only fan the current vault value out.
entry_kind() {
  if [[ "$(jq -r '.auto' <<< "$1")" == "true" ]]; then printf 'rotated'; else printf 'synced'; fi
}

RESULT_IDS=(); RESULT_STATES=(); RESULT_TIMES=(); RESULT_KINDS=()
record_result() { RESULT_IDS+=("$1"); RESULT_STATES+=("$2"); RESULT_TIMES+=("$3"); RESULT_KINDS+=("${4:-rotated}"); }

summary_and_exit() { # exit code
  local code="$1" i=0 state kind mark note total=$SECONDS
  local rotated_n=0 synced_n=0
  echo
  echo "${C_BOLD}── rotate-project $project summary ──${C_OFF}"
  for id in "${RESULT_IDS[@]-}"; do
    [[ -n "$id" ]] || continue
    state="${RESULT_STATES[$i]}"; kind="${RESULT_KINDS[$i]}"; note=""
    if [[ "$state" != "ok" ]]; then
      mark="${C_ERR}✗${C_OFF}"
    elif [[ "$kind" == "synced" ]]; then
      mark="${C_OK}≡${C_OFF}"
      note="  ${C_DIM}synced only — credential NOT rotated${C_OFF}"
      synced_n=$((synced_n + 1))
    else
      mark="${C_OK}✓${C_OFF}"
      rotated_n=$((rotated_n + 1))
    fi
    printf '  %b %-45s %s%b\n' "$mark" "$id" "$(fmt_dur "${RESULT_TIMES[$i]}")" "$note"
    i=$((i + 1))
  done
  if [[ "$code" -eq 0 ]]; then
    sweep_state_clear
    local synced_note=""
    [[ "$synced_n" -gt 0 ]] && synced_note=", ${C_BOLD}$synced_n synced only${C_OFF}"
    echo "  ${C_OK}${C_BOLD}$rotated_n rotated+verified${C_OFF}${synced_note} ${C_DIM}in $(fmt_dur "$total") ($skipped filtered out)${C_OFF}"
    if [[ "$synced_n" -gt 0 ]]; then
      echo "  ${C_DIM}synced entries pushed the value the vault already held; rotate them at their source (see each entry's playbook).${C_OFF}"
    fi
  else
    sweep_state_save
    echo "  ${C_ERR}${C_BOLD}stopped after a failure${C_OFF} ${C_DIM}— rerun the same command to resume (completed entries are not reminted)${C_OFF}"
  fi
  exit "$code"
}

# Stamp postgres entries with lockKey (admin project/tier of the physical box)
# and renderDests so phase 1/3 can run disjoint groups in parallel. Missing
# db-roles.json leaves lockKey=unknown → one postgres per wave (sequential).
annotate_postgres_keys() {
  local db_roles="${DB_ROLES_CONFIG:-$HERE/../config/db-roles.json}"
  [[ -f "$db_roles" ]] || return 0
  run_json="$(printf '%s' "$run_json" | python3 -c '
import json, sys
roles = json.load(open(sys.argv[1]))
entries = json.load(sys.stdin)

def lock_key(entry):
    if entry.get("provider") != "postgres":
        return ""
    ref = entry.get("ref") or ""
    project = entry.get("project") or ""
    parts = ref.split("/")
    if len(parts) < 5 or not ref.startswith("op://"):
        return "unknown"
    title, field = parts[3], parts[4]
    title_l = title.lower()
    if "staging" in title_l:
        tier = "staging"
    elif title_l.startswith("postgres") or title.startswith("PROD_"):
        tier = "prod"
    else:
        return "unknown"
    proj = (roles.get("projects") or {}).get(project) or {}
    base = field.lower()
    for suffix in ("_migrator", "_ro"):
        if base.endswith(suffix):
            base = base[: -len(suffix)]
            break
    inst_p, inst_t = project, tier
    for app in (proj.get("apps") or {}).values():
        prefix = (app.get("item_prefix") or "").rstrip("_").lower()
        if prefix == base:
            inst = app.get("instance") or {}
            inst_p = inst.get("project") or project
            inst_t = (inst.get("tier_map") or {}).get(tier) or tier
            break
    box = ((roles.get("projects") or {}).get(inst_p) or {}).get("tiers", {}).get(inst_t) or {}
    admin = (box.get("admin_via") or {}).get("project") or inst_p
    return "%s/%s" % (admin, inst_t)

def dests(entry):
    out = []
    for c in entry.get("consumers") or []:
        d = str(c.get("dest") or "")
        if d.startswith("srv-") or d.startswith("crn-"):
            out.append(d)
    return sorted(set(out))

for e in entries:
    e["lockKey"] = lock_key(e)
    e["renderDests"] = dests(e)
print(json.dumps(entries, separators=(",", ":")))
' "$db_roles")" || return 1
}

# One dest-disjoint + lock-disjoint wave. $.cdest is invalid jq — the reduce
# accumulator is `.`, saved as $acc before the conflict predicate (which would
# otherwise replace `.` with a boolean).
split_postgres_wave() { # $1 = json array of annotated entries -> {now, later}
  jq -c '
    def dests: (.renderDests // []);
    def lock: (.lockKey // "unknown");
    . as $all
    | reduce range(0; length) as $i ({cdest: [], clock: [], now: [], later: []};
        . as $acc
        | ($all[$i] | dests) as $d
        | ($all[$i] | lock) as $k
        | (
            ($d | any(. as $x | $acc.cdest | index($x) != null))
            or (($k != "unknown") and ($acc.clock | index($k) != null))
            or (($k == "unknown") and (($acc.now | length) > 0))
            or (($k != "unknown") and ($acc.now | any((.lockKey // "unknown") == "unknown")))
          ) as $conflict
        | if $conflict
          then $acc | .later += [$all[$i]]
          else $acc
               | .now += [$all[$i]]
               | .cdest += $d
               | if $k != "unknown" then .clock += [$k] else . end
          end)
    | {now: .now, later: .later}' <<< "$1"
}

postgres_wave_labels() { # $1 = phase json -> {id: "wave i/n · parallel xN"}
  local remaining="${1:-[]}" waves='[]' split
  [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]] || { printf '{}\n'; return 0; }
  while [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]]; do
    split="$(split_postgres_wave "$remaining")"
    waves="$(jq -c --argjson w "$(jq -c '.now' <<< "$split")" '. + [$w]' <<< "$waves")"
    remaining="$(jq -c '.later' <<< "$split")"
  done
  jq -c '
    . as $waves | ($waves | length) as $n
    | [range(0; $n) as $i
       | ($waves[$i] | length) as $bn
       | $waves[$i][]
       | {key: .id,
          value: ("wave \($i+1)/\($n)" + (if $bn > 1 then " · parallel x\($bn)" else "" end))}]
    | from_entries' <<< "$waves"
}

annotate_postgres_keys || echo "${C_DIM}postgres lock annotation skipped${C_OFF}" >&2

echo "${C_BOLD}rotate-project $project${C_OFF} — $run_count of $count entries ${C_DIM}(tier=$tier, $skipped filtered out)${C_OFF}"

# --- dry-run: render the full plan (credential-free) and exit ----------------
finalize_canary() {
  # A --keep-old canary leaves one predecessor login valid as the sweep's
  # rollback window. Once every entry succeeded there is nothing to roll back
  # to, so retire it (idempotent: no state file -> immediate no-op).
  [[ -n "${CANARY_REF:-}" ]] || return 0
  echo "${C_RUN}⟳${C_OFF} finalizing canary ${C_DIM}(retiring the kept predecessor login)${C_OFF}"
  local logf="$logdir/canary-finalize.log"; : > "$logf"
  if "$ROTATE" --ref "$CANARY_REF" --reason "$reason [canary finalize]" --yes --resume >> "$logf" 2>&1; then
    echo "${C_OK}✓${C_OFF} canary predecessor retired"
  elif grep -q "no resumable .* rotation state" "$logf"; then
    # A mid-sweep resume of the canary entry already ran the full retirement
    # (resume does not re-apply --keep-old), so there is nothing left to
    # finalize — that is completion, not failure.
    echo "${C_OK}✓${C_OFF} canary already finalized ${C_DIM}(predecessor was retired during the sweep)${C_OFF}"
  else
    echo "${C_ERR}✗ canary finalize failed — predecessor login remains valid (safe).${C_OFF}"
    tail -8 "$logf" | sed 's/^/  /'
    return 1
  fi
}

if [[ "$dry" -eq 1 ]]; then
  _w1="$(postgres_wave_labels "$(jq -c '[.[] | select(.phase == 1)]' <<< "$run_json")")"
  _w3="$(postgres_wave_labels "$(jq -c '[.[] | select(.phase == 3)]' <<< "$run_json")")"
  # `${var:-{}}` is parsed as default `{` plus a leftover `}` — never use
  # braces inside a `${var:-...}` default.
  [[ -n "$_w1" ]] || _w1='{}'
  [[ -n "$_w3" ]] || _w3='{}'
  pg_wave_labels="$(jq -n -c --argjson a "$_w1" --argjson b "$_w3" '$a + $b')"
  render_plan_section() { # title, color, entries json
    local title="$1" color="$2" entries="$3" n entry id provider mode phase staging how ref dest env label host
    n="$(jq 'length' <<< "$entries")"
    [[ "$n" -gt 0 ]] || return 0
    echo
    echo "${color}${C_BOLD}${title} (${n})${C_OFF}"
    while IFS= read -r entry; do
      id="$(jq -r '.id' <<< "$entry")"
      provider="$(jq -r '.provider' <<< "$entry")"
      mode="$(jq -r '.mode' <<< "$entry")"
      phase="$(jq -r '.phase' <<< "$entry")"
      staging="$(jq -r '.staging' <<< "$entry")"
      if [[ "$phase" == "1" || "$phase" == "3" ]]; then
        how="$(jq -r --arg id "$id" '.[$id] // "dest+lock waves"' <<< "$pg_wave_labels")"
      else
        how="parallel · save-only, one deploy per service"
      fi
      local tierlabel="prod"; [[ "$staging" == "true" ]] && tierlabel="staging"
      local plan=""
      case "$provider" in
        postgres)
          if [[ "$phase" == "1" && "${dry_canary_flagged:-0}" -eq 0 ]]; then
            dry_canary_flagged=1
            plan="stage new versioned DB login → deploy → health-gate; keep predecessor as rollback (canary), auto-retired after the sweep succeeds"
          else
            plan="stage new versioned DB login → deploy → health-gate → drain + retire predecessor"
          fi ;;
        self_minted) plan="mint $(jq -r '(.generate.format // "hex") + "/" + ((.generate.bytes // 32)|tostring)' <<< "$entry") automatically → sync consumers → deploy once per service" ;;
        *) plan="SYNC the item's current 1Password value → consumers → one deploy per service (update the item in 1Password first to rotate it)" ;;
      esac
      echo "  ${C_BOLD}${id}${C_OFF} ${C_DIM}${provider} · ${tierlabel} · ${how}${C_OFF}"
      local disabled
      disabled="$(jq -r '.disabled_reason // ""' <<< "$entry")"
      if [[ -n "$disabled" ]]; then
        echo "    ${C_ERR}DISABLED${C_OFF} ${C_DIM}$disabled${C_OFF}"
      fi
      local hookm
      hookm="$(jq -r '.hook // ""' <<< "$entry")"
      [[ "$hookm" == "full" ]] && plan="repo hook owns the rotation (see hook line) → engine fan-out re-syncs consumers"
      echo "    ${C_DIM}plan${C_OFF}  $plan"
      if [[ -n "$hookm" ]]; then
        if [[ -x "$repo/scripts/secrets/rotate-hook" ]]; then
          if [[ "$hookm" == "full" ]]; then
            echo "    ${C_RUN}hook${C_OFF}  ${C_DIM}rotation delegated to scripts/secrets/rotate-hook (repo-specific)${C_OFF}"
          else
            echo "    ${C_RUN}hook${C_OFF}  ${C_DIM}repo-specific activation via scripts/secrets/rotate-hook (runs inside the rotation window)${C_OFF}"
          fi
          ROTATE_ENTRY_JSON="$entry" "$repo/scripts/secrets/rotate-hook" plan 2>/dev/null | sed "s/^/    ${C_DIM}      /;s/\$/${C_OFF}/" || true
        else
          echo "    ${C_ERR}hook MISSING${C_OFF} ${C_DIM}entry declares hook: $hookm but $repo/scripts/secrets/rotate-hook is absent — rotate-secret will refuse${C_OFF}"
        fi
      elif [[ -x "$repo/scripts/secrets/rotate-hook" && "$provider" != "postgres" ]] \
           && jq -e '[.routes[]? | select(.kind=="prefect")] | length > 0' <<< "$entry" >/dev/null; then
        echo "    ${C_RUN}hook${C_OFF}  ${C_DIM}post-sync: repo hook saves the Prefect block tier(s) after the fan-out${C_OFF}"
      fi
      # Every map row comes from the routes that share the entry's ref(s) —
      # derived, never restated, so it can neither under- nor over-report.
      local kind src
      while IFS=$'\t' read -r kind dest env src; do
        [[ -n "$dest" ]] || continue
        case "$kind" in
          render)
            host="$(jq -r --arg d "$dest" '.health_urls[$d] // empty' "$REGISTRY" | sed -E '/^deploy-only$/d; s#https?://##; s#/.*##')"
            label="render:${host:-$dest}" ;;
          *) label="$kind:$dest" ;;
        esac
        printf '    %bmap%b   %b%s%b  %b→%b  %s  %b%s%b\n' \
          "$C_DIM" "$C_OFF" "$C_RUN" "$src" "$C_OFF" "$C_DIM" "$C_OFF" "$label" "$C_BOLD" "$env" "$C_OFF"
      done < <(jq -r '.routes[]? | [.kind, .dest, .env, .ref] | @tsv' <<< "$entry")
      echo
    done < <(jq -c '.[]' <<< "$entries")
  }
  auto_json="$(jq -c '[.[] | select(.auto)]' <<< "$run_json")"
  sync_json="$(jq -c '[.[] | select(.auto | not)]' <<< "$run_json")"
  render_plan_section "ROTATE — new credentials minted automatically" "$C_OK" "$auto_json"
  render_plan_section "SYNC — pushes the current 1Password value to consumers" "$C_RUN" "$sync_json"
  echo

  # ── preflight: verify every op:// field the sweep will READ actually exists.
  # Item metadata only (field labels) — no values are read or printed. Vaults
  # without a silent credential route (*-sensitive, Touch ID) are reported as
  # unchecked rather than prompting during a dry run. ROTATE_PREFLIGHT=0 skips.
  if [[ "${ROTATE_PREFLIGHT:-1}" == "1" ]]; then
    db_roles="${DB_ROLES_CONFIG:-$HERE/../config/db-roles.json}"
    admin_vault="" admin_vault_sensitive=""
    if [[ -f "$db_roles" ]]; then
      admin_vault="$(jq -r --arg p "$project" '.projects[$p].vault // empty' "$db_roles")"
      admin_vault_sensitive="$(jq -r --arg p "$project" '.projects[$p].vault_sensitive // empty' "$db_roles")"
    fi
    # every ref the run touches: entry ref, sync_refs, provider config refs,
    # route refs — plus the postgres control root ref per tier.
    admin_root_staging="" admin_root_prod=""
    if [[ -f "$db_roles" ]]; then
      admin_root_staging="$(jq -r --arg p "$project" '.projects[$p].admin_refs.staging.root // empty' "$db_roles")"
      admin_root_prod="$(jq -r --arg p "$project" '.projects[$p].admin_refs.prod.root // empty' "$db_roles")"
    fi
    [[ -n "$admin_root_staging" || -z "$admin_vault" ]] || admin_root_staging="op://$admin_vault/Postgres staging/root"
    [[ -n "$admin_root_prod" || -z "$admin_vault_sensitive" ]] || admin_root_prod="op://$admin_vault_sensitive/Postgres prod/root"
    needed="$(jq -r --arg rs "$admin_root_staging" --arg rp "$admin_root_prod" '
      [.[] | ( [.ref] + (.sync_refs // [])
              + [(.config.secret_ref // empty)]
              + [(.routes // [])[].ref]
              + (if .provider == "postgres" then
                   [ (if .staging then $rs else $rp end) | select(. != "") ]
                 else [] end) )[] ]
      | map(select(type == "string" and startswith("op://"))) | unique | .[]' <<< "$run_json")"
    pf_fail=0 pf_checked=0 pf_unchecked=0
    while IFS= read -r vault_item; do
      [[ -n "$vault_item" ]] || continue
      pf_vault="${vault_item%%/*}"; pf_item="${vault_item#*/}"
      pf_fields="$(printf '%s
' "$needed" | awk -F/ -v v="$pf_vault" -v i="$pf_item"         '{ rest=substr($0,6); vv=rest; sub("/.*","",vv); it=rest; sub("^[^/]*/","",it); f=it; sub("/[^/]*$","",it); sub(".*/","",f); if (vv==v && it==i) print f }' | sort -u)"
      if [[ "$pf_vault" == *-sensitive ]]; then
        pf_unchecked=$((pf_unchecked+1))
        echo "  ${C_DIM}preflight: $pf_vault/$pf_item — unchecked (Touch ID vault; verified at run time)${C_OFF}"
        continue
      fi
      if ! pf_json="$("${OP_BIN:-$HERE/op}" item get "$pf_item" --vault "$pf_vault" --format json 2>/dev/null)"; then
        echo "  ${C_ERR}preflight FAIL: item '$pf_vault/$pf_item' is missing or unreadable${C_OFF}" >&2
        pf_fail=1; continue
      fi
      pf_have="$(printf '%s' "$pf_json" | jq -r '[.fields[].label] | join("
")')"
      pf_json=""
      while IFS= read -r pf_f; do
        [[ -n "$pf_f" ]] || continue
        if ! grep -qxF "$pf_f" <<< "$pf_have"; then
          echo "  ${C_ERR}preflight FAIL: '$pf_vault/$pf_item' has no field '$pf_f'${C_OFF}" >&2
          pf_fail=1
        fi
      done <<< "$pf_fields"
      pf_checked=$((pf_checked+1))
    done < <(printf '%s
' "$needed" | sed 's|^op://||; s|/[^/]*$||' | sort -u)
    echo
    if [[ "$pf_fail" -eq 1 ]]; then
      echo "${C_ERR}${C_BOLD}✗ PREFLIGHT FAIL${C_OFF}${C_ERR} — a live sweep would stop on the missing refs above.${C_OFF}" >&2
      exit 1
    fi
    echo "${C_OK}${C_BOLD}✓ PREFLIGHT PASS${C_OFF} ${C_DIM}— $pf_checked item(s) verified by field name; $pf_unchecked Touch-ID item(s) unchecked (verified at run time). No values were read.${C_OFF}"
  fi
  echo "${C_DIM}dry-run: nothing was written anywhere; no secret values were read.${C_OFF}"
  exit 0
fi


SYNC="${SYNC_SECRETS:-$HERE/sync-secrets}"

sync_one() { # entry json, log file: push the CURRENT vault value(s) to consumers
  local entry="$1" logf="$2" ref rc=0 r
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    while IFS= read -r ref; do
      [[ -n "$ref" ]] || continue
      "$SYNC" --repo "$repo" --changed "$ref" --reason "$reason [$(jq -r '.id' <<< "$entry")]" --no-deploy >> "$logf" 2>&1 || rc=$?
    done < <(jq -r '(.sync_refs // [.ref]) | .[]' <<< "$entry")
  done < <(printf 'x\n')
  if [[ "$rc" -eq 0 ]]; then
    jq -r '.consumers[]?.dest | select(test("^(srv|crn)-"))' <<< "$entry" >> "$logdir/pending-dests"
  fi
  return "$rc"
}

rotate_one() { # entry json, log file, extra flag or "", batched(0|1); returns rotate rc
  local entry="$1" logf="$2" xtra="$3" batched="${4:-0}" id ref rc=0
  id="$(jq -r '.id' <<< "$entry")"
  ref="$(jq -r '.ref' <<< "$entry")"
  if [[ "$(jq -r '.auto' <<< "$entry")" != "true" ]]; then
    sync_one "$entry" "$logf"
    return $?
  fi
  if [[ "$batched" -eq 1 ]]; then
    # Save-only: values are written everywhere but Render deploys are deferred;
    # the orchestrator deploys each touched service once per phase.
    ROTATE_NO_DEPLOY=1 "$ROTATE" --repo "$repo" --ref "$ref" --reason "$reason [$id]" --yes ${xtra:+"$xtra"} >> "$logf" 2>&1 || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      jq -r '.consumers[]?.dest | select(test("^(srv|crn)-"))' <<< "$entry" >> "$logdir/pending-dests"
    fi
  else
    "$ROTATE" --repo "$repo" --ref "$ref" --reason "$reason [$id]" --yes ${xtra:+"$xtra"} >> "$logf" 2>&1 || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      health_gate "$entry" >> "$logf" 2>&1 || rc=99
    fi
  fi
  return "$rc"
}

# Deploy every service touched by the batched saves exactly once, wait for the
# deploy to reach a terminal state, then health-gate the service.
finalize_pending_deploys() {
  local sid url status key ref deadline ok=1
  [[ -s "$logdir/pending-dests" ]] || return 0
  # shellcheck source=../secrets/lib/read.sh
  source "$HERE/../secrets/lib/read.sh"
  # shellcheck source=../secrets/lib/vault.sh
  source "$HERE/../secrets/lib/vault.sh"   # op_vault_read (Render API key)
  # shellcheck source=../secrets/lib/render-api.sh
  source "$HERE/../secrets/lib/render-api.sh"
  # Deploy triggering needs the project's Render key + SA token, exactly like
  # sync-secrets resolves them (entries deferred their deploys, so no child
  # process resolved a project context on our behalf).
  if [[ -z "${SECRETS_RENDER_KEY_REF:-}" ]]; then
    local ctx
    ctx="$("$HERE/project-context" --cwd "$repo")" || { echo "ERROR: project context resolution failed for $repo" >&2; return 1; }
    SECRETS_SA_TOKEN_ENV="$(printf '%s' "$ctx" | jq -er '.service_account.token_env')" || return 1
    SECRETS_SA_KEYCHAIN_ITEM="$(printf '%s' "$ctx" | jq -r '.service_account.keychain_item // ""')"
    SECRETS_RENDER_KEY_REF="$(printf '%s' "$ctx" | jq -r '.tools.render.api_key_ref // ""')"
    export SECRETS_SA_TOKEN_ENV SECRETS_SA_KEYCHAIN_ITEM SECRETS_RENDER_KEY_REF
    [[ -n "$SECRETS_RENDER_KEY_REF" ]] || { echo "ERROR: no Render API key ref in project context for $repo" >&2; return 1; }
  fi
  local sids nsids t0 dt pids=() idle_pids=()
  sids="$(sort -u "$logdir/pending-dests")"
  : > "$logdir/pending-dests"
  nsids="$(printf '%s\n' "$sids" | grep -c . || true)"
  echo
  echo "${C_RUN}⟳${C_OFF} ${C_BOLD}all values saved — deploying $nsids service(s) in parallel${C_OFF}"
  # Idle-wait every dest FIRST so one service's new deploy is not treated as
  # in-flight work that blocks the next trigger (that serialized the token wave).
  # Wait the dests concurrently — sequential idle-wait stacked one deploy behind
  # another when both services were already rolling.
  wait_idle() {
    local sid="$1" ref RENDER_API_KEY
    ref="$(render_key_ref_for "$sid")" || return 1
    RENDER_API_KEY="$(render_key_resolve "$ref")" || return 1
    export RENDER_API_KEY
    render_wait_service_idle "$sid"
  }
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    wait_idle "$sid" &
    idle_pids+=($!)
  done <<< "$sids"
  for pid in "${idle_pids[@]-}"; do
    wait "$pid" || return 1
  done
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    ref="$(render_key_ref_for "$sid")" || { echo "ERROR: no Render key ref for $sid" >&2; return 1; }
    RENDER_API_KEY="$(render_key_resolve "$ref")" || { echo "ERROR: could not resolve Render key for $sid" >&2; return 1; }
    export RENDER_API_KEY
    render_trigger_deploy "$sid" || { echo "ERROR: deploy trigger failed for $sid" >&2; return 1; }
  done <<< "$sids"
  echo "${C_DIM}  waiting for every deploy to go live (nothing is done until this passes)…${C_OFF}"
  wait_one() {
    local sid="$1" status deadline dt t0 url
    local ref RENDER_API_KEY
    ref="$(render_key_ref_for "$sid")" || return 1
    RENDER_API_KEY="$(render_key_resolve "$ref")" || return 1
    export RENDER_API_KEY
    t0=$SECONDS
    deadline=$(( $(date +%s) + 1200 ))
    while [[ $(date +%s) -lt $deadline ]]; do
      status="$(render_get "/services/${sid}/deploys?limit=1" | jq -r '.[0].deploy.status // .[0].status // empty')" || status=""
      case "$status" in
        live) break ;;
        build_failed|update_failed|canceled|deactivated|pre_deploy_failed)
          echo "${C_ERR}✗ deploy for $sid ended $status${C_OFF}" >&2
          return 1 ;;
        *) sleep 15 ;;
      esac
    done
    dt=$((SECONDS - t0))
    [[ "$status" == "live" ]] || { echo "${C_ERR}✗ deploy for $sid did not go live within 20m${C_OFF}" >&2; return 1; }
    url="$(jq -r --arg d "$sid" '.health_urls[$d] // empty' "$REGISTRY")"
    [[ "$url" == "deploy-only" ]] && url=""
    if [[ -n "$url" ]]; then
      if curl -sf --max-time 30 "$url" >/dev/null; then
        echo "${C_OK}✓${C_OFF} $sid ${C_DIM}live + healthy ($(fmt_dur "$dt"))${C_OFF}"
      else
        echo "${C_ERR}✗ $sid live but health check failed ($url)${C_OFF}" >&2
        return 1
      fi
    else
      echo "${C_OK}✓${C_OFF} $sid ${C_DIM}live ($(fmt_dur "$dt")) — no health URL registered${C_OFF}"
    fi
  }
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    wait_one "$sid" &
    pids+=($!)
  done <<< "$sids"
  for pid in "${pids[@]-}"; do
    wait "$pid" || ok=0
  done
  [[ "$ok" -eq 1 ]]
}

logdir="$(mktemp -d)"
trap 'rm -rf "$logdir"' EXIT
: > "$logdir/pending-dests"
first_staging_pg=1 ran=0 failed=0 idx=0

if [[ "$fresh" -eq 1 ]]; then
  sweep_state_clear
  echo "${C_DIM}--fresh: discarded unfinished sweep checkpoint${C_OFF}"
fi
sweep_state_load || exit 2
if [[ ${#PENDING_SIDS[@]} -gt 0 ]]; then
  printf '%s\n' "${PENDING_SIDS[@]}" > "$logdir/pending-dests"
  echo "${C_RUN}⟳${C_OFF} ${C_BOLD}resuming${C_OFF} ${C_DIM}retrying ${#PENDING_SIDS[@]} deferred deploy(s); already-minted secrets will not be reminted${C_OFF}"
  finalize_pending_deploys || summary_and_exit 1
  sweep_promote_minted
fi
if [[ ${#COMPLETED_IDS[@]} -gt 0 || ${#MINTED_IDS[@]} -gt 0 ]]; then
  n_skip=$(( ${#COMPLETED_IDS[@]} + ${#MINTED_IDS[@]} ))
  echo "${C_DIM}  checkpoint: $n_skip already completed this sweep — not reminting${C_OFF}"
  skip_json='[]'
  if [[ ${#COMPLETED_IDS[@]} -gt 0 || ${#MINTED_IDS[@]} -gt 0 ]]; then
    skip_json="$(sweep_ids_json ${COMPLETED_IDS[@]+"${COMPLETED_IDS[@]}"} ${MINTED_IDS[@]+"${MINTED_IDS[@]}"})"
  fi
  run_json="$(jq -c --argjson skip "$skip_json" '
    [.[] | select(.id as $id | $skip | index($id) | not)]' <<< "$run_json")"
  run_count="$(jq 'length' <<< "$run_json")"
fi
if [[ "$run_count" -eq 0 ]]; then
  echo "${C_OK}✓${C_OFF} ${C_BOLD}sweep already complete${C_OFF} ${C_DIM}(checkpoint had nothing left)${C_OFF}"
  sweep_state_clear
  summary_and_exit 0
fi

# Phase batches: postgres entries run in dest-disjoint + lock-disjoint waves
# (same Render dest or same instance advisory lock stay sequential). Other
# entries run concurrently when their 1Password items do not overlap.
for phase in 1 2 3; do
  phase_json="$(jq -c --argjson ph "$phase" '[.[] | select(.phase == $ph)]' <<< "$run_json")"
  n="$(jq 'length' <<< "$phase_json")"
  [[ "$n" -gt 0 ]] || continue

  if [[ "$phase" -eq 1 || "$phase" -eq 3 ]]; then
    # postgres: dest-disjoint + lock-disjoint waves. Same Render dest or the
    # same instance advisory lock stay sequential (overlapping dests 202; same
    # lock exits 2).
    remaining="$phase_json"
    while [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]]; do
      wave_split="$(split_postgres_wave "$remaining")"
      current="$(jq -c '.now' <<< "$wave_split")"
      remaining="$(jq -c '.later' <<< "$wave_split")"
      bn="$(jq 'length' <<< "$current")"
      pids=() ids=() entries=()
      batch_t0=$SECONDS
      while IFS= read -r entry; do
        idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
        xtra=""
        if [[ "$phase" -eq 1 && "$first_staging_pg" -eq 1 ]]; then
          xtra="--keep-old"; first_staging_pg=0
          CANARY_REF="$(jq -r '.ref' <<< "$entry")"
          sweep_state_save
        fi
        how="postgres"
        [[ "$bn" -gt 1 ]] && how="postgres, parallel x$bn"
        echo "${C_RUN}⟳${C_OFF} [$idx/$run_count] $id${xtra:+ ${C_DIM}$xtra${C_OFF}} ${C_DIM}($how)${C_OFF}"
        logf="$logdir/$id.log"; : > "$logf"
        (
          rc=0
          rotate_one "$entry" "$logf" "$xtra" || rc=$?
          if [[ "$rc" -ne 0 ]] && grep -q 'rerun with --resume' "$logf"; then
            echo "  unfinished rotation state found — resuming it" >> "$logf"
            rc=0; rotate_one "$entry" "$logf" "--resume" || rc=$?
          fi
          exit "$rc"
        ) &
        pids+=($!); ids+=("$id"); entries+=("$entry")
      done < <(jq -c '.[]' <<< "$current")
      i=0
      for pid in "${pids[@]}"; do
        rc=0; wait "$pid" || rc=$?
        dt=$((SECONDS - batch_t0))
        id="${ids[$i]}"; entry="${entries[$i]}"
        if [[ "$rc" -ne 0 ]]; then
          entry_fail "$id" "$rc" "$dt" "$logdir/$id.log"
          record_result "$id" "failed" "$dt"
          failed=$((failed + 1))
        else
          kind="$(entry_kind "$entry")"
          entry_ok "$id" "$dt" "$logdir/$id.log" "$kind"
          record_result "$id" "ok" "$dt" "$kind"
          sweep_mark_completed "$id"
          ran=$((ran + 1))
        fi
        i=$((i + 1))
      done
      [[ "$failed" -eq 0 ]] || summary_and_exit 1
    done
  else
    # non-postgres: deploys are deferred to finalize_pending_deploys, so env
    # saves cannot race — the whole phase runs as one parallel batch.
    remaining="$phase_json"
    while [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]]; do
      # Wave partitioning: entries whose refs live in the SAME 1Password item
      # (grouped items hold several rotated fields) must not write concurrently
      # — each edit replaces the whole item, so parallel writers race on the
      # item version (409 Conflict; the vault layer retries, but not racing at
      # all is cheaper and deterministic). Take, per item, only the first
      # entry into this wave; the rest run in the next wave. Worst observed
      # depth is 3 (Decrypt proxy staging), so this adds at most ~2 waves.
      wave_split="$(jq -c '
        def items: ([.ref] + (.sync_refs // [])) | map(select(startswith("op://")) | sub("^op://"; "") | sub("/[^/]*$"; ""));
        . as $all
        | reduce range(0; length) as $i ({claimed: [], now: [], later: []};
            ($all[$i] | items) as $mine
            | if ([.claimed[]] | any(. as $c | $mine | index($c) != null))
              then .later += [$all[$i]]
              else .now += [$all[$i]] | .claimed += $mine
              end)
        | {now: .now, later: .later}' <<< "$remaining")"
      current="$(jq -c '.now' <<< "$wave_split")"
      remaining="$(jq -c '.later' <<< "$wave_split")"
      bn="$(jq 'length' <<< "$current")"
      pids=() ids=() entries=()
      batch_t0=$SECONDS
      while IFS= read -r entry; do
        idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
        echo "${C_RUN}⟳${C_OFF} [$idx/$run_count] $id ${C_DIM}(parallel x$bn)${C_OFF}"
        logf="$logdir/$id.log"; : > "$logf"
        rotate_one "$entry" "$logf" "" 1 &
        pids+=($!); ids+=("$id"); entries+=("$entry")
      done < <(jq -c '.[]' <<< "$current")
      i=0
      for pid in "${pids[@]}"; do
        rc=0; wait "$pid" || rc=$?
        dt=$((SECONDS - batch_t0))
        id="${ids[$i]}"; entry="${entries[$i]}"
        if [[ "$rc" -ne 0 ]]; then
          entry_fail "$id" "$rc" "$dt" "$logdir/$id.log"
          record_result "$id" "failed" "$dt"
          failed=$((failed + 1))
        else
          kind="$(entry_kind "$entry")"
          entry_ok "$id" "$dt" "$logdir/$id.log" "$kind"
          record_result "$id" "ok" "$dt" "$kind"
          sweep_mark_minted "$id"
          ran=$((ran + 1))
        fi
        i=$((i + 1))
      done
      [[ "$failed" -eq 0 ]] || summary_and_exit 1
    done
    if [[ "$dry" -eq 0 ]]; then
      sweep_capture_pending_dests
      finalize_pending_deploys || summary_and_exit 1
      sweep_promote_minted
    fi
  fi

done

finalize_canary || summary_and_exit 1
summary_and_exit 0
