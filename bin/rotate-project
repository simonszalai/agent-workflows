#!/usr/bin/env bash
# rotate-project — one-command full rotation sweep for a project.
#
# Runs every config/secret-rotation.json entry belonging to --project through
# rotate-secret in a safe order, verifying consumer health after each entry:
#
#   1. staging postgres entries      (first one runs --keep-old as the canary)
#   2. SELF_MINTED entries           (fully automatic)
#   3. provider entries              (automated when the provider handler can
#                                     mint; otherwise the script prompts you to
#                                     paste the freshly minted value ONCE — it
#                                     is read silently and piped to --complete,
#                                     never argv or history)
#   4. prod postgres entries         (one at a time, health-gated between)
#
# Stops on the first failure; rerunning is safe (rotate-secret is resumable /
# idempotent per entry). Values never reach stdout or argv.
#
# By default only entries that rotate WITHOUT manual intervention run
# (postgres, self-minted, and providers whose registry entry declares
# "automated": true). --manual runs ONLY the manual-intervention entries
# (AWS/Resend-style mint-at-provider flows); --all runs both.
#
# usage:
#   rotate-project <amaru|ts|workflow-pro|autodev> --reason "<why>"
#                  [--dry-run] [--tier staging|prod|all] [--manual | --all]
#                  [--skip id[,id...]] [--only id[,id...]]
#
# exit codes: 0 all entries rotated+verified, 1 a rotation or health check
#   failed (state printed), 2 usage/config, 3 agent-shell refusal.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REGISTRY="${ROTATION_REGISTRY:-$HERE/../config/secret-rotation.json}"
ROTATE="${ROTATE_SECRET:-$HERE/rotate-secret}"

usage() { sed -n '2,25p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//' >&2; exit 2; }

project="" reason="" dry=0 tier="all" skip="" only="" scope="auto"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --manual) scope="manual"; shift ;;
    --all) scope="all"; shift ;;
    --tier) tier="${2:?}"; shift 2 ;;
    --tier=*) tier="${1#*=}"; shift ;;
    --skip) skip="${2:?}"; shift 2 ;;
    --skip=*) skip="${1#*=}"; shift ;;
    --only) only="${2:?}"; shift 2 ;;
    --only=*) only="${1#*=}"; shift ;;
    -h|--help) usage ;;
    -*) echo "ERROR: unknown flag $1" >&2; usage ;;
    *) [[ -z "$project" ]] || usage; project="$1"; shift ;;
  esac
done
[[ -n "$project" ]] || usage
[[ -n "$reason" || "$dry" -eq 1 ]] || { echo "ERROR: --reason is required for a live sweep." >&2; exit 2; }
case "$tier" in staging|prod|all) ;; *) echo "ERROR: --tier must be staging|prod|all" >&2; exit 2 ;; esac
command -v jq >/dev/null || { echo "ERROR: missing dependency: jq" >&2; exit 2; }
[[ -f "$REGISTRY" ]] || { echo "ERROR: registry not found: $REGISTRY" >&2; exit 2; }

# Entry selection + phase classification. Staging-ness comes from the ref's
# item name (environment is encoded in item titles across every vault).
plan_json="$(jq -c --arg p "$project" '
  [.secrets[] | select(.project == $p)
   | . + {staging: ((.ref // "") | test("staging"; "i")),
          auto: (.provider == "postgres" or .mode == "SELF_MINTED" or (.automated // false)),
          phase: (if .provider == "postgres" and ((.ref // "") | test("staging"; "i")) then 1
                  elif .mode == "SELF_MINTED" then 2
                  elif .provider != "postgres" then 3
                  else 4 end)}]
  | sort_by(.phase)' "$REGISTRY")"
count="$(jq 'length' <<< "$plan_json")"
[[ "$count" -gt 0 ]] || { echo "ERROR: no registry entries for project '$project'." >&2; exit 2; }

in_csv() { local needle="$1" csv="$2"; [[ ",$csv," == *",$needle,"* ]]; }

health_gate() { # entry json -> verify every consumer dest registered in health_urls
  local entry="$1" dest url body ok=1
  while IFS= read -r dest; do
    url="$(jq -r --arg d "$dest" '.health_urls[$d] // empty' "$REGISTRY")"
    [[ -n "$url" ]] || continue
    if body="$(curl -sf --max-time 30 "$url")"; then
      if jq -e 'has("databaseRoleSafe")' <<< "$body" >/dev/null 2>&1 \
         && ! jq -e '.status == "ok" and .databaseRoleSafe == true' <<< "$body" >/dev/null; then
        echo "  HEALTH FAIL $dest ($url): $body" >&2; ok=0
      else
        echo "  health ok: $dest"
      fi
    else
      echo "  HEALTH FAIL $dest ($url): unreachable/non-200" >&2; ok=0
    fi
  done < <(jq -r '.consumers[]?.dest' <<< "$entry" | sort -u)
  [[ "$ok" -eq 1 ]]
}

# Filter the plan down to what this invocation actually runs.
run_json="$(jq -c --arg tier "$tier" --arg only "$only" --arg skip "$skip" --arg scope "$scope" '
  def incsv($csv): ($csv | split(",")) as $l | . as $x | ($l | index($x)) != null;
  [.[] | select(($only == "" or (.id | incsv($only)))
    and (($skip == "") or ((.id | incsv($skip)) | not))
    and (if $scope == "auto" then .auto
         elif $scope == "manual" then (.auto | not)
         else true end)
    and (if $tier == "staging" then .staging
         elif $tier == "prod" then (.staging | not)
         else true end))]' <<< "$plan_json")"
run_count="$(jq 'length' <<< "$run_json")"
skipped=$((count - run_count))
# --- output helpers (concise per-entry status; full logs only on failure) ----
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  C_OK=$'\033[32m'; C_ERR=$'\033[31m'; C_RUN=$'\033[36m'; C_DIM=$'\033[2m'; C_BOLD=$'\033[1m'; C_OFF=$'\033[0m'
else
  C_OK=""; C_ERR=""; C_RUN=""; C_DIM=""; C_BOLD=""; C_OFF=""
fi
fmt_dur() { local t="$1"; if [[ "$t" -ge 60 ]]; then printf '%dm%02ds' $((t/60)) $((t%60)); else printf '%ds' "$t"; fi; }
log_highlights() { # concise facts pulled from a full entry log
  grep -E '^\s*(vault: updated|vault: created op|db: retired|drain: predecessor|render\[[^]]*\] deploy |minted new|health ok:)' "$1" \
    | sed -E 's/^ */    /' | sort -u | head -6 || true
}
entry_ok() { # id, seconds, logf
  echo "${C_OK}✓${C_OFF} ${C_BOLD}$1${C_OFF} ${C_DIM}($(fmt_dur "$2"))${C_OFF}"
  log_highlights "$3"
}
entry_fail() { # id, rc, seconds, logf
  echo "${C_ERR}✗ ${C_BOLD}$1${C_OFF}${C_ERR} failed (rc=$2, $(fmt_dur "$3"))${C_OFF}"
  echo "${C_DIM}  ── last log lines ──${C_OFF}"
  tail -12 "$4" | sed 's/^/  /'
  echo "${C_DIM}  full log: $4${C_OFF}"
}
RESULT_IDS=(); RESULT_STATES=(); RESULT_TIMES=()
record_result() { RESULT_IDS+=("$1"); RESULT_STATES+=("$2"); RESULT_TIMES+=("$3"); }

summary_and_exit() { # exit code
  local code="$1" i=0 state mark total=$SECONDS
  echo
  echo "${C_BOLD}── rotate-project $project summary ──${C_OFF}"
  for id in "${RESULT_IDS[@]-}"; do
    [[ -n "$id" ]] || continue
    state="${RESULT_STATES[$i]}"
    if [[ "$state" == "ok" ]]; then mark="${C_OK}✓${C_OFF}"; else mark="${C_ERR}✗${C_OFF}"; fi
    printf '  %b %-45s %s\n' "$mark" "$id" "$(fmt_dur "${RESULT_TIMES[$i]}")"
    i=$((i + 1))
  done
  if [[ "$code" -eq 0 ]]; then
    echo "  ${C_OK}${C_BOLD}$ran rotated+verified${C_OFF} ${C_DIM}in $(fmt_dur "$total") ($skipped filtered out)${C_OFF}"
  else
    echo "  ${C_ERR}${C_BOLD}stopped after a failure${C_OFF} ${C_DIM}— rerun the same command to resume (completed entries converge instantly)${C_OFF}"
  fi
  exit "$code"
}


echo "${C_BOLD}rotate-project $project${C_OFF} — $run_count of $count entries ${C_DIM}(tier=$tier scope=$scope, $skipped filtered out)${C_OFF}"
if [[ "$scope" == "auto" ]]; then
  manual_left="$(jq -r --arg tier "$tier" '[.[] | select((.auto | not)
    and (if $tier == "staging" then .staging elif $tier == "prod" then (.staging | not) else true end)) | .id] | join(", ")' <<< "$plan_json")"
  [[ -z "$manual_left" ]] || echo "manual-intervention entries NOT included (run with --manual): $manual_left"
fi

# --- dry-run: render the full plan (credential-free) and exit ----------------
finalize_canary() {
  # A --keep-old canary leaves one predecessor login valid as the sweep's
  # rollback window. Once every entry succeeded there is nothing to roll back
  # to, so retire it (idempotent: no state file -> immediate no-op).
  [[ -n "${CANARY_REF:-}" ]] || return 0
  echo "${C_RUN}⟳${C_OFF} finalizing canary ${C_DIM}(retiring the kept predecessor login)${C_OFF}"
  local logf="$logdir/canary-finalize.log"; : > "$logf"
  if "$ROTATE" --ref "$CANARY_REF" --reason "$reason [canary finalize]" --yes --resume >> "$logf" 2>&1; then
    echo "${C_OK}✓${C_OFF} canary predecessor retired"
  else
    echo "${C_ERR}✗ canary finalize failed — predecessor login remains valid (safe).${C_OFF}"
    tail -8 "$logf" | sed 's/^/  /'
    return 1
  fi
}

if [[ "$dry" -eq 1 ]]; then
  render_plan_section() { # title, color, entries json
    local title="$1" color="$2" entries="$3" n entry id provider mode phase staging how ref dest env repo label host
    n="$(jq 'length' <<< "$entries")"
    [[ "$n" -gt 0 ]] || return 0
    echo
    echo "${color}${C_BOLD}${title} (${n})${C_OFF}"
    while IFS= read -r entry; do
      id="$(jq -r '.id' <<< "$entry")"
      provider="$(jq -r '.provider' <<< "$entry")"
      mode="$(jq -r '.mode' <<< "$entry")"
      phase="$(jq -r '.phase' <<< "$entry")"
      staging="$(jq -r '.staging' <<< "$entry")"
      if [[ "$phase" == "1" || "$phase" == "4" ]]; then how="sequential"; else how="parallel · save-only, one deploy per service"; fi
      local tierlabel="prod"; [[ "$staging" == "true" ]] && tierlabel="staging"
      local plan=""
      case "$provider" in
        postgres)
          if [[ "$phase" == "1" && "${dry_canary_flagged:-0}" -eq 0 ]]; then
            dry_canary_flagged=1
            plan="stage new versioned DB login → deploy → health-gate; keep predecessor as rollback (canary), auto-retired after the sweep succeeds"
          else
            plan="stage new versioned DB login → deploy → health-gate → drain + retire predecessor"
          fi ;;
        self_minted) plan="mint $(jq -r '(.generate.format // "hex") + "/" + ((.generate.bytes // 32)|tostring)' <<< "$entry") automatically → sync consumers → deploy once per service" ;;
        *) plan="you mint at the provider dashboard, paste once → sync consumers → deploy once per service" ;;
      esac
      echo "  ${C_BOLD}${id}${C_OFF} ${C_DIM}${provider} · ${tierlabel} · ${how}${C_OFF}"
      echo "    ${C_DIM}plan${C_OFF}  $plan"
      local src
      src="$(jq -r '.ref' <<< "$entry")"
      while IFS=$'\t' read -r dest env repo; do
        [[ -n "$dest" ]] || continue
        if [[ "$dest" == srv-* ]]; then
          host="$(jq -r --arg d "$dest" '.health_urls[$d] // empty' "$REGISTRY" | sed -E 's#https?://##; s#/.*##')"
          label="render:${host:-$dest}"
        else
          label="github:$dest"
        fi
        printf '    %bmap%b   %b%s%b  %b→%b  %s  %b%s%b\n' \
          "$C_DIM" "$C_OFF" "$C_RUN" "$src" "$C_OFF" "$C_DIM" "$C_OFF" "$label" "$C_BOLD" "$env" "$C_OFF"
      done < <(jq -r '.consumers[]? | [.dest, .env, .repo] | @tsv' <<< "$entry")
      echo
    done < <(jq -c '.[]' <<< "$entries")
  }
  auto_json="$(jq -c '[.[] | select(.auto)]' <<< "$run_json")"
  manual_json="$(jq -c '[.[] | select(.auto | not)]' <<< "$run_json")"
  render_plan_section "AUTOMATIC — runs hands-off" "$C_OK" "$auto_json"
  render_plan_section "MANUAL — prompts for a provider-minted value" "$C_ERR" "$manual_json"
  echo
  echo "${C_DIM}dry-run: nothing was read from 1Password or written anywhere.${C_OFF}"
  exit 0
fi


rotate_one() { # entry json, log file, extra flag or "", batched(0|1); returns rotate rc
  local entry="$1" logf="$2" xtra="$3" batched="${4:-0}" id ref rc=0
  id="$(jq -r '.id' <<< "$entry")"
  ref="$(jq -r '.ref' <<< "$entry")"
  if [[ "$batched" -eq 1 ]]; then
    # Save-only: values are written everywhere but Render deploys are deferred;
    # the orchestrator deploys each touched service once per phase.
    ROTATE_NO_DEPLOY=1 "$ROTATE" --ref "$ref" --reason "$reason [$id]" --yes ${xtra:+"$xtra"} >> "$logf" 2>&1 || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      jq -r '.consumers[]?.dest' <<< "$entry" >> "$logdir/pending-dests"
    fi
  else
    "$ROTATE" --ref "$ref" --reason "$reason [$id]" --yes ${xtra:+"$xtra"} >> "$logf" 2>&1 || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      health_gate "$entry" >> "$logf" 2>&1 || rc=99
    fi
  fi
  return "$rc"
}

# Deploy every service touched by the batched saves exactly once, wait for the
# deploy to reach a terminal state, then health-gate the service.
finalize_pending_deploys() {
  local sid url status key ref deadline ok=1
  [[ -s "$logdir/pending-dests" ]] || return 0
  # shellcheck source=../secrets/lib/read.sh
  source "$HERE/../secrets/lib/read.sh"
  # shellcheck source=../secrets/lib/render-api.sh
  source "$HERE/../secrets/lib/render-api.sh"
  local sids
  sids="$(sort -u "$logdir/pending-dests")"
  : > "$logdir/pending-dests"
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    ref="$(render_key_ref_for "$sid")" || { echo "ERROR: no Render key ref for $sid" >&2; return 1; }
    RENDER_API_KEY="$(op_vault_read "$ref")" || { echo "ERROR: could not resolve Render key for $sid" >&2; return 1; }
    export RENDER_API_KEY
    render_trigger_deploy "$sid" || { echo "ERROR: deploy trigger failed for $sid" >&2; return 1; }
  done <<< "$sids"
  while IFS= read -r sid; do
    [[ -n "$sid" ]] || continue
    ref="$(render_key_ref_for "$sid")" || return 1
    RENDER_API_KEY="$(op_vault_read "$ref")" || return 1
    export RENDER_API_KEY
    deadline=$(( $(date +%s) + 1200 ))
    while [[ $(date +%s) -lt $deadline ]]; do
      status="$(render_get "/services/${sid}/deploys?limit=1" | jq -r '.[0].deploy.status // .[0].status // empty')" || status=""
      case "$status" in
        live) break ;;
        build_failed|update_failed|canceled|deactivated) echo "ERROR: deploy for $sid ended $status" >&2; return 1 ;;
        *) sleep 15 ;;
      esac
    done
    [[ "$status" == "live" ]] || { echo "ERROR: deploy for $sid did not go live in time" >&2; return 1; }
    url="$(jq -r --arg d "$sid" '.health_urls[$d] // empty' "$REGISTRY")"
    if [[ -n "$url" ]]; then
      if curl -sf --max-time 30 "$url" >/dev/null; then
        echo "  ${C_OK}deployed + healthy:${C_OFF} $sid"
      else
        echo "ERROR: post-deploy health check failed for $sid ($url)" >&2; ok=0
      fi
    else
      echo "  deployed: $sid ${C_DIM}(no health URL registered)${C_OFF}"
    fi
  done <<< "$sids"
  [[ "$ok" -eq 1 ]]
}

manual_complete() { # entry json (provider printed its playbook already)
  local entry="$1" id ref new_value
  id="$(jq -r '.id' <<< "$entry")"
  ref="$(jq -r '.ref' <<< "$entry")"
  if ! { : < /dev/tty; } 2>/dev/null; then
    echo "ERROR: $id needs a manually minted value but there is no controlling terminal." >&2; return 1
  fi
  printf 'Paste the NEW value for %s (input hidden, Enter to submit): ' "$id" > /dev/tty
  IFS= read -rs new_value < /dev/tty; echo > /dev/tty
  [[ -n "$new_value" ]] || { echo "ERROR: empty value — aborting before touching $id." >&2; return 1; }
  printf %s "$new_value" | "$ROTATE" --ref "$ref" --reason "$reason [$id]" --complete || { new_value=""; return 1; }
  new_value=""
  health_gate "$entry"
}

logdir="$(mktemp -d)"
trap 'rm -rf "$logdir"' EXIT
first_staging_pg=1 ran=0 failed=0 idx=0
manual_queue=()

# Phase batches: postgres entries run strictly sequentially (instance advisory
# lock); other entries within one phase run concurrently when their consumer
# dest sets are pairwise disjoint (overlapping services would race deploys).
for phase in 1 2 3 4; do
  phase_json="$(jq -c --argjson ph "$phase" '[.[] | select(.phase == $ph)]' <<< "$run_json")"
  n="$(jq 'length' <<< "$phase_json")"
  [[ "$n" -gt 0 ]] || continue

  if [[ "$phase" -eq 1 || "$phase" -eq 4 ]]; then
    # postgres: sequential
    while IFS= read -r entry; do
      idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
      xtra=""
      if [[ "$phase" -eq 1 && "$first_staging_pg" -eq 1 ]]; then xtra="--keep-old"; first_staging_pg=0; CANARY_REF="$(jq -r '.ref' <<< "$entry")"; fi
      echo "${C_RUN}⟳${C_OFF} [$idx/$run_count] $id${xtra:+ ${C_DIM}$xtra${C_OFF}} ${C_DIM}(postgres, sequential)${C_OFF}"
      logf="$logdir/$id.log"; : > "$logf"
      t0=$SECONDS
      rc=0; rotate_one "$entry" "$logf" "$xtra" || rc=$?
      dt=$((SECONDS - t0))
      if [[ "$rc" -ne 0 ]]; then
        entry_fail "$id" "$rc" "$dt" "$logf"
        record_result "$id" "failed" "$dt"
        summary_and_exit 1
      fi
      entry_ok "$id" "$dt" "$logf"
      record_result "$id" "ok" "$dt"
      ran=$((ran + 1))
    done < <(jq -c '.[]' <<< "$phase_json")
  else
    # non-postgres: deploys are deferred to finalize_pending_deploys, so env
    # saves cannot race — the whole phase runs as one parallel batch.
    remaining="$phase_json"
    while [[ "$(jq 'length' <<< "$remaining")" -gt 0 ]]; do
      current="$remaining"
      remaining="[]"
      bn="$(jq 'length' <<< "$current")"
      pids=() ids=() entries=()
      batch_t0=$SECONDS
      while IFS= read -r entry; do
        idx=$((idx + 1)); id="$(jq -r '.id' <<< "$entry")"
        echo "${C_RUN}⟳${C_OFF} [$idx/$run_count] $id ${C_DIM}(parallel x$bn)${C_OFF}"
        logf="$logdir/$id.log"; : > "$logf"
        rotate_one "$entry" "$logf" "" 1 &
        pids+=($!); ids+=("$id"); entries+=("$entry")
      done < <(jq -c '.[]' <<< "$current")
      i=0
      for pid in "${pids[@]}"; do
        rc=0; wait "$pid" || rc=$?
        dt=$((SECONDS - batch_t0))
        id="${ids[$i]}"; entry="${entries[$i]}"
        if [[ "$rc" -eq 3 ]]; then
          echo "${C_DIM}◻ $id needs a manually minted value — queued for the paste phase${C_OFF}"
          manual_queue+=("$entry")
        elif [[ "$rc" -ne 0 ]]; then
          entry_fail "$id" "$rc" "$dt" "$logdir/$id.log"
          record_result "$id" "failed" "$dt"
          failed=$((failed + 1))
        else
          entry_ok "$id" "$dt" "$logdir/$id.log"
          record_result "$id" "ok" "$dt"
          ran=$((ran + 1))
        fi
        i=$((i + 1))
      done
      [[ "$failed" -eq 0 ]] || summary_and_exit 1
    done
    if [[ "$dry" -eq 0 ]]; then
      finalize_pending_deploys || summary_and_exit 1
    fi
  fi

  # Manual-completion queue drains at the end of its phase, one prompt at a time.
  if [[ "${#manual_queue[@]}" -gt 0 && "$dry" -eq 0 ]]; then
    for entry in "${manual_queue[@]}"; do
      mid="$(jq -r '.id' <<< "$entry")"; t0=$SECONDS
      if manual_complete "$entry"; then
        record_result "$mid" "ok" "$((SECONDS - t0))"
      else
        record_result "$mid" "failed" "$((SECONDS - t0))"
        summary_and_exit 1
      fi
      ran=$((ran + 1))
    done
    manual_queue=()
  fi
done

finalize_canary || summary_and_exit 1
summary_and_exit 0
