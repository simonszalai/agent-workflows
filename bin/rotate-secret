#!/usr/bin/env bash
# rotate-secret — registry-driven two-stage secret rotation.
#
#   rotate    provider mints/stages the new credential and writes the canonical
#             1Password item in place (immutable id, verified); the PREDECESSOR
#             STAYS VALID.
#   fan-out   sync-secrets --changed <ref> to the owner project and every
#             cross-project sync_repos (deploy ids recorded), then the repo hook.
#   prove     wait for every recorded deploy to go live + health gate.
#   finalize  provider retires the predecessor. Never before the proof.
#
# Between rotate and finalize a VALUE-FREE finalize-state file lives under
# ${ROTATE_STATE_DIR:-~/.local/state/agent-workflows/rotate-secret}/<project>/<id>.json
# so every stage is rerunnable: a normal run that finds one REFUSES (no silent
# double mint); --resume redoes verify → fan-out → prove → finalize without
# re-minting; --finalize runs only the finalize stage (idempotent when nothing
# is pending) and is refused until the fan-out has completed (fannedOut).
# NEVER invents providers: unknown (project, item, field) is a hard error
# listing the known registry entries.
#
# usage:
#   rotate-secret --project <id> --item "<Item title>" --field <field> --reason "<why>" \
#                 [--dry-run] [--yes] [--no-finalize|--resume|--finalize]
#   rotate-secret --ref 'op://Vault/Item/field' --reason "<why>" [--dry-run] [--yes] [...]
#   printf %s '<new-value>' | rotate-secret --ref '...' --reason "<why>" --complete
#
# exit codes:
#   0  ok
#   2  usage / unknown registry entry / unknown provider / unfinished rotation
#      state present (rerun with --resume or --finalize) / lock contention
#   3  manual playbook printed or precondition refused, nothing changed
#      (also: agent-shell refusal)
#   4  provider/verify error — vault consistent
#   5  vault holds the NEW value but fan-out/hook/deploy-wait failed
#      (recovery printed; --resume is the recovery)
#   6  rotation complete but predecessor cleanup pending (--finalize is the recovery)
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../secrets/lib}"
PROVIDERS_DIR="${SECRETS_PROVIDERS_DIR:-$HERE/../secrets/providers}"
SYNC_SECRETS_BIN="${SYNC_SECRETS_BIN:-$HERE/sync-secrets}"

# shellcheck source=../secrets/lib/read.sh
source "$SECRETS_LIB/read.sh"
# shellcheck source=../secrets/lib/vault.sh
source "$SECRETS_LIB/vault.sh"
# shellcheck source=../secrets/lib/config.sh
source "$SECRETS_LIB/config.sh"
# shellcheck source=../secrets/lib/render-api.sh
source "$SECRETS_LIB/render-api.sh"
# shellcheck source=../secrets/lib/deploy-wait.sh
source "$SECRETS_LIB/deploy-wait.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  rotate-secret --project <id> --item "<Item title>" --field <field> --reason "<why>" \
                [--dry-run] [--yes] [--no-finalize|--resume|--finalize]
  rotate-secret --ref 'op://Vault/Item/field' --reason "<why>" [--dry-run] [--yes] [...]
  printf %s '<new>' | rotate-secret --ref '...' --reason "<why>" --complete

Rotates a registered secret: provider rotate -> vault write -> fan-out ->
deploys live + health -> provider finalize (predecessor retired).
--dry-run      print the handler and the full consumer fan-out; mutate nothing.
--no-finalize  stop after fan-out (+hook); finalize-state stays on disk.
--finalize     run only the finalize stage from persisted state (idempotent).
--resume       redo fan-out/prove/finalize of an unfinished rotation without re-minting.
--complete     read the externally minted value from stdin once (manual providers).
EOF
  exit 2
}

repo="" project="" item="" field="" ref="" reason="" dry=0 yes=0 complete=0 resume=0 no_finalize=0 finalize_only=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo) repo="${2:?}"; shift 2 ;;
    --repo=*) repo="${1#*=}"; shift ;;
    --project) project="${2:?}"; shift 2 ;;
    --project=*) project="${1#*=}"; shift ;;
    --item) item="${2:?}"; shift 2 ;;
    --item=*) item="${1#*=}"; shift ;;
    --field) field="${2:?}"; shift 2 ;;
    --field=*) field="${1#*=}"; shift ;;
    --ref) ref="${2:?}"; shift 2 ;;
    --ref=*) ref="${1#*=}"; shift ;;
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --yes) yes=1; shift ;;
    --complete) complete=1; shift ;;
    --resume) resume=1; shift ;;
    --no-finalize) no_finalize=1; shift ;;
    --finalize) finalize_only=1; shift ;;
    -h|--help) usage ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage ;;
  esac
done
if [[ "$finalize_only" -eq 1 && $((resume + no_finalize + complete)) -gt 0 ]]; then
  echo "ERROR: --finalize cannot combine with --resume/--no-finalize/--complete" >&2; usage
fi

need jq
# Project config discovery: the repo you run from (or --repo) names the project.
# config_registry synthesizes the registry shape with consumers[] DERIVED from
# the routes, so an entry's consumer set can never drift from the routing truth.
if [[ -z "$repo" ]]; then
  repo="$(git rev-parse --show-toplevel 2>/dev/null)" \
    || { echo "ERROR: not inside a git repo; pass --repo <path>" >&2; exit 2; }
fi
repo="$(cd "$repo" 2>/dev/null && pwd)" || { echo "ERROR: repo path does not exist" >&2; exit 2; }
export _SECRETS_CONFIG="$repo"
REGISTRY="$(config_registry)" || exit 2
export SECRET_ROTATION_CONFIG="$REGISTRY"   # providers (postgres-rotate) + health_gate read this
config_project="$(jq -r '.secrets[0].project // empty' "$REGISTRY")"
if [[ -n "$project" && -n "$config_project" && "$project" != "$config_project" ]]; then
  echo "ERROR: --project $project but $repo belongs to project '$config_project'" >&2
  exit 2
fi

if [[ -n "$ref" ]]; then
  [[ "$ref" =~ ^op://[^/]+/[^/]+/[^/]+$ ]] || { echo "ERROR: --ref needs op://Vault/Item/field" >&2; exit 2; }
  entry="$(jq -c --arg ref "$ref" '.secrets[] | select(.ref == $ref)' "$REGISTRY")"
else
  [[ -n "$project" && -n "$item" && -n "$field" ]] || usage
  entry="$(jq -c --arg p "$project" --arg i "$item" --arg f "$field" '
    .secrets[] | select(.project == $p)
    | select((.ref | sub("^op://[^/]+/"; "") | sub("/[^/]+$"; "")) == $i)
    | select((.ref | sub("^op://[^/]+/[^/]+/"; "")) == $f)' "$REGISTRY")"
fi
if [[ -z "$entry" ]]; then
  echo "ERROR: no rotation entry for ${ref:-project=$project item='$item' field=$field}." >&2
  echo "Known entries (secrets.yaml rotation):" >&2
  jq -r '.secrets[] | "  \(.id)  \(.project)  \(.ref)  provider=\(.provider)"' "$REGISTRY" >&2
  exit 2
fi
disabled_reason="$(printf '%s' "$entry" | jq -r '.disabled_reason // ""')"
if [[ -n "$disabled_reason" ]]; then
  entry_id="$(printf '%s' "$entry" | jq -r '.id')"
  echo "REFUSED: rotation entry '$entry_id' is disabled: $disabled_reason" >&2
  exit 3
fi

ROTATE_ENTRY_JSON="$entry"
ROTATE_ID="$(printf '%s' "$entry" | jq -r '.id')"
ROTATE_PROJECT="$(printf '%s' "$entry" | jq -r '.project')"
ROTATE_REF="$(printf '%s' "$entry" | jq -r '.ref')"
ROTATE_PROVIDER="$(printf '%s' "$entry" | jq -r '.provider')"
ROTATE_REASON="$reason"
ROTATE_YES="$yes"
ROTATE_RESUME="$resume"

# The owner repo (entry owner_repo, resolved through `repos:`) hosts the
# optional rotation hook. Entries declaring hook: activate need repo-owned
# activation steps inside the rotation; hook: full delegates the WHOLE rotation
# to the hook. Declared-but-missing fails closed.
owner_repo_name="$(printf '%s' "$entry" | jq -r '.owner_repo // ""')"
if [[ -n "$owner_repo_name" ]]; then
  ROTATE_REPO="$(config_repo_path "$owner_repo_name")" || exit 2
else
  ROTATE_REPO="$repo"
fi
ROTATE_HOOK="$ROTATE_REPO/scripts/secrets/rotate-hook"
hook_mode="$(printf '%s' "$entry" | jq -r '.hook // ""')"
if [[ -n "$hook_mode" && ! -x "$ROTATE_HOOK" ]]; then
  echo "REFUSED: entry declares hook: $hook_mode but $ROTATE_HOOK is missing or not executable." >&2
  exit 3
fi
[[ -x "$ROTATE_HOOK" ]] || ROTATE_HOOK=""
export ROTATE_ENTRY_JSON ROTATE_ID ROTATE_PROJECT ROTATE_REF ROTATE_PROVIDER \
  ROTATE_REASON ROTATE_YES ROTATE_RESUME ROTATE_HOOK ROTATE_REPO

# Sync fan-out: ONE sync-secrets call per changed ref covers the whole project
# (the project config routes across every repo). Providers rotating a
# multi-item credential (e.g. an AWS id+secret pair) declare every changed ref
# in the entry's sync_refs; default is the entry ref alone.
fanout_refs="$(printf '%s' "$entry" | jq -r '(.sync_refs // [.ref]) | .[]')"

# Cross-project consumers: a credential routed by a SECOND project needs that
# project's manifest swept too, or its destinations keep the retired value.
sync_repos_rel=()
while IFS= read -r _rel; do
  [[ -n "$_rel" ]] || continue
  sync_repos_rel+=("$_rel")
done < <(printf '%s' "$entry" | jq -r '(.sync_repos // [])[]')
fanout_repos=("$repo")
cross_repos=()
if [[ "${#sync_repos_rel[@]}" -gt 0 ]]; then
  while IFS= read -r _abs; do
    [[ -n "$_abs" ]] || continue
    cross_repos+=("$_abs")
    fanout_repos+=("$_abs")
  done < <(config_sync_repos "${sync_repos_rel[@]}")
  [[ "${#cross_repos[@]}" -eq "${#sync_repos_rel[@]}" ]] || {
    echo "ERROR: cannot resolve sync_repos for $ROTATE_ID" >&2; exit 2; }
fi

# Routes of a sibling project's config for one ref (kind dest env ref transform
# repo, tab-separated). Subshell: config.sh caches its parse per process, so the
# sibling config must be read with the cache variables unset.
sibling_rows() { # repo ref
  ( unset _CONFIG_ROWS _CONFIG_DOC _CONFIG_FILE _CONFIG_REGISTRY_FILE
    _SECRETS_CONFIG="$1"
    config_rows_full "" "" "$2" 2>/dev/null )
}

# Postgres: the rotator's finalize inventory scan treats only DECLARED
# consumers as reached by the fan-out; cross-project Render routes of the
# fan-out refs are declared through ROTATE_EXTRA_CONSUMER_DESTS (sid/ENV ...).
# A sweep's inventory cache + id pass straight through when rotate-project set them.
if [[ "$ROTATE_PROVIDER" == "postgres" && "${#cross_repos[@]}" -gt 0 ]]; then
  ROTATE_EXTRA_CONSUMER_DESTS="$(
    for frepo in "${cross_repos[@]}"; do
      while IFS= read -r cref; do
        [[ -n "$cref" ]] || continue
        sibling_rows "$frepo" "$cref" | awk -F'\t' '$1 == "render" && $2 ~ /^(srv|crn)-/ {print $2 "/" $3}'
      done <<< "$fanout_refs"
    done | sort -u | tr '\n' ' ' | sed 's/ $//')"
  export ROTATE_EXTRA_CONSUMER_DESTS
fi
[[ -z "${ROTATE_INVENTORY_CACHE_DIR:-}" ]] || export ROTATE_INVENTORY_CACHE_DIR
[[ -z "${ROTATE_SWEEP_ID:-}" ]] || export ROTATE_SWEEP_ID

# --- finalize-state (value-free) ---------------------------------------------
STATE_DIR="${ROTATE_STATE_DIR:-$HOME/.local/state/agent-workflows/rotate-secret}/$ROTATE_PROJECT"
STATE_FILE="$STATE_DIR/$ROTATE_ID.json"

state_write() { # finalize-json
  local fin="${1:-null}"
  [[ -n "$fin" ]] || fin=null
  printf '%s' "$fin" | jq . >/dev/null 2>&1 || { echo "ERROR: provider finalize data is not JSON" >&2; return 4; }
  mkdir -p "$STATE_DIR" && chmod 700 "$STATE_DIR"
  jq -n -c --arg id "$ROTATE_ID" --arg ref "$ROTATE_REF" --arg p "$ROTATE_PROVIDER" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --argjson fin "$fin" \
    '{stateVersion:1, id:$id, ref:$ref, provider:$p, rotatedAt:$at, finalize:$fin, deploys:[], fannedOut:false, proven:false}' \
    > "$STATE_FILE.tmp" && chmod 600 "$STATE_FILE.tmp" && mv "$STATE_FILE.tmp" "$STATE_FILE"
}
state_update() { # [jq args...] filter — applied to the state file in place
  local tmp="$STATE_FILE.tmp"
  jq -c "$@" "$STATE_FILE" > "$tmp" && chmod 600 "$tmp" && mv "$tmp" "$STATE_FILE"
}
state_add_deploys() { # tsv file of dest<TAB>deployId
  [[ -s "$1" ]] || return 0
  local rows
  rows="$(jq -R -c 'split("\t") | select(length == 2 and .[0] != "" and .[1] != "") | {dest: .[0], deployId: .[1]}' "$1" | jq -s -c .)"
  state_update --argjson rows "$rows" '.deploys = ((.deploys + $rows) | unique)'
}

provider_file="$PROVIDERS_DIR/$ROTATE_PROVIDER.sh"
load_provider() {
  [[ "$hook_mode" == "full" ]] && return 0   # the hook owns the rotation; no provider
  if [[ ! -f "$provider_file" ]]; then
    echo "ERROR: provider '$ROTATE_PROVIDER' has no handler ($provider_file)." >&2
    echo "Implemented providers: $(cd "$PROVIDERS_DIR" && ls ./*.sh | sed 's|^\./||; s|\.sh$||' | tr '\n' ' ')" >&2
    exit 2
  fi
  # shellcheck disable=SC1090
  source "$provider_file"
}

if [[ "$dry" -eq 1 ]]; then
  echo "rotate-secret plan for $ROTATE_ID ($ROTATE_REF):"
  echo "  provider: $ROTATE_PROVIDER"
  load_provider
  if [[ "$hook_mode" == "full" ]]; then
    echo "  rotation: delegated to the repo hook (automatic)"
  elif provider_auto_ready 2>/dev/null; then
    echo "  rotation: automatic (rotate → fan-out → deploys live + health → finalize retires the predecessor)"
  else
    echo "  rotation: manual — the playbook is printed; complete with --complete"
  fi
  echo "  vault write: in-place by immutable id (create if absent)"
  while IFS= read -r cref; do
    [[ -n "$cref" ]] || continue
    for frepo in "${fanout_repos[@]}"; do
      echo "  fan-out: sync-secrets --repo $frepo --changed $cref"
    done
  done <<< "$fanout_refs"
  printf '%s' "$entry" | jq -r '(.routes // [])[] | "  consumer: \(.kind)[\(.dest)]  \(.env)  (\(.repo))"'
  for frepo in ${cross_repos[@]+"${cross_repos[@]}"}; do
    while IFS= read -r cref; do
      [[ -n "$cref" ]] || continue
      sibling_rows "$frepo" "$cref" \
        | awk -F'\t' -v r="$frepo" '{print "  cross-project consumer: " $1 "[" $2 "]  " $3 "  (" $6 " @ " r ")"}'
    done <<< "$fanout_refs"
  done
  if [[ -n "$hook_mode" ]]; then
    echo "  hook: scripts/secrets/rotate-hook ($hook_mode) @ $ROTATE_REPO"
    "$ROTATE_HOOK" plan 2>/dev/null | sed 's/^/    /' || true
  elif [[ -n "$ROTATE_HOOK" && "$ROTATE_PROVIDER" != "postgres" ]]; then
    echo "  hook: scripts/secrets/rotate-hook (post-sync) @ $ROTATE_REPO"
    "$ROTATE_HOOK" plan 2>/dev/null | sed 's/^/    /' || true
  fi
  if [[ -f "$STATE_FILE" ]]; then
    echo "  unfinished rotation state: $STATE_FILE (rerun with --resume, or --finalize)"
  fi
  # Provider-specific read-free plan detail (postgres prints its state machine).
  if declare -F provider_plan >/dev/null; then provider_plan; fi
  echo "  (dry-run: nothing read, nothing written)"
  exit 0
fi

[[ -n "$reason" ]] || { echo "ERROR: --reason is required for live rotations." >&2; exit 2; }
export SENSITIVE_ACCESS_REASON="$reason"
guard_agent_shell || exit 3
need openssl
load_provider

confirm_live() { # prompt
  if [[ "$yes" -ne 1 && -t 0 ]]; then
    confirm "$1" || { echo "Aborted." >&2; exit 2; }
  elif [[ "$yes" -ne 1 ]]; then
    echo "ERROR: non-interactive live rotation needs --yes." >&2
    exit 2
  fi
}

fan_out_sync() {
  local failed=0 cref frepo deploys_file
  local extra=()
  # The postgres rotator already activated its declared Render targets itself;
  # its fan-out covers github rows and derived consumers, so DB-credential rows
  # are skipped (not refused) in the writers.
  [[ "$ROTATE_PROVIDER" == "postgres" ]] && extra+=(--skip-db-rows)
  # ROTATE_NO_DEPLOY=1 (rotate-project batching) defers the Render deploy:
  # values are saved only; the orchestrator deploys each touched service once.
  [[ "${ROTATE_NO_DEPLOY:-0}" -eq 1 ]] && extra+=(--no-deploy)
  deploys_file="$(mktemp "${TMPDIR:-/tmp}/rotate-deploys.XXXXXX")"
  # The operator confirmed this live rotation: the prod prefect tier must not
  # prompt again (the writer would abort without a tty).
  export SECRETS_ASSUME_YES=1
  while IFS= read -r cref; do
    [[ -n "$cref" ]] || continue
    for frepo in "${fanout_repos[@]}"; do
      echo "== rotate-secret: fan-out sync ($frepo <- $cref) =="
      : > "$deploys_file"
      SYNC_DEPLOYS_FILE="$deploys_file" "$SYNC_SECRETS_BIN" --repo "$frepo" --changed "$cref" \
        --reason "$ROTATE_REASON" ${extra[@]+"${extra[@]}"} || failed=1
      # Persist after every leg: a later failed leg must not lose these ids.
      state_add_deploys "$deploys_file"
    done
  done <<< "$fanout_refs"
  rm -f "$deploys_file"
  return "$failed"
}

# Repo-specific post-sync activation (e.g. Prefect block saves for the tiers
# this entry routes into). postgres entries get their hook call from the
# rotator itself (activate, inside the dual-key window) — not here.
hook_post_sync() {
  [[ -n "$ROTATE_HOOK" && "$ROTATE_PROVIDER" != "postgres" ]] || return 0
  echo "== rotate-secret: repo hook post-sync ($ROTATE_HOOK) =="
  "$ROTATE_HOOK" post-sync
}

post_mint_recovery() {
  cat >&2 <<EOF
ERROR: the vault now holds the NEW value but at least one consumer sync failed.
Recovery (safe to repeat; the predecessor is still valid):
  rotate-secret --ref '$ROTATE_REF' --reason "$ROTATE_REASON" --yes --resume
(--finalize is refused until a --resume has completed the fan-out.) The legs were:
EOF
  local cref frepo
  while IFS= read -r cref; do
    [[ -n "$cref" ]] || continue
    for frepo in "${fanout_repos[@]}"; do
      echo "       sync-secrets --repo $frepo --changed $cref --reason \"$ROTATE_REASON\"" >&2
    done
  done <<< "$fanout_refs"
  echo "Until every consumer is synced+redeployed, services may still hold the OLD value. Nothing was deleted." >&2
}

verify_failed() {
  echo "ERROR: provider verification failed — investigate before syncing consumers." >&2
  echo "The vault holds the NEW value (predecessor still valid). Recovery: rotate-secret --ref '$ROTATE_REF' --reason \"$ROTATE_REASON\" --yes --resume" >&2
  exit 4
}

# Provider verification of the vault value (skipped for hook: full, which owns
# the whole rotation).
verify_minted() {
  [[ "$hook_mode" != "full" ]] && declare -F provider_verify >/dev/null || return 0
  provider_verify
}

# Deploy-liveness + health proof for the recorded deploys. Idempotent: once
# proven it is persisted and not repeated.
prove_live() {
  [[ "$(jq -r '.proven' "$STATE_FILE")" == "true" ]] && return 0
  local deploys_tsv rc=0
  deploys_tsv="$(mktemp "${TMPDIR:-/tmp}/rotate-deploys.XXXXXX")"
  jq -r '.deploys[] | [.dest, .deployId] | @tsv' "$STATE_FILE" > "$deploys_tsv"
  if [[ -s "$deploys_tsv" ]]; then
    echo "== rotate-secret: waiting for deploys to go live =="
    render_key_once "$repo" && deploy_wait_all "$deploys_tsv" || rc=1
  fi
  rm -f "$deploys_tsv"
  [[ "$rc" -eq 0 ]] || return 1
  echo "== rotate-secret: health gate =="
  health_gate "$ROTATE_ENTRY_JSON" || return 1
  state_update '.proven = true'
}

run_finalize() {
  local fin
  fin="$(jq -c '.finalize' "$STATE_FILE")"
  if [[ "$hook_mode" != "full" ]] && declare -F provider_finalize >/dev/null; then
    echo "== rotate-secret: finalize (retire predecessor) =="
    provider_finalize "$fin" || return 1
  fi
  rm -f "$STATE_FILE"
}

finalize_failed() {
  echo "ERROR: rotation complete (vault + fan-out + deploys live) but predecessor cleanup failed — the old credential may still be valid." >&2
  echo "Recovery: rotate-secret --ref '$ROTATE_REF' --reason \"$ROTATE_REASON\" --yes --finalize" >&2
  exit 6
}

# Everything after the vault holds the new value: fan-out → hook → (stop on
# --no-finalize) → prove live → finalize → state removed.
finish_rotation() {
  if ! fan_out_sync; then post_mint_recovery; exit 5; fi
  hook_post_sync || { echo "ERROR: repo hook post-sync failed — recovery: rotate-secret --ref '$ROTATE_REF' --reason \"$ROTATE_REASON\" --yes --resume" >&2; exit 5; }
  state_update '.fannedOut = true'
  if [[ "$no_finalize" -eq 1 ]]; then
    echo "rotate-secret: $ROTATE_ID rotated + fanned out; finalize deferred (--no-finalize). State: $STATE_FILE"
    exit 0
  fi
  prove_live || { echo "ERROR: deploys/health not proven — predecessor still valid. Recovery: rotate-secret --ref '$ROTATE_REF' --reason \"$ROTATE_REASON\" --yes --resume" >&2; exit 5; }
  run_finalize || finalize_failed
  cat <<EOF

rotate-secret: $ROTATE_ID rotated (vault + fan-out + deploys live + predecessor retired).
Next: if a consumer caches credentials (mcp-gateway etc.), restart it.
EOF
  exit 0
}

# --- --finalize: only the finalize stage, from persisted state ----------------
if [[ "$finalize_only" -eq 1 ]]; then
  if [[ ! -f "$STATE_FILE" ]]; then
    echo "rotate-secret: nothing to finalize for $ROTATE_ID"
    exit 0
  fi
  if [[ "$(jq -r '.fannedOut' "$STATE_FILE")" != "true" ]]; then
    echo "ERROR: $ROTATE_ID was minted but its fan-out never completed — consumers may still hold the OLD value; refusing to finalize." >&2
    echo "Recovery: rotate-secret --ref '$ROTATE_REF' --reason \"$ROTATE_REASON\" --yes --resume" >&2
    exit 5
  fi
  confirm_live "Finalize $ROTATE_ID ($ROTATE_REF): retire the predecessor now?"
  prove_live || { echo "ERROR: deploys/health not proven — predecessor still valid. Fix the consumers and rerun --finalize (or --resume)." >&2; exit 5; }
  run_finalize || finalize_failed
  echo "rotate-secret: $ROTATE_ID finalized (predecessor retired)."
  exit 0
fi

if [[ -f "$STATE_FILE" && "$resume" -ne 1 ]]; then
  echo "ERROR: unfinished rotation for $ROTATE_ID ($STATE_FILE); rerun with --resume (or --finalize)." >&2
  exit 2
fi

# --- --resume with state: skip the mint, redo fan-out → prove → finalize ------
if [[ -f "$STATE_FILE" ]]; then
  confirm_live "Resume $ROTATE_ID ($ROTATE_REF): redo fan-out and finalize without re-minting?"
  echo "== rotate-secret: resuming $ROTATE_ID (minted $(jq -r '.rotatedAt' "$STATE_FILE"); not re-minting) =="
  verify_minted || verify_failed
  finish_rotation
fi

# --- hook: full — the repo hook owns mint + vault + provider steps -----------
if [[ "$hook_mode" == "full" ]]; then
  confirm_live "Rotate $ROTATE_ID ($ROTATE_REF) via repo hook now?"
  echo "== rotate-secret: rotation delegated to repo hook ($ROTATE_HOOK rotate) =="
  "$ROTATE_HOOK" rotate || { echo "ERROR: repo hook rotation failed — nothing synced." >&2; exit 4; }
  state_write null || exit 4
  finish_rotation
fi

# --- --complete: externally minted value arrives on stdin ONCE ---------------
if [[ "$complete" -eq 1 ]]; then
  if [[ "${PROVIDER_ACCEPTS_COMPLETE:-0}" != "1" ]]; then
    echo "ERROR: --complete is only for providers that take an externally minted value (provider '$ROTATE_PROVIDER' mints its own; run without --complete)." >&2
    exit 2
  fi
  new_value="$(cat)"
  [[ -n "$new_value" ]] || { echo "ERROR: --complete got an empty value on stdin — vault untouched." >&2; exit 2; }
  VAULT_VALUE="$new_value" vault_write_value "$ROTATE_REF" || { new_value=""; exit 4; }
  new_value=""
  state_write "${PROVIDER_FINALIZE_JSON:-null}" || exit 4
  finish_rotation
fi

confirm_live "Rotate $ROTATE_ID ($ROTATE_REF) via $ROTATE_PROVIDER now?"

rc=0
provider_rotate || rc=$?
if [[ "$rc" -eq 7 ]]; then
  # Leftovers of an unfinished/crashed rotation: the provider reconciles them
  # into a predecessor (rc 0, PROVIDER_FINALIZE_JSON set, nothing minted) or
  # prints the playbook (rc 3).
  echo "== rotate-secret: provider found leftovers — reconciling =="
  rc=0
  provider_reconcile || rc=$?
  case "$rc" in
    0) ;;
    3) exit 3 ;;
    *) echo "ERROR: provider '$ROTATE_PROVIDER' reconcile failed (rc $rc) — see output above. Vault state is safe." >&2; exit 4 ;;
  esac
else
  case "$rc" in
    0) ;;
    2) exit 2 ;;  # usage / rotation-state mismatch / lock contention — nothing changed
    3) exit 3 ;;  # manual playbook printed / precondition refused, nothing changed
    *) echo "ERROR: provider '$ROTATE_PROVIDER' failed (rc $rc) — see output above. Vault state is safe." >&2; exit 4 ;;
  esac
fi
# State first: a verify failure must leave a resumable record, or a rerun
# would mint a second credential.
state_write "${PROVIDER_FINALIZE_JSON:-null}" || exit 4
verify_minted || verify_failed
finish_rotation
