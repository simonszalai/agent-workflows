#!/usr/bin/env bash
# rotate-secret — registry-driven secret rotation: mint/collect a new value,
# write the canonical 1Password item in place (immutable id, verified), then
# fan out `sync-secrets --changed <ref>` to the owner repo and every registered
# consumer repo. NEVER invents providers: unknown (project, item, field) is a
# hard error listing the known registry entries.
#
# usage:
#   rotate-secret --project <amaru|ts|workflow-pro|autodev> --item "<Item title>" --field <field> \
#     --reason "<why>" [--dry-run] [--yes] [--accept-brief-outage]
#   rotate-secret --ref 'op://Vault/Item/field' --reason "<why>" [...]
#   printf %s '<new-value>' | rotate-secret --ref '...' --reason "<why>" --complete
#
# exit codes:
#   0  rotated + vault + sync + verify OK
#   2  usage / unknown registry entry / unknown provider
#   3  manual playbook printed, nothing changed (also: agent-shell refusal)
#   4  provider/verify error — safe state, vault consistent
#   5  sync fan-out failed AFTER the vault was updated (recovery printed)
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../secrets/lib}"
PROVIDERS_DIR="${SECRETS_PROVIDERS_DIR:-$HERE/../secrets/providers}"
REGISTRY="${SECRET_ROTATION_CONFIG:-$HERE/../config/secret-rotation.json}"
SYNC_SECRETS_BIN="${SYNC_SECRETS_BIN:-$HERE/sync-secrets}"

# shellcheck source=../secrets/lib/read.sh
source "$SECRETS_LIB/read.sh"
# shellcheck source=../secrets/lib/vault.sh
source "$SECRETS_LIB/vault.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  rotate-secret --project <id> --item "<Item title>" --field <field> --reason "<why>" \
                [--dry-run] [--yes] [--accept-brief-outage]
  rotate-secret --ref 'op://Vault/Item/field' --reason "<why>" [--dry-run] [--yes]
  printf %s '<new>' | rotate-secret --ref '...' --reason "<why>" --complete

Rotates a registered secret: provider handler -> vault write -> sync fan-out.
--dry-run prints the handler and the full consumer fan-out; mutates nothing.
--complete reads the externally minted value from stdin once (manual providers).
EOF
  exit 2
}

project="" item="" field="" ref="" reason="" dry=0 yes=0 accept_outage=0 complete=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --project) project="${2:?}"; shift 2 ;;
    --project=*) project="${1#*=}"; shift ;;
    --item) item="${2:?}"; shift 2 ;;
    --item=*) item="${1#*=}"; shift ;;
    --field) field="${2:?}"; shift 2 ;;
    --field=*) field="${1#*=}"; shift ;;
    --ref) ref="${2:?}"; shift 2 ;;
    --ref=*) ref="${1#*=}"; shift ;;
    --reason) reason="${2:?}"; shift 2 ;;
    --reason=*) reason="${1#*=}"; shift ;;
    --dry-run) dry=1; shift ;;
    --yes) yes=1; shift ;;
    --accept-brief-outage) accept_outage=1; shift ;;
    --complete) complete=1; shift ;;
    -h|--help) usage ;;
    *) echo "ERROR: unknown argument: $1" >&2; usage ;;
  esac
done

need jq
[[ -f "$REGISTRY" ]] || { echo "ERROR: rotation registry not found: $REGISTRY" >&2; exit 2; }
jq -e '.schema_version == 1 and (.secrets | type == "array")' "$REGISTRY" >/dev/null \
  || { echo "ERROR: unsupported rotation registry schema: $REGISTRY" >&2; exit 2; }

if [[ -n "$ref" ]]; then
  [[ "$ref" =~ ^op://[^/]+/[^/]+/[^/]+$ ]] || { echo "ERROR: --ref needs op://Vault/Item/field" >&2; exit 2; }
  entry="$(jq -c --arg ref "$ref" '.secrets[] | select(.ref == $ref)' "$REGISTRY")"
else
  [[ -n "$project" && -n "$item" && -n "$field" ]] || usage
  entry="$(jq -c --arg p "$project" --arg i "$item" --arg f "$field" '
    .secrets[] | select(.project == $p)
    | select((.ref | sub("^op://[^/]+/"; "") | sub("/[^/]+$"; "")) == $i)
    | select((.ref | sub("^op://[^/]+/[^/]+/"; "")) == $f)' "$REGISTRY")"
fi
if [[ -z "$entry" ]]; then
  echo "ERROR: no rotation registry entry for ${ref:-project=$project item='$item' field=$field}." >&2
  echo "Known entries (config/secret-rotation.json):" >&2
  jq -r '.secrets[] | "  \(.id)  \(.project)  \(.ref)  provider=\(.provider)"' "$REGISTRY" >&2
  exit 2
fi
if [[ "$(printf '%s\n' "$entry" | grep -c .)" -ne 1 ]]; then
  echo "ERROR: registry lookup matched more than one entry — fix config/secret-rotation.json" >&2
  exit 2
fi

ROTATE_ENTRY_JSON="$entry"
ROTATE_ID="$(printf '%s' "$entry" | jq -r '.id')"
ROTATE_PROJECT="$(printf '%s' "$entry" | jq -r '.project')"
ROTATE_REF="$(printf '%s' "$entry" | jq -r '.ref')"
ROTATE_PROVIDER="$(printf '%s' "$entry" | jq -r '.provider')"
ROTATE_MODE="$(printf '%s' "$entry" | jq -r '.mode // "IN_PLACE"')"
ROTATE_OWNER_REPO="$(printf '%s' "$entry" | jq -r '.owner_repo')"
ROTATE_REASON="$reason"
ROTATE_YES="$yes"
ROTATE_ACCEPT_BRIEF_OUTAGE="$accept_outage"
export ROTATE_ENTRY_JSON ROTATE_ID ROTATE_PROJECT ROTATE_REF ROTATE_PROVIDER \
  ROTATE_MODE ROTATE_OWNER_REPO ROTATE_REASON ROTATE_YES ROTATE_ACCEPT_BRIEF_OUTAGE

# Fan-out repo list: owner first, then every distinct consumer repo.
fanout_repos="$(printf '%s' "$entry" | jq -r '[.owner_repo] + [(.consumers // [])[].repo] | unique | .[]')"

if [[ "$dry" -eq 1 ]]; then
  echo "rotate-secret plan for $ROTATE_ID ($ROTATE_REF):"
  echo "  provider: $ROTATE_PROVIDER  mode: $ROTATE_MODE"
  echo "  vault write: in-place by immutable id (create if absent)"
  echo "  fan-out (sync-secrets --changed $ROTATE_REF) to:"
  while IFS= read -r r; do
    [[ -n "$r" ]] && echo "    $r"
  done <<< "$fanout_repos"
  printf '%s' "$entry" | jq -r '(.consumers // [])[] | "  consumer: \(.repo)  \(.dest)  \(.env)"'
  echo "  (dry-run: nothing read, nothing written)"
  exit 0
fi

[[ -n "$reason" ]] || { echo "ERROR: --reason is required for live rotations." >&2; exit 2; }
export SENSITIVE_ACCESS_REASON="$reason"
guard_agent_shell || exit 3
need openssl

provider_file="$PROVIDERS_DIR/$ROTATE_PROVIDER.sh"
if [[ ! -f "$provider_file" ]]; then
  echo "ERROR: provider '$ROTATE_PROVIDER' has no handler yet ($provider_file)." >&2
  echo "Implemented providers: $(cd "$PROVIDERS_DIR" && ls ./*.sh | sed 's|^\./||; s|\.sh$||' | tr '\n' ' ')" >&2
  exit 2
fi
# shellcheck disable=SC1090
source "$provider_file"

fan_out_sync() {
  local failed=0 r
  while IFS= read -r r; do
    [[ -n "$r" ]] || continue
    echo "== rotate-secret: fan-out sync ($r) =="
    "$SYNC_SECRETS_BIN" --repo "$r" --changed "$ROTATE_REF" --reason "$ROTATE_REASON" || failed=1
  done <<< "$fanout_repos"
  return "$failed"
}

post_mint_recovery() {
  cat >&2 <<EOF
ERROR: the vault now holds the NEW value but at least one consumer sync failed.
Recovery (safe to repeat; sync is idempotent and upsert-only):
  1. Re-run the failed leg(s):
       sync-secrets --repo <repo> --changed $ROTATE_REF --reason "$ROTATE_REASON"
  2. Until every consumer is synced+redeployed, services may still hold the OLD
     value. Nothing was deleted; re-running the sync converges them.
EOF
}

if [[ "$complete" -eq 1 ]]; then
  # Manual completion: the externally minted value arrives on stdin ONCE.
  new_value="$(cat)"
  [[ -n "$new_value" ]] || { echo "ERROR: --complete got an empty value on stdin — vault untouched." >&2; exit 2; }
  VAULT_VALUE="$new_value" vault_write_value "$ROTATE_REF" || { new_value=""; exit 4; }
  new_value=""
  if ! fan_out_sync; then post_mint_recovery; exit 5; fi
  echo "rotate-secret: completed $ROTATE_ID (vault + fan-out OK)"
  exit 0
fi

if [[ "$yes" -ne 1 && -t 0 ]]; then
  confirm "Rotate $ROTATE_ID ($ROTATE_REF) via $ROTATE_PROVIDER now?" || { echo "Aborted." >&2; exit 2; }
elif [[ "$yes" -ne 1 ]]; then
  echo "ERROR: non-interactive live rotation needs --yes." >&2
  exit 2
fi

rc=0
provider_rotate || rc=$?
case "$rc" in
  0) ;;
  3) exit 3 ;;  # manual playbook printed, nothing changed
  *) echo "ERROR: provider '$ROTATE_PROVIDER' failed (rc $rc) — see output above. Vault state is safe." >&2; exit 4 ;;
esac

provider_verify || { echo "ERROR: provider verification failed — investigate before syncing consumers." >&2; exit 4; }

if ! fan_out_sync; then post_mint_recovery; exit 5; fi

cat <<EOF

rotate-secret: $ROTATE_ID rotated (vault + verify + fan-out OK).
Next:
  1. Confirm consumer services redeployed with the new value.
  2. If a consumer caches credentials (mcp-gateway etc.), restart it.
EOF
