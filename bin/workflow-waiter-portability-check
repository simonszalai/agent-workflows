#!/usr/bin/env python3
"""Reject repository-relative shared waiter invocations in active workflows."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


NONPORTABLE_WAITER = re.compile(r"\bbin/wait-[A-Za-z0-9_-]+\b")


def violations(root: Path) -> list[dict[str, object]]:
    found: list[dict[str, object]] = []
    for directory in ("skills", "agents", "workflows"):
        base = root / directory
        if not base.exists():
            continue
        for path in sorted(base.rglob("*")):
            if not path.is_file() or path.suffix not in {".md", ".toml", ".js", ".mjs"}:
                continue
            for line_number, line in enumerate(
                path.read_text(encoding="utf-8", errors="replace").splitlines(), 1
            ):
                match = NONPORTABLE_WAITER.search(line)
                if match:
                    found.append(
                        {
                            "path": str(path.relative_to(root)),
                            "line": line_number,
                            "waiter": match.group(0),
                            "reason": "shared_waiters_must_resolve_through_PATH",
                        }
                    )
    return found


def main() -> int:
    parser = argparse.ArgumentParser(prog="workflow-waiter-portability-check")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    args = parser.parse_args()
    found = violations(args.root.resolve())
    print(
        json.dumps(
            {"status": "pass" if not found else "fail", "violations": found},
            separators=(",", ":"),
        )
    )
    return 0 if not found else 2


if __name__ == "__main__":
    sys.exit(main())
