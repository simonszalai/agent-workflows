#!/usr/bin/env bash
# slack-api — project-aware Slack Web API with silent credential injection.
#
# USAGE  slack-api <method> [key=value ...]
#        slack-api conversations.list types=public_channel limit=20
#        slack-api conversations.history channel=C0123456789 limit=10
#        slack-api chat.postMessage channel=C0123456789 text='hello'
#        slack-api search.messages query='deploy failed' count=5
#
# key=value pairs are form-encoded (Slack's preferred encoding for all methods).
# Output is raw API JSON; pipe to jq to trim. Always check `"ok": true/false`.
#
# The exact Git origin selects both the Slack token reference and the project's
# 1Password service account from config/project-tools.json. Projects without an
# explicit Slack profile fail closed. Never print the token.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

[ $# -ge 1 ] || { echo "usage: slack-api <method> [key=value ...]" >&2; exit 2; }
METHOD="$1"; shift

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_CONTEXT="$HERE/project-context"
OP_WRAPPER="$HERE/op"
command -v jq >/dev/null 2>&1 || { echo "ERROR: jq is required" >&2; exit 3; }
[ -x "$PROJECT_CONTEXT" ] || { echo "ERROR: missing project resolver: $PROJECT_CONTEXT" >&2; exit 3; }
[ -x "$OP_WRAPPER" ] || { echo "ERROR: missing 1Password wrapper: $OP_WRAPPER" >&2; exit 3; }

context="$("$PROJECT_CONTEXT" --cwd "$PWD" --tool slack)"
project="$(jq -er '.project' <<<"$context")"
token_ref="$(jq -er '.tools.slack.token_ref' <<<"$context")"
token_env="$(jq -er '.service_account.token_env' <<<"$context")"
keychain_item="$(jq -r '.service_account.keychain_item // empty' <<<"$context")"

# token_env is registry-validated as <PROJECT>_OP_SERVICE_ACCOUNT_TOKEN, so this
# indirection is safe. eval keeps macOS bash 3.2 happy; ${!name:-} does not work there.
eval "tok=\${$token_env:-}"
if [ -z "$tok" ] && [ -n "$keychain_item" ] && [ "$(uname -s)" = "Darwin" ]; then
  tok="$(security find-generic-password -s "$keychain_item" -a simon -w 2>/dev/null || true)"
fi
[ -n "$tok" ] || {
  echo "ERROR: no 1Password service-account token for project '$project': set $token_env${keychain_item:+ or store it in the Mac Keychain as $keychain_item}." >&2
  exit 3
}

# Only the selected project token may authenticate the audited credential read.
for variable_name in $(compgen -v); do
  case "$variable_name" in
    OP_SERVICE_ACCOUNT_TOKEN|OP_CONNECT_HOST|OP_CONNECT_TOKEN|OP_SESSION_*|*_OP_SERVICE_ACCOUNT_TOKEN)
      unset "$variable_name"
      ;;
  esac
done
slack_tok="$(OP_SERVICE_ACCOUNT_TOKEN="$tok" "$OP_WRAPPER" read --no-newline "$token_ref")"
unset tok
[ -n "$slack_tok" ] || { echo "ERROR: 1Password returned an empty Slack token for project '$project'" >&2; exit 3; }

args=()
for kv in "$@"; do
  args+=(--data-urlencode "$kv")
done

# Keep the Slack token out of argv and strip every 1Password credential from curl.
exec 3< <(printf 'Authorization: Bearer %s\n' "$slack_tok")
unset slack_tok
for variable_name in $(compgen -v); do
  case "$variable_name" in
    OP_SERVICE_ACCOUNT_TOKEN|OP_CONNECT_HOST|OP_CONNECT_TOKEN|OP_SESSION_*|*_OP_SERVICE_ACCOUNT_TOKEN)
      unset "$variable_name"
      ;;
  esac
done

# ${args[@]+...} keeps macOS bash 3.2's set -u happy when no key=value args were given.
exec curl -sfS --max-time 30 "https://slack.com/api/${METHOD}" \
  -H @/dev/fd/3 ${args[@]+"${args[@]}"}
