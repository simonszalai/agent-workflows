#!/usr/bin/env python3
"""Extract and run a repo's GitHub Actions CI jobs locally before pushing.

Generic CI-parity gate: parses .github/workflows/*.yml, skips environment-setup
actions (checkout, setup-*, cache, artifacts), and emits or executes the
remaining `run:` steps with their env vars in the current local environment.

This tool is advisory scaffolding for an agent, not an oracle: jobs it marks
SKIP (services, expressions, opaque actions) may still be reproducible with
judgment, and a local PASS does not replace GitHub CI as the authority.

Modes:
  ci-local                 list the execution plan (default)
  ci-local --run           run all runnable jobs; per-job pass/fail summary
  ci-local --run --job X   run only job X (forces jobs classified as SKIP)

If the target repo has its own bin/ci-local or scripts/ci-local, that override
is exec'd instead (unless --no-override).
"""

from __future__ import annotations

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from datetime import datetime, timezone
from pathlib import Path

try:
    import yaml
except ImportError:  # re-exec through uv to supply pyyaml without a repo dependency
    if os.environ.get("CI_LOCAL_REEXEC") != "1":
        uv = shutil.which("uv")
        if uv:
            os.environ["CI_LOCAL_REEXEC"] = "1"
            os.execv(uv, [uv, "run", "--quiet", "--no-project", "--with", "pyyaml",
                          "python3", os.path.abspath(__file__), *sys.argv[1:]])
    print("ci-local: PyYAML unavailable and uv not found", file=sys.stderr)
    sys.exit(2)


SETUP_ACTION_PREFIXES = (
    "actions/checkout",
    "actions/setup-",
    "actions/cache",
    "actions/upload-artifact",
    "actions/download-artifact",
    "astral-sh/setup-uv",
    "oven-sh/setup-bun",
    "pnpm/action-setup",
)

CI_EVENTS = {"push", "pull_request", "pull_request_target", "merge_group"}


@dataclass
class Step:
    command: str
    env: dict[str, str]
    name: str | None = None
    needs_expression: bool = False


@dataclass
class Job:
    name: str
    steps: list[Step] = field(default_factory=list)
    services: list[str] = field(default_factory=list)
    condition: str | None = None
    opaque_actions: list[str] = field(default_factory=list)

    @property
    def execution_blockers(self) -> list[str]:
        reasons = []
        if self.services:
            reasons.append(f"needs services: {', '.join(self.services)}")
        return reasons

    @property
    def partial_reasons(self) -> list[str]:
        reasons = []
        if self.opaque_actions:
            reasons.append(f"non-setup actions: {', '.join(self.opaque_actions)}")
        if any(s.needs_expression for s in self.steps):
            reasons.append("uses ${{ ... }} expressions needing substitution")
        return reasons

    @property
    def skip_reasons(self) -> list[str]:
        return [*self.execution_blockers, *self.partial_reasons]


def is_setup_action(uses: str) -> bool:
    ref = uses.split("@", 1)[0]
    return any(ref.startswith(prefix) for prefix in SETUP_ACTION_PREFIXES)


def str_env(env: object) -> dict[str, str]:
    if not isinstance(env, dict):
        return {}
    return {str(k): str(v) for k, v in env.items()}


def triggers_on_ci_event(workflow: dict) -> bool:
    on = workflow.get("on") or workflow.get(True)  # yaml 1.1 parses bare `on:` as True
    if isinstance(on, str):
        return on in CI_EVENTS
    if isinstance(on, list):
        return bool(CI_EVENTS.intersection(on))
    if isinstance(on, dict):
        return bool(CI_EVENTS.intersection(on.keys()))
    return False


def parse_workflow(path: Path) -> list[Job]:
    workflow = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(workflow, dict) or not triggers_on_ci_event(workflow):
        return []
    top_env = str_env(workflow.get("env"))
    jobs: list[Job] = []
    for job_name, job_def in (workflow.get("jobs") or {}).items():
        if not isinstance(job_def, dict) or "steps" not in job_def:
            continue  # reusable-workflow call or malformed job
        job = Job(
            name=job_name,
            services=sorted((job_def.get("services") or {}).keys()),
            condition=str(job_def["if"]) if "if" in job_def else None,
        )
        job_env = {**top_env, **str_env(job_def.get("env"))}
        for step_def in job_def.get("steps") or []:
            uses = step_def.get("uses")
            if uses:
                if not is_setup_action(uses):
                    job.opaque_actions.append(uses)
                continue
            run = step_def.get("run")
            if not run:
                continue
            command = str(run).strip()
            job.steps.append(Step(
                command=command,
                env={**job_env, **str_env(step_def.get("env"))},
                name=step_def.get("name"),
                needs_expression="${{" in command
                or any("${{" in v for v in {**job_env, **str_env(step_def.get("env"))}.values()),
            ))
        if job.steps:
            jobs.append(job)
    return jobs


def collect_jobs(workflow_dir: Path) -> list[Job]:
    jobs: list[Job] = []
    for path in sorted(workflow_dir.glob("*.yml")) + sorted(workflow_dir.glob("*.yaml")):
        jobs.extend(parse_workflow(path))
    return jobs


def print_plan(jobs: list[Job]) -> None:
    for job in jobs:
        reasons = job.skip_reasons
        if job.execution_blockers:
            status = "SKIP"
        elif reasons:
            status = "PARTIAL"
        else:
            status = "RUN"
        print(f"[{status}] {job.name}" + (f"  (if: {job.condition})" if job.condition else ""))
        for reason in reasons:
            print(f"       - {reason}")
        for step in job.steps:
            first_line = step.command.splitlines()[0]
            extra = len(step.command.splitlines()) - 1
            marker = " [expr]" if step.needs_expression else ""
            print(f"       $ {first_line}" + (f"  (+{extra} lines)" if extra else "") + marker)


def git_read(repo_root: Path, *args: str, env: dict[str, str] | None = None) -> str | None:
    result = subprocess.run(
        ["git", "-C", str(repo_root), *args],
        capture_output=True,
        text=True,
        check=False,
        env=env,
    )
    return result.stdout.strip() if result.returncode == 0 else None


def git_identity(
    repo_root: Path,
    *,
    exclude_paths: tuple[Path, ...] = (),
) -> dict[str, str | None]:
    head_sha = git_read(repo_root, "rev-parse", "HEAD")
    tree_sha = git_read(repo_root, "rev-parse", "HEAD^{tree}")
    index_path_value = git_read(repo_root, "rev-parse", "--git-path", "index")
    if index_path_value:
        index_path = Path(index_path_value)
        if not index_path.is_absolute():
            index_path = repo_root / index_path
        with tempfile.TemporaryDirectory() as directory:
            temporary_index = Path(directory) / "index"
            if index_path.is_file():
                shutil.copy2(index_path, temporary_index)
            environment = os.environ.copy()
            environment["GIT_INDEX_FILE"] = str(temporary_index)
            staged = subprocess.run(
                ["git", "-C", str(repo_root), "add", "-A"],
                capture_output=True,
                text=True,
                check=False,
                env=environment,
            )
            if staged.returncode == 0:
                for excluded in exclude_paths:
                    try:
                        relative = excluded.resolve().relative_to(repo_root)
                    except ValueError:
                        continue
                    if git_read(
                        repo_root, "ls-files", "--error-unmatch", str(relative)
                    ) is not None:
                        continue
                    subprocess.run(
                        [
                            "git",
                            "-C",
                            str(repo_root),
                            "reset",
                            "-q",
                            "HEAD",
                            "--",
                            str(relative),
                        ],
                        capture_output=True,
                        text=True,
                        check=False,
                        env=environment,
                    )
                tree_sha = git_read(repo_root, "write-tree", env=environment)
    return {"head_sha": head_sha, "tree_sha": tree_sha}


def atomic_json(path: Path, value: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(
        json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
    )
    temporary.chmod(0o600)
    os.replace(temporary, path)


def validate_receipt(path: Path, repo_root: Path) -> tuple[dict, int]:
    try:
        receipt = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return {"status": "invalid", "error": f"cannot read receipt: {exc}"}, 2
    if not isinstance(receipt, dict) or receipt.get("schema_version") != 1:
        return {"status": "invalid", "error": "receipt schema_version must equal 1"}, 2
    required = {
        "started_at": str,
        "completed_at": str,
        "head_sha": str,
        "tree_sha": str,
        "post_tree_sha": str,
        "tree_changed_during_run": bool,
        "executed_jobs": list,
        "jobs": list,
        "explicit_skips": list,
        "overall_status": str,
    }
    for field, expected_type in required.items():
        if not isinstance(receipt.get(field), expected_type):
            return {
                "status": "invalid",
                "error": f"receipt {field} has an invalid type",
            }, 2
    for field in ("head_sha", "tree_sha", "post_tree_sha"):
        digest = receipt[field]
        if len(digest) not in {40, 64} or any(
            character not in "0123456789abcdef" for character in digest
        ):
            return {
                "status": "invalid",
                "error": f"receipt {field} is not a git identity",
            }, 2
    if receipt.get("overall_status") not in {"passed", "passed_with_skips"}:
        return {"status": "invalid", "error": "receipt is not a passing terminal result"}, 2
    if receipt["tree_changed_during_run"] or receipt["post_tree_sha"] != receipt["tree_sha"]:
        return {"status": "invalid", "error": "receipt tree changed during the CI run"}, 2
    allowed_results = {"passed", "partial", "skipped", "failed"}
    if any(
        not isinstance(row, dict) or row.get("result") not in allowed_results
        for row in receipt["jobs"]
    ):
        return {"status": "invalid", "error": "receipt jobs are malformed"}, 2
    if any(row["result"] == "failed" for row in receipt["jobs"]):
        return {"status": "invalid", "error": "receipt contains a failed job"}, 2
    for row in receipt["jobs"]:
        if not isinstance(row.get("steps"), list) or not isinstance(
            row.get("failed_steps"), list
        ):
            return {
                "status": "invalid",
                "error": "receipt jobs require exhaustive steps and failed_steps",
            }, 2
        if row["result"] != "skipped" and not row["steps"]:
            return {
                "status": "invalid",
                "error": "executed receipt job has no step results",
            }, 2
        if any(
            not isinstance(step, dict)
            or step.get("result") not in {"passed", "skipped", "failed"}
            for step in row["steps"]
        ):
            return {
                "status": "invalid",
                "error": "receipt step results are malformed",
            }, 2
        derived_failed_steps = [
            str(step.get("name"))
            for step in row["steps"]
            if step.get("result") == "failed"
        ]
        if row["failed_steps"] != derived_failed_steps:
            return {
                "status": "invalid",
                "error": "receipt failed_steps do not match exhaustive step results",
            }, 2
    if receipt["overall_status"] == "passed" and receipt["explicit_skips"]:
        return {
            "status": "invalid",
            "error": "passing receipt cannot conceal explicit skips",
        }, 2
    current = git_identity(repo_root, exclude_paths=(path,))
    if not current["tree_sha"]:
        return {"status": "invalid", "error": "current git tree identity is unavailable"}, 2
    if receipt.get("tree_sha") != current["tree_sha"]:
        return {
            "status": "stale",
            "error": "receipt tree_sha does not match the current working tree",
            "receipt_tree_sha": receipt.get("tree_sha"),
            "current_tree_sha": current["tree_sha"],
        }, 3
    return {
        "status": "current",
        "receipt_path": str(path.resolve()),
        "head_sha": current["head_sha"],
        "tree_sha": current["tree_sha"],
        "overall_status": receipt["overall_status"],
    }, 0


def run_job(job: Job, repo_root: Path) -> tuple[bool, list[dict[str, object]]]:
    print(f"\n=== job: {job.name} ===", flush=True)
    step_receipts: list[dict[str, object]] = []
    for step in job.steps:
        label = step.name or step.command.splitlines()[0]
        if step.needs_expression:
            print(f"--- SKIPPED (needs ${{{{ }}}} substitution): {label}", flush=True)
            step_receipts.append({
                "name": label,
                "result": "skipped",
                "exit_code": None,
                "reason": "needs expression substitution",
            })
            continue
        print(f"--- {label}", flush=True)
        result = subprocess.run(
            ["bash", "-eo", "pipefail", "-c", step.command],
            cwd=repo_root, env={**os.environ, **step.env},
        )
        step_result = "failed" if result.returncode else "passed"
        step_receipts.append({
            "name": label,
            "result": step_result,
            "exit_code": result.returncode,
        })
        if result.returncode:
            print(f"FAIL {job.name}: step '{label}' exited {result.returncode}", flush=True)
    failed_count = sum(row["result"] == "failed" for row in step_receipts)
    if failed_count:
        print(f"FAIL {job.name}: {failed_count} step(s) failed", flush=True)
    else:
        print(f"PASS {job.name}", flush=True)
    return failed_count == 0, step_receipts


def main() -> int:
    parser = argparse.ArgumentParser(prog="ci-local", description=__doc__)
    parser.add_argument("--repo", default=".", help="repo root (default: cwd)")
    parser.add_argument("--run", action="store_true", help="execute runnable jobs")
    parser.add_argument("--job", action="append", default=[],
                        help="limit to this job (repeatable); forces SKIP-classified jobs")
    parser.add_argument("--no-override", action="store_true",
                        help="ignore a repo-local ci-local override script")
    parser.add_argument("--receipt", type=Path,
                        help="atomically write a machine-readable run receipt")
    parser.add_argument("--require-receipt", type=Path,
                        help="validate a passing receipt against the current working tree")
    args = parser.parse_args()

    repo_root = Path(args.repo).resolve()
    if args.receipt and not args.run:
        parser.error("--receipt requires --run")
    if args.require_receipt:
        if args.run or args.job or args.receipt:
            parser.error("--require-receipt is a standalone validation mode")
        result, exit_code = validate_receipt(args.require_receipt.resolve(), repo_root)
        print(json.dumps(result, separators=(",", ":")))
        return exit_code
    if not args.no_override and os.environ.get("CI_LOCAL_OVERRIDE") != "1":
        for override in (repo_root / "bin" / "ci-local", repo_root / "scripts" / "ci-local"):
            if override.is_file() and os.access(override, os.X_OK) \
                    and override.resolve() != Path(__file__).resolve():
                print(f"ci-local: delegating to repo override {override}", flush=True)
                os.environ["CI_LOCAL_OVERRIDE"] = "1"
                os.execv(str(override), [str(override), *sys.argv[1:]])

    workflow_dir = repo_root / ".github" / "workflows"
    if not workflow_dir.is_dir():
        print(f"ci-local: no workflows directory at {workflow_dir}", file=sys.stderr)
        return 2
    jobs = collect_jobs(workflow_dir)
    if not jobs:
        print("ci-local: no CI-triggered jobs with run steps found", file=sys.stderr)
        return 2
    if args.job:
        unknown = set(args.job) - {j.name for j in jobs}
        if unknown:
            print(f"ci-local: unknown job(s): {', '.join(sorted(unknown))}", file=sys.stderr)
            return 2
        jobs = [j for j in jobs if j.name in args.job]

    if not args.run:
        print_plan(jobs)
        return 0

    started_at = datetime.now(timezone.utc).isoformat()
    identity_before = git_identity(
        repo_root, exclude_paths=(args.receipt.resolve(),)
    ) if args.receipt else {
        "head_sha": None, "tree_sha": None
    }
    if args.receipt and (
        identity_before["head_sha"] is None or identity_before["tree_sha"] is None
    ):
        print("ci-local: git head/tree identity is required for a receipt", file=sys.stderr)
        return 2
    results: dict[str, str] = {}
    job_receipts: list[dict[str, object]] = []
    explicit_skips: list[dict[str, object]] = []
    for job in jobs:
        if job.execution_blockers and not args.job:
            results[job.name] = "SKIP (" + "; ".join(job.execution_blockers) + ")"
            skipped = {"job": job.name, "reasons": job.execution_blockers}
            explicit_skips.append(skipped)
            job_receipts.append({
                "name": job.name,
                "result": "skipped",
                "skip_reasons": job.execution_blockers,
                "skipped_steps": [],
                "failed_steps": [],
                "steps": [],
            })
            continue
        passed, step_receipts = run_job(job, repo_root)
        skipped_steps = [
            str(row["name"]) for row in step_receipts if row["result"] == "skipped"
        ]
        failed_steps = [
            str(row["name"]) for row in step_receipts if row["result"] == "failed"
        ]
        partial = bool(skipped_steps or job.opaque_actions)
        results[job.name] = "FAIL" if not passed else ("PARTIAL" if partial else "PASS")
        if skipped_steps:
            explicit_skips.append({
                "job": job.name,
                "reasons": ["steps require expression substitution"],
                "steps": skipped_steps,
            })
        if job.opaque_actions:
            explicit_skips.append({
                "job": job.name,
                "reasons": ["non-setup actions were not reproduced locally"],
                "actions": job.opaque_actions,
            })
        job_receipts.append({
            "name": job.name,
            "result": "failed" if not passed else ("partial" if partial else "passed"),
            "skip_reasons": [],
            "skipped_steps": skipped_steps,
            "skipped_actions": job.opaque_actions,
            "failed_steps": failed_steps,
            "steps": step_receipts,
        })

    print("\n=== ci-local summary ===")
    for name, outcome in results.items():
        if outcome in {"PASS", "FAIL", "PARTIAL"}:
            print(f"{outcome:>7s}  {name}")
        else:
            print(f"   SKIP  {name}: {outcome[6:-1]}")
    exit_code = 1 if any(outcome == "FAIL" for outcome in results.values()) else 0
    if args.receipt:
        identity_after = git_identity(
            repo_root, exclude_paths=(args.receipt.resolve(),)
        )
        tree_changed = identity_before["tree_sha"] != identity_after["tree_sha"]
        if exit_code:
            overall_status = "failed"
        elif tree_changed:
            overall_status = "tree_changed"
            exit_code = 2
        elif explicit_skips:
            overall_status = "passed_with_skips"
        else:
            overall_status = "passed"
        receipt = {
            "schema_version": 1,
            "started_at": started_at,
            "completed_at": datetime.now(timezone.utc).isoformat(),
            "repo_root": str(repo_root),
            **identity_before,
            "post_tree_sha": identity_after["tree_sha"],
            "tree_changed_during_run": tree_changed,
            "executed_jobs": [
                row["name"] for row in job_receipts if row["result"] != "skipped"
            ],
            "jobs": job_receipts,
            "explicit_skips": explicit_skips,
            "overall_status": overall_status,
        }
        atomic_json(args.receipt.resolve(), receipt)
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
