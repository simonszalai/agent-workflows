#!/usr/bin/env bash
# tailscale-admin — Tailscale admin (control-plane) API with silent credential
# injection. Replaces the admin half of the tailscale MCP server; the local half
# is just the `tailscale` CLI, no credentials needed (see skills/tool-tailscale).
#
# USAGE  tailscale-admin <METHOD> </api/v2 path> [curl args...]
#        tailscale-admin GET  /tailnet/-/devices
#        tailscale-admin GET  /tailnet/-/keys
#        tailscale-admin POST /tailnet/-/keys -d '{"capabilities":{...}}'
#
# `-` in the path means "the tailnet of the authenticated credential".
#
# Credentials: an OAuth client whose op:// refs come from the calling project's
# `tailscale` profile in config/project-tools.json, resolved per call with that
# project's own service-account token — silent, no Touch ID. The short-lived access
# token exists only in this process. Never print tokens.
#
# Only projects with their own tailnet declare a `tailscale` profile; everywhere else
# this fails closed rather than reaching for another project's tailnet.
set -euo pipefail

API="https://api.tailscale.com/api/v2"

[ $# -ge 2 ] || { echo "usage: tailscale-admin <METHOD> </api/v2 path> [curl args...]" >&2; exit 2; }
METHOD="$1"; APIPATH="$2"; shift 2

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_CONTEXT="$HERE/project-context"
# shellcheck source=../secrets/lib/read.sh
source "$HERE/../secrets/lib/read.sh"
command -v jq >/dev/null 2>&1 || { echo "ERROR: jq is required" >&2; exit 3; }
[ -x "$PROJECT_CONTEXT" ] || { echo "ERROR: missing project resolver: $PROJECT_CONTEXT" >&2; exit 3; }

context="$("$PROJECT_CONTEXT" --cwd "$PWD" --tool tailscale)"
project="$(jq -er '.project' <<<"$context")"
token_env="$(jq -er '.service_account.token_env' <<<"$context")"
keychain_item="$(jq -r '.service_account.keychain_item // empty' <<<"$context")"
client_id_ref="$(jq -er '.tools.tailscale.oauth_client_id_ref' <<<"$context")"
client_secret_ref="$(jq -er '.tools.tailscale.oauth_client_secret_ref' <<<"$context")"

# token_env is registry-validated as <PROJECT>_OP_SERVICE_ACCOUNT_TOKEN, so this
# indirection is safe. eval keeps macOS bash 3.2 happy; ${!name:-} does not work there.
eval "tok=\${$token_env:-}"
if [ -z "$tok" ] && [ -n "$keychain_item" ] && [ "$(uname -s)" = "Darwin" ]; then
  tok="$(security find-generic-password -s "$keychain_item" -a "$(sa_token_account)" -w 2>/dev/null || true)"
fi
[ -n "$tok" ] || {
  echo "ERROR: no 1Password service-account token for project '$project': set $token_env${keychain_item:+ or store it in the Mac Keychain as $keychain_item}." >&2
  exit 3
}

cid="$(OP_SERVICE_ACCOUNT_TOKEN="$tok" op read "$client_id_ref")"
csec="$(OP_SERVICE_ACCOUNT_TOKEN="$tok" op read "$client_secret_ref")"

access="$(curl -sf --max-time 15 "${API}/oauth/token" \
  -d grant_type=client_credentials \
  -d client_id="$cid" -d client_secret="$csec" | jq -r .access_token)"
[ -n "$access" ] && [ "$access" != "null" ] || { echo "ERROR: OAuth token exchange failed" >&2; exit 4; }

exec curl -sfS --max-time 30 -X "$METHOD" \
  -H "Authorization: Bearer $access" -H "Content-Type: application/json" \
  "${API}${APIPATH}" "$@"
