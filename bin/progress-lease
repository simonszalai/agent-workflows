#!/usr/bin/env python3
"""Validate durable progress leases and decide the single expiry action."""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
import time
from pathlib import Path


NONTERMINAL_STATES = {"running", "sleep", "paused", "unknown"}
TERMINAL_STATES = {"complete", "blocked", "failed", "rotate_required"}
POLLING_OPERATIONS = {
    "wait_agent",
    "write_stdin",
    "list_agents",
    "github_status",
    "render_status",
    "prefect_status",
    "equivalent_status_read",
}


class ContractError(ValueError):
    """A lease or expiry observation violates the durable-progress contract."""


def load(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ContractError(f"cannot read {path}: {exc}") from exc
    if not isinstance(value, dict):
        raise ContractError(f"{path}: root must be an object")
    return value


def require_int(value: object, field: str, *, minimum: int = 0) -> int:
    if isinstance(value, bool) or not isinstance(value, int) or value < minimum:
        raise ContractError(f"{field} must be an integer >= {minimum}")
    return value


def require_number(value: object, field: str) -> float:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ContractError(f"{field} must be a number")
    return float(value)


def require_string(value: object, field: str) -> str:
    if not isinstance(value, str) or not value.strip():
        raise ContractError(f"{field} must be a non-empty string")
    return value


def validate_progress(value: object, field: str) -> dict:
    if not isinstance(value, dict):
        raise ContractError(f"{field} must be an object")
    kind = value.get("kind")
    if kind not in {"checkpoint", "tool_receipt"}:
        raise ContractError(f"{field}.kind must be checkpoint or tool_receipt")
    sequence = require_int(value.get("sequence"), f"{field}.sequence")
    path = Path(require_string(value.get("path"), f"{field}.path"))
    digest = require_string(value.get("sha256"), f"{field}.sha256")
    if not path.is_absolute() or not path.is_file():
        raise ContractError(f"{field}.path must name an existing absolute file")
    if hashlib.sha256(path.read_bytes()).hexdigest() != digest:
        raise ContractError(f"{field}.sha256 mismatch")
    return {"kind": kind, "sequence": sequence, "path": str(path), "sha256": digest}


def validate_lease(lease: dict, *, allow_expired: bool) -> dict:
    require_string(lease.get("phase_name"), "phase_name")
    require_int(lease.get("rotation_generation"), "rotation_generation")
    require_int(lease.get("lease_generation"), "lease_generation")
    if require_int(lease.get("inspection_budget"), "inspection_budget") != 1:
        raise ContractError("inspection_budget must equal 1")
    if require_int(lease.get("renewal_budget"), "renewal_budget") != 1:
        raise ContractError("renewal_budget must equal 1")
    renewals_used = require_int(lease.get("renewals_used"), "renewals_used")
    if renewals_used > 1:
        raise ContractError("renewals_used cannot exceed 1")
    started = require_number(lease.get("started_at_epoch"), "started_at_epoch")
    deadline = require_number(lease.get("lease_deadline_epoch"), "lease_deadline_epoch")
    absolute = require_number(lease.get("absolute_deadline_epoch"), "absolute_deadline_epoch")
    if not started < deadline <= absolute:
        raise ContractError(
            "timestamps must satisfy started_at_epoch < lease_deadline_epoch "
            "<= absolute_deadline_epoch"
        )
    if not allow_expired and deadline <= time.time():
        raise ContractError("lease_deadline_epoch must be in the future")
    validate_progress(lease.get("durable_progress"), "durable_progress")
    return lease


def decide_expiry(lease: dict, observation: dict) -> dict:
    state = observation.get("state")
    if state not in NONTERMINAL_STATES | TERMINAL_STATES:
        raise ContractError("state is invalid")
    if require_int(observation.get("inspections_used"), "inspections_used") != 1:
        raise ContractError("expiry permits exactly one status inspection")
    observed_at = require_number(observation.get("observed_at_epoch"), "observed_at_epoch")
    if observed_at < lease["lease_deadline_epoch"]:
        raise ContractError("expiry observation cannot precede lease_deadline_epoch")

    if state in TERMINAL_STATES:
        return {
            "status": "valid",
            "action": "consume_terminal",
            "state": state,
            "renewal_allowed": False,
        }

    current = validate_progress(observation.get("durable_progress"), "durable_progress")
    prior = validate_progress(lease.get("durable_progress"), "lease.durable_progress")
    advanced = current["sequence"] > prior["sequence"] and current["sha256"] != prior["sha256"]
    hard_deadline = observed_at >= lease["absolute_deadline_epoch"]
    renewals_used = require_int(lease.get("renewals_used"), "renewals_used")

    if hard_deadline:
        action = "interrupt_rotate"
        reason = "absolute_deadline"
    elif advanced and renewals_used == 0:
        action = "renew_once"
        reason = "durable_progress_advanced"
    else:
        action = "interrupt_rotate"
        reason = "stale_progress" if not advanced else "renewal_already_used"
    return {
        "status": "valid",
        "action": action,
        "reason": reason,
        "state": state,
        "durable_progress_advanced": advanced,
        "renewal_allowed": action == "renew_once",
        "elapsed_is_failure": False,
    }


def validate_execution_economy_receipt(receipt: dict) -> dict:
    observations = receipt.get("observations")
    if not isinstance(observations, list):
        raise ContractError("observations must be an array")
    model_by_condition: dict[str, int] = {}
    expiry_inspections = 0
    violations: list[str] = []
    for index, observation in enumerate(observations):
        if not isinstance(observation, dict):
            raise ContractError(f"observations[{index}] must be an object")
        actor = observation.get("actor")
        if actor not in {"model", "deterministic_waiter"}:
            raise ContractError(
                f"observations[{index}].actor must be model or deterministic_waiter"
            )
        operation = require_string(
            observation.get("operation"), f"observations[{index}].operation"
        )
        condition = require_string(
            observation.get("condition"), f"observations[{index}].condition"
        )
        lease_inspection = observation.get("lease_expiry_inspection", False)
        if not isinstance(lease_inspection, bool):
            raise ContractError(
                f"observations[{index}].lease_expiry_inspection must be boolean"
            )
        if actor == "model" and operation in POLLING_OPERATIONS:
            model_by_condition[condition] = model_by_condition.get(condition, 0) + 1
            if lease_inspection:
                expiry_inspections += 1
    for condition, count in sorted(model_by_condition.items()):
        if count > 1:
            violations.append(f"repeated model polling for {condition}: {count} observations")
    if expiry_inspections > 1:
        violations.append(
            f"lease expiry inspection budget exceeded: {expiry_inspections} observations"
        )
    return {
        "status": "valid" if not violations else "invalid",
        "execution_economy_compliant": not violations,
        "model_poll_conditions": model_by_condition,
        "lease_expiry_inspections": expiry_inspections,
        "violations": violations,
    }


def main() -> int:
    parser = argparse.ArgumentParser(prog="progress-lease")
    subparsers = parser.add_subparsers(dest="command", required=True)
    issue = subparsers.add_parser("issue")
    issue.add_argument("lease", type=Path)
    expiry = subparsers.add_parser("expiry")
    expiry.add_argument("observation", type=Path)
    expiry.add_argument("--lease", required=True, type=Path)
    policy = subparsers.add_parser("policy")
    policy.add_argument("receipt", type=Path)
    args = parser.parse_args()
    try:
        if args.command == "issue":
            validate_lease(load(args.lease), allow_expired=False)
            result = {"status": "valid", "action": "block_once"}
        elif args.command == "expiry":
            lease = validate_lease(load(args.lease), allow_expired=True)
            result = decide_expiry(lease, load(args.observation))
        else:
            result = validate_execution_economy_receipt(load(args.receipt))
    except ContractError as exc:
        print(json.dumps({"status": "invalid", "error": str(exc)}, separators=(",", ":")))
        return 2
    print(json.dumps(result, separators=(",", ":")))
    return 0 if result.get("execution_economy_compliant", True) else 2


if __name__ == "__main__":
    sys.exit(main())
