#!/usr/bin/env python3
"""Reject unbounded noisy shell commands in active workflow examples."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path


NOISY = re.compile(
    r"(^|\s)(pytest|npm test|pnpm test|yarn test|bun test|cargo test|go test|"
    r"docker build|terraform (?:plan|apply)|alembic (?:upgrade|downgrade)|"
    r"prefect deploy|bin/check-agent-workflows|git diff(?:\s|$))",
    re.IGNORECASE,
)
SAFE_BOUND = re.compile(
    r"(\|\s*(?:head|tail)\s+-n?\s*\d+|--max-count(?:=|\s+)\d+|"
    r"\s-[nN]\s*\d+|>\s*[^\s]+|--stat(?:\s|$))"
)
PRODUCTION_MUTATION = re.compile(
    r"(?:(?:prefect\s+deploy|terraform\s+apply|kubectl\s+apply|render\s+deploy|"
    r"fly\s+deploy|aws\b.{0,30}\bdeploy|gcloud\b.{0,30}\bdeploy)"
    r".{0,100}\b(?:production|prod)\b|"
    r"\b(?:production|prod)\b.{0,100}"
    r"(?:prefect\s+deploy|terraform\s+apply|kubectl\s+apply|render\s+deploy|"
    r"fly\s+deploy|aws\b.{0,30}\bdeploy|gcloud\b.{0,30}\bdeploy))",
    re.IGNORECASE,
)
MAX_INVESTIGATOR_INLINE_BYTES = 8192


def violations(root: Path) -> list[dict[str, object]]:
    found: list[dict[str, object]] = []
    for directory in ("skills", "agents", "workflows"):
        base = root / directory
        if not base.exists():
            continue
        for path in sorted(base.rglob("*")):
            if not path.is_file() or path.suffix not in {".md", ".toml"}:
                continue
            in_fence = False
            pending = ""
            pending_line = 0
            for line_number, line in enumerate(path.read_text(errors="replace").splitlines(), 1):
                stripped = line.strip()
                if stripped.startswith("```"):
                    in_fence = not in_fence
                    pending = ""
                    continue
                if not in_fence or stripped.startswith(("#", "//", "{")):
                    continue
                if pending:
                    pending += " " + stripped.removesuffix("\\").strip()
                else:
                    pending = stripped.removesuffix("\\").strip()
                    pending_line = line_number
                if stripped.endswith("\\"):
                    continue
                command = pending
                command_line = pending_line
                pending = ""
                if PRODUCTION_MUTATION.search(command) and "bin/redacted-exec" not in command:
                    found.append(
                        {
                            "path": str(path.relative_to(root)),
                            "line": command_line,
                            "command": command[:240],
                            "reason": "production_mutation_requires_redacted_exec",
                        }
                    )
                    continue
                if not NOISY.search(command):
                    continue
                if "bin/redacted-exec" in command:
                    continue
                if "bin/compact-exec" in command:
                    continue
                if SAFE_BOUND.search(command):
                    continue
                found.append(
                    {
                        "path": str(path.relative_to(root)),
                        "line": command_line,
                        "command": command[:240],
                    }
                )
    return found


def investigator_result_violations(path: Path) -> list[dict[str, object]]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return [{"reason": "invalid_result_json", "detail": str(exc)[:240]}]
    if not isinstance(value, dict) or not isinstance(value.get("evidence"), list):
        return [{"reason": "result_must_contain_evidence_array"}]
    found: list[dict[str, object]] = []
    for index, row in enumerate(value["evidence"]):
        prefix = f"evidence[{index}]"
        if not isinstance(row, dict):
            found.append({"field": prefix, "reason": "evidence_row_must_be_object"})
            continue
        command = row.get("command")
        status = row.get("status")
        output_bytes = row.get("output_bytes")
        output_tail = row.get("output_tail")
        summary = row.get("summary")
        compact_receipt = row.get("compact_receipt") is True
        if not isinstance(command, str) or not command.strip():
            found.append({"field": f"{prefix}.command", "reason": "non_empty_string_required"})
            command = ""
        if status not in {"success", "failure"}:
            found.append({"field": f"{prefix}.status", "reason": "invalid_status"})
        if isinstance(output_bytes, bool) or not isinstance(output_bytes, int) or output_bytes < 0:
            found.append({"field": f"{prefix}.output_bytes", "reason": "non_negative_int_required"})
            output_bytes = 0
        if not isinstance(output_tail, str) or len(output_tail.encode()) > 8192:
            found.append({"field": f"{prefix}.output_tail", "reason": "bounded_tail_required"})
        if not isinstance(summary, str) or len(summary.encode()) > 4096:
            found.append({"field": f"{prefix}.summary", "reason": "bounded_summary_required"})
        if status == "failure" and not output_tail:
            found.append({"field": f"{prefix}.output_tail", "reason": "failure_tail_required"})
        if NOISY.search(command) and not compact_receipt:
            found.append({"field": prefix, "reason": "unwrapped_noisy_investigator_command"})
        if output_bytes > MAX_INVESTIGATOR_INLINE_BYTES and not compact_receipt:
            found.append({"field": prefix, "reason": "unreferenced_noisy_output"})
        if compact_receipt:
            log_file = row.get("log_file")
            log_sha256 = row.get("log_sha256")
            log_path = Path(log_file) if isinstance(log_file, str) else None
            if log_path is None or not log_path.is_absolute() or not log_path.is_file():
                found.append({
                    "field": f"{prefix}.log_file",
                    "reason": "absolute_existing_log_file_required",
                })
            elif (
                not isinstance(log_sha256, str)
                or len(log_sha256) != 64
                or hashlib.sha256(log_path.read_bytes()).hexdigest() != log_sha256
            ):
                found.append({
                    "field": f"{prefix}.log_sha256",
                    "reason": "log_sha256_mismatch",
                })
    return found


def main() -> int:
    parser = argparse.ArgumentParser(prog="workflow-noisy-command-check")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--investigator-result", type=Path)
    args = parser.parse_args()
    found = (
        investigator_result_violations(args.investigator_result.resolve())
        if args.investigator_result
        else violations(args.root.resolve())
    )
    print(
        json.dumps(
            {"status": "pass" if not found else "fail", "violations": found},
            separators=(",", ":"),
        )
    )
    return 0 if not found else 2


if __name__ == "__main__":
    sys.exit(main())
