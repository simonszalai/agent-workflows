import json
import subprocess
import sys
import time
from pathlib import Path


ROTATION_REASONS = {
    "first_compaction",
    "turn_budget",
    "elapsed_budget",
    "token_budget",
}
TERMINAL_STATUSES = {"complete", "blocked", "failed", "rotate_required"}
TICKET_PHASE_BUDGETS = {
    "planning": {
        "max_turns": 25,
        "max_checkpoints": 4,
        "max_elapsed_seconds": 1800,
        "max_tokens": 50000,
    },
    "build_review": {
        "max_turns": 40,
        "max_checkpoints": 12,
        "max_elapsed_seconds": 3600,
        "max_tokens": 90000,
    },
    "deploy_verify": {
        "max_turns": 20,
        "max_checkpoints": 8,
        "max_elapsed_seconds": 2700,
        "max_tokens": 60000,
    },
}
# Budgets are cumulative: rotation resumes a phase, it does not renew its budget forever.
# A dispatch beyond the phase's generation cap is rejected; the flow persists its checkpoint
# and stops with an exact resume command instead of spending another full budget.
TICKET_MAX_ROTATION_GENERATIONS = {
    "planning": 1,
    "build_review": 2,
    "deploy_verify": 3,
}
TICKET_RUN_LIMITS = {
    "direct": {
        "delivery": 2,
        "environment": 6,
        "repair_cycles": 1,
    },
    "standard": {
        "delivery": 3,
        "environment": 6,
        "repair_cycles": 1,
    },
    "heavy": {
        "delivery": 12,
        "environment": 12,
        "repair_cycles": 3,
    },
}
TICKET_SESSION_ROLES = {
    "delivery": {
        "delivery_owner",
        "reviewer",
        "repair_owner",
        "researcher",
        "planner",
        "build_planner",
        "builder_chain",
        "test_writer",
        "specialist_reviewer",
    },
    "environment": {
        "deployment_owner",
        "deterministic_waiter",
        "verifier",
        "repair_owner",
    },
}
TICKET_INTENSITY_ORDER = {"direct": 0, "standard": 1, "heavy": 2}
EPIC_SESSION_ROLES = {
    "milestone_owner",
    "milestone_waiter",
    "milestone_verifier",
    "milestone_repair_owner",
    "production_owner",
    "production_waiter",
    "production_verifier",
}
