# Project-restricted AutoDEV bearer references for the shared Mac router.
# Resolved once at process startup; values remain in the router process memory.
AMARU_AUTODEV_MEMORY_API_TOKEN=op://AMARU/AMARU_AUTODEV_MEMORY_API_TOKEN/value
AUTODEV_AUTODEV_MEMORY_API_TOKEN=op://AUTODEV/AUTODEV_AUTODEV_MEMORY_API_TOKEN/value
TS_AUTODEV_MEMORY_API_TOKEN=op://TS/TS_AUTODEV_MEMORY_API_TOKEN/value
WORKFLOW_PRO_AUTODEV_MEMORY_API_TOKEN=op://WORKFLOW_PRO/WORKFLOW_PRO_AUTODEV_MEMORY_API_TOKEN/value
