# Project-restricted AutoDEV bearer references for the shared Mac router.
# Resolved once at process startup; values remain in the router process memory.
AMARU_AUTODEV_MEMORY_API_TOKEN=op://AMARU/Autodev memory/api_token
AUTODEV_AUTODEV_MEMORY_API_TOKEN=op://AUTODEV/Autodev memory/api_token
TS_AUTODEV_MEMORY_API_TOKEN=op://TS/Autodev memory/api_token
WORKFLOW_PRO_AUTODEV_MEMORY_API_TOKEN=op://WORKFLOW_PRO/Autodev memory/api_token
