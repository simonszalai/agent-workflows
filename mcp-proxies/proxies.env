# 1Password references for the local (Mac) MCP loopback proxies. Values-free:
# resolved at runtime by `op run --env-file` in start-proxies.sh, authenticated by
# the service-account token from the Keychain (op-dev-token) — silent, no Touch ID.
#
# Same canonical op://TS items as ts-prefect/.env.cloud-mcp, so a rotation
# propagates to both environments with no extra sync step.
#
# NOT yet here: SLACK_MCP_USER_TOKEN — slack stays on the mcp-gateway.
# (op://MCP became service-account-readable — verified 2026-07-28 — so context7
# lives here now; the old "needs the R0001 vault move" blocker no longer applies.)
TS_RENDER_API_KEY=op://TS/TS_RENDER_API_KEY/value
AUTODEV_MEMORY_API_TOKEN=op://TS/AUTODEV_MEMORY_API_TOKEN/value
CONTEXT7_API_KEY=op://MCP/CONTEXT7_API_KEY/value
TAILSCALE_OAUTH_CLIENT_ID=op://TS/TAILSCALE_OAUTH_CLIENT_ID_MCP/value
TAILSCALE_OAUTH_CLIENT_SECRET=op://TS/TAILSCALE_OAUTH_CLIENT_SECRET_MCP/value
