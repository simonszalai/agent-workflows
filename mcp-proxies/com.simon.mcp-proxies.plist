<?xml version="1.0" encoding="UTF-8"?>
<!-- Loopback MCP auth proxies (project-routed autodev-memory 8792, context7 8793).
     Install: cp to ~/Library/LaunchAgents/ then
       launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.simon.mcp-proxies.plist
     Unlike the retired mcp-gateway plist, retrying is FREE here: credentials come from
     project-specific Keychain service-account tokens, never Touch ID. StartInterval re-runs the
     idempotent `ensure` every 5 minutes as a self-heal (a healthy listener is left
     alone; a dead one is restarted). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.simon.mcp-proxies</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/simon/dev/agent-workflows/mcp-proxies/start-proxies.sh</string>
        <string>ensure</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- `ensure` spawns the proxies with nohup and exits immediately. Without this,
         launchd reaps the whole process group when the script returns, killing every
         proxy it just started (they bind, log "ready", then die). -->
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/mcp-proxies.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mcp-proxies.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
