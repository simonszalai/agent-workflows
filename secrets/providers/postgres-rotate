#!/usr/bin/env bash
# postgres-rotate — resumable dual-principal Postgres credential rotation
# (registry-driven; one registry entry = one principal = one vault field).
#
# Two stages, both idempotent and resumable through one state file:
#   rotate   (default)          create + verify a versioned candidate login,
#                               activate every declared Render consumer (batch
#                               PUT, exact deploy, health), promote the candidate
#                               to the canonical vault field. STOPS at phase
#                               `promoted`; the predecessor stays valid.
#   finalize (ROTATE_FINALIZE=1) drain predecessor sessions, prove the complete
#                               Render inventory holds no predecessor, fence,
#                               retire, clean up the candidate item.
# rotate-secret runs the fan-out (github/prefect/hermes/cross-project) and the
# deploy/health gates between the two stages.
#
# Environment (exported by rotate-secret): ROTATE_ENTRY_JSON, ROTATE_REASON,
# ROTATE_RESUME (0/1), ROTATE_FINALIZE (0/1), SECRET_ROTATION_CONFIG, ROTATE_HOOK.
# Optional: ROTATE_EXTRA_CONSUMER_DESTS ("sid/ENV ..." accepted as declared by
# the inventory scan), ROTATE_INVENTORY_CACHE_DIR + ROTATE_SWEEP_ID (cache a
# clean inventory result per sweep), ROTATE_HOOK (activate / drain-stall).
#
# `postgres-rotate --print-lock-key` prints `<admin-project>/<instance-tier>`
# (the advisory-lock scope) from ROTATE_ENTRY_JSON + db-roles.json and exits;
# it reads nothing.
#
# exit codes: 0 promoted (rotate) / retired or nothing to finalize (finalize);
#   2 usage, state mismatch, lock contention or lock connection failure;
#   3 precondition refused, nothing changed; 4 candidate/activation failed
#   before promotion (predecessor valid, --resume); 5 promoted but a later proof
#   or retirement step failed (predecessor valid, --resume / finalize again);
#   75 advisory-lock session lost.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../lib}"
DB_ROLES_CONFIG="${DB_ROLES_CONFIG:-$HERE/../../config/db-roles.json}"

PRINT_LOCK_KEY=0
case "${1:-}" in
	"") ;;
	--print-lock-key) PRINT_LOCK_KEY=1 ;;
	*) echo "usage: postgres-rotate [--print-lock-key]  (driven by rotate-secret env)" >&2; exit 2 ;;
esac

# shellcheck source=../lib/read.sh
source "$SECRETS_LIB/read.sh"
# shellcheck source=../lib/derive.sh
source "$SECRETS_LIB/derive.sh"
# shellcheck source=../lib/vault.sh
source "$SECRETS_LIB/vault.sh"
# shellcheck source=../lib/render-api.sh
source "$SECRETS_LIB/render-api.sh"
# shellcheck source=../lib/db-url.sh
source "$SECRETS_LIB/db-url.sh"
# shellcheck source=../lib/db-rotation.sh
source "$SECRETS_LIB/db-rotation.sh"

fail() { echo "ERROR: $1" >&2; exit "${2:-2}"; }

[[ -n "${ROTATE_ENTRY_JSON:-}" ]] || fail "postgres-rotate must be invoked by rotate-secret (ROTATE_ENTRY_JSON missing)"
[[ -f "$DB_ROLES_CONFIG" ]] || fail "db roles config not found: $DB_ROLES_CONFIG"
need jq

ENTRY_ID="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '.id')"
PROJECT="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '.project')"
CANONICAL_REF="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '.ref')"

PROJECT_CFG="$(jq -ce --arg p "$PROJECT" '.projects[$p]' "$DB_ROLES_CONFIG")" \
	|| fail "project '$PROJECT' is not in $DB_ROLES_CONFIG" 3
cfg() { printf '%s' "$PROJECT_CFG" | jq -r "$1 // \"\""; }

# --- scope derivation from the grouped item title + field ---------------------
# Title carries the tier ("Postgres <tier>[ RO]"), the field the principal:
# root | owner | app | ro | canonical (legacy shared) | <app-slug>[_ro|_migrator].
REF_VAULT="" REF_TITLE="" REF_FIELD=""
ref_parts "$CANONICAL_REF" || exit 2
RO_ITEM=0
case "$REF_TITLE" in
	"Postgres prod") TIER="prod" ;;
	"Postgres staging") TIER="staging" ;;
	"Postgres prod RO") TIER="prod"; RO_ITEM=1 ;;
	"Postgres staging RO") TIER="staging"; RO_ITEM=1 ;;
	*) fail "cannot derive tier from item title '$REF_TITLE' (grouped 'Postgres <tier>[ RO]' expected)" 3 ;;
esac
FIELD="$REF_FIELD"
if [[ "$RO_ITEM" -eq 1 ]]; then
	if [[ "$FIELD" == "canonical" ]]; then FIELD="ro"; else FIELD="${FIELD}_ro"; fi
fi

SCOPE_KIND="" CAPABILITY="" APP_SLUG=""
case "$FIELD" in
	root)
		[[ "$PRINT_LOCK_KEY" -eq 1 ]] || {
			echo "MANUAL: the root credential is the provider-managed break-glass principal." >&2
			echo "Rotate it in the Render dashboard, then update $CANONICAL_REF with rotate-secret --complete." >&2
			exit 3
		}
		SCOPE_KIND="root" ;;
	owner) SCOPE_KIND="owner"; CAPABILITY="$(cfg '.roles.owner')" ;;
	app) SCOPE_KIND="app"; CAPABILITY="$(cfg '.roles.app')" ;;
	ro) SCOPE_KIND="ro"; CAPABILITY="$(cfg '.roles.ro')" ;;
	canonical)
		[[ "$PRINT_LOCK_KEY" -eq 1 ]] && SCOPE_KIND="canonical" \
			|| fail "field 'canonical' on '$REF_TITLE' is the legacy shared credential — rotate the per-role fields instead" 3 ;;
	*)
		while IFS=$'\t' read -r slug app_role ro_role migrator_role; do
			[[ -n "$slug" ]] || continue
			case "$FIELD" in
				"$slug") SCOPE_KIND="app"; APP_SLUG="$slug"; CAPABILITY="$app_role" ;;
				"${slug}_ro") SCOPE_KIND="ro"; APP_SLUG="$slug"; CAPABILITY="$ro_role" ;;
				"${slug}_migrator") SCOPE_KIND="migrator"; APP_SLUG="$slug"; CAPABILITY="$migrator_role" ;;
			esac
		done < <(printf '%s' "$PROJECT_CFG" | jq -r '(.apps // {}) | to_entries[]
			| [.key, (.value.roles.app // "-"), (.value.roles.ro // "-"), (.value.roles.migrator // "-")] | @tsv')
		[[ "$CAPABILITY" != "-" ]] || CAPABILITY=""
		;;
esac
[[ -n "$SCOPE_KIND" && ( -n "$CAPABILITY" || "$PRINT_LOCK_KEY" -eq 1 ) ]] \
	|| fail "item field '$REF_FIELD' on '$REF_TITLE' does not map to a role in $DB_ROLES_CONFIG (project $PROJECT)" 3

# --- instance / admin resolution ---------------------------------------------
# The role lives on an INSTANCE (physical Render Postgres). Cross-instance apps
# declare instance {project, tier_map}; shared boxes declare admin_via. The
# ADMIN project owns the box's root/owner fields, render key, and lock scope.
INSTANCE_PROJECT="$PROJECT" INSTANCE_TIER="$TIER"
if [[ -n "$APP_SLUG" ]]; then
	inst="$(printf '%s' "$PROJECT_CFG" | jq -r --arg a "$APP_SLUG" '.apps[$a].instance.project // ""')"
	if [[ -n "$inst" ]]; then
		INSTANCE_PROJECT="$inst"
		INSTANCE_TIER="$(printf '%s' "$PROJECT_CFG" | jq -r --arg a "$APP_SLUG" --arg t "$TIER" '.apps[$a].instance.tier_map[$t] // ""')"
		[[ -n "$INSTANCE_TIER" ]] || fail "app '$APP_SLUG' has no instance tier mapping for tier '$TIER'" 3
	fi
fi
INSTANCE_CFG="$(jq -ce --arg p "$INSTANCE_PROJECT" '.projects[$p]' "$DB_ROLES_CONFIG")" \
	|| fail "instance project '$INSTANCE_PROJECT' is not in $DB_ROLES_CONFIG" 3
BOX_CFG="$(printf '%s' "$INSTANCE_CFG" | jq -ce --arg t "$INSTANCE_TIER" '.tiers[$t]')" \
	|| fail "instance project '$INSTANCE_PROJECT' has no tier '$INSTANCE_TIER'" 3
DB_ID="$(printf '%s' "$BOX_CFG" | jq -r '.db_id')"
TABLE_OWNER="$(printf '%s' "$BOX_CFG" | jq -r '.table_owner')"
ADMIN_PROJECT="$(printf '%s' "$BOX_CFG" | jq -r '.admin_via.project // ""')"
[[ -n "$ADMIN_PROJECT" ]] || ADMIN_PROJECT="$INSTANCE_PROJECT"
ADMIN_CFG="$(jq -ce --arg p "$ADMIN_PROJECT" '.projects[$p]' "$DB_ROLES_CONFIG")" \
	|| fail "admin project '$ADMIN_PROJECT' is not in $DB_ROLES_CONFIG" 3
ADMIN_TABLE_OWNER="$(printf '%s' "$BOX_CFG" | jq -r '.admin_via.table_owner // ""')"
[[ -n "$ADMIN_TABLE_OWNER" ]] || ADMIN_TABLE_OWNER="$TABLE_OWNER"

# Single source of the advisory-lock scope (rotate-project waves use it too).
LOCK_KEY="${ADMIN_PROJECT}/${INSTANCE_TIER}"
if [[ "$PRINT_LOCK_KEY" -eq 1 ]]; then
	printf '%s\n' "$LOCK_KEY"
	exit 0
fi

# --- run preconditions --------------------------------------------------------
ROTATION_CONFIG="${SECRET_ROTATION_CONFIG:-}"
[[ -n "$ROTATION_CONFIG" ]] || fail "SECRET_ROTATION_CONFIG must be exported by rotate-secret"
[[ -f "$ROTATION_CONFIG" ]] || fail "rotation registry not found: $ROTATION_CONFIG"
REASON="${ROTATE_REASON:-}"
[[ -n "$REASON" ]] || fail "--reason is required for database and vault credential access"
export SENSITIVE_ACCESS_REASON="$REASON"
guard_agent_shell || exit 3
FINALIZE="${ROTATE_FINALIZE:-0}"
LOAD_STATE="${ROTATE_RESUME:-0}"
[[ "$FINALIZE" == "1" ]] && LOAD_STATE=1

# Admin credentials are declared per admin-project/tier; no convention fallback
# (a plausible-looking item may hold the wrong principal entirely).
ROOT_REF="$(printf '%s' "$ADMIN_CFG" | jq -r --arg t "$INSTANCE_TIER" '.admin_refs[$t].root // empty')"
[[ -n "$ROOT_REF" ]] || fail "no admin_refs.$INSTANCE_TIER.root for admin project '$ADMIN_PROJECT' in $DB_ROLES_CONFIG; declare it (root must NOT be a rotatable login)" 3
ADMIN_OWNER_REF="$(printf '%s' "$ADMIN_CFG" | jq -r --arg t "$INSTANCE_TIER" '.admin_refs[$t].owner // empty')"
[[ -n "$ADMIN_OWNER_REF" ]] || fail "no admin_refs.$INSTANCE_TIER.owner for admin project '$ADMIN_PROJECT' in $DB_ROLES_CONFIG; declare it" 3
RENDER_KEY_REF="$(printf '%s' "$ADMIN_CFG" | jq -r '.render_key_ref')"

OWNER_KIND="$(printf '%s' "$INSTANCE_CFG" | jq -r '.owner_kind // "render_credential"')"
# App/ro SET ROLE their capability. Migrator on a sql_role box SET ROLEs the
# SQL owner; on a dedicated box it SET ROLEs itself (Render has no superuser,
# GRANT table_owner is not a rotation primitive).
SET_ROLE_TARGET="$CAPABILITY"
if [[ "$SCOPE_KIND" == "migrator" && "$OWNER_KIND" == "sql_role" ]]; then
	SET_ROLE_TARGET="$(printf '%s' "$INSTANCE_CFG" | jq -r '.roles.owner // empty')"
	[[ -n "$SET_ROLE_TARGET" ]] || fail "sql_role migrator needs projects.$INSTANCE_PROJECT.roles.owner" 3
fi
if [[ "$SCOPE_KIND" == "owner" && "$OWNER_KIND" != "render_credential" ]]; then
	cat >&2 <<EOF
REFUSED: project '$PROJECT' has owner_kind '$OWNER_KIND'. On the shared instance
($DB_ID) creating or deleting a Render managed credential would flip the
instance default away from the admin owner. SQL-role owner rotation is not
implemented; rotate this owner manually as the instance admin ($ADMIN_TABLE_OWNER)
following docs/secrets.md "Postgres rotation".
Nothing was changed.
EOF
	exit 3
fi

# Target database for the candidate URL (per-app databases override wins).
PRIMARY_DB="$(printf '%s' "$BOX_CFG" | jq -r '.database')"
if [[ -n "$APP_SLUG" ]]; then
	app_db="$(printf '%s' "$PROJECT_CFG" | jq -r --arg a "$APP_SLUG" '(.apps[$a].databases // [])[0] // ""')"
	[[ -n "$app_db" ]] && PRIMARY_DB="$app_db"
fi

# --- targets: the registry consumer rows (dest, env, transform) ----------------
# Render dests are ACTIVATION targets (batch PUT + exact deploy + health).
# GitHub dests are fan-out-only consumers (rotate-secret). Anything else fails.
ROTATION_SIDS=() ROTATION_ENVS=() ROTATION_TRANSFORMS=() ROTATION_NEW_VALUES=()
while IFS=$'\t' read -r sid env tr_val; do
	[[ -n "$sid" ]] || continue
	if [[ "$sid" =~ ^(srv|crn)- ]]; then
		ROTATION_SIDS+=("$sid")
		ROTATION_ENVS+=("$env")
		# The route's TRANSFORM shapes the value THIS dest receives.
		ROTATION_TRANSFORMS+=("${tr_val:-self}")
	elif [[ "$sid" == */* ]]; then
		: # github row — covered by the sync fan-out after promotion
	else
		fail "consumer dest '$sid' is neither a Render service id nor a github repo; refusing an unknown consumer kind" 3
	fi
done < <(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '. as $e | ($e.consumers // [])[] | . as $c
	| [$c.dest, $c.env, (([($e.routes // [])[] | select(.dest == $c.dest and .env == $c.env) | .transform] | first) // "self")] | @tsv')

# Dests the inventory scan treats as DECLARED (fan-out reaches them): every
# render route of this entry plus rotate-secret's cross-project allowlist.
ROTATION_DECLARED_DESTS="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '
	[(.consumers // [])[], (.routes // [])[] | select((.dest // "") | test("^(srv|crn)-")) | "\(.dest)/\(.env)"]
	| unique | join(" ")') ${ROTATE_EXTRA_CONSUMER_DESTS:-}"
# A predecessor login is only dangerous where it can authenticate: the scan
# requires the instance host marker OR a pgbouncer host routed for this entry.
ROTATION_INSTANCE_MARKERS="${DB_ID%-a} $(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '
	[(.routes // [])[] | (.transform // "") | select(startswith("pgbouncer=")) | ltrimstr("pgbouncer=") | split("/")[0] | split(":")[0]]
	| unique | join(" ")')"

# Health URLs are a fail-closed registry: every target service must be
# registered BEFORE any mutation.
health_url_for() { # sid -> url; rc 1 unknown
	jq -er --arg sid "$1" '.health_urls[$sid] | select(type == "string" and length > 0)' "$ROTATION_CONFIG"
}
while IFS= read -r sid; do
	[[ -n "$sid" ]] || continue
	health_url_for "$sid" >/dev/null \
		|| fail "no health URL registered for render[$sid] in $ROTATION_CONFIG (health_urls) — refusing to rotate blind" 3
done < <(rotation_unique_services)

# --- state file (read-free checks before any credential is touched) ------------
STATE_DIR="${DB_ROTATION_STATE_DIR:-$HOME/.local/state/agent-workflows/db-rotation}"
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"
# One state file per independent rotation (scope + app slug); the instance
# advisory lock still serializes execution.
STATE_FILE="$STATE_DIR/${PROJECT}-${TIER}-${SCOPE_KIND}${APP_SLUG:+-$APP_SLUG}.state"
if [[ "$FINALIZE" == "1" ]]; then
	[[ -f "$STATE_FILE" ]] || { echo "nothing to finalize for ${PROJECT}/${TIER}/${SCOPE_KIND}${APP_SLUG:+/$APP_SLUG} (no rotation state)"; exit 0; }
elif [[ "$LOAD_STATE" == "1" ]]; then
	# rotate-secret --resume with nothing to resume is a fresh rotation
	# (rotate-project always passes --resume so reruns converge).
	if [[ ! -f "$STATE_FILE" ]]; then
		echo "no ${PROJECT}/${TIER}/${SCOPE_KIND}${APP_SLUG:+/$APP_SLUG} rotation state to resume; starting a fresh rotation"
		LOAD_STATE=0
	fi
else
	[[ ! -e "$STATE_FILE" ]] || fail "unfinished ${PROJECT}/${TIER}/${SCOPE_KIND}${APP_SLUG:+/$APP_SLUG} rotation state exists; rerun with --resume (or finalize)."
fi

need curl
need openssl
need "${PSQL_BIN:-psql}"

# --- Render keys ----------------------------------------------------------------
# The admin key can read/write the Render Postgres instance. Consumer services
# may live in a different workspace (autodev services on the workflow-pro box):
# using the admin key for /services/<sid> is a 403.
PROJECT_TOOLS="${PROJECT_TOOLS_CONFIG:-$HERE/../../config/project-tools.json}"
[[ -f "$PROJECT_TOOLS" ]] || fail "project-tools config not found: $PROJECT_TOOLS" 3
ADMIN_RENDER_KEY="$(op_vault_read "$RENDER_KEY_REF")" || exit 3
[[ -n "$ADMIN_RENDER_KEY" ]] || fail "Render API key resolved empty" 3
RENDER_API_KEY="$ADMIN_RENDER_KEY"
export RENDER_API_KEY

_CONSUMER_KEY_REFS=()
_CONSUMER_KEY_VALS=()
render_key_ref_for_repo() { # repo-name -> op:// ref
	local repo="$1" matches n keyref
	matches="$(jq -r --arg repo "$repo" '
		[.projects | to_entries[]
		 | select(any(.value.repo_remotes[]?;
		     (split("/")[-1] == $repo) or (split("/")[-1] == ($repo + ".git"))))
		 | .key] | unique | .[]' "$PROJECT_TOOLS")" || return 3
	n="$(printf '%s\n' "$matches" | sed '/^$/d' | wc -l | tr -d ' ')"
	[[ "$n" == "1" ]] || {
		echo "ERROR: repo '$repo' maps to $n project-tools profiles; need exactly one to pick a Render key" >&2
		return 3
	}
	keyref="$(jq -r --arg p "$matches" '.projects[$p].render.api_key_ref // empty' "$PROJECT_TOOLS")"
	[[ -n "$keyref" ]] || { echo "ERROR: project '$matches' has no render.api_key_ref" >&2; return 3; }
	printf %s "$keyref"
}
repo_for_sid() { # sid -> repo name from the synthesized consumers/routes
	printf '%s' "$ROTATE_ENTRY_JSON" | jq -r --arg d "$1" '
		([.consumers[]? | select(.dest == $d) | .repo]
		 + [.routes[]? | select(.dest == $d) | .repo])
		| map(select(type == "string" and . != "")) | first // empty'
}
render_key_value_for_ref() { # op:// ref -> key value (cached)
	local ref="$1" val i=0
	[[ "$ref" == "$RENDER_KEY_REF" ]] && { printf %s "$ADMIN_RENDER_KEY"; return 0; }
	while [[ $i -lt ${#_CONSUMER_KEY_REFS[@]} ]]; do
		[[ "${_CONSUMER_KEY_REFS[$i]}" == "$ref" ]] && { printf %s "${_CONSUMER_KEY_VALS[$i]}"; return 0; }
		i=$((i + 1))
	done
	val="$(op_vault_read "$ref")" || return 3
	[[ -n "$val" ]] || { echo "ERROR: Render API key $ref resolved empty" >&2; return 3; }
	_CONSUMER_KEY_REFS+=("$ref")
	_CONSUMER_KEY_VALS+=("$val")
	printf %s "$val"
}
consumer_render_key_for_sid() { # sid -> key value
	local sid="$1" repo ref
	repo="$(repo_for_sid "$sid")"
	[[ -n "$repo" ]] || {
		echo "ERROR: no repo on rotation consumers/routes for render[$sid]; refusing to use the instance admin Render key (cross-workspace 403)" >&2
		return 3
	}
	ref="$(render_key_ref_for_repo "$repo")" || return $?
	render_key_value_for_ref "$ref"
}
with_sid_render_key() { # sid cmd... — RENDER_API_KEY of that service's workspace for one call
	local sid="$1" key
	shift
	key="$(consumer_render_key_for_sid "$sid")" || return $?
	RENDER_API_KEY="$key" "$@"
}
inventory_render_key_refs() { # unique refs: instance admin + every consumer workspace
	local sid repo ref out="$RENDER_KEY_REF"
	while IFS= read -r sid; do
		[[ -n "$sid" ]] || continue
		repo="$(repo_for_sid "$sid")"
		[[ -n "$repo" ]] || continue
		ref="$(render_key_ref_for_repo "$repo")" || return $?
		out="$out"$'\n'"$ref"
	done < <(rotation_unique_services)
	printf '%s\n' "$out" | sort -u
}

RENDER_INTERNAL="" RENDER_EXTERNAL=""
refresh_conninfo() {
	local info
	info="$(render_get "/postgres/${DB_ID}/connection-info")" || return $?
	RENDER_INTERNAL="$(printf '%s' "$info" | jq -er '.internalConnectionString | select(type == "string" and length > 0)')" || return $?
	RENDER_EXTERNAL="$(printf '%s' "$info" | jq -er '.externalConnectionString | select(type == "string" and length > 0)')" || return $?
}
refresh_conninfo || fail "Render connection-info for $DB_ID is unavailable" 3

# --- advisory lock (one long-lived root session over the external endpoint) ----
LOCK_PID="" LOCK_IN="" LOCK_OUT="" LOCK_ERR="" ROOT_CONTROL_URL=""
close_rotation_lock() {
	if [[ -n "$LOCK_PID" ]]; then
		printf '\\q\n' >&8 2>/dev/null || true
		exec 8>&- 2>/dev/null || true
		exec 7<&- 2>/dev/null || true
		wait "$LOCK_PID" 2>/dev/null || true
		LOCK_PID=""
	fi
	rm -f "$LOCK_IN" "$LOCK_OUT" "$LOCK_ERR"
}
rotation_exit_cleanup() {
	local rc=$?
	close_rotation_lock
	trap - EXIT
	exit "$rc"
}
trap rotation_exit_cleanup EXIT

# Every mutation and every poll iteration probes the lock session; a lost
# session stops the rotator before the next mutation (rc 75).
assert_rotation_lock_live() {
	local result
	[[ -n "$LOCK_PID" ]] && kill -0 "$LOCK_PID" 2>/dev/null || {
		echo "ERROR: the PostgreSQL advisory-lock process is not alive." >&2
		return 75
	}
	printf "SELECT EXISTS (SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND pid = pg_backend_pid() AND granted);\n" >&8 || {
		echo "ERROR: could not probe the PostgreSQL advisory-lock session." >&2
		return 75
	}
	IFS= read -r result <&7 || {
		echo "ERROR: the PostgreSQL advisory-lock session closed during its liveness probe." >&2
		return 75
	}
	[[ "$result" == "t" ]] || {
		echo "ERROR: the PostgreSQL session no longer holds the tier advisory lock." >&2
		return 75
	}
}

acquire_rotation_lock() { # rc 0 held, 2 contention/connection failure, 3 root unreadable
	local root_url root_external result
	root_url="$(op_vault_read "$ROOT_REF")" || return 3
	root_external="$(db_rehost_url "$root_url" "$RENDER_EXTERNAL")" || return 2
	root_url=""
	# Drop options=-c role=... so the lock/GRANT session is the root login
	# (ts_root has ADMIN OPTION on ts_user; SET ROLE ts_user does not).
	root_external="$(db_url_without_role_option "$root_external")" || return 2
	ROOT_CONTROL_URL="$root_external"
	LOCK_IN="$STATE_DIR/${PROJECT}-${TIER}.lock.in.$$"
	LOCK_OUT="$STATE_DIR/${PROJECT}-${TIER}.lock.out.$$"
	LOCK_ERR="$STATE_DIR/${PROJECT}-${TIER}.lock.err.$$"
	mkfifo "$LOCK_IN" "$LOCK_OUT"
	chmod 600 "$LOCK_IN" "$LOCK_OUT"
	# Socket keepalives: the Render external proxy drops idle flows at ~5min and
	# a long drain-stall hook can leave a multi-minute gap between probes.
	PGKEEPALIVESIDLE=30 PGKEEPALIVESINTERVAL=10 PGKEEPALIVESCOUNT=6 \
	db_run_psql_url "$root_external" -q -t -A -F '|' -v ON_ERROR_STOP=1 \
		< "$LOCK_IN" > "$LOCK_OUT" 2> "$LOCK_ERR" &
	LOCK_PID=$!
	root_external=""
	exec 8> "$LOCK_IN"
	exec 7< "$LOCK_OUT"
	printf "SELECT pg_try_advisory_lock(hashtextextended('%s-credential-rotation:%s', 0)), pg_backend_pid();\n" \
		"${LOCK_KEY%/*}" "${LOCK_KEY#*/}" >&8
	IFS= read -r result <&7 || {
		echo "ERROR: advisory-lock connection failed ($(tr '\n' ' ' < "$LOCK_ERR" 2>/dev/null))." >&2
		return 2
	}
	case "$result" in
		t\|*)
			echo "  db: acquired $LOCK_KEY credential-rotation advisory lock"
			assert_rotation_lock_live ;;
		f\|*) echo "ERROR: another $LOCK_KEY credential rotation holds the advisory lock." >&2; return 2 ;;
		*) echo "ERROR: advisory-lock response was invalid." >&2; return 2 ;;
	esac
}
acquire_rotation_lock || exit $?
ROOT_LOGIN="$(db_url_username "$ROOT_CONTROL_URL")" || exit 2

# --- rotation state ---------------------------------------------------------------
STATE_PHASE="initial" VERSION_TAG="" LOGIN="" CANDIDATE_REF="" OLD_LOGINS=""
write_state() {
	local tmp="${STATE_FILE}.tmp.$$"
	assert_rotation_lock_live || return $?
	(
		umask 077
		jq -n --arg entryId "$ENTRY_ID" --arg project "$PROJECT" --arg tier "$TIER" \
			--arg scope "$SCOPE_KIND" --arg phase "$STATE_PHASE" --arg versionTag "$VERSION_TAG" \
			--arg login "$LOGIN" --arg candidateRef "$CANDIDATE_REF" --arg oldLogins "$OLD_LOGINS" \
			'{stateVersion:1,entryId:$entryId,project:$project,tier:$tier,scope:$scope,
			  phase:$phase,versionTag:$versionTag,login:$login,candidateRef:$candidateRef,oldLogins:$oldLogins}'
	) > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$STATE_FILE"
}

CANDIDATE_LOGIN_PATTERN="^${CAPABILITY}_login_[a-z0-9]+(_[a-z0-9]+)*$"
PREDECESSOR_PATTERN="^${CAPABILITY}(_login_[a-z0-9]+(_[a-z0-9]+)*)?$"

validate_predecessor() { # login
	[[ "$1" =~ $PREDECESSOR_PATTERN ]] || {
		echo "ERROR: refusing to rotate unexpected $SCOPE_KIND predecessor login '$1'." >&2
		return 1
	}
}
# The instance table owner / admin owner and the root login are never
# predecessors: never drained, never fenced, never retired.
protected_login() { [[ "$1" == "$ADMIN_TABLE_OWNER" || "$1" == "$TABLE_OWNER" || "$1" == "$ROOT_LOGIN" ]]; }

candidate_ref_for() { # suffix -> candidate vault ref beside the canonical item
	printf 'op://%s/%s_CANDIDATE_%s_%s/value' "$REF_VAULT" "$REF_TITLE" "$REF_FIELD" "$1"
}

if [[ "$LOAD_STATE" == "1" ]]; then
	state_json="$(cat "$STATE_FILE")" || exit 2
	jq -e 'type == "object" and .stateVersion == 1
		and all(.entryId,.project,.tier,.scope,.phase,.versionTag,.login,.candidateRef,.oldLogins; type == "string")' \
		< <(printf '%s' "$state_json") >/dev/null || fail "malformed rotation state JSON."
	state_scope="$(printf '%s' "$state_json" | jq -r '[.entryId,.project,.tier,.scope] | join("|")')"
	[[ "$state_scope" == "$ENTRY_ID|$PROJECT|$TIER|$SCOPE_KIND" ]] \
		|| fail "requested entry/tier/scope does not match the saved rotation state."
	STATE_PHASE="$(printf '%s' "$state_json" | jq -r '.phase')"
	VERSION_TAG="$(printf '%s' "$state_json" | jq -r '.versionTag')"
	LOGIN="$(printf '%s' "$state_json" | jq -r '.login')"
	CANDIDATE_REF="$(printf '%s' "$state_json" | jq -r '.candidateRef')"
	OLD_LOGINS="$(printf '%s' "$state_json" | jq -r '.oldLogins')"
	state_json=""
	[[ "$LOGIN" =~ $CANDIDATE_LOGIN_PATTERN ]] || fail "rotation state contains an invalid $SCOPE_KIND login name."
	for old in $OLD_LOGINS; do validate_predecessor "$old" || exit 2; done
	case "$STATE_PHASE" in initial|prepared|activated|promoted|retired) ;; *) fail "invalid rotation state phase." ;; esac
	[[ "$VERSION_TAG" =~ ^[a-z0-9]+(_[a-z0-9]+)*$ ]] || fail "invalid rotation version tag."
	candidate_suffix="${LOGIN#"${CAPABILITY}"_login_}"
	[[ "$candidate_suffix" == "$VERSION_TAG" || "$candidate_suffix" == "${VERSION_TAG}_retry_"* ]] \
		&& [[ "$CANDIDATE_REF" == "$(candidate_ref_for "$candidate_suffix")" ]] \
		|| fail "candidate identity does not match the rotation state."
	echo "Resuming ${PROJECT}/${TIER}/${SCOPE_KIND}${APP_SLUG:+/$APP_SLUG} rotation at phase $STATE_PHASE$([[ "$FINALIZE" == "1" ]] && echo " (finalize)")."
else
	version_timestamp="$(date -u +%Y%m%dt%H%M%S)" || exit 2
	version_hex="$(openssl rand -hex 3)" || exit 2
	[[ "$version_timestamp" =~ ^[0-9]{8}t[0-9]{6}$ && "$version_hex" =~ ^[a-f0-9]{6}$ ]] \
		|| fail "could not generate a valid rotation identity."
	VERSION_TAG="${version_timestamp}_${version_hex}"
	LOGIN="${CAPABILITY}_login_${VERSION_TAG}"
	CANDIDATE_REF="$(candidate_ref_for "$VERSION_TAG")"
fi

# --- admin control connection (DDL + drain evidence) -------------------------------
if ADMIN_OWNER_VALUE="$(op_vault_read "$ADMIN_OWNER_REF")"; then
	:
elif [[ "$LOAD_STATE" == "1" && "$STATE_PHASE" != "initial" ]]; then
	ADMIN_OWNER_VALUE=""
	echo "  vault: admin OWNER field is unavailable; using zero-consumer root for recovery"
else
	fail "the admin OWNER field ($ADMIN_OWNER_REF) is not readable; provision the instance first (db-provision-roles)." 3
fi
CONTROL_URL="$ROOT_CONTROL_URL"
[[ -z "$ADMIN_OWNER_VALUE" ]] || CONTROL_URL="$(db_rehost_url "$ADMIN_OWNER_VALUE" "$RENDER_EXTERNAL")" || exit 3
if [[ -n "$ADMIN_OWNER_VALUE" ]] \
	&& control_effective="$(db_run_psql_url "$CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -c 'SELECT current_user')" \
	&& [[ "$control_effective" == "$ADMIN_TABLE_OWNER" ]]; then
	:
elif [[ "$LOAD_STATE" == "1" && "$STATE_PHASE" != "initial" ]] \
	&& control_effective="$(db_run_psql_url "$ROOT_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -c 'SELECT current_user')" \
	&& [[ -n "$control_effective" ]]; then
	CONTROL_URL="$ROOT_CONTROL_URL"
	echo "  db: admin OWNER control is unavailable; using zero-consumer root for recovery"
else
	fail "the admin control connection is not effective role $ADMIN_TABLE_OWNER." 3
fi
ADMIN_OWNER_VALUE=""

# --- live target iteration + predecessor capture -------------------------------------
append_unique_word() { # variable-name value
	local var="$1" word="$2" current
	current="${!var}"
	[[ " $current " == *" $word "* ]] || printf -v "$var" '%s' "${current:+$current }$word"
}

target_live_value() { # index -> live env value on stdout ("" when the var is blank)
	local sid="${ROTATION_SIDS[$1]}" env="${ROTATION_ENVS[$1]}" json
	json="$(with_sid_render_key "$sid" render_get "/services/${sid}/env-vars/${env}")" || return $?
	printf '%s' "$json" | jq -r '.value // ""'
}
for_each_live_target() { # callback(index value) — one Render read per declared target
	local i=0 value
	while [[ $i -lt ${#ROTATION_SIDS[@]} ]]; do
		value="$(target_live_value "$i")" || return $?
		"$1" "$i" "$value" || return $?
		value=""
		i=$((i + 1))
	done
}

record_predecessor() { # login
	local login="$1"
	if protected_login "$login"; then
		echo "  predecessor: $login is a protected principal (table owner / root); it is never drained or retired"
		return 0
	fi
	validate_predecessor "$login" || return 1
	if [[ "$login" == "$LOGIN" ]]; then
		echo "ERROR: candidate login already appears in a live/canonical source while rotation state is initial; refusing an ambiguous predecessor snapshot." >&2
		return 1
	fi
	append_unique_word OLD_LOGINS "$login"
}
_capture_target() { # index value
	local login
	[[ -n "$2" ]] || { echo "  render[${ROTATION_SIDS[$1]}] ${ROTATION_ENVS[$1]} is unset; no predecessor captured there"; return 0; }
	login="$(db_url_username "$2")" || return $?
	record_predecessor "$login"
}
capture_predecessors() {
	local value login
	[[ "$STATE_PHASE" == "initial" ]] || return 0
	for_each_live_target _capture_target || return $?
	# Render and 1Password can drift: snapshot the canonical principal too so
	# promotion never loses the only reference to a still-valid predecessor.
	value="$(op_vault_read "$CANONICAL_REF")" || return $?
	login="$(db_url_username "$value")" || return $?
	value=""
	record_predecessor "$login" || return $?
	write_state
}
capture_predecessors || { echo "ERROR: predecessor capture failed; nothing was changed." >&2; exit 3; }

# --- candidate ------------------------------------------------------------------------
locked_vault_create() { assert_rotation_lock_live || return $?; vault_create_value "$1"; }   # value in VAULT_VALUE
locked_vault_replace() { assert_rotation_lock_live || return $?; vault_replace_value "$1"; } # value in VAULT_VALUE
vault_delete_candidate() { # ref
	local ref="$1" item_id rc
	local REF_VAULT REF_TITLE REF_FIELD
	[[ -n "$ref" ]] || return 0
	if item_id="$(vault_item_id "$ref")"; then
		ref_parts "$ref"
		assert_rotation_lock_live || return $?
		op_vault_mutation "$REF_VAULT" item delete "$item_id" --vault "$REF_VAULT" >/dev/null
		vault_listing_invalidate
		if item_id="$(vault_item_id "$ref")"; then
			echo "ERROR: candidate item still exists after deletion ($ref)." >&2
			return 1
		else
			rc=$?
			[[ "$rc" == "1" ]] || return "$rc"
		fi
		echo "  vault: removed candidate item $ref"
	else
		rc=$?
		[[ "$rc" == "1" ]] || return "$rc"
	fi
}

OBSERVED_CANDIDATE=""
_observe_target() { # index value
	local user
	[[ -n "$2" ]] || return 0
	user="$(db_url_username "$2")" || return 2
	[[ "$user" == "$LOGIN" ]] || return 0
	[[ -z "$OBSERVED_CANDIDATE" || "$OBSERVED_CANDIDATE" == "$2" ]] || {
		echo "ERROR: conflicting live values use the missing candidate login." >&2
		return 2
	}
	OBSERVED_CANDIDATE="$2"
}
observe_candidate_value() { # -> exact observed value; 1=unused, 2=conflict
	local value user
	OBSERVED_CANDIDATE=""
	for_each_live_target _observe_target || return 2
	value="$(op_vault_read "$CANONICAL_REF")" || return 2
	user="$(db_url_username "$value")" || return 2
	if [[ "$user" == "$LOGIN" ]]; then
		[[ -z "$OBSERVED_CANDIDATE" || "$OBSERVED_CANDIDATE" == "$value" ]] || {
			echo "ERROR: canonical and live values conflict for the missing candidate login." >&2
			return 2
		}
		OBSERVED_CANDIDATE="$value"
	fi
	value=""
	[[ -n "$OBSERVED_CANDIDATE" ]] || return 1
	printf %s "$OBSERVED_CANDIDATE"
}

reset_candidate_identity() { # old candidate is retained for final proof/retirement
	local retry_hex
	retry_hex="$(openssl rand -hex 3)" || return $?
	[[ "$retry_hex" =~ ^[a-f0-9]{6}$ ]] || { echo "ERROR: OpenSSL did not produce a valid retry identity suffix." >&2; return 1; }
	append_unique_word OLD_LOGINS "$LOGIN"
	LOGIN="${CAPABILITY}_login_${VERSION_TAG}_retry_${retry_hex}"
	CANDIDATE_REF="$(candidate_ref_for "${VERSION_TAG}_retry_${retry_hex}")"
	STATE_PHASE="prepared"
	write_state
	echo "  recovery: replaced unusable candidate identity; prior login remains tracked for retirement"
}

CANDIDATE_VALUE="" CANDIDATE_EXTERNAL=""

_verify_candidate_target() { # index value — a live value for the candidate login must equal what was PUT
	local live_user expected
	[[ -n "$2" ]] || return 0
	live_user="$(db_url_username "$2")" || return $?
	# Compare the value that was actually PUT (route transform), not the raw DSN.
	expected="$(printf %s "$CANDIDATE_VALUE" | apply_transform "${ROTATION_TRANSFORMS[$1]}")" || return $?
	if [[ "$live_user" == "$LOGIN" && "$2" != "$expected" ]]; then
		echo "ERROR: candidate item differs from a live Render value for the same login; refusing to change an active password." >&2
		return 1
	fi
}
verify_sql_candidate_before_mutation() {
	local canonical canonical_user
	[[ "$(db_url_username "$CANDIDATE_VALUE")" == "$LOGIN" ]] || {
		echo "ERROR: candidate item does not contain the saved candidate login." >&2
		return 1
	}
	[[ "$STATE_PHASE" != "initial" ]] || return 0
	for_each_live_target _verify_candidate_target || return $?
	if canonical="$(op_vault_read "$CANONICAL_REF")"; then
		canonical_user="$(db_url_username "$canonical")" || return $?
		if [[ "$canonical_user" == "$LOGIN" && "$canonical" != "$CANDIDATE_VALUE" ]]; then
			echo "ERROR: candidate item differs from the canonical value for the same login; refusing to change an active password." >&2
			return 1
		fi
		if [[ "$STATE_PHASE" == "promoted" && "$canonical" != "$CANDIDATE_VALUE" ]]; then
			echo "ERROR: promoted canonical value no longer matches the saved candidate." >&2
			return 1
		fi
	elif [[ "$STATE_PHASE" == "promoted" ]]; then
		echo "ERROR: promoted canonical item is unreadable; refusing candidate mutation." >&2
		return 1
	fi
}

candidate_base_url() {
	# Cross-instance consumers and sql_role shared boxes cannot use the
	# Render-internal hostname; in-instance Render consumers prefer it.
	if [[ "$INSTANCE_PROJECT" != "$PROJECT" || "$OWNER_KIND" == "sql_role" ]]; then
		printf %s "$RENDER_EXTERNAL"
	elif [[ ${#ROTATION_SIDS[@]} -gt 0 ]]; then
		printf %s "$RENDER_INTERNAL"
	else
		printf %s "$RENDER_EXTERNAL"
	fi
}
compose_candidate_url() { # password -> URL with SET ROLE option + target db
	local url
	url="$(db_compose_url "$(candidate_base_url)" "$LOGIN" "$1" "$SET_ROLE_TARGET")" || return $?
	db_url_with_database "$url" "$PRIMARY_DB"
}

# One CREATE/ALTER/GRANT for every SQL scope. Never GRANT the Render table
# owner (no superuser; SET ROLE table_owner cannot grant itself).
create_candidate_login() { # password
	local is_ro=0
	[[ "$SCOPE_KIND" == "ro" ]] && is_ro=1
	assert_rotation_lock_live || return $?
	LOGIN_PASSWORD="$1" db_run_psql_url "$CONTROL_URL" -q -v ON_ERROR_STOP=1 \
		-v login="$LOGIN" -v capability="$CAPABILITY" -v set_role="$SET_ROLE_TARGET" -v ro="$is_ro" <<'SQL'
\set login_pw `printf %s "$LOGIN_PASSWORD"`
SELECT format('CREATE ROLE %I NOINHERIT LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS', :'login', :'login_pw')
WHERE to_regrole(:'login') IS NULL \gexec
SELECT format('ALTER ROLE %I NOINHERIT LOGIN PASSWORD %L NOCREATEDB NOCREATEROLE', :'login', :'login_pw') \gexec
SELECT format('ALTER ROLE %I SET default_transaction_read_only = on', :'login') WHERE :'ro' = '1' \gexec
SELECT format('GRANT %I TO %I WITH INHERIT TRUE, SET TRUE, ADMIN FALSE', :'capability', :'login') \gexec
SELECT format('GRANT %I TO %I WITH INHERIT TRUE, SET TRUE, ADMIN FALSE', :'set_role', :'login') WHERE :'set_role' <> :'capability' \gexec
SQL
}

# One attestation query for every scope; callers compare field-wise ('*' = any):
#   session_user|current_user|login.super|login.bypassrls|runtime.super|
#   runtime.bypassrls|can SET ROLE|owns any public table|owns all public tables|
#   login inherits SELECT on public tables|default_transaction_read_only
ATTEST_SQL="SELECT session_user, current_user, l.rolsuper, l.rolbypassrls, r.rolsuper, r.rolbypassrls,
 pg_has_role(session_user, current_user, 'SET'),
 EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p') AND pg_has_role(session_user, c.relowner, 'MEMBER')),
 NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p') AND NOT pg_has_role(session_user, c.relowner, 'MEMBER')),
 COALESCE((SELECT bool_or(has_table_privilege(session_user, c.oid, 'SELECT')) FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p')), false),
 current_setting('default_transaction_read_only')
 FROM pg_roles l, pg_roles r WHERE l.rolname = session_user AND r.rolname = current_user"
attest_candidate() { # expected-pattern
	local actual i
	local -a exp act
	actual="$(db_run_psql_url "$CANDIDATE_EXTERNAL" -q -t -A -F '|' -v ON_ERROR_STOP=1 -c "$ATTEST_SQL")" || return 1
	IFS='|' read -r -a exp <<<"$1"
	IFS='|' read -r -a act <<<"$actual"
	[[ ${#exp[@]} -eq ${#act[@]} ]] || return 1
	for i in "${!exp[@]}"; do
		[[ "${exp[$i]}" == "*" || "${exp[$i]}" == "${act[$i]}" ]] || return 1
	done
}

ensure_sql_candidate() { # app | ro | migrator
	local pw="" item_status recovered="" recovery_status
	if vault_item_id "$CANDIDATE_REF" >/dev/null; then
		CANDIDATE_VALUE="$(op_vault_read "$CANDIDATE_REF")" || return $?
	else
		item_status=$?
		[[ "$item_status" == "1" ]] || return "$item_status"
		if [[ "$STATE_PHASE" != "initial" ]] && recovered="$(observe_candidate_value)"; then
			CANDIDATE_VALUE="$recovered"
		else
			recovery_status=$?
			[[ "$STATE_PHASE" == "initial" || "$recovery_status" == "1" ]] || return "$recovery_status"
			[[ "$STATE_PHASE" == "initial" ]] || reset_candidate_identity || return $?
			pw="$(openssl rand -hex 24)"
			CANDIDATE_VALUE="$(compose_candidate_url "$pw")" || return $?
		fi
		VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_create "$CANDIDATE_REF" || return $?
	fi
	verify_sql_candidate_before_mutation || return 1
	CANDIDATE_EXTERNAL="$(db_url_with_database "$(db_rehost_url "$CANDIDATE_VALUE" "$RENDER_EXTERNAL")" "$PRIMARY_DB")" || return $?
	pw="$(db_parse_url "$CANDIDATE_VALUE" && db_urldecode "$DB_URL_PASS")" || return $?
	create_candidate_login "$pw" || return 1
	pw=""
	case "$SCOPE_KIND" in
		ro)
			attest_candidate "$LOGIN|$CAPABILITY|f|f|f|f|t|*|*|t|on" \
				|| { echo "ERROR: RO candidate failed its role-safety attestation (inherited read + read-only session required)." >&2; return 1; }
			if db_run_psql_url "$CANDIDATE_EXTERNAL" -q -v ON_ERROR_STOP=1 -c 'CREATE TABLE _rotation_ro_probe(id int)' >/dev/null 2>&1; then
				echo "ERROR: RO candidate was able to CREATE TABLE." >&2
				return 1
			fi
			echo "  db: RO candidate login verified (write probe rejected, inherited read verified)" ;;
		migrator)
			attest_candidate "$LOGIN|$SET_ROLE_TARGET|f|f|f|f|t|t|*|*|*" \
				|| { echo "ERROR: MIGRATOR candidate failed its role-safety attestation (expected SET ROLE $SET_ROLE_TARGET owning public tables)." >&2; return 1; }
			echo "  db: MIGRATOR candidate login verified (session runs as $SET_ROLE_TARGET)" ;;
		*)
			# The login itself (not the SET-ROLE'd current_user) must inherit table
			# privileges: consumers that ignore ?options=role=... (asyncpg) connect
			# as the bare login (2026-08-08 prod outage).
			attest_candidate "$LOGIN|$CAPABILITY|f|f|f|f|t|f|*|t|*" \
				|| { echo "ERROR: APP candidate failed its role-safety attestation (no table ownership, inherited privileges required)." >&2; return 1; }
			echo "  db: APP candidate login verified (role-safety + inherited privileges)" ;;
	esac
}

request_owner_provider_candidate() { # sets OWNER_PROVIDER_VALUE
	local credentials deadline default_user
	assert_rotation_lock_live || return $?
	printf '%s' "$LOGIN" | jq -Rs '{username:.}' | render_curl POST "/postgres/${DB_ID}/credentials" >/dev/null || return 1
	echo "  render-postgres: requested OWNER candidate login"
	deadline=$(( $(date +%s) + ${RENDER_CREDENTIAL_TIMEOUT_SECONDS:-300} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
		jq -e 'type == "array"' < <(printf '%s' "$credentials") >/dev/null || return 1
		if jq -e --arg user "$LOGIN" '[.[] | select(.username == $user and .default == true)] | length == 1' \
			< <(printf '%s' "$credentials") >/dev/null; then
			break
		fi
		sleep "${RENDER_POLL_SECONDS:-5}"
	done
	default_user="$(printf '%s' "$credentials" | jq -r '.[] | select(.default == true) | .username')"
	[[ "$default_user" == "$LOGIN" ]] || {
		echo "ERROR: OWNER candidate did not become Render's unique default; predecessor remains valid." >&2
		return 1
	}
	refresh_conninfo || return $?
	[[ "$(db_url_username "$RENDER_INTERNAL")" == "$LOGIN" ]] || {
		echo "ERROR: Render connection-info did not return the new OWNER candidate." >&2
		return 1
	}
	OWNER_PROVIDER_VALUE="$(db_with_role_option "$RENDER_INTERNAL" "$TABLE_OWNER")"
}

ensure_owner_candidate() {
	local credentials candidate_count saved="" candidate_item_exists=0 item_status recovered="" recovery_status current_default canonical=""
	OWNER_PROVIDER_VALUE=""
	credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
	jq -e 'type == "array"' < <(printf '%s' "$credentials") >/dev/null || return 1
	if vault_item_id "$CANDIDATE_REF" >/dev/null; then
		candidate_item_exists=1
	else
		item_status=$?
		[[ "$item_status" == "1" ]] || return "$item_status"
	fi
	candidate_count="$(printf '%s' "$credentials" | jq -er --arg user "$LOGIN" '[.[] | select(.username == $user)] | length')" || return 1
	[[ "$candidate_count" == "0" || "$candidate_count" == "1" ]] || {
		echo "ERROR: Render returned duplicate OWNER candidate credentials." >&2
		return 1
	}
	if [[ "$candidate_count" == "0" && "$STATE_PHASE" != "initial" ]]; then
		# The provider principal was externally removed; it cannot be repaired
		# beneath possibly active URLs. Track it, create a fresh version.
		[[ "$candidate_item_exists" == "0" ]] || { vault_delete_candidate "$CANDIDATE_REF" || return $?; candidate_item_exists=0; }
		reset_candidate_identity || return $?
	fi
	if [[ "$candidate_count" == "0" ]]; then
		request_owner_provider_candidate || return $?
		saved="$OWNER_PROVIDER_VALUE"
	elif [[ "$candidate_item_exists" == "1" ]]; then
		saved="$(op_vault_read "$CANDIDATE_REF")" || return $?
	elif canonical="$(op_vault_read "$CANONICAL_REF")" && [[ "$(db_url_username "$canonical")" == "$LOGIN" ]]; then
		saved="$canonical"
		canonical=""
	else
		canonical=""
		current_default="$(db_url_username "$RENDER_INTERNAL")" || return $?
		if [[ "$current_default" == "$LOGIN" ]]; then
			refresh_conninfo || return $?
			saved="$(db_with_role_option "$RENDER_INTERNAL" "$TABLE_OWNER")"
		elif recovered="$(observe_candidate_value)"; then
			saved="$recovered"
		else
			recovery_status=$?
			[[ "$recovery_status" == "1" ]] || return "$recovery_status"
			# The managed credential exists but nothing references it and its
			# password is unrecoverable: leave it tracked, mint a fresh one.
			reset_candidate_identity || return $?
			request_owner_provider_candidate || return $?
			saved="$OWNER_PROVIDER_VALUE"
		fi
	fi
	[[ "$(db_url_username "$saved")" == "$LOGIN" ]] || {
		echo "ERROR: saved OWNER candidate does not contain the rotation's login." >&2
		return 1
	}
	CANDIDATE_VALUE="$(db_rehost_url "$saved" "$RENDER_INTERNAL")"
	CANDIDATE_EXTERNAL="$(db_rehost_url "$saved" "$RENDER_EXTERNAL")"
	saved=""
	# Attest BEFORE the candidate item is written: an unverified provider
	# credential must never become a durable vault candidate.
	attest_candidate "$LOGIN|$TABLE_OWNER|f|f|f|f|t|*|t|*|*" \
		|| { echo "ERROR: OWNER candidate failed its role-safety attestation." >&2; return 1; }
	if [[ "$candidate_item_exists" == "0" ]]; then
		VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_create "$CANDIDATE_REF" || return $?
	else
		VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_replace "$CANDIDATE_REF" || return $?
	fi
	echo "  db: OWNER candidate login verified"
}

# --- activation (snapshot -> PUT all -> trigger all -> wait all -> probe all) --------
rotation_get_env() { with_sid_render_key "$1" render_get_env_value "$1" "$2"; }
rotation_put_env() {
	assert_rotation_lock_live || return $?
	with_sid_render_key "$1" render_upsert_env_value "$1" "$2"
}
rotation_trigger_deploy() {
	assert_rotation_lock_live || return $?
	with_sid_render_key "$1" render_trigger_deploy_id "$1"
}
rotation_wait_deploy() { with_sid_render_key "$1" render_wait_deploy_live "$1" "$2"; }
rotation_probe_service() {
	local sid="$1" url deadline
	url="$(health_url_for "$sid")" || { echo "ERROR: no health URL registered for render[$sid]." >&2; return 1; }
	# "deploy-only": a TCP-only private service (pgbouncer) has no HTTP surface;
	# the gate is the deploy reaching live plus the rotator's own DB proofs.
	if [[ "$url" == "deploy-only" ]]; then
		echo "  render[$sid] deploy-only health gate: deploy live accepted (no HTTP surface)"
		return 0
	fi
	deadline=$(( $(date +%s) + ${ROTATION_HEALTH_TIMEOUT_SECONDS:-300} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		if rotation_probe_health_once "$url"; then
			echo "  render[$sid] public health passed"
			return 0
		fi
		sleep "${ROTATION_HEALTH_POLL_SECONDS:-5}"
	done
	return 1
}

verify_canonical_value() {
	local value
	value="$(op_vault_read "$CANONICAL_REF")" || return $?
	[[ "$value" == "$CANDIDATE_VALUE" ]] || { echo "ERROR: canonical item does not match the candidate." >&2; return 1; }
}
_verify_target_current() { # index value
	[[ "$2" == "${ROTATION_NEW_VALUES[$1]}" ]] || {
		echo "ERROR: render[${ROTATION_SIDS[$1]}] ${ROTATION_ENVS[$1]} does not reference the promoted candidate." >&2
		return 1
	}
}
verify_declared_targets_current() { for_each_live_target _verify_target_current; }

# --- main: candidate -> activation -> promotion ----------------------------------------
if [[ "$STATE_PHASE" == "retired" ]]; then
	# Crash after retirement but before candidate cleanup: finish cleanup only.
	vault_delete_candidate "$CANDIDATE_REF" || exit 5
	assert_rotation_lock_live
	rm -f "$STATE_FILE"
	echo "Credential rotation retirement was already complete; candidate cleanup is now complete."
	exit 0
fi

if [[ "$SCOPE_KIND" == "owner" ]]; then prepare_candidate() { ensure_owner_candidate; }; else prepare_candidate() { ensure_sql_candidate; }; fi
prepare_candidate || {
	echo "Candidate preparation failed; nothing was activated and predecessor logins remain valid. Fix the reported problem, then use --resume." >&2
	exit 4
}
if [[ "$STATE_PHASE" == "initial" ]]; then
	STATE_PHASE="prepared"
	write_state
fi

i=0
while [[ $i -lt ${#ROTATION_SIDS[@]} ]]; do
	target_value="$(printf %s "$CANDIDATE_VALUE" | apply_transform "${ROTATION_TRANSFORMS[$i]}")" \
		|| fail "transform '${ROTATION_TRANSFORMS[$i]}' failed for render[${ROTATION_SIDS[$i]}]" 4
	ROTATION_NEW_VALUES+=("$target_value")
	target_value=""
	i=$((i + 1))
done

case "$STATE_PHASE" in
	prepared)
		if [[ ${#ROTATION_SIDS[@]} -gt 0 ]]; then
			rotation_activate || {
				echo "Rotation paused before canonical promotion. Fix the reported problem, then use --resume; predecessor logins remain valid." >&2
				exit 4
			}
		fi
		STATE_PHASE="activated"
		write_state
		;;
	activated|promoted)
		# Already activated: prove the declared targets still hold the candidate
		# and are healthy — never PUT/deploy a second time.
		if [[ ${#ROTATION_SIDS[@]} -gt 0 ]]; then
			verify_declared_targets_current && rotation_probe_all_services || {
				echo "Rotation paused: a declared Render target no longer holds the promoted candidate or is unhealthy; predecessor logins remain valid. Restore it, then use --resume." >&2
				[[ "$STATE_PHASE" == "promoted" ]] && exit 5 || exit 4
			}
			echo "  render: declared targets verified current and healthy (no re-activation)"
		fi
		;;
esac

if [[ "$STATE_PHASE" != "promoted" ]]; then
	VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_replace "$CANONICAL_REF" || {
		echo "Rotation paused: canonical promotion failed; use --resume (predecessor logins remain valid)." >&2
		exit 5
	}
	STATE_PHASE="promoted"
	write_state
fi
verify_canonical_value || {
	echo "Rotation paused: canonical candidate promotion is not currently proven. Use --resume after correcting it." >&2
	exit 5
}

if [[ "$FINALIZE" != "1" ]]; then
	# Repo-specific activation inside the dual-key window (Prefect blocks, ...).
	# The lock fds are closed for the child: the lock is a strict one-write/
	# one-read exchange on 8/7 and a hook touching either would desync it.
	if [[ -n "${ROTATE_HOOK:-}" && -x "${ROTATE_HOOK:-}" ]]; then
		echo "  hook: repo-specific activation ($ROTATE_HOOK activate)"
		"$ROTATE_HOOK" activate 8>&- 7<&- || {
			echo "Rotation paused: repo hook activation failed; predecessor logins remain valid. Fix and use --resume." >&2
			exit 5
		}
	fi
	echo "Rotation promoted: entry=$ENTRY_ID tier=$TIER scope=$SCOPE_KIND. Candidate is canonical; predecessor logins (${OLD_LOGINS:-none}) remain valid until finalize."
	exit 0
fi

# --- finalize: drain -> inventory -> fence -> retire -----------------------------------
# Owner rotations retire over the NEW owner connection; app/ro/migrator over
# the still-current admin control connection.
DRAIN_CONTROL_URL="$CONTROL_URL"
[[ "$SCOPE_KIND" != "owner" ]] || DRAIN_CONTROL_URL="$CANDIDATE_EXTERNAL"

# Orphan versioned logins (aborted earlier runs) are reconciled into the
# predecessor set: drained, scanned and retired with the others.
reconcile_orphan_logins() {
	local orphans login
	if [[ "$SCOPE_KIND" == "owner" ]]; then
		orphans="$(render_get "/postgres/${DB_ID}/credentials" | jq -r --arg pat "^${CAPABILITY}_login_" --arg login "$LOGIN" \
			'.[] | .username | select(test($pat) and . != $login)')" || return 1
	else
		orphans="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v pat="^${CAPABILITY}_login_" -v login="$LOGIN" <<'SQL'
SELECT rolname FROM pg_roles WHERE rolname ~ :'pat' AND rolname <> :'login' ORDER BY 1
SQL
)" || return 1
	fi
	for login in $orphans; do
		[[ " $OLD_LOGINS " == *" $login "* ]] && continue
		validate_predecessor "$login" || return 1
		echo "  reconcile: orphan versioned login $login is tracked as a predecessor (drain, scan, retire)"
		append_unique_word OLD_LOGINS "$login"
	done
	write_state
}

owner_provider_open_total() {
	local credentials user total=0 count
	[[ "$SCOPE_KIND" == "owner" && -n "$OLD_LOGINS" ]] || { printf 0; return 0; }
	credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
	for user in $OLD_LOGINS; do
		count="$(rotation_render_credential_open_connections "$credentials" "$user")" || {
			echo "ERROR: Render OWNER connection evidence is incomplete for $user." >&2
			return 1
		}
		total=$((total + count))
	done
	printf %s "$total"
}

predecessor_session_count() { # -> pg_stat_activity sessions of every predecessor
	local csv="${OLD_LOGINS// /,}"
	db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v old_csv="$csv" <<'SQL'
SELECT count(*) FROM pg_stat_activity WHERE usename = ANY(string_to_array(:'old_csv', ','))
SQL
}

wait_for_predecessor_drain() {
	local count provider_count deadline
	[[ -n "$OLD_LOGINS" ]] || return 0
	# Evidence-based drain: the predecessor session count (database + provider)
	# must hold at zero for ROTATION_DRAIN_STABLE_POLLS consecutive polls.
	local stable_needed="${ROTATION_DRAIN_STABLE_POLLS:-3}" stable=0
	[[ "$stable_needed" =~ ^[1-9][0-9]*$ ]] || { echo "ERROR: ROTATION_DRAIN_STABLE_POLLS must be a positive integer." >&2; return 1; }
	echo "  drain: polling until predecessor sessions hold at zero for $stable_needed consecutive checks"
	local drain_start hook_called=0 hook_after="${ROTATION_DRAIN_HOOK_AFTER_SECONDS:-120}"
	drain_start=$(date +%s)
	deadline=$(( drain_start + ${ROTATION_DRAIN_TIMEOUT_SECONDS:-600} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		# Keeps the otherwise idle lock session warm across the external proxy's
		# idle drop and fails within one poll when the lock is genuinely lost.
		assert_rotation_lock_live || return $?
		count="$(predecessor_session_count)" || return $?
		provider_count="$(owner_provider_open_total)" || return $?
		[[ "$count" =~ ^[0-9]+$ && "$provider_count" =~ ^[0-9]+$ ]] || {
			echo "ERROR: predecessor connection evidence was not numeric." >&2
			return 1
		}
		if [[ "$count" == "0" && "$provider_count" == "0" ]]; then
			stable=$((stable + 1))
			if [[ "$stable" -ge "$stable_needed" ]]; then
				echo "  drain: predecessor sessions held at zero ($stable consecutive checks)"
				return 0
			fi
		else
			stable=0
			echo "  drain: waiting for predecessor sessions (database=$count provider-owner=$provider_count)"
			# Long-lived consumers (always-on flows) hold predecessor connections
			# no redeploy touches. Past the stall threshold the repo hook gets ONE
			# shot at converging them; the drain still requires a sustained zero.
			if [[ "$hook_called" -eq 0 && -n "${ROTATE_HOOK:-}" && -x "${ROTATE_HOOK:-}" ]] \
				&& [[ $(( $(date +%s) - drain_start )) -ge "$hook_after" ]]; then
				hook_called=1
				echo "  drain: predecessor sessions lingering after ${hook_after}s — invoking repo hook (drain-stall)"
				"$ROTATE_HOOK" drain-stall 8>&- 7<&- || echo "  drain: hook drain-stall failed (continuing to poll; drain still requires zero)" >&2
			fi
		fi
		sleep "${ROTATION_DRAIN_POLL_SECONDS:-10}"
	done
	echo "ERROR: predecessor database sessions did not drain; predecessor remains valid." >&2
	return 1
}

run_inventory_scan() { # rc 0 clean, 1 predecessor referenced, 2 unprovable
	local refs ref key
	ROTATION_PREDECESSORS="$OLD_LOGINS"
	refs="$(inventory_render_key_refs)" || return 2
	while IFS= read -r ref; do
		[[ -n "$ref" ]] || continue
		key="$(render_key_value_for_ref "$ref")" || return 2
		RENDER_API_KEY="$key" render_inventory_clean_cached "$ref" || return $?
	done <<<"$refs"
}

fence_sql_predecessors() { # NOLOGIN (password retained) for every SQL predecessor
	local old
	for old in $OLD_LOGINS; do
		assert_rotation_lock_live || return $?
		db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" <<'SQL' || return 1
SELECT format('ALTER ROLE %I NOLOGIN', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		echo "  db: fenced predecessor login $old (password retained)"
	done
}
unfence_sql_predecessors() { # restore LOGIN after an incomplete fence proof; rc 1 if unproven
	local old failed=0 status
	for old in $OLD_LOGINS; do
		if ! assert_rotation_lock_live; then failed=1; continue; fi
		if db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT format('ALTER ROLE %I LOGIN', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		then
			echo "  db: restored predecessor LOGIN after incomplete fence proof ($old)" >&2
		else
			echo "ERROR: could not restore predecessor LOGIN after incomplete fence proof ($old)." >&2
			failed=1
		fi
	done
	for old in $OLD_LOGINS; do
		status="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT COALESCE((SELECT CASE WHEN rolcanlogin THEN 'login' ELSE 'nologin' END FROM pg_roles WHERE rolname = :'old'), 'absent')
SQL
)" || { failed=1; continue; }
		[[ "$status" == "login" || "$status" == "absent" ]] || {
			echo "ERROR: predecessor LOGIN restoration did not verify ($old, status=$status)." >&2
			failed=1
		}
	done
	return "$failed"
}
wait_for_fenced_sql_drain() {
	local count deadline
	deadline=$(( $(date +%s) + ${ROTATION_DRAIN_TIMEOUT_SECONDS:-600} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		assert_rotation_lock_live || return $?
		count="$(predecessor_session_count)" || return $?
		[[ "$count" =~ ^[0-9]+$ ]] || { echo "ERROR: fenced-session evidence was not numeric." >&2; return 1; }
		if [[ "$count" == "0" ]]; then
			echo "  drain: fenced SQL predecessor sessions reached zero"
			return 0
		fi
		echo "  drain: waiting for fenced SQL predecessor sessions (database=$count)"
		sleep "${ROTATION_DRAIN_POLL_SECONDS:-10}"
	done
	echo "ERROR: fenced SQL predecessor sessions did not drain." >&2
	return 1
}
fence_pause() { # reason — unfence, report, exit 5
	if unfence_sql_predecessors; then
		echo "Rotation paused: $1; every surviving predecessor was verified LOGIN again. Use --resume." >&2
	else
		echo "Rotation paused: $1 and LOGIN restoration was not proven. Operator intervention is required before --resume." >&2
	fi
	exit 5
}

# Retirement: NOLOGIN + PASSWORD NULL is the safety property (must succeed);
# DROP ROLE is best-effort (dependent objects / ADMIN OPTION gaps).
retire_sql_predecessors() {
	local old can_login
	for old in $OLD_LOGINS; do
		assert_rotation_lock_live || return $?
		protected_login "$old" && { echo "  db: $old is protected; not retired"; continue; }
		db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" -v capability="$CAPABILITY" <<'SQL' || return 1
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SELECT format('REVOKE %I FROM %I', :'capability', :'old') WHERE to_regrole(:'old') IS NOT NULL AND :'old' <> :'capability' \gexec
SQL
		if [[ "$old" != "$CAPABILITY" ]] && ! db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT format('DROP ROLE %I', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		then
			echo "  WARN: DROP ROLE $old failed; it is inert (NOLOGIN, no password) — drop it by hand when convenient." >&2
		fi
		echo "  db: retired predecessor login $old"
	done
	# The stable capability is a role, never a credential, even when the
	# snapshot was already versioned and did not list it as a predecessor.
	# A protected principal (table owner / root) is never touched.
	if protected_login "$CAPABILITY"; then
		echo "  db: capability $CAPABILITY is a protected principal; LOGIN left as is"
		return 0
	fi
	assert_rotation_lock_live || return $?
	db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v capability="$CAPABILITY" <<'SQL' || return 1
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'capability') WHERE to_regrole(:'capability') IS NOT NULL \gexec
SQL
	can_login="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v capability="$CAPABILITY" <<'SQL'
SELECT rolcanlogin FROM pg_roles WHERE rolname = :'capability'
SQL
)" || return 1
	[[ "$can_login" == "f" ]] || { echo "ERROR: stable capability $CAPABILITY is still login-enabled." >&2; return 1; }
	echo "  db: stable capability $CAPABILITY verified NOLOGIN"
}

retire_owner_predecessor_api() { printf '' | render_curl DELETE "/postgres/${DB_ID}/credentials/${1}" >/dev/null 2>&1; }
retire_owner_predecessor_sql() { # old — fence must succeed, DROP best-effort
	db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$1" >/dev/null <<'SQL' || return 1
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
	if ! db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$1" >/dev/null <<'SQL'
SELECT format('DROP ROLE %I', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
	then
		echo "  WARN: DROP ROLE $1 failed; it is inert (NOLOGIN, no password) — remove it in the Render dashboard when convenient." >&2
	fi
}
retire_owner_predecessors() {
	local credentials old present default open
	for old in $OLD_LOGINS; do
		protected_login "$old" && { echo "  render-postgres: $old is protected; not retired"; continue; }
		credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
		open="$(rotation_render_credential_open_connections "$credentials" "$old")" || return 1
		present="$(printf '%s' "$credentials" | jq -er --arg user "$old" '[.[] | select(.username == $user)] | length')" || return 1
		if [[ "$present" == "0" ]]; then
			echo "  render-postgres: predecessor $old already absent"
			continue
		fi
		[[ "$present" == "1" ]] || { echo "ERROR: duplicate Render OWNER credential $old." >&2; return 1; }
		# tostring: a bare boolean false would make jq -e exit 1.
		default="$(jq -er --arg user "$old" '
			[.[] | select(.username == $user)]
			| if length == 1 and (.[0].default | type) == "boolean" then (.[0].default | tostring)
			  else error("missing, duplicate, or invalid credential") end' < <(printf '%s' "$credentials"))" || return 1
		[[ "$default" == "false" && "$open" == "0" ]] || {
			echo "ERROR: refusing to delete OWNER predecessor $old (default=$default, openConnections=$open)." >&2
			return 1
		}
		assert_rotation_lock_live || return $?
		if retire_owner_predecessor_api "$old"; then
			echo "  render-postgres: retired OWNER predecessor $old"
		elif retire_owner_predecessor_sql "$old"; then
			echo "  db: retired OWNER predecessor $old via SQL"
		else
			# Render refuses API deletion of versioned owner credentials and no
			# accessible session holds ADMIN OPTION on them. The credential is
			# inert (not default, zero connections, password rotated away).
			echo "  WARN: OWNER predecessor $old cannot be fenced programmatically (Render: unmanaged; SQL: no ADMIN OPTION)." >&2
			echo "  WARN: it is inert (not default, 0 connections, password rotated away); remove it in the Render dashboard when convenient." >&2
		fi
	done
}

reconcile_orphan_logins || { echo "Rotation paused: orphan login reconciliation failed. Finalize again." >&2; exit 5; }
wait_for_predecessor_drain || exit 5
inventory_rc=0
run_inventory_scan || inventory_rc=$?
if [[ "$inventory_rc" -eq 1 ]]; then
	echo "Rotation paused: Render still references a predecessor (see above: declared consumers need the fan-out again, undeclared ones need a route). Finalize again." >&2
	exit 5
elif [[ "$inventory_rc" -ne 0 ]]; then
	echo "Rotation paused: the complete Render consumer inventory could not be proven. Finalize again." >&2
	exit 5
fi
echo "  render: complete service/env-group/secret-file inventory contains no predecessor login"
verify_declared_targets_current || { echo "Rotation paused: a declared Render target changed during retirement proof. Finalize again." >&2; exit 5; }
verify_canonical_value || { echo "Rotation paused: the canonical item changed during retirement proof. Finalize again." >&2; exit 5; }
rotation_probe_all_services || { echo "Rotation paused: final post-drain public health is not proven. Finalize again." >&2; exit 5; }

if [[ "$SCOPE_KIND" != "owner" && -n "$OLD_LOGINS" ]]; then
	fence_sql_predecessors || fence_pause "SQL predecessor fencing failed"
	wait_for_fenced_sql_drain || fence_pause "fenced SQL sessions did not drain"
	verify_declared_targets_current && verify_canonical_value && rotation_probe_all_services \
		|| fence_pause "a final post-fence proof failed"
fi

if [[ "$SCOPE_KIND" == "owner" ]]; then
	retire_owner_predecessors || { echo "Rotation paused: OWNER predecessor retirement failed; finalize again." >&2; exit 5; }
else
	retire_sql_predecessors || { echo "Rotation paused: SQL predecessor retirement failed; finalize again." >&2; exit 5; }
fi

rotation_probe_all_services || {
	echo "ERROR: post-retirement public health could not be proven. Retirement is resumable and no retired credential is recreated." >&2
	exit 5
}
STATE_PHASE="retired"
write_state
vault_delete_candidate "$CANDIDATE_REF" || exit 5
assert_rotation_lock_live
rm -f "$STATE_FILE"
echo "Credential rotation complete: entry=$ENTRY_ID tier=$TIER scope=$SCOPE_KIND. Candidate is canonical and all recorded predecessors are retired."
