#!/usr/bin/env bash
# postgres-rotate — resumable dual-principal Postgres credential rotation
# (central port of amaru-web scripts/db/rotate-credentials, registry-driven).
#
# One registry entry = one principal (one vault item). A new versioned login is
# created and verified first; every registry-declared Render consumer is then
# updated as one batch, every exact deploy is polled to live, and every
# config-registered public health endpoint is probed. Only after the candidate
# is the canonical 1Password value, old sessions have drained, and the complete
# Render env/secret-file inventory contains no predecessor username is the
# predecessor disabled. Any incomplete proof leaves the predecessor valid.
#
# Invoked by secrets/providers/postgres.sh with the rotate-secret entry contract
# in the environment: ROTATE_ENTRY_JSON, ROTATE_REF, ROTATE_PROJECT,
# ROTATE_REASON, ROTATE_RESUME (0/1), ROTATE_KEEP_OLD (0/1).
#
# exit codes: 0 success/keep-old; 2 usage/state-mismatch/lock-contention;
#   3 precondition refused, nothing changed; 4 activation failed (paused before
#   promotion; both principals valid); 5 retirement proof failed (predecessor
#   remains valid); 75 advisory-lock session lost.
case "$-" in *x*) set +x ;; esac
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SECRETS_LIB="${SECRETS_LIB:-$HERE/../lib}"
DB_ROLES_CONFIG="${DB_ROLES_CONFIG:-$HERE/../../config/db-roles.json}"
# The synthesized registry (consumers derived from the project secrets.yaml
# routes) is exported by rotate-secret; there is no standalone registry file.
ROTATION_CONFIG="${SECRET_ROTATION_CONFIG:?SECRET_ROTATION_CONFIG must be exported by rotate-secret}"

# shellcheck source=../lib/read.sh
source "$SECRETS_LIB/read.sh"
# shellcheck source=../lib/derive.sh
source "$SECRETS_LIB/derive.sh"
# shellcheck source=../lib/vault.sh
source "$SECRETS_LIB/vault.sh"
# shellcheck source=../lib/render-api.sh
source "$SECRETS_LIB/render-api.sh"
# shellcheck source=../lib/db-url.sh
source "$SECRETS_LIB/db-url.sh"
# shellcheck source=../lib/db-rotation.sh
source "$SECRETS_LIB/db-rotation.sh"

fail() { echo "ERROR: $1" >&2; exit "${2:-2}"; }

[[ -n "${ROTATE_ENTRY_JSON:-}" ]] || fail "postgres-rotate must be invoked by rotate-secret (ROTATE_ENTRY_JSON missing)"
[[ -f "$DB_ROLES_CONFIG" ]] || fail "db roles config not found: $DB_ROLES_CONFIG"
[[ -f "$ROTATION_CONFIG" ]] || fail "rotation registry not found: $ROTATION_CONFIG"
REASON="${ROTATE_REASON:-}"
RESUME="${ROTATE_RESUME:-0}"
KEEP_OLD="${ROTATE_KEEP_OLD:-0}"
[[ -n "$REASON" ]] || fail "--reason is required for database and vault credential access"
export SENSITIVE_ACCESS_REASON="$REASON"
guard_agent_shell || exit 3
need jq

ENTRY_ID="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '.id')"
PROJECT="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '.project')"
CANONICAL_REF="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '.ref')"

PROJECT_CFG="$(jq -ce --arg p "$PROJECT" '.projects[$p]' "$DB_ROLES_CONFIG")" \
	|| fail "project '$PROJECT' is not in $DB_ROLES_CONFIG" 3
cfg() { printf '%s' "$PROJECT_CFG" | jq -r "$1 // \"\""; }

# --- scope derivation from the canonical item title --------------------------
REF_VAULT="" REF_TITLE="" REF_FIELD=""
ref_parts "$CANONICAL_REF" || exit 2
# Grouped items (slice 6) carry the tier in the TITLE and the role/app in the
# FIELD; legacy flat {TIER}_POSTGRES_URL_* titles remain accepted.
grouped_rest_from_field() { # ro_item(0|1); echoes the TITLE_REST equivalent
	local ro_item="$1" f_upper
	f_upper="$(printf '%s' "$REF_FIELD" | tr '[:lower:]' '[:upper:]')"
	if [[ "$ro_item" -eq 1 ]]; then
		case "$REF_FIELD" in
			canonical) echo "RO" ;;
			*) echo "${f_upper}_RO" ;;
		esac
	else
		case "$REF_FIELD" in
			root|owner|app|ro) echo "$f_upper" ;;
			canonical) fail "field 'canonical' on '$REF_TITLE' is the legacy shared credential — rotate the per-role fields instead" 3 ;;
			*) echo "$f_upper" ;;
		esac
	fi
}
case "$REF_TITLE" in
	"Postgres prod") TIER="prod"; TITLE_REST="$(grouped_rest_from_field 0)" ;;
	"Postgres staging") TIER="staging"; TITLE_REST="$(grouped_rest_from_field 0)" ;;
	"Postgres prod RO") TIER="prod"; TITLE_REST="$(grouped_rest_from_field 1)" ;;
	"Postgres staging RO") TIER="staging"; TITLE_REST="$(grouped_rest_from_field 1)" ;;
	PROD_POSTGRES_URL_*) TIER="prod"; TITLE_REST="${REF_TITLE#PROD_POSTGRES_URL_}" ;;
	STAGING_POSTGRES_URL_*) TIER="staging"; TITLE_REST="${REF_TITLE#STAGING_POSTGRES_URL_}" ;;
	*) fail "cannot derive tier/scope from item title '$REF_TITLE' (grouped 'Postgres <tier>[ RO]' or legacy {PROD|STAGING}_POSTGRES_URL_* expected)" 3 ;;
esac
TIER_U="$(printf '%s' "$TIER" | tr '[:lower:]' '[:upper:]')"

SCOPE_KIND="" CAPABILITY="" APP_SLUG=""
case "$TITLE_REST" in
	ROOT)
		echo "MANUAL: the ROOT credential is the provider-managed break-glass principal." >&2
		echo "Rotate it in the Render dashboard, then update $CANONICAL_REF with rotate-secret --complete." >&2
		exit 3
		;;
	OWNER) SCOPE_KIND="owner"; CAPABILITY="$(cfg '.roles.owner')" ;;
	APP) SCOPE_KIND="app"; CAPABILITY="$(cfg '.roles.app')" ;;
	RO) SCOPE_KIND="ro"; CAPABILITY="$(cfg '.roles.ro')" ;;
	*)
		while IFS=$'\t' read -r slug prefix app_role ro_role; do
			[[ -n "$slug" ]] || continue
			appslug_upper="${prefix%_}"
			if [[ "$TITLE_REST" == "$appslug_upper" ]]; then
				SCOPE_KIND="app"; APP_SLUG="$slug"; CAPABILITY="$app_role"
			elif [[ "$TITLE_REST" == "${appslug_upper}_RO" ]]; then
				SCOPE_KIND="ro"; APP_SLUG="$slug"; CAPABILITY="$ro_role"
			fi
		done < <(printf '%s' "$PROJECT_CFG" | jq -r '(.apps // {}) | to_entries[] | [.key, .value.item_prefix, .value.roles.app // "", .value.roles.ro // ""] | @tsv')
		;;
esac
[[ -n "$SCOPE_KIND" && -n "$CAPABILITY" ]] \
	|| fail "item title '$REF_TITLE' does not map to a role in $DB_ROLES_CONFIG (project $PROJECT)" 3

# --- instance / admin resolution ---------------------------------------------
# The role lives on an INSTANCE (physical Render Postgres). Cross-instance apps
# declare instance {project, tier_map}; shared boxes declare admin_via. The
# ADMIN project owns the box's ROOT/OWNER items, render key, and lock scope.
INSTANCE_PROJECT="$PROJECT" INSTANCE_TIER="$TIER"
if [[ -n "$APP_SLUG" ]]; then
	inst="$(printf '%s' "$PROJECT_CFG" | jq -r --arg a "$APP_SLUG" '.apps[$a].instance.project // ""')"
	if [[ -n "$inst" ]]; then
		INSTANCE_PROJECT="$inst"
		INSTANCE_TIER="$(printf '%s' "$PROJECT_CFG" | jq -r --arg a "$APP_SLUG" --arg t "$TIER" '.apps[$a].instance.tier_map[$t] // ""')"
		[[ -n "$INSTANCE_TIER" ]] || fail "app '$APP_SLUG' has no instance tier mapping for tier '$TIER'" 3
	fi
fi
INSTANCE_CFG="$(jq -ce --arg p "$INSTANCE_PROJECT" '.projects[$p]' "$DB_ROLES_CONFIG")" \
	|| fail "instance project '$INSTANCE_PROJECT' is not in $DB_ROLES_CONFIG" 3
BOX_CFG="$(printf '%s' "$INSTANCE_CFG" | jq -ce --arg t "$INSTANCE_TIER" '.tiers[$t]')" \
	|| fail "instance project '$INSTANCE_PROJECT' has no tier '$INSTANCE_TIER'" 3
DB_ID="$(printf '%s' "$BOX_CFG" | jq -r '.db_id')"
TABLE_OWNER="$(printf '%s' "$BOX_CFG" | jq -r '.table_owner')"

ADMIN_PROJECT="$(printf '%s' "$BOX_CFG" | jq -r '.admin_via.project // ""')"
[[ -n "$ADMIN_PROJECT" ]] || ADMIN_PROJECT="$INSTANCE_PROJECT"
ADMIN_CFG="$(jq -ce --arg p "$ADMIN_PROJECT" '.projects[$p]' "$DB_ROLES_CONFIG")" \
	|| fail "admin project '$ADMIN_PROJECT' is not in $DB_ROLES_CONFIG" 3
ADMIN_TABLE_OWNER="$(printf '%s' "$BOX_CFG" | jq -r '.admin_via.table_owner // ""')"
[[ -n "$ADMIN_TABLE_OWNER" ]] || ADMIN_TABLE_OWNER="$TABLE_OWNER"

# Admin credentials are declared per admin-project/tier in db-roles.json. There
# is no convention fallback: an unconfigured tier throws here rather than
# silently resolving to a plausible-looking item that may hold the wrong
# principal entirely (workflow-pro staging's "root" field held the OWNER login,
# which deadlocked every owner drain against the rotator's own lock session).
ROOT_REF="$(printf '%s' "$ADMIN_CFG" | jq -r --arg t "$INSTANCE_TIER" '.admin_refs[$t].root // empty')"
[[ -n "$ROOT_REF" ]] || fail "no admin_refs.$INSTANCE_TIER.root for admin project '$ADMIN_PROJECT' in $DB_ROLES_CONFIG; declare it (root must NOT be a rotatable login)" 3
ADMIN_OWNER_REF="$(printf '%s' "$ADMIN_CFG" | jq -r --arg t "$INSTANCE_TIER" '.admin_refs[$t].owner // empty')"
[[ -n "$ADMIN_OWNER_REF" ]] || fail "no admin_refs.$INSTANCE_TIER.owner for admin project '$ADMIN_PROJECT' in $DB_ROLES_CONFIG; declare it" 3
RENDER_KEY_REF="$(printf '%s' "$ADMIN_CFG" | jq -r '.render_key_ref')"

OWNER_KIND="$(printf '%s' "$INSTANCE_CFG" | jq -r '.owner_kind // "render_credential"')"
if [[ "$SCOPE_KIND" == "owner" && "$OWNER_KIND" != "render_credential" ]]; then
	cat >&2 <<EOF
REFUSED: project '$PROJECT' has owner_kind '$OWNER_KIND'. On the shared instance
($DB_ID) creating or deleting a Render managed credential would flip the
instance default away from the admin owner. SQL-role owner rotation is not
implemented; rotate this owner manually:
  1. As the instance admin ($ADMIN_TABLE_OWNER), create a candidate login, GRANT
     the owner role, verify it, update every consumer, then retire the old one
     following docs/secrets.md "Postgres rotation".
  2. Or wait for the sql_role owner rotation slice.
Nothing was changed.
EOF
	exit 3
fi

# Target database for the candidate URL (per-app databases override wins).
PRIMARY_DB="$(printf '%s' "$BOX_CFG" | jq -r '.database')"
if [[ -n "$APP_SLUG" ]]; then
	app_db="$(printf '%s' "$PROJECT_CFG" | jq -r --arg a "$APP_SLUG" '(.apps[$a].databases // [])[0] // ""')"
	[[ -n "$app_db" ]] && PRIMARY_DB="$app_db"
fi

# --- targets: the registry consumer rows (repo, dest, env) --------------------
# Render dests are ACTIVATION targets (batch PUT + exact deploy + health).
# GitHub dests (owner/repo) are fan-out-only consumers, pushed by rotate-secret's
# post-promotion sync-secrets leg. Anything else fails closed.
TARGET_SIDS=()
TARGET_ENVS=()
TARGET_TRANSFORMS=()
while IFS=$'\t' read -r sid env; do
	[[ -n "$sid" ]] || continue
	if [[ "$sid" =~ ^(srv|crn)- ]]; then
		TARGET_SIDS+=("$sid")
		TARGET_ENVS+=("$env")
		# The route's TRANSFORM shapes the value THIS dest receives (e.g.
		# no-query for pgbouncer, whose config generator rejects ?options=...).
		tr_val="$(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r --arg d "$sid" --arg e "$env" 			'[(.routes // [])[] | select(.dest == $d and .env == $e) | .transform] | first // "self"')"
		TARGET_TRANSFORMS+=("$tr_val")
	elif [[ "$sid" == */* ]]; then
		: # github row — covered by the sync fan-out after promotion
	else
		fail "consumer dest '$sid' is neither a Render service id nor a github repo; refusing an unknown consumer kind" 3
	fi
done < <(printf '%s' "$ROTATE_ENTRY_JSON" | jq -r '(.consumers // [])[] | [.dest, .env] | @tsv')

# Health URLs are a fail-closed config registry: every unique target service
# must be registered in the rotation config BEFORE any mutation.
health_url_for() { # sid -> url; rc 1 unknown
	jq -er --arg sid "$1" '.health_urls[$sid] | select(type == "string" and length > 0)' "$ROTATION_CONFIG"
}
seen_sids=""
for sid in ${TARGET_SIDS[@]+"${TARGET_SIDS[@]}"}; do
	[[ " $seen_sids " == *" $sid "* ]] && continue
	seen_sids="${seen_sids:+$seen_sids }$sid"
	health_url_for "$sid" >/dev/null \
		|| fail "no health URL registered for render[$sid] in $ROTATION_CONFIG (health_urls) — refusing to rotate blind" 3
done

need curl
need awk
need openssl
need "${PSQL_BIN:-psql}"
need ps

RENDER_API_KEY="$(op_vault_read "$RENDER_KEY_REF")" || exit 3
[[ -n "$RENDER_API_KEY" ]] || fail "Render API key resolved empty" 3
export RENDER_API_KEY

STATE_DIR="${DB_ROTATION_STATE_DIR:-$HOME/.local/state/agent-workflows/db-rotation}"
mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"
# One state file per independent rotation: scope (and app slug) are part of
# the key so a paused --keep-old app canary does not block the owner/ro/other
# app rotations on the same instance. The instance advisory lock still
# serializes actual execution.
STATE_FILE="$STATE_DIR/${PROJECT}-${TIER}-${SCOPE_KIND}${APP_SLUG:+-$APP_SLUG}.state"
# Migrate a legacy tier-keyed state file when it belongs to this exact scope.
LEGACY_STATE_FILE="$STATE_DIR/${PROJECT}-${TIER}.state"
if [[ -f "$LEGACY_STATE_FILE" && ! -f "$STATE_FILE" ]]; then
	if jq -e --arg s "$SCOPE_KIND" '.scope == $s' "$LEGACY_STATE_FILE" >/dev/null 2>&1; then
		mv "$LEGACY_STATE_FILE" "$STATE_FILE"
	fi
fi

STATE_VERSION=1
STATE_PHASE="initial"
VERSION_TAG=""
LOGIN="" CANDIDATE_REF="" OLD_LOGINS=""
DEPLOY_RECORDS=""

write_state() {
	local tmp="${STATE_FILE}.tmp.$$"
	assert_rotation_lock_live || return $?
	(
		umask 077
		jq -n --argjson stateVersion "$STATE_VERSION" \
			--arg entryId "$ENTRY_ID" --arg project "$PROJECT" --arg tier "$TIER" \
			--arg scope "$SCOPE_KIND" --arg phase "$STATE_PHASE" --arg versionTag "$VERSION_TAG" \
			--arg login "$LOGIN" --arg candidateRef "$CANDIDATE_REF" --arg oldLogins "$OLD_LOGINS" \
			--arg deployRecords "$DEPLOY_RECORDS" \
			'{stateVersion:$stateVersion,entryId:$entryId,project:$project,tier:$tier,scope:$scope,
			  phase:$phase,versionTag:$versionTag,login:$login,candidateRef:$candidateRef,
			  oldLogins:$oldLogins,deployRecords:$deployRecords}'
	) > "$tmp"
	chmod 600 "$tmp"
	mv "$tmp" "$STATE_FILE"
}

CANDIDATE_LOGIN_PATTERN="^${CAPABILITY}_login_[a-z0-9]+(_[a-z0-9]+)*$"
PREDECESSOR_PATTERN="^${CAPABILITY}(_login_[a-z0-9]+(_[a-z0-9]+)*)?$"
OWNER_PREDECESSOR_PATTERN="^(${CAPABILITY}|${ADMIN_TABLE_OWNER})(_login_[a-z0-9]+(_[a-z0-9]+)*)?$"

validate_state_login() {
	local value="$1"
	[[ -z "$value" ]] && return 0
	[[ "$value" =~ $CANDIDATE_LOGIN_PATTERN ]] || {
		echo "ERROR: rotation state contains an invalid $SCOPE_KIND login name." >&2
		return 1
	}
}

validate_predecessor() { # login
	local login="$1" pattern="$PREDECESSOR_PATTERN"
	[[ "$SCOPE_KIND" == "owner" ]] && pattern="$OWNER_PREDECESSOR_PATTERN"
	[[ "$login" =~ $pattern ]] || {
		echo "ERROR: refusing to rotate unexpected $SCOPE_KIND predecessor login '$login'." >&2
		return 1
	}
}

validate_state_old_list() {
	local login
	for login in $OLD_LOGINS; do validate_predecessor "$login"; done
}

CONNINFO_JSON=""
RENDER_INTERNAL=""
RENDER_EXTERNAL=""
refresh_conninfo() {
	CONNINFO_JSON="$(render_get "/postgres/${DB_ID}/connection-info")" || return $?
	RENDER_INTERNAL="$(printf '%s' "$CONNINFO_JSON" | jq -er '.internalConnectionString | select(type == "string" and length > 0)')" || return $?
	RENDER_EXTERNAL="$(printf '%s' "$CONNINFO_JSON" | jq -er '.externalConnectionString | select(type == "string" and length > 0)')" || return $?
	CONNINFO_JSON=""
}
refresh_conninfo

LOCK_PID="" LOCK_WATCHDOG_PID="" LOCK_WATCHDOG_MARKER="" LOCK_IN="" LOCK_OUT="" LOCK_ERR="" ROOT_CONTROL_URL=""
close_rotation_lock() {
	# Stop the watchdog first so an intentional \q cannot be mistaken for an
	# unexpected loss of the lock-holding backend.
	if [[ -n "$LOCK_WATCHDOG_PID" ]]; then
		kill "$LOCK_WATCHDOG_PID" 2>/dev/null || true
		wait "$LOCK_WATCHDOG_PID" 2>/dev/null || true
		LOCK_WATCHDOG_PID=""
	fi
	[[ -z "$LOCK_WATCHDOG_MARKER" ]] || rm -f "$LOCK_WATCHDOG_MARKER"
	if [[ -n "$LOCK_PID" ]]; then
		printf '\\q\n' >&8 2>/dev/null || true
		exec 8>&- 2>/dev/null || true
		exec 7<&- 2>/dev/null || true
		wait "$LOCK_PID" 2>/dev/null || true
		LOCK_PID=""
	fi
	rm -f "$LOCK_IN" "$LOCK_OUT" "$LOCK_ERR"
}
rotation_lock_lost() {
	echo "ERROR: the PostgreSQL advisory-lock session was lost; stopping this rotator before any further mutation." >&2
	exit 75
}
rotation_exit_cleanup() {
	local rc=$?
	close_rotation_lock
	trap - EXIT
	exit "$rc"
}
trap rotation_exit_cleanup EXIT
trap rotation_lock_lost HUP TERM

assert_rotation_lock_live() {
	local result
	[[ -n "$LOCK_PID" ]] && kill -0 "$LOCK_PID" 2>/dev/null || {
		echo "ERROR: the PostgreSQL advisory-lock process is not alive." >&2
		return 75
	}
	printf "SELECT EXISTS (SELECT 1 FROM pg_locks WHERE locktype = 'advisory' AND pid = pg_backend_pid() AND granted);\n" >&8 || {
		echo "ERROR: could not probe the PostgreSQL advisory-lock session." >&2
		return 75
	}
	IFS= read -r result <&7 || {
		echo "ERROR: the PostgreSQL advisory-lock session closed during its liveness probe." >&2
		return 75
	}
	[[ "$result" == "t" ]] || {
		echo "ERROR: the PostgreSQL session no longer holds the tier advisory lock." >&2
		return 75
	}
}

start_rotation_lock_watchdog() {
	local parent_pid="$$" lock_pid="$LOCK_PID"
	LOCK_WATCHDOG_MARKER="$STATE_DIR/${PROJECT}-${TIER}.lock.watchdog.$$"
	(
		local children="" watchdog_pid=""
		while [[ ! -s "$LOCK_WATCHDOG_MARKER" ]]; do /bin/sleep 0.01; done
		watchdog_pid="$(cat "$LOCK_WATCHDOG_MARKER")"
		while kill -0 "$lock_pid" 2>/dev/null; do
			/bin/sleep 1
		done
		# Bash defers a trapped signal while it waits for a foreground child. Signal
		# the parent first, then its direct children, so an in-flight curl/op/psql or
		# a long drain sleep cannot let the parent resume past the pending trap.
		kill -TERM "$parent_pid" 2>/dev/null || true
		children="$(ps -axo pid=,ppid= 2>/dev/null \
			| awk -v root="$parent_pid" -v self="$watchdog_pid" '
				{ pid[NR] = $1; parent[$1] = $2 }
				END {
					descendant[root] = 1
					for (pass = 1; pass <= NR; pass++)
						for (i = 1; i <= NR; i++)
							if (pid[i] != self && descendant[parent[pid[i]]]) descendant[pid[i]] = 1
					for (i = NR; i >= 1; i--)
						if (pid[i] != root && pid[i] != self && descendant[pid[i]]) print pid[i]
				}' || true)"
		[[ -z "$children" ]] || kill -TERM $children 2>/dev/null || true
	) &
	LOCK_WATCHDOG_PID=$!
	printf '%s' "$LOCK_WATCHDOG_PID" > "$LOCK_WATCHDOG_MARKER"
	chmod 600 "$LOCK_WATCHDOG_MARKER"
}

acquire_rotation_lock() {
	local root_url root_external result
	root_url="$(op_vault_read "$ROOT_REF")" || return 3
	root_external="$(db_rehost_url "$root_url" "$RENDER_EXTERNAL")" || return $?
	root_url=""
	ROOT_CONTROL_URL="$root_external"
	LOCK_IN="$STATE_DIR/${PROJECT}-${TIER}.lock.in.$$"
	LOCK_OUT="$STATE_DIR/${PROJECT}-${TIER}.lock.out.$$"
	LOCK_ERR="$STATE_DIR/${PROJECT}-${TIER}.lock.err.$$"
	mkfifo "$LOCK_IN" "$LOCK_OUT"
	chmod 600 "$LOCK_IN" "$LOCK_OUT"
	# Socket-level keepalives on the lock connection only (db_run_psql_url
	# exports the PG* environment through to psql). The per-poll liveness probe
	# already keeps the session warm, but a long-running drain-stall hook can
	# still leave a multi-minute gap between probes -- these keep the flow alive
	# across the Render external proxy's idle drop regardless of probe cadence.
	PGKEEPALIVESIDLE=30 PGKEEPALIVESINTERVAL=10 PGKEEPALIVESCOUNT=6 \
	db_run_psql_url "$root_external" -q -t -A -F '|' -v ON_ERROR_STOP=1 \
		< "$LOCK_IN" > "$LOCK_OUT" 2> "$LOCK_ERR" &
	LOCK_PID=$!
	root_external=""
	exec 8> "$LOCK_IN"
	exec 7< "$LOCK_OUT"
	printf "SELECT pg_try_advisory_lock(hashtextextended('%s-credential-rotation:%s', 0)), pg_backend_pid();\n" \
		"$ADMIN_PROJECT" "$INSTANCE_TIER" >&8
	IFS= read -r result <&7 || {
		echo "ERROR: advisory-lock connection failed." >&2
		return 1
	}
	case "$result" in
		t\|*)
			echo "  db: acquired ${ADMIN_PROJECT}/${INSTANCE_TIER} credential-rotation advisory lock"
			assert_rotation_lock_live
			start_rotation_lock_watchdog
			;;
		f\|*) echo "ERROR: another ${ADMIN_PROJECT}/${INSTANCE_TIER} credential rotation holds the advisory lock." >&2; return 2 ;;
		*) echo "ERROR: advisory-lock response was invalid." >&2; return 1 ;;
	esac
}
lock_rc=0
acquire_rotation_lock || lock_rc=$?
case "$lock_rc" in
	0) ;;
	2) exit 2 ;;
	3) exit 3 ;;
	*) exit 4 ;;
esac

candidate_ref_for() { # suffix -> candidate vault ref beside the canonical item
	printf 'op://%s/%s_CANDIDATE_%s/value' "$REF_VAULT" "$REF_TITLE" "$1"
}

if [[ "$RESUME" == "1" ]]; then
	state_json=""
	[[ -f "$STATE_FILE" ]] || { echo "ERROR: no resumable ${PROJECT}/${TIER} rotation state at $STATE_FILE" >&2; exit 2; }
	state_json="$(cat "$STATE_FILE")" || exit $?
	jq -e 'type == "object"
		and (.stateVersion | type) == "number"
		and all(.entryId,.project,.tier,.scope,.phase,.versionTag,.login,.candidateRef,
			.oldLogins,.deployRecords; type == "string")' \
		< <(printf '%s' "$state_json") >/dev/null || { echo "ERROR: malformed rotation state JSON." >&2; exit 2; }
	STATE_VERSION="$(printf '%s' "$state_json" | jq -r '.stateVersion')"
	state_entry="$(printf '%s' "$state_json" | jq -r '.entryId')"
	state_project="$(printf '%s' "$state_json" | jq -r '.project')"
	state_tier="$(printf '%s' "$state_json" | jq -r '.tier')"
	state_scope="$(printf '%s' "$state_json" | jq -r '.scope')"
	STATE_PHASE="$(printf '%s' "$state_json" | jq -r '.phase')"
	VERSION_TAG="$(printf '%s' "$state_json" | jq -r '.versionTag')"
	LOGIN="$(printf '%s' "$state_json" | jq -r '.login')"
	CANDIDATE_REF="$(printf '%s' "$state_json" | jq -r '.candidateRef')"
	OLD_LOGINS="$(printf '%s' "$state_json" | jq -r '.oldLogins')"
	DEPLOY_RECORDS="$(printf '%s' "$state_json" | jq -r '.deployRecords')"
	state_json=""
	[[ "$STATE_VERSION" == "1" && "$state_entry" == "$ENTRY_ID" && "$state_project" == "$PROJECT" \
		&& "$state_tier" == "$TIER" && "$state_scope" == "$SCOPE_KIND" ]] || {
		echo "ERROR: requested entry/tier/scope does not match the saved rotation state." >&2
		exit 2
	}
	validate_state_login "$LOGIN"
	validate_state_old_list
	case "$STATE_PHASE" in initial|prepared|activated|promoted|retired) ;; *) echo "ERROR: invalid rotation state phase." >&2; exit 2 ;; esac
	[[ "$VERSION_TAG" =~ ^[a-z0-9]+(_[a-z0-9]+)*$ ]] || { echo "ERROR: invalid rotation version tag." >&2; exit 2; }
	[[ "$DEPLOY_RECORDS" =~ ^$|^[a-z0-9-]+:[a-z0-9-]+(\ [a-z0-9-]+:[a-z0-9-]+)*$ ]] || { echo "ERROR: invalid deploy records in rotation state." >&2; exit 2; }
	candidate_suffix="${LOGIN#"${CAPABILITY}"_login_}"
	[[ "$candidate_suffix" == "$VERSION_TAG" || "$candidate_suffix" == "${VERSION_TAG}_retry_"* ]] \
		&& [[ "$CANDIDATE_REF" == "$(candidate_ref_for "$candidate_suffix")" ]] \
		|| { echo "ERROR: candidate identity does not match the rotation state." >&2; exit 2; }
	echo "Resuming ${PROJECT}/${TIER}/${SCOPE_KIND} rotation at phase $STATE_PHASE."
else
	[[ ! -e "$STATE_FILE" ]] || {
		echo "ERROR: unfinished ${PROJECT}/${TIER}/${SCOPE_KIND}${APP_SLUG:+/$APP_SLUG} rotation state exists; rerun with --resume." >&2
		exit 2
	}
	version_timestamp="$(date -u +%Y%m%dt%H%M%S)" || exit $?
	version_hex="$(openssl rand -hex 3)" || exit $?
	[[ "$version_timestamp" =~ ^[0-9]{8}t[0-9]{6}$ && "$version_hex" =~ ^[a-f0-9]{6}$ ]] || {
		echo "ERROR: could not generate a valid rotation identity." >&2
		exit 1
	}
	VERSION_TAG="${version_timestamp}_${version_hex}"
	LOGIN="${CAPABILITY}_login_${VERSION_TAG}"
	CANDIDATE_REF="$(candidate_ref_for "$VERSION_TAG")"
	write_state
fi

# --- admin control connection (DDL + drain evidence) --------------------------
if ADMIN_OWNER_VALUE="$(op_vault_read "$ADMIN_OWNER_REF")"; then
	:
elif [[ "$RESUME" == "1" && "$STATE_PHASE" != "initial" ]]; then
	ADMIN_OWNER_VALUE=""
	echo "  vault: admin OWNER item is unavailable; using zero-consumer root for recovery"
else
	echo "ERROR: the admin OWNER item ($ADMIN_OWNER_REF) is not readable; provision the instance first (db-provision-roles)." >&2
	exit 3
fi
if [[ -n "$ADMIN_OWNER_VALUE" ]]; then
	CONTROL_URL="$(db_rehost_url "$ADMIN_OWNER_VALUE" "$RENDER_EXTERNAL")"
else
	CONTROL_URL="$ROOT_CONTROL_URL"
fi
if [[ -n "$ADMIN_OWNER_VALUE" ]] \
	&& control_effective="$(db_run_psql_url "$CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -c 'SELECT current_user')" \
	&& [[ "$control_effective" == "$ADMIN_TABLE_OWNER" ]]; then
	:
elif [[ "$RESUME" == "1" && "$STATE_PHASE" != "initial" ]] \
	&& control_effective="$(db_run_psql_url "$ROOT_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -c 'SELECT current_user')" \
	&& [[ -n "$control_effective" ]]; then
	CONTROL_URL="$ROOT_CONTROL_URL"
	echo "  db: admin OWNER control is unavailable; using zero-consumer root for recovery"
else
	echo "ERROR: the admin control connection is not effective role $ADMIN_TABLE_OWNER." >&2
	exit 3
fi
ADMIN_OWNER_VALUE=""

append_unique_word() { # variable-name value
	local var="$1" word="$2" current
	current="${!var}"
	[[ " $current " == *" $word "* ]] || printf -v "$var" '%s' "${current:+$current }$word"
}

record_predecessor() { # login
	local login="$1"
	validate_predecessor "$login"
	if [[ -n "$LOGIN" && "$login" == "$LOGIN" ]]; then
		echo "ERROR: candidate login already appears in a live/canonical source while rotation state is initial; refusing an ambiguous predecessor snapshot." >&2
		return 1
	fi
	append_unique_word OLD_LOGINS "$login"
}

capture_predecessors() {
	local i=0 value login
	[[ "$STATE_PHASE" == "initial" ]] || return 0
	while [[ $i -lt ${#TARGET_SIDS[@]} ]]; do
		value="$(render_get_env_value "${TARGET_SIDS[$i]}" "${TARGET_ENVS[$i]}")" || return $?
		login="$(db_url_username "$value")" || return $?
		record_predecessor "$login"
		value=""
		i=$((i + 1))
	done
	# Render and 1Password can drift. Snapshot the canonical principal too so
	# promotion never loses the only reference to a still-valid predecessor.
	value="$(op_vault_read "$CANONICAL_REF")" || return $?
	login="$(db_url_username "$value")" || return $?
	record_predecessor "$login"
	value=""
	write_state
}
capture_predecessors

# Vault mutations must not proceed on a lost lock; the shared vault.sh helpers
# are wrapped with a liveness probe.
locked_vault_create() { # ref (value in VAULT_VALUE)
	assert_rotation_lock_live || return $?
	vault_create_value "$1"
}
locked_vault_replace() { # ref (value in VAULT_VALUE)
	assert_rotation_lock_live || return $?
	vault_replace_value "$1"
}
vault_delete_candidate() { # ref
	local ref="$1" item_id rc
	local REF_VAULT REF_TITLE REF_FIELD
	[[ -n "$ref" ]] || return 0
	if item_id="$(vault_item_id "$ref")"; then
		ref_parts "$ref"
		assert_rotation_lock_live || return $?
		op_vault_mutation "$REF_VAULT" item delete "$item_id" --vault "$REF_VAULT" >/dev/null
		if item_id="$(vault_item_id "$ref")"; then
			echo "ERROR: candidate item still exists after deletion ($ref)." >&2
			return 1
		else
			rc=$?
			[[ "$rc" == "1" ]] || return "$rc"
		fi
		echo "  vault: removed candidate item $ref"
	else
		rc=$?
		[[ "$rc" == "1" ]] || return "$rc"
	fi
}

observe_candidate_value() { # -> exact observed value; 1=unused, 2=conflict
	local observed="" value user i=0
	while [[ $i -lt ${#TARGET_SIDS[@]} ]]; do
		value="$(render_get_env_value "${TARGET_SIDS[$i]}" "${TARGET_ENVS[$i]}")" || return 2
		user="$(db_url_username "$value")" || return 2
		if [[ "$user" == "$LOGIN" ]]; then
			[[ -z "$observed" || "$observed" == "$value" ]] || {
				echo "ERROR: conflicting live values use the missing candidate login." >&2
				return 2
			}
			observed="$value"
		fi
		value=""
		i=$((i + 1))
	done
	value="$(op_vault_read "$CANONICAL_REF")" || return 2
	user="$(db_url_username "$value")" || return 2
	if [[ "$user" == "$LOGIN" ]]; then
		[[ -z "$observed" || "$observed" == "$value" ]] || {
			echo "ERROR: canonical and live values conflict for the missing candidate login." >&2
			return 2
		}
		observed="$value"
	fi
	value=""
	[[ -n "$observed" ]] || return 1
	printf %s "$observed"
}

reset_candidate_identity() { # old candidate is retained for final proof/retirement
	local retry_hex="" retry_suffix="" old_login
	retry_hex="$(openssl rand -hex 3)" || return $?
	[[ "$retry_hex" =~ ^[a-f0-9]{6}$ ]] || {
		echo "ERROR: OpenSSL did not produce a valid retry identity suffix." >&2
		return 1
	}
	retry_suffix="${VERSION_TAG}_retry_${retry_hex}"
	old_login="$LOGIN"
	append_unique_word OLD_LOGINS "$old_login"
	LOGIN="${CAPABILITY}_login_${retry_suffix}"
	CANDIDATE_REF="$(candidate_ref_for "$retry_suffix")"
	STATE_PHASE="prepared"
	DEPLOY_RECORDS=""
	write_state
	echo "  recovery: replaced unusable candidate identity; prior login remains tracked for retirement"
}

# Retirement is irreversible but safe because the new principal has already
# passed every gate. Persist a dedicated phase before candidate cleanup so a
# crash after deleting the candidate can resume cleanup without ever resetting
# the active login's password from a newly generated candidate.
if [[ "$STATE_PHASE" == "retired" ]]; then
	vault_delete_candidate "$CANDIDATE_REF"
	assert_rotation_lock_live
	rm -f "$STATE_FILE"
	echo "Credential rotation retirement was already complete; candidate cleanup is now complete."
	exit 0
fi

CANDIDATE_VALUE="" CANDIDATE_EXTERNAL=""

verify_sql_candidate_before_mutation() { # value
	local candidate="$1"
	local i=0 live live_user canonical="" canonical_user=""
	[[ "$(db_url_username "$candidate")" == "$LOGIN" ]] || {
		echo "ERROR: candidate item does not contain the saved candidate login." >&2
		return 1
	}
	[[ "$STATE_PHASE" != "initial" ]] || return 0

	while [[ $i -lt ${#TARGET_SIDS[@]} ]]; do
		live="$(render_get_env_value "${TARGET_SIDS[$i]}" "${TARGET_ENVS[$i]}")" || return $?
		live_user="$(db_url_username "$live")" || return $?
		if [[ "$live_user" == "$LOGIN" && "$live" != "$candidate" ]]; then
			echo "ERROR: candidate item differs from a live Render value for the same login; refusing to change an active password." >&2
			return 1
		fi
		live=""
		i=$((i + 1))
	done

	if canonical="$(op_vault_read "$CANONICAL_REF")"; then
		canonical_user="$(db_url_username "$canonical")" || return $?
		if [[ "$canonical_user" == "$LOGIN" && "$canonical" != "$candidate" ]]; then
			echo "ERROR: candidate item differs from the canonical value for the same login; refusing to change an active password." >&2
			return 1
		fi
		if [[ "$STATE_PHASE" == "promoted" && "$canonical" != "$candidate" ]]; then
			echo "ERROR: promoted canonical value no longer matches the saved candidate." >&2
			return 1
		fi
		canonical=""
	elif [[ "$STATE_PHASE" == "promoted" ]]; then
		echo "ERROR: promoted canonical item is unreadable; refusing candidate mutation." >&2
		return 1
	fi
}

candidate_base_url() { # internal for Render-consumed principals, external otherwise
	if [[ ${#TARGET_SIDS[@]} -gt 0 ]]; then printf %s "$RENDER_INTERNAL"; else printf %s "$RENDER_EXTERNAL"; fi
}

compose_candidate_url() { # password -> URL with capability role option + target db
	local pw="$1" url
	url="$(db_compose_url "$(candidate_base_url)" "$LOGIN" "$pw" "$CAPABILITY")" || return $?
	db_url_with_database "$url" "$PRIMARY_DB"
}

ensure_sql_candidate() { # app | ro
	local pw="" safety item_status recovered="" recovery_status
	if vault_item_id "$CANDIDATE_REF" >/dev/null; then
		CANDIDATE_VALUE="$(op_vault_read "$CANDIDATE_REF")" || return $?
	else
		item_status=$?
		[[ "$item_status" == "1" ]] || return "$item_status"
		if [[ "$STATE_PHASE" == "initial" ]]; then
			pw="$(openssl rand -hex 24)"
			CANDIDATE_VALUE="$(compose_candidate_url "$pw")"
			VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_create "$CANDIDATE_REF"
		else
			if recovered="$(observe_candidate_value)"; then
				CANDIDATE_VALUE="$recovered"
				VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_create "$CANDIDATE_REF"
			else
				recovery_status=$?
				[[ "$recovery_status" == "1" ]] || return "$recovery_status"
				reset_candidate_identity
				pw="$(openssl rand -hex 24)"
				CANDIDATE_VALUE="$(compose_candidate_url "$pw")"
				VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_create "$CANDIDATE_REF"
			fi
		fi
	fi
	verify_sql_candidate_before_mutation "$CANDIDATE_VALUE"
	CANDIDATE_EXTERNAL="$(db_rehost_url "$CANDIDATE_VALUE" "$RENDER_EXTERNAL")"
	CANDIDATE_EXTERNAL="$(db_url_with_database "$CANDIDATE_EXTERNAL" "$PRIMARY_DB")"
	pw="$(db_parse_url "$CANDIDATE_VALUE" && db_urldecode "$DB_URL_PASS")"
	assert_rotation_lock_live || return $?
	if [[ "$SCOPE_KIND" == "ro" ]]; then
		LOGIN_PASSWORD="$pw" db_run_psql_url "$CONTROL_URL" -q -v ON_ERROR_STOP=1 -v login="$LOGIN" -v capability="$CAPABILITY" <<'SQL'
\set login_pw `printf %s "$LOGIN_PASSWORD"`
SELECT format('CREATE ROLE %I NOINHERIT LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS', :'login', :'login_pw')
WHERE to_regrole(:'login') IS NULL \gexec
SELECT format('ALTER ROLE %I NOINHERIT LOGIN PASSWORD %L NOCREATEDB NOCREATEROLE', :'login', :'login_pw') \gexec
SELECT format('ALTER ROLE %I SET default_transaction_read_only = on', :'login') \gexec
SELECT format('GRANT %I TO %I WITH INHERIT FALSE, SET TRUE, ADMIN FALSE', :'capability', :'login') \gexec
SQL
	else
		LOGIN_PASSWORD="$pw" db_run_psql_url "$CONTROL_URL" -q -v ON_ERROR_STOP=1 -v login="$LOGIN" -v capability="$CAPABILITY" <<'SQL'
\set login_pw `printf %s "$LOGIN_PASSWORD"`
SELECT format('CREATE ROLE %I NOINHERIT LOGIN PASSWORD %L NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS', :'login', :'login_pw')
WHERE to_regrole(:'login') IS NULL \gexec
SELECT format('ALTER ROLE %I NOINHERIT LOGIN PASSWORD %L NOCREATEDB NOCREATEROLE', :'login', :'login_pw') \gexec
SELECT format('GRANT %I TO %I WITH INHERIT FALSE, SET TRUE, ADMIN FALSE', :'capability', :'login') \gexec
SQL
	fi
	pw=""
	if [[ "$SCOPE_KIND" == "ro" ]]; then
		safety="$(db_run_psql_url "$CANDIDATE_EXTERNAL" -q -t -A -F '|' -v ON_ERROR_STOP=1 -c \
			"SELECT session_user, current_user, r.rolsuper, r.rolbypassrls, pg_has_role(session_user,current_user,'SET'), current_setting('default_transaction_read_only') FROM pg_roles r WHERE r.rolname=session_user")"
		[[ "$safety" == "$LOGIN|$CAPABILITY|f|f|t|on" ]] || {
			echo "ERROR: RO candidate failed its role-safety attestation." >&2
			return 1
		}
		if db_run_psql_url "$CANDIDATE_EXTERNAL" -q -v ON_ERROR_STOP=1 -c 'CREATE TABLE _rotation_ro_probe(id int)' >/dev/null 2>&1; then
			echo "ERROR: RO candidate was able to CREATE TABLE." >&2
			return 1
		fi
		echo "  db: RO candidate login verified (write probe rejected)"
	else
		safety="$(db_run_psql_url "$CANDIDATE_EXTERNAL" -q -t -A -F '|' -v ON_ERROR_STOP=1 -c \
			"SELECT session_user, current_user, r.rolsuper, r.rolbypassrls,
			 EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p') AND pg_has_role(session_user,c.relowner,'MEMBER')),
			 pg_has_role(session_user,current_user,'SET') FROM pg_roles r WHERE r.rolname=session_user")"
		[[ "$safety" == "$LOGIN|$CAPABILITY|f|f|f|t" ]] || {
			echo "ERROR: APP candidate failed its role-safety attestation." >&2
			return 1
		}
		echo "  db: APP candidate login verified"
	fi
}

request_owner_provider_candidate() { # sets OWNER_PROVIDER_VALUE
	local credentials deadline default_user
	assert_rotation_lock_live || return $?
	printf '%s' "$LOGIN" | jq -Rs '{username:.}' | render_curl POST "/postgres/${DB_ID}/credentials" >/dev/null
	echo "  render-postgres: requested OWNER candidate login"
	deadline=$(( $(date +%s) + ${RENDER_CREDENTIAL_TIMEOUT_SECONDS:-300} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
		jq -e 'type == "array"' < <(printf '%s' "$credentials") >/dev/null || return 1
		if jq -e --arg user "$LOGIN" '
			[.[] | select(.username == $user and .default == true)] | length == 1' < <(printf '%s' "$credentials") >/dev/null; then
			break
		fi
		sleep "${RENDER_POLL_SECONDS:-5}"
	done
	default_user="$(printf '%s' "$credentials" | jq -r '.[] | select(.default == true) | .username')"
	[[ "$default_user" == "$LOGIN" ]] || {
		echo "ERROR: OWNER candidate did not become Render's unique default; predecessor remains valid." >&2
		return 1
	}
	refresh_conninfo
	[[ "$(db_url_username "$RENDER_INTERNAL")" == "$LOGIN" ]] || {
		echo "ERROR: Render connection-info did not return the new OWNER candidate." >&2
		return 1
	}
	OWNER_PROVIDER_VALUE="$(db_with_role_option "$RENDER_INTERNAL" "$TABLE_OWNER")"
}

ensure_owner_candidate() {
	local credentials candidate_count safety saved="" candidate_item_exists=0 item_status recovered="" recovery_status current_default canonical=""
	OWNER_PROVIDER_VALUE=""
	credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
	jq -e 'type == "array"' < <(printf '%s' "$credentials") >/dev/null || return 1
	if vault_item_id "$CANDIDATE_REF" >/dev/null; then
		candidate_item_exists=1
	else
		item_status=$?
		[[ "$item_status" == "1" ]] || return "$item_status"
	fi
	candidate_count="$(printf '%s' "$credentials" | jq -er --arg user "$LOGIN" '[.[] | select(.username == $user)] | length')" || return 1
	[[ "$candidate_count" == "0" || "$candidate_count" == "1" ]] || {
		echo "ERROR: Render returned duplicate OWNER candidate credentials." >&2
		return 1
	}

	if [[ "$candidate_count" == "0" && "$STATE_PHASE" != "initial" ]]; then
		# The provider principal was externally removed. It cannot be repaired in
		# place without changing the password beneath possibly active URLs. Track
		# that identity as a predecessor and create a fresh version instead.
		if [[ "$candidate_item_exists" == "1" ]]; then
			vault_delete_candidate "$CANDIDATE_REF"
			candidate_item_exists=0
		fi
		reset_candidate_identity
		candidate_count=0
	fi

	if [[ "$candidate_count" == "0" ]]; then
		request_owner_provider_candidate || return $?
		saved="$OWNER_PROVIDER_VALUE"
	elif [[ "$candidate_item_exists" == "1" ]]; then
		saved="$(op_vault_read "$CANDIDATE_REF")" || return $?
	elif canonical="$(op_vault_read "$CANONICAL_REF")" && [[ "$(db_url_username "$canonical")" == "$LOGIN" ]]; then
		saved="$canonical"
		canonical=""
	else
		canonical=""
		current_default="$(db_url_username "$RENDER_INTERNAL")" || return $?
		if [[ "$current_default" == "$LOGIN" ]]; then
			refresh_conninfo
			saved="$(db_with_role_option "$RENDER_INTERNAL" "$TABLE_OWNER")"
		elif recovered="$(observe_candidate_value)"; then
			saved="$recovered"
		else
			recovery_status=$?
			[[ "$recovery_status" == "1" ]] || return "$recovery_status"
			# The managed credential still exists but no declared/canonical value
			# references it and its password is not recoverable. Leave it valid and
			# tracked, then switch to a fresh provider credential.
			reset_candidate_identity
			request_owner_provider_candidate || return $?
			saved="$OWNER_PROVIDER_VALUE"
		fi
	fi

	[[ "$(db_url_username "$saved")" == "$LOGIN" ]] || {
		echo "ERROR: saved OWNER candidate does not contain the rotation's login." >&2
		return 1
	}
	CANDIDATE_VALUE="$(db_rehost_url "$saved" "$RENDER_INTERNAL")"
	CANDIDATE_EXTERNAL="$(db_rehost_url "$saved" "$RENDER_EXTERNAL")"
	if [[ "$candidate_item_exists" == "0" ]]; then
		VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_create "$CANDIDATE_REF"
	else
		# Phase initial can recreate an externally deleted, not-yet-active provider
		# principal. Update the durable candidate item by immutable id.
		VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_replace "$CANDIDATE_REF"
	fi
	saved=""
	safety="$(db_run_psql_url "$CANDIDATE_EXTERNAL" -q -t -A -F '|' -v ON_ERROR_STOP=1 -c \
		"SELECT session_user, current_user, login.rolsuper, login.rolbypassrls, runtime.rolsuper, runtime.rolbypassrls,
		 NOT EXISTS (SELECT 1 FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='public' AND c.relkind IN ('r','p') AND NOT pg_has_role(session_user,c.relowner,'MEMBER'))
		 FROM pg_roles login, pg_roles runtime WHERE login.rolname=session_user AND runtime.rolname=current_user")"
	[[ "$safety" == "$LOGIN|$TABLE_OWNER|f|f|f|f|t" ]] || {
		echo "ERROR: OWNER candidate failed its role-safety attestation." >&2
		return 1
	}
	echo "  db: OWNER candidate login verified"
}

if [[ "$SCOPE_KIND" == "owner" ]]; then
	ensure_owner_candidate
else
	ensure_sql_candidate
fi
if [[ "$STATE_PHASE" == "initial" ]]; then
	STATE_PHASE="prepared"
	write_state
fi

# --- activation (snapshot -> PUT all -> trigger all -> wait all -> probe all) --
rotation_get_env() { render_get_env_value "$1" "$2"; }
rotation_put_env() {
	assert_rotation_lock_live || return $?
	render_upsert_env_value "$1" "$2"
}
rotation_trigger_deploy() {
	assert_rotation_lock_live || return $?
	render_trigger_deploy_id "$1"
}
rotation_wait_deploy() { render_wait_deploy_live "$1" "$2"; }

rotation_probe_service() {
	local sid="$1" url deadline
	url="$(health_url_for "$sid")" || { echo "ERROR: no health URL registered for render[$sid]." >&2; return 1; }
	# "deploy-only": a TCP-only private service (pgbouncer) has no HTTP surface.
	# The gate is the deploy reaching live (Render's container/port check) plus
	# the rotator's own DB-level proofs (candidate verified, drain, canonical).
	# Declared explicitly in health: so a reduced gate is a visible choice.
	if [[ "$url" == "deploy-only" ]]; then
		echo "  render[$sid] deploy-only health gate: deploy live accepted (no HTTP surface)"
		return 0
	fi
	deadline=$(( $(date +%s) + ${ROTATION_HEALTH_TIMEOUT_SECONDS:-300} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		if rotation_probe_health_once "$url"; then
			echo "  render[$sid] public health passed"
			return 0
		fi
		sleep "${ROTATION_HEALTH_POLL_SECONDS:-5}"
	done
	return 1
}

ROTATION_SIDS=()
ROTATION_ENVS=()
ROTATION_NEW_VALUES=()
i=0
while [[ $i -lt ${#TARGET_SIDS[@]} ]]; do
	ROTATION_SIDS+=("${TARGET_SIDS[$i]}")
	ROTATION_ENVS+=("${TARGET_ENVS[$i]}")
	target_value="$(printf %s "$CANDIDATE_VALUE" | apply_transform "${TARGET_TRANSFORMS[$i]:-self}")" \
		|| fail "transform '${TARGET_TRANSFORMS[$i]:-self}' failed for render[${TARGET_SIDS[$i]}]" 3
	ROTATION_NEW_VALUES+=("$target_value")
	target_value=""
	i=$((i + 1))
done

verify_canonical_value() {
	local value
	value="$(op_vault_read "$CANONICAL_REF")" || return $?
	[[ "$value" == "$CANDIDATE_VALUE" ]] || { echo "ERROR: canonical item does not match the candidate." >&2; return 1; }
	value=""
}

if [[ "$STATE_PHASE" != "promoted" ]]; then
	if [[ ${#ROTATION_SIDS[@]} -gt 0 ]]; then
		rotation_activate || {
			echo "Rotation paused before canonical promotion. Fix the reported problem, then use --resume; predecessor logins remain valid." >&2
			exit 4
		}
		DEPLOY_RECORDS=""
		i=0
		while [[ $i -lt ${#ROTATION_DEPLOY_IDS[@]} ]]; do
			DEPLOY_RECORDS="${DEPLOY_RECORDS:+$DEPLOY_RECORDS }${ROTATION_DEPLOY_SIDS[$i]}:${ROTATION_DEPLOY_IDS[$i]}"
			i=$((i + 1))
		done
	fi
	STATE_PHASE="activated"
	write_state

	VAULT_VALUE="$CANDIDATE_VALUE" locked_vault_replace "$CANONICAL_REF"
	STATE_PHASE="promoted"
	write_state
else
	# A promoted resume must prove that live env values still reference this
	# candidate and that current public health is good before retirement.
	i=0
	while [[ $i -lt ${#ROTATION_SIDS[@]} ]]; do
		live_value="$(rotation_get_env "${ROTATION_SIDS[$i]}" "${ROTATION_ENVS[$i]}")" || exit $?
		[[ "$live_value" == "${ROTATION_NEW_VALUES[$i]}" ]] || {
			echo "ERROR: render[${ROTATION_SIDS[$i]}] ${ROTATION_ENVS[$i]} no longer matches the promoted candidate; predecessor remains valid." >&2
			exit 4
		}
		live_value=""
		i=$((i + 1))
	done
	rotation_probe_all_services
fi
verify_canonical_value || {
	echo "Rotation paused: canonical candidate promotion is not currently proven. Use --resume after correcting it." >&2
	exit 4
}

verify_declared_targets_current() {
	local i=0 live_value
	while [[ $i -lt ${#ROTATION_SIDS[@]} ]]; do
		live_value="$(rotation_get_env "${ROTATION_SIDS[$i]}" "${ROTATION_ENVS[$i]}")" || return $?
		[[ "$live_value" == "${ROTATION_NEW_VALUES[$i]}" ]] || {
			echo "ERROR: render[${ROTATION_SIDS[$i]}] ${ROTATION_ENVS[$i]} does not reference the promoted candidate." >&2
			return 1
		}
		live_value=""
		i=$((i + 1))
	done
}

all_old_logins() {
	local word seen=""
	for word in $OLD_LOGINS; do
		[[ " $seen " == *" $word "* ]] && continue
		seen="${seen:+$seen }$word"
		printf '%s\n' "$word"
	done
}

owner_provider_open_total() {
	local credentials user total=0 count
	[[ "$SCOPE_KIND" == "owner" && -n "$OLD_LOGINS" ]] || { printf 0; return 0; }
	credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
	for user in $OLD_LOGINS; do
		count="$(rotation_render_credential_open_connections "$credentials" "$user")" || {
			echo "ERROR: Render OWNER connection evidence is incomplete for $user." >&2
			return 1
		}
		total=$((total + count))
	done
	printf %s "$total"
}

wait_for_predecessor_drain() {
	local csv="" user count provider_count deadline grace lock_user
	while IFS= read -r user; do csv="${csv:+$csv,}$user"; done < <(all_old_logins)
	[[ -n "$csv" ]] || return 0
	# The rotator holds its advisory-lock session open for the whole rotation.
	# If that session authenticates AS a predecessor, it is itself counted by
	# both drain counters (pg_stat_activity and Render's per-credential open
	# connections), so the drain can never reach zero -- it would spin the full
	# timeout waiting for a connection this process is holding. Throw instead.
	lock_user="$(db_url_username "$ROOT_CONTROL_URL")" || return 1
	case ",$csv," in
		*",$lock_user,"*)
			echo "ERROR: the admin/root credential ($ROOT_REF) authenticates as '$lock_user', which is a predecessor of this rotation." >&2
			echo "       The advisory-lock session would be counted as an undrained predecessor forever." >&2
			echo "       Point admin_refs.$INSTANCE_TIER.root at a principal that is never a rotation target." >&2
			return 1 ;;
	esac
	# Evidence-based drain: instead of a blind grace sleep, require the
	# predecessor session count (database + provider) to hold at zero for
	# ROTATION_DRAIN_STABLE_POLLS consecutive polls. This keeps the safety
	# property (sustained zero, not a lucky instant) while exiting as soon as
	# Render's old instances are actually gone.
	local stable_needed="${ROTATION_DRAIN_STABLE_POLLS:-3}" stable=0
	[[ "$stable_needed" =~ ^[1-9][0-9]*$ ]] || {
		echo "ERROR: ROTATION_DRAIN_STABLE_POLLS must be a positive integer." >&2
		return 1
	}
	echo "  drain: polling until predecessor sessions hold at zero for $stable_needed consecutive checks"
	local drain_start hook_called=0 hook_after="${ROTATION_DRAIN_HOOK_AFTER_SECONDS:-120}"
	drain_start=$(date +%s)
	deadline=$(( drain_start + ${ROTATION_DRAIN_TIMEOUT_SECONDS:-600} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		# Keep the advisory-lock session warm. It is otherwise idle for the whole
		# drain (every poll below opens its own connection), and the lock runs
		# over the Render EXTERNAL endpoint, whose proxy drops idle flows at
		# ~5min -- shorter than this loop's own 600s budget, so any slow drain
		# used to lose the lock and abort after the drain. The probe doubles as
		# the liveness check, so a genuinely lost lock now fails within one poll
		# instead of after the full drain.
		assert_rotation_lock_live || return $?
		# psql -c does not interpolate -v variables; feed the query on stdin.
		count="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v old_csv="$csv" <<'SQL'
SELECT count(*) FROM pg_stat_activity WHERE usename = ANY(string_to_array(:'old_csv', ','))
SQL
)" || return $?
		provider_count="$(owner_provider_open_total)" || return $?
		[[ "$count" =~ ^[0-9]+$ && "$provider_count" =~ ^[0-9]+$ ]] || {
			echo "ERROR: predecessor connection evidence was not numeric." >&2
			return 1
		}
		if [[ "$count" == "0" && "$provider_count" == "0" ]]; then
			stable=$((stable + 1))
			if [[ "$stable" -ge "$stable_needed" ]]; then
				echo "  drain: predecessor sessions held at zero ($stable consecutive checks)"
				return 0
			fi
		else
			stable=0
			echo "  drain: waiting for predecessor sessions (database=$count provider-owner=$provider_count)"
		# Long-lived consumers (always-on flows) hold predecessor connections that
		# no redeploy touches. Past the stall threshold, give the repo hook ONE
		# shot at converging them (e.g. restart the tier's worker so flows
		# reconnect with the already-activated new credential), then keep
		# polling. Hook absence or failure never widens the drain: retirement
		# still requires a sustained zero.
		if [[ "$hook_called" -eq 0 && -n "${ROTATE_HOOK:-}" && -x "${ROTATE_HOOK:-}" ]] \
			&& [[ $(( $(date +%s) - drain_start )) -ge "$hook_after" ]]; then
			hook_called=1
			echo "  drain: predecessor sessions lingering after ${hook_after}s — invoking repo hook (drain-stall)"
			# Close the advisory-lock fds for the child: the lock is a strict
			# one-write/one-read exchange on 8/7, so a hook that touched either
			# would silently desync every later liveness probe.
			"$ROTATE_HOOK" drain-stall 8>&- 7<&- || echo "  drain: hook drain-stall failed (continuing to poll; drain still requires zero)" >&2
		fi
		fi
		sleep "${ROTATION_DRAIN_POLL_SECONDS:-10}"
	done
	echo "ERROR: predecessor database sessions did not drain; predecessor remains valid." >&2
	return 1
}

# Repo-specific activation inside the dual-key window: the vault already holds
# the promoted candidate and the predecessor is still valid, so the hook can
# converge non-Render channels (Prefect blocks, etc.) with zero downtime. A
# failure pauses BEFORE retirement — rerun with --resume; nothing was retired.
if [[ -n "${ROTATE_HOOK:-}" && -x "${ROTATE_HOOK:-}" ]]; then
	echo "  hook: repo-specific activation ($ROTATE_HOOK activate)"
	if ! "$ROTATE_HOOK" activate; then
		echo "Rotation paused: repo hook activation failed; predecessor logins remain valid. Fix and use --resume." >&2
		exit 5
	fi
fi

# Owner rotations retire over the NEW owner connection; app/ro over the still-
# current admin control connection.
if [[ "$SCOPE_KIND" == "owner" ]]; then
	DRAIN_CONTROL_URL="$CANDIDATE_EXTERNAL"
else
	DRAIN_CONTROL_URL="$CONTROL_URL"
fi

wait_for_predecessor_drain || exit 5
ROTATION_INSTANCE_MARKER="${DB_ID%-a}"
if render_inventory_has_predecessor; then
	:
else
	rc=$?
	if [[ "$rc" -eq 1 ]]; then
		echo "Rotation paused: Render still references a predecessor. Correct the undeclared consumer, then use --resume." >&2
	else
		echo "Rotation paused: the complete Render consumer inventory could not be proven. Use --resume." >&2
	fi
	exit 5
fi
echo "  render: complete service/env-group/secret-file inventory contains no predecessor login"
verify_declared_targets_current || {
	echo "Rotation paused: a declared Render target changed during retirement proof. Use --resume." >&2
	exit 5
}
verify_canonical_value || {
	echo "Rotation paused: a canonical item changed during retirement proof. Use --resume." >&2
	exit 5
}
rotation_probe_all_services || {
	echo "Rotation paused: final post-drain public health is not proven. Use --resume." >&2
	exit 5
}

if [[ "$KEEP_OLD" == "1" ]]; then
	echo "Rotation activated and promoted. --keep-old requested, so predecessor logins remain valid; use --resume to retire them."
	exit 0
fi

FENCED_SQL_LOGINS=""
if [[ "$SCOPE_KIND" != "owner" ]]; then
	for old in $OLD_LOGINS; do append_unique_word FENCED_SQL_LOGINS "$old"; done
fi

fence_sql_predecessors() {
	local old
	# The complete intended set is recorded before the first ALTER. If the server
	# commits NOLOGIN but the client loses its acknowledgement, rollback still
	# attempts and verifies that nominally failed role.
	for old in $FENCED_SQL_LOGINS; do
		assert_rotation_lock_live || return $?
		if ! db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT format('ALTER ROLE %I NOLOGIN', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		then
			return 1
		fi
		echo "  db: fenced predecessor login $old (password retained)"
	done
}

unfence_sql_predecessors() {
	local old failed=0 status
	for old in $FENCED_SQL_LOGINS; do
		if ! assert_rotation_lock_live; then
			failed=1
			continue
		fi
		if db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT format('ALTER ROLE %I LOGIN', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		then
			echo "  db: restored predecessor LOGIN after incomplete fence proof ($old)" >&2
		else
			echo "ERROR: could not restore predecessor LOGIN after incomplete fence proof ($old)." >&2
			failed=1
		fi
	done
	for old in $FENCED_SQL_LOGINS; do
		# psql -c does not interpolate -v variables; feed the query on stdin.
		status="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT COALESCE((SELECT CASE WHEN rolcanlogin THEN 'login' ELSE 'nologin' END FROM pg_roles WHERE rolname = :'old'), 'absent')
SQL
)" || {
			failed=1
			continue
		}
		[[ "$status" == "login" || "$status" == "absent" ]] || {
			echo "ERROR: predecessor LOGIN restoration did not verify ($old, status=$status)." >&2
			failed=1
		}
	done
	return "$failed"
}

wait_for_fenced_sql_drain() {
	local csv="" old count deadline
	for old in $FENCED_SQL_LOGINS; do csv="${csv:+$csv,}$old"; done
	[[ -n "$csv" ]] || return 0
	deadline=$(( $(date +%s) + ${ROTATION_DRAIN_TIMEOUT_SECONDS:-600} ))
	while [[ $(date +%s) -lt $deadline ]]; do
		# Same keepalive requirement as wait_for_predecessor_drain: this loop has
		# the same 600s budget and leaves the lock session equally idle.
		assert_rotation_lock_live || return $?
		# psql -c does not interpolate -v variables; feed the query on stdin.
		count="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v old_csv="$csv" <<'SQL'
SELECT count(*) FROM pg_stat_activity WHERE usename = ANY(string_to_array(:'old_csv', ','))
SQL
)" || return $?
		[[ "$count" =~ ^[0-9]+$ ]] || { echo "ERROR: fenced-session evidence was not numeric." >&2; return 1; }
		if [[ "$count" == "0" ]]; then
			echo "  drain: fenced SQL predecessor sessions reached zero"
			return 0
		fi
		echo "  drain: waiting for fenced SQL predecessor sessions (database=$count)"
		sleep "${ROTATION_DRAIN_POLL_SECONDS:-10}"
	done
	echo "ERROR: fenced SQL predecessor sessions did not drain." >&2
	return 1
}

if [[ -n "$FENCED_SQL_LOGINS" ]]; then
	fence_failed=0
	fence_sql_predecessors || fence_failed=1
	if [[ "$fence_failed" -ne 0 ]]; then
		if unfence_sql_predecessors; then
			echo "Rotation paused: SQL predecessor fencing failed; every surviving predecessor was verified LOGIN again. Use --resume." >&2
		else
			echo "Rotation paused: SQL predecessor fencing failed and LOGIN restoration was not proven. Operator intervention is required before --resume." >&2
		fi
		exit 5
	fi
	if ! wait_for_fenced_sql_drain; then
		if unfence_sql_predecessors; then
			echo "Rotation paused: fenced SQL sessions did not drain; every surviving predecessor was verified LOGIN again. Use --resume." >&2
		else
			echo "Rotation paused: fenced SQL sessions did not drain and LOGIN restoration was not proven. Operator intervention is required before --resume." >&2
		fi
		exit 5
	fi
	if ! verify_declared_targets_current || ! verify_canonical_value || ! rotation_probe_all_services; then
		if unfence_sql_predecessors; then
			echo "Rotation paused: a final post-fence proof failed; every surviving predecessor was verified LOGIN again. Use --resume." >&2
		else
			echo "Rotation paused: a final post-fence proof failed and LOGIN restoration was not proven. Operator intervention is required before --resume." >&2
		fi
		exit 5
	fi
fi

retire_sql_predecessors() {
	local old can_login
	for old in $FENCED_SQL_LOGINS; do
		assert_rotation_lock_live || return $?
		if [[ "$old" == "$CAPABILITY" ]]; then
			db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" <<'SQL'
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		else
			db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$old" -v capability="$CAPABILITY" <<'SQL'
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SELECT format('REVOKE %I FROM %I', :'capability', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SELECT format('DROP ROLE %I', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
		fi
		echo "  db: retired predecessor login $old"
	done
	# The stable role is a capability, never a credential. Enforce this even if
	# the current Render/canonical snapshot was already versioned and therefore
	# did not list the legacy capability as a predecessor.
	assert_rotation_lock_live || return $?
	db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v capability="$CAPABILITY" <<'SQL'
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'capability') WHERE to_regrole(:'capability') IS NOT NULL \gexec
SQL
	# psql -c does not interpolate -v variables; feed the query on stdin.
	can_login="$(db_run_psql_url "$DRAIN_CONTROL_URL" -q -t -A -v ON_ERROR_STOP=1 -v capability="$CAPABILITY" <<'SQL'
SELECT rolcanlogin FROM pg_roles WHERE rolname = :'capability'
SQL
)"
	[[ "$can_login" == "f" ]] || {
		echo "ERROR: stable capability $CAPABILITY is still login-enabled." >&2
		return 1
	}
	echo "  db: stable capability $CAPABILITY verified NOLOGIN"
}

retire_owner_predecessors() {
	local credentials old present default open
	for old in $OLD_LOGINS; do
		credentials="$(render_get "/postgres/${DB_ID}/credentials")" || return $?
		open="$(rotation_render_credential_open_connections "$credentials" "$old")" || return 1
		present="$(printf '%s' "$credentials" | jq -er --arg user "$old" '[.[] | select(.username == $user)] | length')" || return 1
		if [[ "$present" == "0" ]]; then
			echo "  render-postgres: predecessor $old already absent"
			continue
		fi
		[[ "$present" == "1" ]] || { echo "ERROR: duplicate Render OWNER credential $old." >&2; return 1; }
		# tostring: a bare boolean false output would make jq -e exit 1 — which
		# silently failed retirement exactly when the credential was deletable.
		default="$(jq -er --arg user "$old" '
			[.[] | select(.username == $user)]
			| if length == 1 and (.[0].default | type) == "boolean" then (.[0].default | tostring)
			  else error("missing, duplicate, or invalid credential") end' < <(printf '%s' "$credentials"))" || return 1
		[[ "$default" == "false" && "$open" == "0" ]] || {
			echo "ERROR: refusing to delete OWNER predecessor $old (default=$default, openConnections=$open)." >&2
			return 1
		}
		assert_rotation_lock_live || return $?
		if retire_owner_predecessor_api "$old"; then
			echo "  render-postgres: retired OWNER predecessor $old"
		elif retire_owner_predecessor_sql "$old"; then
			echo "  db: retired OWNER predecessor $old via SQL"
		else
			# Render refuses API deletion of versioned owner credentials
			# ("cannot delete unmanaged credential") and no accessible session
			# holds ADMIN OPTION on them (the role that created each one is its
			# retired predecessor). The credential is already dead: not the
			# default, zero connections (guarded above), and its password was
			# rotated away in the vault. Leave it fenced and say so loudly —
			# it can be removed by hand in the Render dashboard.
			echo "  WARN: OWNER predecessor $old cannot be deleted programmatically (Render: unmanaged; SQL: no ADMIN OPTION)." >&2
			echo "  WARN: it is inert (not default, 0 connections, password rotated away); remove it in the Render dashboard when convenient." >&2
		fi
	done
}

retire_owner_predecessor_api() { # old
	printf '' | render_curl DELETE "/postgres/${DB_ID}/credentials/${1}" >/dev/null 2>&1
}

retire_owner_predecessor_sql() { # old
	db_run_psql_url "$DRAIN_CONTROL_URL" -q -v ON_ERROR_STOP=1 -v old="$1" >/dev/null 2>&1 <<'SQL'
SELECT format('ALTER ROLE %I NOLOGIN PASSWORD NULL', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SELECT format('DROP ROLE %I', :'old') WHERE to_regrole(:'old') IS NOT NULL \gexec
SQL
}

if [[ "$SCOPE_KIND" == "owner" ]]; then
	retire_owner_predecessors
else
	retire_sql_predecessors
fi

rotation_probe_all_services || {
	echo "ERROR: post-retirement public health could not be proven. Retirement is resumable and no retired credential is recreated." >&2
	exit 5
}

STATE_PHASE="retired"
write_state

vault_delete_candidate "$CANDIDATE_REF"

assert_rotation_lock_live
rm -f "$STATE_FILE"
echo "Credential rotation complete: entry=$ENTRY_ID tier=$TIER scope=$SCOPE_KIND. Candidate is canonical and all recorded predecessors are retired."
