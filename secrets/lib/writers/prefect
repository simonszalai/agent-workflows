#!/usr/bin/env bash
# writers/prefect — resolve a tier's prefect rows into the process env, then
# run the target repo's block-save entrypoint
# (`scripts/prefect_ops/save_blocks.py --yes` via uv). No deploy trigger —
# flows pick up new block values next run.
#
# Part of the default sync-secrets sweep (one run per tier that has rows);
# the prod tier requires confirmation unless SECRETS_ASSUME_YES=1.
#
# Usage: writers/prefect --repo <path> [--dest <staging|prod>]
#                        [--only NAME[,NAME...]] [--ref <EXACT_OP_REF>]
#                        [--ref-prefix <op://VAULT/ITEM/>]
#                        [--reason TEXT] [--dry-run]
#   --repo     the repo whose manifest is being synced (owns save_blocks.py)
#   --dest     tier (DEST column); default staging. prod prompts to confirm.
#   --dry-run  print the plan; read nothing, run nothing (no op, no uv)
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../config.sh
source "$LIB/config.sh"
# shellcheck source=../writer-common.sh
source "$LIB/writer-common.sh"

repo=""
writer_flag() {
  case "$1" in
    --repo) repo="${2:-}"; [[ -n "$repo" ]] || { echo "ERROR: --repo needs a value" >&2; exit 2; }; return 2 ;;
  esac
  return 0
}
W_KIND=prefect W_LABEL=prefect W_FAIL_NOTE="blocks not saved"
writer_parse_args "$@"
[[ -n "$repo" ]] || { echo "ERROR: --repo is required" >&2; exit 2; }
tier="${W_DEST:-staging}"
[[ "$tier" == "staging" || "$tier" == "prod" ]] || { echo "ERROR: --dest must be staging or prod" >&2; exit 2; }
writer_select_rows "$tier"

# Rows become exported env vars for the entrypoint: the name must be a plain
# identifier and never one the shell/loader itself honours.
_check_env_name() {
  [[ "$3" =~ ^[A-Z_][A-Z0-9_]*$ ]] || { echo "ERROR: prefect[$2] $3 is not a valid env var name" >&2; exit 2; }
  case "$3" in
    PATH|HOME|SHELL|USER|LOGNAME|TMPDIR|PWD|OLDPWD|IFS|ENV|BASH_ENV|PROMPT_COMMAND|PYTHONPATH|PYTHONHOME|PYTHONSTARTUP|LD_PRELOAD|LD_LIBRARY_PATH|DYLD_INSERT_LIBRARIES|DYLD_LIBRARY_PATH|OP_SERVICE_ACCOUNT_TOKEN)
      echo "ERROR: prefect[$2] refusing to export reserved name $3" >&2; exit 2 ;;
  esac
}
writer_each_row _check_env_name

echo "prefect[$tier] plan:"
writer_print_plan
if [[ "$W_DRY" == "1" ]]; then exit 0; fi

writer_precheck uv

# SECRETS_ASSUME_YES=1 is set by rotate-secret / rotate-project (the operator
# confirmed the live rotation) and by the rotation hook path.
if [[ "$tier" == "prod" && "${SECRETS_ASSUME_YES:-0}" != "1" ]]; then
  confirm "Save PROD prefect blocks for $repo?" || { echo "Aborted." >&2; exit 3; }
fi

# Resolve every row (batch-validated), export into this process env (never
# argv), then run the block saver once.
writer_resolve_batch
i=0
while [[ $i -lt ${#W_ENVS[@]} ]]; do
  export "${W_ENVS[$i]}"="${W_VALS[$i]}"
  i=$((i + 1))
done
W_VALS=()

cd "$repo"
PYTHONPATH="$repo" uv run python scripts/prefect_ops/save_blocks.py --yes
