#!/usr/bin/env bash
# writers/prefect — resolve a tier's prefect rows into the process env, then
# run the target repo's block-save entrypoint
# (`scripts/prefect_ops/save_blocks.py --yes` via uv). No deploy trigger —
# flows pick up new block values next run.
#
# Excluded from the default sync-secrets sweep: its side effect is running a
# Python entrypoint and prod requires interactive confirmation.
#
# Usage: writers/prefect --repo <path> [--dest <staging|prod>]
#                        [--only NAME[,NAME...]] [--ref <EXACT_OP_REF>]
#                        [--ref-prefix <op://VAULT/ITEM/>]
#                        [--reason TEXT] [--dry-run]
#   --repo     the repo whose manifest is being synced (owns save_blocks.py)
#   --dest     tier (DEST column); default staging. prod prompts to confirm.
#   --dry-run  print the plan; read nothing, run nothing (no op, no uv)
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../config.sh
source "$LIB/config.sh"

dry=0 tier="staging" repo="" ref="" ref_prefix="" only=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --reason)
      [[ -n "${2:-}" ]] || { echo "ERROR: --reason requires non-empty text" >&2; exit 2; }
      SENSITIVE_ACCESS_REASON="$2"; export SENSITIVE_ACCESS_REASON; shift ;;
    --repo) repo="${2:-}"; [[ -n "$repo" ]] || { echo "ERROR: --repo needs a value" >&2; exit 2; }; shift ;;
    --dest) tier="${2:-}"; [[ "$tier" == "staging" || "$tier" == "prod" ]] || { echo "ERROR: --dest must be staging or prod" >&2; exit 2; }; shift ;;
    --only) only="${2:-}"; [[ -n "$only" ]] || { echo "ERROR: --only needs a value" >&2; exit 2; }; shift ;;
    --ref) ref="${2:-}"; [[ "$ref" == op://*/*/* ]] || { echo "ERROR: --ref needs a full op://VAULT/ITEM/field ref" >&2; exit 2; }; shift ;;
    --ref-prefix) ref_prefix="${2:-}"; [[ "$ref_prefix" == op://*/*/ ]] || { echo "ERROR: --ref-prefix needs op://VAULT/ITEM/" >&2; exit 2; }; shift ;;
    -*) echo "ERROR: unknown flag $1" >&2; exit 2 ;;
    *) echo "ERROR: unexpected arg $1" >&2; exit 2 ;;
  esac
  shift
done
[[ -n "$repo" ]] || { echo "ERROR: --repo is required" >&2; exit 2; }

want() { [[ -z "$only" ]] || case ",$only," in *",$1,"*) ;; *) return 1 ;; esac; }

rows="$(config_rows prefect "$tier" "$ref")" || exit $?
if [[ -n "$ref_prefix" ]]; then
  rows="$(awk -F'\t' -v p="$ref_prefix" 'index($4, p) == 1' <<< "$rows")"
fi
selected=""
while IFS=$'\t' read -r _kind d env r transform; do
  [[ -n "$env" ]] || continue
  want "$env" || continue
  row="$(printf '%s\t%s\t%s\t%s\t%s' "$_kind" "$d" "$env" "$r" "$transform")"
  if [[ -n "$selected" ]]; then selected="$selected"$'\n'"$row"; else selected="$row"; fi
done <<< "$rows"
[[ -n "$selected" ]] || { echo "No prefect rows for tier $tier selected in manifest."; exit 0; }

echo "prefect[$tier] plan:"
while IFS=$'\t' read -r _kind d env r transform; do
  printf "  prefect[%s] %s <- %s (%s)\n" "$d" "$env" "$r" "$transform"
done <<< "$selected"
if [[ "$dry" == "1" ]]; then
  exit 0
fi

need uv; need "$OP_BIN"

# Sensitivity precheck: if ANY selected row needs a Touch ID read, refuse an
# agent shell BEFORE the first read of anything.
if grep -q $'\t'"op://[^/]*-sensitive/" <<< "$selected"; then
  guard_agent_shell || exit 3
fi

if [[ "$tier" == "prod" ]]; then
  confirm "Save PROD prefect blocks for $repo?" || { echo "Aborted." >&2; exit 3; }
fi

# Resolve every row into this process env (values via export, never argv), then
# run the block saver once. A failed/empty resolve aborts before the entrypoint.
while IFS=$'\t' read -r _kind d env r transform; do
  rc=0
  raw="$(resolve_ref "$r")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "  prefect[$d] $env: RESOLVE FAILED ($r) — blocks not saved" >&2
    [[ "$rc" == "3" ]] && exit 3
    exit 1
  fi
  [[ -n "$raw" ]] || { echo "  prefect[$d] $env: EMPTY VALUE ($r) — blocks not saved" >&2; exit 1; }
  val="$(printf %s "$raw" | apply_transform "$transform")" \
    || { echo "  prefect[$d] $env: DERIVE FAILED ($r) — blocks not saved" >&2; exit 1; }
  raw=""
  [[ -n "$val" ]] || { echo "  prefect[$d] $env: EMPTY VALUE ($r) — blocks not saved" >&2; exit 1; }
  export "$env"="$val"
  val=""
done <<< "$selected"

cd "$repo"
PYTHONPATH="$repo" uv run python scripts/prefect_ops/save_blocks.py --yes
