#!/usr/bin/env bash
# writers/render — push Render env vars from the manifest, then trigger deploys.
#
# Four-phase ordering contract (amaru/workflow_pro lineage):
#   A. resolve each DISTINCT Render API key once;
#   B. resolve+transform+non-empty-check the ENTIRE selected batch before any
#      PUT — distinct refs resolved at most once (one Touch ID per sensitive
#      ref); any failure => exit, nothing written, no deploy;
#   C. PUTs in parallel waves of SYNC_PUT_CONCURRENCY (default 8), failures
#      collected;
#   D. deploy-last — one deploy per touched service, ONLY if every PUT
#      succeeded. `--no-deploy` skips this phase.
#
# Usage: writers/render [--dest <srv-id>] [--only NAME[,NAME...]]
#                       [--ref <EXACT_OP_REF>] [--ref-prefix <op://VAULT/ITEM/>]
#                       [--reason TEXT] [--no-deploy] [--dry-run] [--include-db]
#   --dry-run  print the plan; read nothing, write nothing (no op, no curl)
#   --include-db  initial-cutover override: push the canonical DB rows selected
#                 by --ref/--ref-prefix like normal rows (requires a ref
#                 selection and --reason; rotations stay with rotate-secret)
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../render-api.sh
source "$LIB/render-api.sh"
# shellcheck source=../manifest.sh
source "$LIB/manifest.sh"

dry=0 dest="" ref="" ref_prefix="" only="" do_deploy=1 skip_db_rows=0 include_db=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --no-deploy) do_deploy=0 ;;
    --skip-db-rows) skip_db_rows=1 ;;
    --include-db) include_db=1 ;;
    --reason)
      [[ -n "${2:-}" ]] || { echo "ERROR: --reason requires non-empty text" >&2; exit 2; }
      SENSITIVE_ACCESS_REASON="$2"; export SENSITIVE_ACCESS_REASON; shift ;;
    --dest) dest="${2:-}"; [[ -n "$dest" ]] || { echo "ERROR: --dest needs a value" >&2; exit 2; }; shift ;;
    --only) only="${2:-}"; [[ -n "$only" ]] || { echo "ERROR: --only needs a value" >&2; exit 2; }; shift ;;
    --ref) ref="${2:-}"; [[ "$ref" == op://*/*/* ]] || { echo "ERROR: --ref needs a full op://VAULT/ITEM/field ref" >&2; exit 2; }; shift ;;
    --ref-prefix) ref_prefix="${2:-}"; [[ "$ref_prefix" == op://*/*/ ]] || { echo "ERROR: --ref-prefix needs op://VAULT/ITEM/" >&2; exit 2; }; shift ;;
    -*) echo "ERROR: unknown flag $1" >&2; exit 2 ;;
    *) echo "ERROR: unexpected arg $1" >&2; exit 2 ;;
  esac
  shift
done

# --include-db is the targeted, audited initial-cutover override only: a ref
# selection plus a reason, and never together with --skip-db-rows.
if [[ "$include_db" -eq 1 ]]; then
  if [[ "$skip_db_rows" -eq 1 ]]; then
    echo "ERROR: --include-db cannot combine with --skip-db-rows" >&2
    exit 2
  fi
  if [[ -z "$ref" && -z "$ref_prefix" ]]; then
    echo "ERROR: --include-db needs a --ref/--ref-prefix selection — full sweeps never push canonical DB rows." >&2
    exit 2
  fi
  if [[ -z "${SENSITIVE_ACCESS_REASON:-}" ]]; then
    echo "ERROR: --include-db requires --reason (audited one-time initial-cutover push)" >&2
    exit 2
  fi
fi

want() { [[ -z "$only" ]] || case ",$only," in *",$1,"*) ;; *) return 1 ;; esac; }

rows="$(manifest_rows render "$dest" "$ref")" || exit $?
if [[ -n "$ref_prefix" ]]; then
  rows="$(awk -F'\t' -v p="$ref_prefix" 'index($4, p) == 1' <<< "$rows")"
fi
selected=""
while IFS=$'\t' read -r _kind sid env r transform; do
  [[ -n "$env" ]] || continue
  want "$env" || continue
  row="$(printf '%s\t%s\t%s\t%s\t%s' "$_kind" "$sid" "$env" "$r" "$transform")"
  if [[ -n "$selected" ]]; then selected="$selected"$'\n'"$row"; else selected="$row"; fi
done <<< "$rows"
[[ -n "$selected" ]] || { echo "No render rows${dest:+ for $dest} selected in manifest."; exit 0; }

# DB-credential guard (amaru lineage). The three canonical runtime/migration
# DB env names are rotated ONLY by the postgres tooling (rotate-secret provider
# postgres / db-provision-roles), never by a plain sync:
#   * targeted --ref/--ref-prefix selection of one of them => refuse (exit 2);
#   * full sweeps (no ref selection, dry or live) skip those rows with a note.
# The match is EXACT — derived per-database credentials such as
# DATABASE_URL_GLOBAL are routine pushes and stay in scope. --include-db
# (validated above: ref selection + reason) is the one initial-cutover
# override: the selected DB rows push like normal rows.
is_db_cred_env() {
  case "$1" in
    DATABASE_URL|MIGRATE_DATABASE_URL|SYSTEM_DATABASE_URL) return 0 ;;
  esac
  return 1
}

if [[ "$include_db" -eq 1 ]]; then
  : # initial cutover: selected DB rows stay in the batch like normal rows
elif [[ -n "$ref" || -n "$ref_prefix" ]] && [[ "$skip_db_rows" -eq 0 ]]; then
  while IFS=$'\t' read -r _kind sid env r transform; do
    if is_db_cred_env "$env"; then
      echo "ERROR: render[$sid] $env is a DB credential — refusing ref-selected sync." >&2
      echo "Rotate Postgres credentials through the postgres tooling instead:" >&2
      echo "  rotate-secret --ref '$r' --reason ...   (provider postgres)" >&2
      echo "  db-provision-roles --project <p> [--app <app>] <tier> --reason ..." >&2
      echo "Initial cutover to a fresh per-app item ONLY: rerun with --include-db --reason ..." >&2
      exit 2
    fi
  done <<< "$selected"
else
  kept=""
  while IFS=$'\t' read -r _kind sid env r transform; do
    if is_db_cred_env "$env"; then
      echo "  render[$sid] $env  skipped (db credential — use rotate-secret/db tooling; initial cutover: --changed + --include-db)"
      continue
    fi
    row="$(printf '%s\t%s\t%s\t%s\t%s' "$_kind" "$sid" "$env" "$r" "$transform")"
    if [[ -n "$kept" ]]; then kept="$kept"$'\n'"$row"; else kept="$row"; fi
  done <<< "$selected"
  selected="$kept"
  [[ -n "$selected" ]] || { echo "No render rows left after db-credential skip."; exit 0; }
fi

if [[ "$dry" == "1" ]]; then
  while IFS=$'\t' read -r _kind sid env r transform; do
    printf "  render[%s] %s <- %s (%s)\n" "$sid" "$env" "$r" "$transform"
  done <<< "$selected"
  exit 0
fi

need curl; need jq; need "$OP_BIN"

# Sensitivity precheck: if ANY selected row needs a Touch ID read, refuse an
# agent shell BEFORE the first read of anything (key resolution included).
if grep -q $'\t'"op://[^/]*-sensitive/" <<< "$selected"; then
  guard_agent_shell || exit 3
fi

# Unique services in this batch (service ids never contain spaces).
services="$(awk -F'\t' '{print $2}' <<< "$selected" | sort -u)"

# Phase A: resolve each DISTINCT Render API key once (cached in indexed arrays;
# bash 3.2 — no associative arrays).
keyrefs=(); keyvals=()
key_cached() { local kr="$1" j=0; while [[ $j -lt ${#keyrefs[@]} ]]; do [[ "${keyrefs[$j]}" == "$kr" ]] && return 0; j=$((j + 1)); done; return 1; }
key_for_sid() { local kr; kr="$(render_key_ref_for "$1")" || return $?; local j=0; while [[ $j -lt ${#keyrefs[@]} ]]; do [[ "${keyrefs[$j]}" == "$kr" ]] && { printf %s "${keyvals[$j]}"; return 0; }; j=$((j + 1)); done; return 1; }
for sid in $services; do
  kr="$(render_key_ref_for "$sid")" || exit 3
  key_cached "$kr" && continue
  rc=0
  kv="$(render_key_resolve "$kr")" || rc=$?
  if [[ "$rc" -ne 0 || -z "$kv" ]]; then
    echo "ERROR: could not read Render API key ($kr) — nothing written" >&2
    [[ "$rc" == "3" ]] && exit 3
    exit 1
  fi
  keyrefs+=("$kr"); keyvals+=("$kv"); kv=""
done

# Phase B: resolve+validate EVERY selected value before any PUT. Resolve each
# DISTINCT ref at most once (cache raw values), so a shared secret is read once
# and a *-sensitive ref triggers ONE Touch ID prompt no matter how many
# services it lands on. Transforms are pure, so they are applied per row
# against the cached raw value.
b_sids=(); b_envs=(); b_vals=()
rvrefs=(); rvvals=()
rv_lookup() { local rr="$1" j=0; while [[ $j -lt ${#rvrefs[@]} ]]; do [[ "${rvrefs[$j]}" == "$rr" ]] && { printf %s "${rvvals[$j]}"; return 0; }; j=$((j + 1)); done; return 1; }
while IFS=$'\t' read -r _kind sid env r transform; do
  if raw="$(rv_lookup "$r")"; then :; else
    rc=0
    raw="$(resolve_ref "$r")" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
      echo "  render[$sid] $env: RESOLVE FAILED ($r) — nothing written, no deploy" >&2
      [[ "$rc" == "3" ]] && exit 3
      exit 1
    fi
    [[ -n "$raw" ]] || { echo "  render[$sid] $env: EMPTY VALUE ($r) — nothing written, no deploy" >&2; exit 1; }
    rvrefs+=("$r"); rvvals+=("$raw")
  fi
  val="$(printf %s "$raw" | apply_transform "$transform")" \
    || { echo "  render[$sid] $env: DERIVE FAILED ($r) — nothing written, no deploy" >&2; exit 1; }
  [[ -n "$val" ]] || { echo "  render[$sid] $env: EMPTY VALUE ($r) — nothing written, no deploy" >&2; exit 1; }
  b_sids+=("$sid"); b_envs+=("$env"); b_vals+=("$val"); val=""; raw=""
done <<< "$selected"
rvvals=()  # drop cached raw secret values from memory once resolution is done

# Phase C: attempt EVERY PUT; collect failures. No deploy happens in this
# phase. PUTs are independent per (service, env-var), so they run in parallel
# waves of SYNC_PUT_CONCURRENCY (default 8).
fail=0
conc="${SYNC_PUT_CONCURRENCY:-8}"
pids=()
drain() { local p; for p in ${pids[@]+"${pids[@]}"}; do wait "$p" || fail=1; done; pids=(); }
i=0
while [[ $i -lt ${#b_envs[@]} ]]; do
  sid="${b_sids[$i]}"; env="${b_envs[$i]}"
  if key="$(key_for_sid "$sid")"; then
    (
      export RENDER_API_KEY="$key"
      if printf %s "${b_vals[$i]}" | render_upsert_env_value "$sid" "$env"; then
        echo "  render[$sid] $env  OK"
      else
        echo "  render[$sid] $env: PUT FAILED" >&2
        exit 1
      fi
    ) &
    pids+=($!)
    [[ ${#pids[@]} -lt $conc ]] || drain
  else
    echo "  render[$sid] $env: no API key resolved" >&2
    fail=1
  fi
  key=""
  i=$((i + 1))
done
drain
b_vals=()

# Phase D: deploy-last. Any failed PUT => zero deploys.
if [[ "$fail" != "0" ]]; then
  echo "ERROR: a Render PUT failed — triggering NO deploys. Repair and rerun before activation." >&2
  exit 1
fi
if [[ "$do_deploy" == "1" ]]; then
  for sid in $services; do
    RENDER_API_KEY="$(key_for_sid "$sid")"; export RENDER_API_KEY
    render_trigger_deploy "$sid"
  done
else
  echo "  deploys skipped (--no-deploy)"
fi
