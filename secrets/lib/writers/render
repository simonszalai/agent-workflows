#!/usr/bin/env bash
# writers/render — push Render env vars from the manifest, then trigger deploys.
#
# Four-phase ordering contract (amaru/workflow_pro lineage):
#   A. resolve each DISTINCT Render API key once;
#   B. resolve+transform+non-empty-check the ENTIRE selected batch before any
#      PUT — distinct refs resolved at most once (one Touch ID per sensitive
#      ref); any failure => exit, nothing written, no deploy;
#   C. per row: GET the current value and PUT only when it differs, in parallel
#      waves of SYNC_PUT_CONCURRENCY (default 8); failures collected;
#   D. deploy-last — one env-only deploy (deployMode deploy_only) per service
#      with >=1 changed var, ONLY if every PUT succeeded; every service is
#      attempted. Under a rotation ($SYNC_DEPLOYS_FILE set) EVERY touched
#      service deploys, unchanged or not: a resumed rotation must re-prove the
#      live instance, and an env-only deploy is idempotent. Deploy ids are
#      appended to $SYNC_DEPLOYS_FILE (dest\tid). `--no-deploy` skips this
#      phase.
#
# Usage: writers/render [--dest <srv-id>] [--only NAME[,NAME...]]
#                       [--ref <EXACT_OP_REF>] [--ref-prefix <op://VAULT/ITEM/>]
#                       [--reason TEXT] [--no-deploy] [--dry-run] [--include-db]
#   --dry-run  print the plan; read nothing, write nothing (no op, no curl)
#   --include-db  initial-cutover override: push the canonical DB rows selected
#                 by --ref/--ref-prefix like normal rows (requires a ref
#                 selection and --reason; rotations stay with rotate-secret)
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../render-api.sh
source "$LIB/render-api.sh"
# shellcheck source=../config.sh
source "$LIB/config.sh"
# shellcheck source=../writer-common.sh
source "$LIB/writer-common.sh"

do_deploy=1 skip_db_rows=0 include_db=0
writer_flag() {
  case "$1" in
    --no-deploy) do_deploy=0; return 1 ;;
    --skip-db-rows) skip_db_rows=1; return 1 ;;
    --include-db) include_db=1; return 1 ;;
  esac
  return 0
}
W_KIND=render W_LABEL=render W_FAIL_NOTE="nothing written, no deploy"
writer_parse_args "$@"

# --include-db is the targeted, audited initial-cutover override only: a ref
# selection plus a reason, and never together with --skip-db-rows.
if [[ "$include_db" -eq 1 ]]; then
  if [[ "$skip_db_rows" -eq 1 ]]; then
    echo "ERROR: --include-db cannot combine with --skip-db-rows" >&2
    exit 2
  fi
  if [[ -z "$W_REF" && -z "$W_REF_PREFIX" ]]; then
    echo "ERROR: --include-db needs a --ref/--ref-prefix selection — full sweeps never push canonical DB rows." >&2
    exit 2
  fi
  if [[ -z "${SENSITIVE_ACCESS_REASON:-}" ]]; then
    echo "ERROR: --include-db requires --reason (audited one-time initial-cutover push)" >&2
    exit 2
  fi
fi

writer_select_rows

# DB-credential guard (shared with sync-secrets): targeted selection of a
# canonical DB env => refuse; full sweeps skip those rows with a note;
# --include-db keeps them in the batch.
if [[ "$include_db" -eq 1 ]]; then
  :
elif [[ -n "$W_REF" || -n "$W_REF_PREFIX" ]] && [[ "$skip_db_rows" -eq 0 ]]; then
  db_guard_refuse render <<< "$W_SELECTED"
else
  kept=""
  _keep_or_skip() {
    if is_db_cred_env "$3"; then
      echo "  render[$2] $3  skipped (db credential — use rotate-secret/db tooling; initial cutover: --changed + --include-db)"
    else
      kept="${kept:+$kept$'\n'}$(printf '%s\t%s\t%s\t%s\t%s' "$1" "$2" "$3" "$4" "$5")"
    fi
  }
  writer_each_row _keep_or_skip
  W_SELECTED="$kept"
  [[ -n "$W_SELECTED" ]] || { echo "No render rows left after db-credential skip."; exit 0; }
fi

if [[ "$W_DRY" == "1" ]]; then writer_print_plan; exit 0; fi

writer_precheck curl jq
conc="$(writer_concurrency)"

# Unique services in this batch (service ids never contain spaces).
services="$(awk -F'\t' '{print $2}' <<< "$W_SELECTED" | sort -u)"

# Phase A: resolve each DISTINCT Render API key once (indexed arrays; bash 3.2).
keyrefs=(); keyvals=()
key_cached() { local kr="$1" j=0; while [[ $j -lt ${#keyrefs[@]} ]]; do [[ "${keyrefs[$j]}" == "$kr" ]] && return 0; j=$((j + 1)); done; return 1; }
key_for_sid() { local kr; kr="$(render_key_ref_for "$1")" || return $?; local j=0; while [[ $j -lt ${#keyrefs[@]} ]]; do [[ "${keyrefs[$j]}" == "$kr" ]] && { printf %s "${keyvals[$j]}"; return 0; }; j=$((j + 1)); done; return 1; }
for sid in $services; do
  kr="$(render_key_ref_for "$sid")" || exit 3
  key_cached "$kr" && continue
  rc=0
  kv="$(render_key_resolve "$kr")" || rc=$?
  if [[ "$rc" -ne 0 || -z "$kv" ]]; then
    echo "ERROR: could not read Render API key ($kr) — nothing written" >&2
    [[ "$rc" == "3" ]] && exit 3
    exit 1
  fi
  keyrefs+=("$kr"); keyvals+=("$kv"); kv=""
done

# Phase B: resolve+validate EVERY selected value before any PUT.
writer_resolve_batch

# Phase C: compare-then-PUT every row; collect failures; no deploy here. Rows
# are independent per (service, env-var), so they run in parallel waves.
# Subshells report "changed" per service through marker files.
work="$(mktemp -d "${TMPDIR:-/tmp}/sync-render.XXXXXX")"
trap 'rm -rf "$work"' EXIT
fail=0 pids=()
drain() { local p; for p in ${pids[@]+"${pids[@]}"}; do wait "$p" || fail=1; done; pids=(); }
i=0
while [[ $i -lt ${#W_ENVS[@]} ]]; do
  sid="${W_DESTS[$i]}"; env="${W_ENVS[$i]}"
  if key="$(key_for_sid "$sid")"; then
    (
      export RENDER_API_KEY="$key"
      cur="$(render_get_env_value "$sid" "$env" 2>/dev/null || true)"
      if [[ -n "$cur" && "$cur" == "${W_VALS[$i]}" ]]; then
        echo "  render[$sid] $env  unchanged"
        exit 0
      fi
      cur=""
      if printf %s "${W_VALS[$i]}" | render_upsert_env_value "$sid" "$env"; then
        : > "$work/changed.$sid"
        echo "  render[$sid] $env  OK"
      else
        echo "  render[$sid] $env: PUT FAILED" >&2
        exit 1
      fi
    ) &
    pids+=($!)
    [[ ${#pids[@]} -lt $conc ]] || drain
  else
    echo "  render[$sid] $env: no API key resolved" >&2
    fail=1
  fi
  key=""
  i=$((i + 1))
done
drain
W_VALS=()

# Phase D: deploy-last. Any failed PUT => zero deploys. Only services with a
# changed var deploy (every touched service under a rotation); every such
# service is attempted before a failure exits.
if [[ "$fail" != "0" ]]; then
  echo "ERROR: a Render PUT failed — triggering NO deploys. Repair and rerun before activation." >&2
  exit 1
fi
if [[ "$do_deploy" == "1" ]]; then
  for sid in $services; do
    if [[ ! -e "$work/changed.$sid" ]]; then
      if [[ -n "${SYNC_DEPLOYS_FILE:-}" ]]; then
        echo "  render[$sid] no changes — deploying anyway (rotation must prove the live instance)"
      else
        echo "  render[$sid] no changes — deploy skipped"; continue
      fi
    fi
    RENDER_API_KEY="$(key_for_sid "$sid")"; export RENDER_API_KEY
    render_trigger_deploy "$sid" || fail=1
  done
  [[ "$fail" == "0" ]] || { echo "ERROR: a Render deploy trigger failed — rerun to converge." >&2; exit 1; }
else
  echo "  deploys skipped (--no-deploy)"
fi
