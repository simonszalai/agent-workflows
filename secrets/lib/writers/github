#!/usr/bin/env bash
# writers/github — push GitHub Actions secrets from the manifest.
#   resolve (op/literal) -> derive (transform) -> `gh secret set`. Values never
#   reach argv. The WHOLE selected batch is resolved and validated BEFORE the
#   first write; writes then run in parallel waves (SYNC_PUT_CONCURRENCY) with
#   transient gh failures retried and every row attempted before exit 1.
#
# Usage: writers/github [--dest <owner/repo>] [--only NAME[,NAME...]]
#                       [--ref <EXACT_OP_REF>] [--ref-prefix <op://VAULT/ITEM/>]
#                       [--reason TEXT] [--dry-run]
#   --dry-run  print the plan; read nothing, write nothing (no op, no gh)
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../config.sh
source "$LIB/config.sh"
# shellcheck source=../writer-common.sh
source "$LIB/writer-common.sh"

W_KIND=github W_LABEL=gh W_FAIL_NOTE="nothing written"
writer_parse_args "$@"
writer_select_rows
if [[ "$W_DRY" == "1" ]]; then writer_print_plan; exit 0; fi
writer_precheck gh
writer_resolve_batch

# Write in parallel waves; values go through stdin (RETRY_STDIN env), never
# argv. Every row is attempted; any failure => exit 1 after the loop.
conc="$(writer_concurrency)"
fail=0 pids=()
drain() { local p; for p in ${pids[@]+"${pids[@]}"}; do wait "$p" || fail=1; done; pids=(); }
i=0
while [[ $i -lt ${#W_ENVS[@]} ]]; do
  (
    if RETRY_STDIN="${W_VALS[$i]}" retry_transient gh secret set "${W_ENVS[$i]}" --repo "${W_DESTS[$i]}"; then
      echo "  gh[${W_DESTS[$i]}] ${W_ENVS[$i]}  OK"
    else
      echo "  gh[${W_DESTS[$i]}] ${W_ENVS[$i]}: SET FAILED" >&2
      exit 1
    fi
  ) &
  pids+=($!)
  [[ ${#pids[@]} -lt $conc ]] || drain
  i=$((i + 1))
done
drain
W_VALS=()
[[ "$fail" == "0" ]] || { echo "ERROR: a GitHub secret write failed — rerun to converge." >&2; exit 1; }
