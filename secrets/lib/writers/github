#!/usr/bin/env bash
# writers/github — push GitHub Actions secrets from the manifest.
#   resolve (op/literal) -> derive (transform) -> `gh secret set`. Values never
#   reach argv. The WHOLE selected batch is resolved and validated BEFORE the
#   first write, so a failed/empty read never leaves a half-written batch.
#
# Usage: writers/github [--dest <owner/repo>] [--only NAME[,NAME...]]
#                       [--ref <EXACT_OP_REF>] [--ref-prefix <op://VAULT/ITEM/>]
#                       [--reason TEXT] [--dry-run]
#   --dest        restrict to one repo (default: every github row)
#   --only        restrict to these ENVNAMEs
#   --ref         restrict to rows whose REF equals this EXACT ref
#   --ref-prefix  restrict to rows whose REF starts with op://VAULT/ITEM/
#                 (field-less --changed; still never bare-substring)
#   --dry-run     print the plan; read nothing, write nothing (no op, no gh)
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../manifest.sh
source "$LIB/manifest.sh"

dry=0 dest="" ref="" ref_prefix="" only=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --reason)
      [[ -n "${2:-}" ]] || { echo "ERROR: --reason requires non-empty text" >&2; exit 2; }
      SENSITIVE_ACCESS_REASON="$2"; export SENSITIVE_ACCESS_REASON; shift ;;
    --dest) dest="${2:-}"; [[ -n "$dest" ]] || { echo "ERROR: --dest needs a value" >&2; exit 2; }; shift ;;
    --only) only="${2:-}"; [[ -n "$only" ]] || { echo "ERROR: --only needs a value" >&2; exit 2; }; shift ;;
    --ref) ref="${2:-}"; [[ "$ref" == op://*/*/* ]] || { echo "ERROR: --ref needs a full op://VAULT/ITEM/field ref" >&2; exit 2; }; shift ;;
    --ref-prefix) ref_prefix="${2:-}"; [[ "$ref_prefix" == op://*/*/ ]] || { echo "ERROR: --ref-prefix needs op://VAULT/ITEM/" >&2; exit 2; }; shift ;;
    -*) echo "ERROR: unknown flag $1" >&2; exit 2 ;;
    *) echo "ERROR: unexpected arg $1" >&2; exit 2 ;;
  esac
  shift
done

want() { [[ -z "$only" ]] || case ",$only," in *",$1,"*) ;; *) return 1 ;; esac; }

rows="$(manifest_rows github "$dest" "$ref")" || exit $?
if [[ -n "$ref_prefix" ]]; then
  rows="$(awk -F'\t' -v p="$ref_prefix" 'index($4, p) == 1' <<< "$rows")"
fi
selected=""
while IFS=$'\t' read -r _kind d env r transform; do
  [[ -n "$env" ]] || continue
  want "$env" || continue
  row="$(printf '%s\t%s\t%s\t%s\t%s' "$_kind" "$d" "$env" "$r" "$transform")"
  if [[ -n "$selected" ]]; then selected="$selected"$'\n'"$row"; else selected="$row"; fi
done <<< "$rows"
[[ -n "$selected" ]] || { echo "No github rows${dest:+ for $dest} selected in manifest."; exit 0; }

if [[ "$dry" == "1" ]]; then
  while IFS=$'\t' read -r _kind d env r transform; do
    printf "  gh[%s] %s <- %s (%s)\n" "$d" "$env" "$r" "$transform"
  done <<< "$selected"
  exit 0
fi

need gh; need "$OP_BIN"

# Sensitivity precheck: if ANY selected row needs a Touch ID read, refuse an
# agent shell BEFORE the first read of anything.
if grep -q $'\t'"op://[^/]*-sensitive/" <<< "$selected"; then
  guard_agent_shell || exit 3
fi

# Phase 1: resolve+validate the ENTIRE selected batch first (a failed read must
# never blank a live secret, and must not leave a partially-written batch).
# Refusals (agent shell, rc 3) propagate as exit 3.
d_dests=(); d_envs=(); d_vals=()
while IFS=$'\t' read -r _kind d env r transform; do
  rc=0
  raw="$(resolve_ref "$r")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "  gh[$d] $env: RESOLVE FAILED ($r) — nothing written" >&2
    [[ "$rc" == "3" ]] && exit 3
    exit 1
  fi
  [[ -n "$raw" ]] || { echo "  gh[$d] $env: EMPTY VALUE ($r) — nothing written" >&2; exit 1; }
  val="$(printf %s "$raw" | apply_transform "$transform")" \
    || { echo "  gh[$d] $env: DERIVE FAILED ($r) — nothing written" >&2; exit 1; }
  raw=""
  [[ -n "$val" ]] || { echo "  gh[$d] $env: EMPTY VALUE ($r) — nothing written" >&2; exit 1; }
  d_dests+=("$d"); d_envs+=("$env"); d_vals+=("$val"); val=""
done <<< "$selected"

# Phase 2: only now write. Values go through stdin, never argv.
i=0
while [[ $i -lt ${#d_envs[@]} ]]; do
  printf %s "${d_vals[$i]}" | gh secret set "${d_envs[$i]}" --repo "${d_dests[$i]}"
  echo "  gh[${d_dests[$i]}] ${d_envs[$i]}  OK"
  i=$((i + 1))
done
d_vals=()
