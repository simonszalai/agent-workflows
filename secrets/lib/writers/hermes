#!/usr/bin/env bash
# writers/hermes — push root-only credential files to the Hermes box over SSH.
#
# Hermes' systemd services consume static files via LoadCredential
# (/etc/hermes-schedules/op.token etc.). Those files are OUTSIDE every other
# sync channel, which is how the 2026-08 rotation stranded the scheduled
# runners (B0403): rotations updated the vault + GitHub/Render but the box
# kept the retired values. This writer makes them manifest-routed consumers.
#
# Route shape: kind=hermes, DEST=<absolute file path on the box>, ENV=<logical
# name, reporting only>, REF, TRANSFORM (normally self). The SSH destination
# comes from the manifest's top-level `hermes.ssh` (override: HERMES_SSH_DEST).
#
# Writes are atomic (temp file + mv), root:root 0400, values flow only via
# stdin. After a write the file's dependent long-running units restart;
# schedule-token files need no restart (LoadCredential is read at each timer
# run's service start).
#
# Usage: writers/hermes [--dest <path>] [--only NAME[,NAME...]]
#                       [--ref <EXACT_OP_REF>] [--ref-prefix <op://VAULT/ITEM/>]
#                       [--reason TEXT] [--dry-run]
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../config.sh
source "$LIB/config.sh"

dry=0 dest="" ref="" ref_prefix="" only=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) dry=1 ;;
    --reason)
      [[ -n "${2:-}" ]] || { echo "ERROR: --reason requires non-empty text" >&2; exit 2; }
      SENSITIVE_ACCESS_REASON="$2"; export SENSITIVE_ACCESS_REASON; shift ;;
    --dest) dest="${2:-}"; [[ -n "$dest" ]] || { echo "ERROR: --dest needs a value" >&2; exit 2; }; shift ;;
    --only) only="${2:-}"; [[ -n "$only" ]] || { echo "ERROR: --only needs a value" >&2; exit 2; }; shift ;;
    --ref) ref="${2:-}"; [[ "$ref" == op://*/*/* ]] || { echo "ERROR: --ref needs a full op://VAULT/ITEM/field ref" >&2; exit 2; }; shift ;;
    --ref-prefix) ref_prefix="${2:-}"; [[ "$ref_prefix" == op://*/*/ ]] || { echo "ERROR: --ref-prefix needs op://VAULT/ITEM/" >&2; exit 2; }; shift ;;
    -*) echo "ERROR: unknown flag $1" >&2; exit 2 ;;
    *) echo "ERROR: unexpected arg $1" >&2; exit 2 ;;
  esac
  shift
done

want() { [[ -z "$only" ]] || case ",$only," in *",$1,"*) ;; *) return 1 ;; esac; }

# Units to restart per credential file (basename). Schedule tokens are read at
# each timer run's service start, so they converge without a restart.
restart_units() {
  case "$(basename "$1")" in
    autodev-memory.token) echo "hermes-autodev-mcp" ;;
    conductor-api.token)  echo "hermes-conductor" ;;
    *) ;;
  esac
}

rows="$(config_rows hermes "$dest" "$ref")" || exit $?
if [[ -n "$ref_prefix" ]]; then
  rows="$(awk -F'\t' -v p="$ref_prefix" 'index($4, p) == 1' <<< "$rows")"
fi
selected=""
while IFS=$'\t' read -r _kind d env r transform; do
  [[ -n "$env" ]] || continue
  want "$env" || continue
  row="$(printf '%s\t%s\t%s\t%s\t%s' "$_kind" "$d" "$env" "$r" "$transform")"
  if [[ -n "$selected" ]]; then selected="$selected"$'\n'"$row"; else selected="$row"; fi
done <<< "$rows"
[[ -n "$selected" ]] || { echo "No hermes rows${dest:+ for $dest} selected in manifest."; exit 0; }

ssh_dest="${HERMES_SSH_DEST:-$(config_hermes_ssh)}"
[[ -n "$ssh_dest" ]] || { echo "ERROR: no hermes.ssh in manifest and HERMES_SSH_DEST unset" >&2; exit 2; }

if [[ "$dry" == "1" ]]; then
  while IFS=$'\t' read -r _kind d env r transform; do
    units="$(restart_units "$d")"
    printf "  hermes[%s] %s <- %s (%s)%s\n" "$d" "$env" "$r" "$transform" "${units:+ + restart $units}"
  done <<< "$selected"
  exit 0
fi

need ssh; need "$OP_BIN"

# Sensitivity precheck: if ANY selected row needs a Touch ID read (sensitive
# vaults, or the human-only "OP SA" service-account-token vault), refuse an
# agent shell BEFORE the first read of anything.
if grep -qE $'\t'"op://([^/]*-sensitive|OP SA)/" <<< "$selected"; then
  guard_agent_shell || exit 3
fi

# Reachability precheck, before any secret read: the box is tailnet-only, so a
# clear "cannot reach" beats a half-resolved batch.
if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$ssh_dest" 'sudo -n true' 2>/dev/null; then
  echo "ERROR: cannot reach $ssh_dest with passwordless sudo (tailnet down, host unknown, or sudoers missing) — nothing read, nothing written" >&2
  exit 1
fi

# Phase 1: resolve+validate the ENTIRE selected batch first (a failed read must
# never blank a live credential file or leave a partially-written batch).
d_paths=(); d_envs=(); d_vals=()
while IFS=$'\t' read -r _kind d env r transform; do
  rc=0
  raw="$(resolve_ref "$r")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "  hermes[$d] $env: RESOLVE FAILED ($r) — nothing written" >&2
    [[ "$rc" == "3" ]] && exit 3
    exit 1
  fi
  [[ -n "$raw" ]] || { echo "  hermes[$d] $env: EMPTY VALUE ($r) — nothing written" >&2; exit 1; }
  val="$(printf %s "$raw" | apply_transform "$transform")" \
    || { echo "  hermes[$d] $env: DERIVE FAILED ($r) — nothing written" >&2; exit 1; }
  raw=""
  [[ -n "$val" ]] || { echo "  hermes[$d] $env: EMPTY VALUE ($r) — nothing written" >&2; exit 1; }
  d_paths+=("$d"); d_envs+=("$env"); d_vals+=("$val"); val=""
done <<< "$selected"

# Phase 2: write each file atomically (root:root 0400), verify by remote
# sha256, then restart the dependent units. Values go via stdin, never argv.
worst=0
i=0
while [[ $i -lt ${#d_envs[@]} ]]; do
  path="${d_paths[$i]}"
  want_sum="$(printf %s "${d_vals[$i]}" | shasum -a 256 | awk '{print $1}')"
  rc=0
  printf %s "${d_vals[$i]}" | ssh -o BatchMode=yes "$ssh_dest" \
    "sudo -n sh -c 'umask 077 && mkdir -p \"\$(dirname \"$path\")\" && cat > \"$path.tmp\" && chown root:root \"$path.tmp\" && chmod 0400 \"$path.tmp\" && mv -f \"$path.tmp\" \"$path\"'" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "  hermes[$path] ${d_envs[$i]}  WRITE FAILED (ssh rc $rc)" >&2
    worst=1; i=$((i + 1)); continue
  fi
  got_sum="$(ssh -o BatchMode=yes "$ssh_dest" "sudo -n sha256sum \"$path\"" | awk '{print $1}')" || got_sum=""
  if [[ "$got_sum" != "$want_sum" ]]; then
    echo "  hermes[$path] ${d_envs[$i]}  VERIFY FAILED (remote hash mismatch)" >&2
    worst=1; i=$((i + 1)); continue
  fi
  units="$(restart_units "$path")"
  if [[ -n "$units" ]]; then
    ssh -o BatchMode=yes "$ssh_dest" "sudo -n systemctl restart $units" \
      || { echo "  hermes[$path] ${d_envs[$i]}  RESTART FAILED ($units)" >&2; worst=1; i=$((i + 1)); continue; }
  fi
  echo "  hermes[$path] ${d_envs[$i]}  OK${units:+ (restarted $units)}"
  i=$((i + 1))
done
d_vals=()
exit "$worst"
