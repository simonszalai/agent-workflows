#!/usr/bin/env bash
# writers/hermes — push root-only credential files to the Hermes box over SSH.
#
# Hermes' systemd services consume static files via LoadCredential
# (/etc/hermes-schedules/op.token etc.). Those files are OUTSIDE every other
# sync channel, which is how the 2026-08 rotation stranded the scheduled
# runners (B0403): rotations updated the vault + GitHub/Render but the box
# kept the retired values. This writer makes them manifest-routed consumers.
#
# Route shape: kind=hermes, DEST=<absolute file path on the box>, ENV=<logical
# name, reporting only>, REF, TRANSFORM (normally self). The SSH destination
# comes from the manifest's top-level `hermes.ssh` (override: HERMES_SSH_DEST).
#
# One remote script per batch: the whole batch streams over ONE ssh session's
# stdin as `path sha256 base64(value)` lines (values never on argv); the box
# writes each file atomically (mktemp in the target dir, root:root 0400, mv),
# verifies the hash, then restarts the dependent long-running units. Schedule
# token files need no restart (LoadCredential is read at each timer run).
#
# Usage: writers/hermes [--dest <path>] [--only NAME[,NAME...]]
#                       [--ref <EXACT_OP_REF>] [--ref-prefix <op://VAULT/ITEM/>]
#                       [--reason TEXT] [--dry-run]
case "$-" in *x*) set +x ;; esac
set -euo pipefail
LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../read.sh
source "$LIB/read.sh"
# shellcheck source=../derive.sh
source "$LIB/derive.sh"
# shellcheck source=../config.sh
source "$LIB/config.sh"
# shellcheck source=../writer-common.sh
source "$LIB/writer-common.sh"

W_KIND=hermes W_LABEL=hermes W_FAIL_NOTE="nothing written"
writer_parse_args "$@"
writer_select_rows

# Units to restart per credential file (basename). Schedule tokens are read at
# each timer run's service start, so they converge without a restart.
restart_units() {
  case "$(basename "$1")" in
    autodev-memory.token) echo "hermes-autodev-mcp" ;;
    conductor-api.token)  echo "hermes-conductor" ;;
    *) ;;
  esac
}
_plan_suffix() { local u; u="$(restart_units "$1")"; printf '%s' "${u:+ + restart $u}"; }

ssh_dest="${HERMES_SSH_DEST:-$(config_hermes_ssh)}"
[[ -n "$ssh_dest" ]] || { echo "ERROR: no hermes.ssh in manifest and HERMES_SSH_DEST unset" >&2; exit 2; }

if [[ "$W_DRY" == "1" ]]; then writer_print_plan _plan_suffix; exit 0; fi

writer_precheck ssh

# Reachability precheck, before any secret read: the box is tailnet-only, so a
# clear "cannot reach" beats a half-resolved batch.
if ! ssh -o BatchMode=yes -o ConnectTimeout=8 "$ssh_dest" 'sudo -n true' 2>/dev/null; then
  echo "ERROR: cannot reach $ssh_dest with passwordless sudo (tailnet down, host unknown, or sudoers missing) — nothing read, nothing written" >&2
  exit 1
fi

# Phase 1: resolve+validate the ENTIRE selected batch first.
writer_resolve_batch

# Phase 2: one remote script for the batch. Its stdin carries
# `path sha256 base64(value)` lines; it prints `OK <path>` / `FAIL <path> <why>`
# per line, then restarts the units named after the `RESTART` marker line.
remote_script='
set -u; umask 077
units=""
while IFS=" " read -r path sum b64; do
  if [ "$path" = "RESTART" ]; then units="$sum $b64"; continue; fi
  dir="$(dirname "$path")"
  mkdir -p "$dir" || { echo "FAIL $path mkdir"; continue; }
  tmp="$(mktemp "$dir/.sync.XXXXXX")" || { echo "FAIL $path mktemp"; continue; }
  if ! printf "%s" "$b64" | base64 -d > "$tmp"; then echo "FAIL $path decode"; rm -f "$tmp"; continue; fi
  got="$(sha256sum "$tmp" | cut -d" " -f1)"
  if [ "$got" != "$sum" ]; then echo "FAIL $path verify"; rm -f "$tmp"; continue; fi
  chown root:root "$tmp" && chmod 0400 "$tmp" && mv -f "$tmp" "$path" || { echo "FAIL $path install"; rm -f "$tmp"; continue; }
  echo "OK $path"
done
for u in $units; do
  systemctl restart "$u" && echo "RESTARTED $u" || echo "RESTART-FAILED $u"
done
'

units_all=""
stream() {
  local i=0 sum u
  while [[ $i -lt ${#W_ENVS[@]} ]]; do
    sum="$(printf %s "${W_VALS[$i]}" | shasum -a 256 | awk '{print $1}')"
    printf '%s %s %s\n' "${W_DESTS[$i]}" "$sum" "$(printf %s "${W_VALS[$i]}" | base64 | tr -d '\n')"
    i=$((i + 1))
  done
  [[ -z "$units_all" ]] || printf 'RESTART %s\n' "$units_all"
}
i=0
while [[ $i -lt ${#W_ENVS[@]} ]]; do
  u="$(restart_units "${W_DESTS[$i]}")"
  [[ -z "$u" ]] || case " $units_all " in *" $u "*) ;; *) units_all="${units_all:+$units_all }$u" ;; esac
  i=$((i + 1))
done

result="$(stream | ssh -o BatchMode=yes "$ssh_dest" "sudo -n sh -c '$remote_script'")" || {
  echo "ERROR: hermes batch ssh failed ($ssh_dest) — see above" >&2
  W_VALS=()
  exit 1
}
W_VALS=()

worst=0
i=0
while [[ $i -lt ${#W_ENVS[@]} ]]; do
  path="${W_DESTS[$i]}"
  if grep -qx "OK $path" <<< "$result"; then
    echo "  hermes[$path] ${W_ENVS[$i]}  OK"
  else
    echo "  hermes[$path] ${W_ENVS[$i]}  FAILED ($(grep "^FAIL $path " <<< "$result" | awk '{print $3}' || echo no-result))" >&2
    worst=1
  fi
  i=$((i + 1))
done
for u in $units_all; do
  if grep -qx "RESTARTED $u" <<< "$result"; then
    echo "  hermes: restarted $u"
  else
    echo "  hermes: RESTART FAILED ($u)" >&2
    worst=1
  fi
done
exit "$worst"
