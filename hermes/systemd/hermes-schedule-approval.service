[Unit]
Description=Hermes Slack production approval bridge
After=network-online.target hermes-conductor.service hermes-autodev-mcp.service
Wants=network-online.target hermes-conductor.service hermes-autodev-mcp.service
OnFailure=hermes-schedule-alert@approval.service

[Service]
Type=oneshot
User=hermes-schedules
Group=hermes-schedules
WorkingDirectory=/opt/hermes-schedules
LoadCredential=slack.token:/etc/hermes-schedules/slack.token
StateDirectory=hermes-schedules
StateDirectoryMode=0700
TimeoutStartSec=5m
ExecStart=/opt/hermes-schedules/bin/run-schedule-release approvals
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
