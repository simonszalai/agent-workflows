[Unit]
Description=Fetch and atomically activate reviewed Hermes schedule prompts
After=network-online.target
Wants=network-online.target
OnFailure=hermes-schedule-sync-alert.service

[Service]
Type=oneshot
User=root
Group=root
StateDirectory=hermes-schedule-sync
StateDirectoryMode=0700
TimeoutStartSec=20min
ExecStart=/opt/hermes-schedules/bin/hermes-schedule-release sync
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# The root coordinator must drop to the secretless builder with runuser.
# NoNewPrivileges remains inherited by that child and prevents re-escalation.
RestrictSUIDSGID=false
LockPersonality=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/hermes-schedules
MemoryMax=1G
TasksMax=512
UMask=0077
