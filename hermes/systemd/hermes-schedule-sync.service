[Unit]
Description=Fetch and atomically activate reviewed Hermes schedule prompts
After=network-online.target
Wants=network-online.target
OnFailure=hermes-schedule-sync-alert.service

[Service]
Type=oneshot
# No explicit User=/Group=: the coordinator runs as root by default. An explicit
# User=root plus NoNewPrivileges=true makes systemd 255 take its user-switch
# path, and the later setpriv/runuser setuid to the builder then fails with
# EPERM (verified on the Hermes host, 2026-09-03).
StateDirectory=hermes-schedule-sync
StateDirectoryMode=0700
TimeoutStartSec=20min
ExecStart=/opt/hermes-schedules/bin/hermes-schedule-release sync
# The fixed root coordinator needs CAP_SETUID once; setpriv drops capabilities
# and sets no-new-privileges before any candidate-controlled dependency work.
# NoNewPrivileges=true is compatible with that setuid as long as User= is unset.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_SETGID CAP_SETUID
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/hermes-schedules
MemoryMax=1G
TasksMax=512
UMask=0077
