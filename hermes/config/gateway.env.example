# Copy to /etc/hermes-bootstrap/gateway.env, replace every placeholder, then set root:root 0400.
# This file documents names only. Never commit the populated file.
SLACK_APP_TOKEN=replace-with-xapp-token
SLACK_BOT_TOKEN=replace-with-xoxb-token
SLACK_ALLOWED_CHANNELS=replace-with-channel-allowlist
SLACK_FREE_RESPONSE_CHANNELS=replace-with-channel-allowlist
SLACK_HOME_CHANNEL=replace-with-home-channel-id
SLACK_HOME_CHANNEL_NAME=replace-with-home-channel-name
SLACK_ALLOW_ALL_USERS=false
WHATSAPP_ENABLED=true
WHATSAPP_ALLOWED_USERS=replace-with-user-allowlist
WHATSAPP_HOME_CHANNEL=replace-with-home-chat
# Optional: leave empty when the home chat is not a thread.
WHATSAPP_HOME_CHANNEL_THREAD_ID=
WHATSAPP_MODE=replace-with-reviewed-mode
BROWSERBASE_ADVANCED_STEALTH=false
BROWSERBASE_PROXIES=false
BROWSER_INACTIVITY_TIMEOUT=120
BROWSER_SESSION_TIMEOUT=900
IMAGE_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
TERMINAL_LIFETIME_SECONDS=300
TERMINAL_MODAL_IMAGE=false
TERMINAL_TIMEOUT=180
VISION_TOOLS_DEBUG=false
WEB_TOOLS_DEBUG=false
