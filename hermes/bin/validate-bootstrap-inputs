#!/usr/bin/env python3
"""Validate secret input structure without logging any secret values."""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path


EXPECTED_ENV_KEYS = {
    "BROWSERBASE_ADVANCED_STEALTH",
    "BROWSERBASE_PROXIES",
    "BROWSER_INACTIVITY_TIMEOUT",
    "BROWSER_SESSION_TIMEOUT",
    "IMAGE_TOOLS_DEBUG",
    "MOA_TOOLS_DEBUG",
    "SLACK_ALLOW_ALL_USERS",
    "SLACK_ALLOWED_CHANNELS",
    "SLACK_APP_TOKEN",
    "SLACK_BOT_TOKEN",
    "SLACK_FREE_RESPONSE_CHANNELS",
    "SLACK_HOME_CHANNEL",
    "SLACK_HOME_CHANNEL_NAME",
    "TERMINAL_LIFETIME_SECONDS",
    "TERMINAL_MODAL_IMAGE",
    "TERMINAL_TIMEOUT",
    "VISION_TOOLS_DEBUG",
    "WEB_TOOLS_DEBUG",
    "WHATSAPP_ALLOWED_USERS",
    "WHATSAPP_ENABLED",
    "WHATSAPP_HOME_CHANNEL",
    "WHATSAPP_HOME_CHANNEL_THREAD_ID",
    "WHATSAPP_MODE",
}
BOOLEAN_KEYS = {
    "BROWSERBASE_ADVANCED_STEALTH",
    "BROWSERBASE_PROXIES",
    "IMAGE_TOOLS_DEBUG",
    "MOA_TOOLS_DEBUG",
    "SLACK_ALLOW_ALL_USERS",
    "VISION_TOOLS_DEBUG",
    "WEB_TOOLS_DEBUG",
    "WHATSAPP_ENABLED",
}
INTEGER_KEYS = {
    "BROWSER_INACTIVITY_TIMEOUT",
    "BROWSER_SESSION_TIMEOUT",
    "TERMINAL_LIFETIME_SECONDS",
    "TERMINAL_TIMEOUT",
}
OPTIONAL_EMPTY_KEYS = {
    "WHATSAPP_HOME_CHANNEL_THREAD_ID",
}
KEY = re.compile(r"^[A-Z][A-Z0-9_]*$")


class InputError(RuntimeError):
    """A values-safe input validation error."""


def parse_environment(path: Path) -> dict[str, str]:
    values: dict[str, str] = {}
    for line_number, raw_line in enumerate(path.read_text().splitlines(), 1):
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if "=" not in line:
            raise InputError(f"gateway.env line {line_number} is not KEY=VALUE")
        key, value = line.split("=", 1)
        if not KEY.fullmatch(key) or key in values:
            raise InputError(f"gateway.env has an invalid or duplicate key on line {line_number}")
        if (not value and key not in OPTIONAL_EMPTY_KEYS) or "replace-with-" in value.lower():
            raise InputError(f"gateway.env key {key} is empty or still a placeholder")
        values[key] = value
    missing = EXPECTED_ENV_KEYS - set(values)
    unexpected = set(values) - EXPECTED_ENV_KEYS
    if missing or unexpected:
        raise InputError(
            "gateway.env keys differ from the reviewed schema "
            f"(missing={sorted(missing)}, unexpected={sorted(unexpected)})"
        )
    for key in BOOLEAN_KEYS:
        if values[key] not in {"true", "false"}:
            raise InputError(f"gateway.env key {key} must be true or false")
    for key in INTEGER_KEYS:
        if not values[key].isdigit() or int(values[key]) <= 0:
            raise InputError(f"gateway.env key {key} must be a positive integer")
    if not values["SLACK_APP_TOKEN"].startswith("xapp-"):
        raise InputError("SLACK_APP_TOKEN has an unexpected format")
    if not values["SLACK_BOT_TOKEN"].startswith("xoxb-"):
        raise InputError("SLACK_BOT_TOKEN has an unexpected format")
    if values["WHATSAPP_MODE"] != "bot":
        raise InputError("WHATSAPP_MODE must be the reviewed bot mode")
    return values


def validate_auth(path: Path) -> None:
    try:
        value = json.loads(path.read_text())
    except json.JSONDecodeError as error:
        raise InputError("auth.json is not valid JSON") from error
    if not isinstance(value, dict) or value.get("active_provider") != "xai-oauth":
        raise InputError("auth.json must select the xai-oauth provider")
    pool = value.get("credential_pool")
    credentials = pool.get("xai-oauth") if isinstance(pool, dict) else None
    if not isinstance(credentials, list) or not credentials:
        raise InputError("auth.json has no xai-oauth credential")
    usable = False
    for credential in credentials:
        if not isinstance(credential, dict):
            continue
        if all(
            isinstance(credential.get(key), str) and bool(credential[key].strip())
            for key in ("access_token", "refresh_token", "auth_type", "base_url")
        ):
            usable = True
    if not usable:
        raise InputError("auth.json has no structurally usable xai-oauth credential")


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("gateway_environment", type=Path)
    parser.add_argument("auth", type=Path)
    arguments = parser.parse_args(argv[1:])
    try:
        parse_environment(arguments.gateway_environment)
        validate_auth(arguments.auth)
    except (InputError, OSError, UnicodeError) as error:
        print(f"Hermes bootstrap input validation failed: {error}", file=sys.stderr)
        return 1
    print("Hermes bootstrap input structure is valid")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
